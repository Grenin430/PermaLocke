<Window x:Class="PermaLocke.Admin.AnnouncementsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel"
        Title="PermaLocke Admin · Anuncios" Height="600" Width="760" Icon="Assets/PermaLocke.Admin.ico"
        Background="{StaticResource PxBaseBrush}" WindowStartupLocation="CenterOwner">
    <!-- ANUNCIOS: un mensaje para todos los jugadores; el más reciente sale en JUGAR. -->
    <DockPanel Margin="18">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Content="ACTUALIZAR" Command="{Binding RefreshCommand}" />
            <StackPanel VerticalAlignment="Center">
                <pixel:PixelText Text="ANUNCIOS" Scale="3" Tight="True" Colour="{StaticResource PxText}"
                                 Shadow="{StaticResource PxShadow}" />
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource Faint}" FontSize="11.5" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <pixel:PixelWindow DockPanel.Dock="Top" Title="NUEVO ANUNCIO" Icon="IconDocument" Margin="0,0,0,12">
            <StackPanel>
                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True"
                         MinHeight="70" MaxLength="400" />
                <Button Content="PUBLICAR" Style="{StaticResource Primary}" Command="{Binding PublishCommand}"
                        HorizontalAlignment="Left" Margin="0,8,0,0" MinWidth="120" />
            </StackPanel>
        </pixel:PixelWindow>

        <pixel:PixelWindow Title="PUBLICADOS" Icon="IconCheck">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Published}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource FaceHigh}" Padding="12,8" Margin="0,0,0,6">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="RETIRAR" VerticalAlignment="Center" Margin="10,0,0,0"
                                            Command="{Binding DataContext.WithdrawCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Texto}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding When}" Foreground="{StaticResource Faint}" FontSize="11.5" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </pixel:PixelWindow>
    </DockPanel>
</Window>
