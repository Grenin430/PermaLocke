<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PermaLocke.Core\PermaLocke.Core.csproj" />
    <ProjectReference Include="..\PermaLocke.Rules\PermaLocke.Rules.csproj" />
    <ProjectReference Include="..\PermaLocke.Randomizer\PermaLocke.Randomizer.csproj" />
    <ProjectReference Include="..\PermaLocke.GameLink\PermaLocke.GameLink.csproj" />
    <ProjectReference Include="..\PermaLocke.Data\PermaLocke.Data.csproj" />
    <ProjectReference Include="..\PermaLocke.Infrastructure\PermaLocke.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- La misma Poke Ball que la app del jugador con el rojo pasado al violeta del tema, para
         que en el escritorio y en la barra de tareas se vea que es de la familia y cual es cual. -->
    <ApplicationIcon>Assets\PermaLocke.Admin.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tambien como recurso, para que la ventana pueda ponerselo en su barra de titulo. -->
    <Resource Include="Assets\PermaLocke.Admin.ico" />
  </ItemGroup>

</Project>
