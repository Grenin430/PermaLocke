<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PermaLocke.Core\PermaLocke.Core.csproj" />
    <ProjectReference Include="..\PermaLocke.Rules\PermaLocke.Rules.csproj" />
    <ProjectReference Include="..\PermaLocke.Randomizer\PermaLocke.Randomizer.csproj" />
    <ProjectReference Include="..\PermaLocke.GameLink\PermaLocke.GameLink.csproj" />
    <ProjectReference Include="..\PermaLocke.Data\PermaLocke.Data.csproj" />
    <ProjectReference Include="..\PermaLocke.Infrastructure\PermaLocke.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- La misma Poke Ball que la app del jugador con el rojo pasado al violeta del tema, para
         que en el escritorio y en la barra de tareas se vea que es de la familia y cual es cual. -->
    <ApplicationIcon>Assets\PermaLocke.Admin.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tambien como recurso, para que la ventana pueda ponerselo en su barra de titulo. -->
    <Resource Include="Assets\PermaLocke.Admin.ico" />
    <!-- El mismo inicio de sesión que la app del jugador, sin duplicarlo: el organizador entra con su Discord. -->
    <Compile Include="..\PermaLocke.App\Services\DiscordLogin.cs" Link="Services\DiscordLogin.cs" />
    <Compile Include="..\PermaLocke.App\Services\DisplayNames.cs" Link="Services\DisplayNames.cs" />
    <!-- El kit pixel de la app, el mismo fichero y no una copia: Admin se ve igual que la app del jugador. -->
    <Compile Include="..\PermaLocke.App\Views\Pixel\*.cs" Link="Pixel\%(Filename)%(Extension)" />
    <Compile Include="..\PermaLocke.App\Views\PixelPanel.cs;..\PermaLocke.App\Views\PixelBar.cs;..\PermaLocke.App\Views\ToastPixels.cs;..\PermaLocke.App\Services\ToastKind.cs" Link="Pixel\%(Filename)%(Extension)" />
    <Page Include="..\PermaLocke.App\Themes\Pixel.xaml" Link="Themes\Pixel.xaml" />
  </ItemGroup>

</Project>
