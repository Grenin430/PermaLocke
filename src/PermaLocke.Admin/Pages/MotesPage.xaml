<UserControl x:Class="PermaLocke.Admin.Pages.MotesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- MOTES (2026-09-28): cada votación de mote, con lo propuesto y votado; ANULAR la borra (20-motes.sql). -->
    <DockPanel Margin="18">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource Faint}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>

        <DataGrid ItemsSource="{Binding Motes}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Cuándo" Binding="{Binding When}" Width="90" />
                <DataGridTextColumn Header="Jugador" Binding="{Binding Player}" Width="130" />
                <DataGridTextColumn Header="Pokémon" Binding="{Binding Pokemon}" Width="120" />
                <DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="220" />
                <DataGridTextColumn Header="Propuestas y votos" Binding="{Binding Ballots}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="ANULAR" Margin="4,2" CommandParameter="{Binding}"
                                    ToolTip="Borra la votación. Si el mote aún no se ha puesto, ya no se pondrá."
                                    Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
