<UserControl x:Class="PermaLocke.Admin.Pages.RulesPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel">
    <!-- REGLAS (2026-09-26): los ficheros de Data/ que el organizador cambia para todos, por el servidor. -->
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Faint}" FontSize="11.5" Margin="0,4,0,0"
                       Text="Lo que subas aquí lo descarga el PermaLocke de cada jugador al abrirse (con copia de su versión) y se aplica al reiniciarlo. Sin versión oficial, cada uno usa la de su PermaLocke. Necesita tools/supabase/14-reglas.sql." />
        </StackPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="QUITAR LA OFICIAL" Command="{Binding WithdrawCommand}" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="SUBIR COMO OFICIAL" Style="{StaticResource Primary}" Command="{Binding PublishCommand}" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="RECARGAR" Command="{Binding LoadCommand}" Margin="8,0,0,0" />
            <ComboBox ItemsSource="{Binding Files}" SelectedItem="{Binding Selected}" />
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="{StaticResource Gold}" Margin="2,10,0,0" TextWrapping="Wrap" />

        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                 FontFamily="Consolas" FontSize="12.5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" VerticalContentAlignment="Top" />
    </DockPanel>
</UserControl>
