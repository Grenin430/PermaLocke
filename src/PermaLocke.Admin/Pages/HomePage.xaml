<UserControl x:Class="PermaLocke.Admin.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel">
    <!-- INICIO (2026-09-28, centro de control 2026-10-08): cuatro cifras leídas del servidor, lo que pide atención con su
         botón para ir, y lo último que ha cambiado un organizador. Ninguna cifra es de adorno: cada una dice de dónde sale. -->
    <UserControl.Resources>
        <Style x:Key="Figure" TargetType="Border" BasedOn="{StaticResource Panel}">
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="18,16,18,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- ================================================== CIFRAS -->
            <UniformGrid Grid.ColumnSpan="3" Rows="1" Margin="0,0,-12,16">
                <Border Style="{StaticResource Figure}" ToolTip="Su app ha dado señales en los últimos 3 minutos (presencia).">
                    <StackPanel>
                        <TextBlock Text="CONECTADOS" Style="{StaticResource Caption}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <pixel:PixelText Text="{Binding Online}" Scale="5" Tight="True" Colour="{StaticResource PxGood}" Shadow="{StaticResource PxShadow}" />
                            <pixel:PixelText Text="{Binding InTournament, StringFormat=/ {0}}" Scale="2" Tight="True" Colour="{StaticResource PxTextFaint}"
                                             VerticalAlignment="Bottom" Margin="8,0,0,2" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"><Run Text="{Binding PlayingNow, Mode=OneWay}" /><Run Text=" con el juego abierto · de los que están en la LISTA" /></TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Figure}" ToolTip="Regalos, ajustes y órdenes que algún destinatario aún no ha recogido (su historial subido).">
                    <StackPanel>
                        <TextBlock Text="ENVÍOS SIN RECOGER" Style="{StaticResource Caption}" />
                        <pixel:PixelText Text="{Binding PendingGifts}" Scale="5" Tight="True" Colour="{StaticResource PxGold}" Shadow="{StaticResource PxShadow}" Margin="0,8,0,0" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="se recogen al abrir PermaLocke" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Figure}" ToolTip="Cierres de Azahar que han mandado las apps (informes en el servidor).">
                    <StackPanel>
                        <TextBlock Text="INFORMES DE CIERRE" Style="{StaticResource Caption}" />
                        <pixel:PixelText Text="{Binding CrashReports}" Scale="5" Tight="True" Colour="{StaticResource PxAccentLight}" Shadow="{StaticResource PxShadow}" Margin="0,8,0,0" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="en INFORMES; la LIMPIEZA quita los viejos" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Figure}" ToolTip="Sugerencias en el buzón del servidor.">
                    <StackPanel>
                        <TextBlock Text="BUZÓN" Style="{StaticResource Caption}" />
                        <pixel:PixelText Text="{Binding Mailbox}" Scale="5" Tight="True" Colour="{StaticResource PxText}" Shadow="{StaticResource PxShadow}" Margin="0,8,0,0" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="sugerencias de los jugadores" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ================================================== REQUIERE ATENCIÓN -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Panel}" VerticalAlignment="Top">
                <StackPanel>
                    <pixel:PixelText Text="REQUIERE ATENCIÓN" Style="{StaticResource Heading}" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding Alerts}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Raised}" CornerRadius="4" Padding="0,0,10,0" Margin="0,0,0,6" ToolTip="{Binding Detail}">
                                    <DockPanel>
                                        <Border x:Name="Edge" DockPanel.Dock="Left" Width="4" Background="{StaticResource Gold}" CornerRadius="4,0,0,4" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Link}" VerticalAlignment="Center" CommandParameter="{Binding}"
                                                Command="{Binding DataContext.OpenAlertCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <TextBlock><Run Text="IR A " /><Run Text="{Binding Section, Mode=OneWay}" /></TextBlock>
                                        </Button>
                                        <TextBlock x:Name="Count" DockPanel.Dock="Left" Text="{Binding Count}" FontSize="20" FontFamily="Segoe UI Semibold" MinWidth="44"
                                                   TextAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Gold}" Margin="6,0,6,0" />
                                        <StackPanel Margin="0,8,0,8">
                                            <TextBlock Text="{Binding Text}" FontFamily="Segoe UI Semibold" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Severe}" Value="True">
                                        <Setter TargetName="Edge" Property="Background" Value="{StaticResource Bad}" />
                                        <Setter TargetName="Count" Property="Foreground" Value="{StaticResource Bad}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Visibility="{Binding AllClear, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,6">
                        <pixel:PixelIcon Icon="IconCheck" Scale="3" HorizontalAlignment="Left" />
                        <TextBlock Text="Nada pendiente. Todo lo que se ha leído del servidor está en orden." Foreground="{StaticResource Muted}" Margin="0,8,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ================================================== VERSIONES Y ÚLTIMOS CAMBIOS -->
            <StackPanel Grid.Row="1" Grid.Column="2">
                <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
                    <StackPanel>
                        <pixel:PixelText Text="VERSIONES" Style="{StaticResource Heading}" />
                        <TextBlock Text="{Binding Versions}" FontFamily="Consolas" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   Text="La que dice la app de cada uno al conectarse. Solo desde la 1.0.16: antes no se apuntaba." />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="TODO EL REGISTRO" Style="{StaticResource Link}" Command="{Binding GoCommand}" CommandParameter="REGISTRO" />
                            <pixel:PixelText Text="ÚLTIMOS CAMBIOS" Style="{StaticResource Heading}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Log.Latest}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,6">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Caption}"><Run Text="{Binding WhenText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ByText, Mode=OneWay}" /></TextBlock>
                                            <TextBlock Margin="0,2,0,0" TextTrimming="CharacterEllipsis"><Run Text="{Binding What, Mode=OneWay}" FontFamily="Segoe UI Semibold" /><Run Text="  " /><Run
                                                Text="{Binding Summary, Mode=OneWay}" Foreground="{StaticResource Muted}" /></TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding Log.Status}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
