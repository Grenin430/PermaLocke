<UserControl x:Class="PermaLocke.Admin.Pages.ReportsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel">
    <!-- INFORMES (§199): los informes de cierre de Azahar que mandan las apps de los jugadores (17-informes.sql). -->
    <DockPanel Margin="18">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource Faint}" FontSize="11.5" Margin="0,4,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <DataGrid ItemsSource="{Binding Reports}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Cuándo" Binding="{Binding When}" Width="150" />
                <DataGridTextColumn Header="Jugador" Binding="{Binding Player}" Width="160" />
                <DataGridTextColumn Header="Tamaño" Binding="{Binding Size}" Width="80" />
                <DataGridTextColumn Header="Fichero" Binding="{Binding Name}" Width="*" />
                <DataGridTemplateColumn Header="" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="DESCARGAR" Margin="4,2" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
