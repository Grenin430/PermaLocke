<UserControl x:Class="PermaLocke.Admin.Pages.GiftsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel">
    <!-- REGALOS Y PUNTOS: a quién (izquierda), qué (centro) y lo ya mandado (derecha). -->
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 1. A QUIÉN -->
        <pixel:PixelWindow Grid.Column="0" Title="1. A QUIÉN" Icon="IconPeople">
            <DockPanel>
                <Button DockPanel.Dock="Top" Content="MARCAR A TODOS" Click="OnChooseAll" Margin="0,0,0,6"
                        ToolTip="Marca a todos los jugadores (o desmarca si ya lo estaban)." />
                <TextBlock DockPanel.Dock="Top" Text="Clic en un jugador para marcarlo o desmarcarlo." Foreground="{StaticResource Faint}"
                           FontSize="11.5" Margin="0,0,0,8" TextWrapping="Wrap" />
                <ListBox x:Name="PlayerList" ItemsSource="{Binding Players}" SelectionMode="Multiple" SelectionChanged="OnPlayersChosen"
                         HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row" Background="{StaticResource FaceHigh}" BorderBrush="{StaticResource Canvas}"
                                                BorderThickness="2" Padding="12,9" CornerRadius="6">
                                            <DockPanel>
                                                <pixel:PixelIcon x:Name="Tick" DockPanel.Dock="Right" Icon="IconCheck" Scale="2"
                                                                 Visibility="Hidden" VerticalAlignment="Center" />
                                                <ContentPresenter />
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Hover}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="14" />
                                <TextBlock Text="{Binding Points, StringFormat={}{0} puntos}" Foreground="{StaticResource Faint}" FontSize="11.5" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </pixel:PixelWindow>

        <!-- 2. QUÉ -->
        <pixel:PixelWindow Grid.Column="2" Title="2. QUÉ" Icon="IconGift">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <pixel:PixelText Text="MOTIVO" Style="{StaticResource Heading}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MinHeight="46" AcceptsReturn="True" />
                    <TextBlock Foreground="{StaticResource Faint}" FontSize="11.5" Margin="0,4,0,0" Text="Lo lee el jugador, y queda en su historial." />

                    <pixel:PixelText Text="REGALO" Style="{StaticResource Heading}" Margin="0,18,0,6" />
                    <Border Background="{StaticResource FaceHigh}" Padding="12,10" CornerRadius="6">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBox DockPanel.Dock="Right" Text="{Binding Points, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                                <TextBlock Text="Puntos (en negativo para quitar)" VerticalAlignment="Center" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Banners}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,5">
                                            <TextBox DockPanel.Dock="Right" Width="60" Text="{Binding Rolls, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="{Binding Name, StringFormat=Tiradas: {0}}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="0,3,0,0">
                                <TextBox DockPanel.Dock="Right" Text="{Binding WonderTrades, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                                <TextBlock Text="Wonder trades" VerticalAlignment="Center" />
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="MANDAR" Style="{StaticResource Primary}" Command="{Binding SendCommand}" IsEnabled="{Binding CanSend}"
                                        MinWidth="120" ToolTip="Manda el regalo a los jugadores marcados. Pregunta antes." />
                                <Button Content="LIMPIAR" Command="{Binding ClearCommand}" Margin="8,0,0,0" ToolTip="Vacía el regalo sin mandar nada." />
                            </StackPanel>
                            <TextBlock Foreground="{StaticResource Faint}" FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="Cada uno lo recoge la próxima vez que abra PermaLocke." />
                        </StackPanel>
                    </Border>

                    <pixel:PixelText Text="AJUSTAR PUNTOS" Style="{StaticResource Heading}" Margin="0,18,0,6" />
                    <Border Background="{StaticResource FaceHigh}" Padding="12,10" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource Faint}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="Para sanciones y correcciones. No se recoge: su PermaLocke lo aplica solo en unos segundos (o al abrirlo)." />
                            <DockPanel>
                                <TextBox DockPanel.Dock="Left" Text="{Binding AdjustPoints, UpdateSourceTrigger=PropertyChanged}" Width="90"
                                         ToolTip="Puntos: en negativo para quitar" />
                                <TextBox Text="{Binding AdjustReason, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0"
                                         ToolTip="Motivo: lo lee el jugador y queda en su historial" />
                            </DockPanel>
                            <Button Content="AJUSTAR YA" Style="{StaticResource Primary}" Command="{Binding AdjustCommand}" IsEnabled="{Binding CanAdjust}"
                                    HorizontalAlignment="Left" Margin="0,8,0,0" MinWidth="120"
                                    ToolTip="Suma o resta puntos a los marcados, sin que tengan que recogerlo. Pregunta antes." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </pixel:PixelWindow>

        <!-- 3. LO MANDADO -->
        <pixel:PixelWindow Grid.Column="4" Title="3. MANDADOS" Icon="IconDocument">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Sent}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource FaceHigh}" BorderBrush="{StaticResource Canvas}" BorderThickness="1" Padding="12,9"
                                    Margin="0,0,0,6" CornerRadius="6">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="RETIRAR" Padding="10,5" VerticalAlignment="Center" Margin="10,0,0,0"
                                            ToolTip="Quita el regalo si nadie lo ha recogido todavía."
                                            Command="{Binding DataContext.WithdrawCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Gift.Reason}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Foreground="{StaticResource Gold}" FontSize="12" Margin="0,2,0,0" Text="{Binding Gift.Say}" />
                                        <TextBlock Foreground="{StaticResource Faint}" FontSize="11.5" Margin="0,2,0,0">
                                            <Run Text="{Binding State, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Detail, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </pixel:PixelWindow>
    </Grid>
</UserControl>
