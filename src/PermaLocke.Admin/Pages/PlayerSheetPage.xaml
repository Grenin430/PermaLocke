<UserControl x:Class="PermaLocke.Admin.Pages.PlayerSheetPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel">
    <!-- FICHA DEL JUGADOR (2026-09-26, rehecha 2026-10-08): la cabecera con su estado y sus cifras, y una pestaña por cosa:
         lo que pide atención, su run, lo que se le ha mandado, las notas, el registro y las acciones. Cada acción pregunta
         el motivo en su confirmación. -->
    <UserControl.Resources>
        <Style x:Key="Grid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="MinRowHeight" Value="30" />
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                        <Setter Property="Padding" Value="6,4" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Wrap" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ActionCard" TargetType="Border" BasedOn="{StaticResource Panel}">
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Width" Value="284" />
            <Setter Property="Background" Value="{StaticResource Raised}" />
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource Panel}" Padding="0">
        <DockPanel>
            <!-- ================================================== CABECERA -->
            <Border DockPanel.Dock="Top" Padding="18,14,14,12" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="ACTUALIZAR" Command="{Binding LoadCommand}" ToolTip="Vuelve a leer su ficha del servidor" />
                    </StackPanel>
                    <Grid DockPanel.Dock="Left" Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Top">
                        <Border Background="{StaticResource Raised}" CornerRadius="4">
                            <pixel:PixelIcon Icon="IconPeople" Scale="3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Image Source="{Binding Player.AvatarUrl, TargetNullValue={x:Null}}" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding Player.Name}" FontSize="20" FontFamily="Segoe UI Semibold" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Player.Name}" />
                        <WrapPanel Margin="0,6,0,0">
                            <Border Style="{StaticResource Tag}">
                                <TextBlock Text="{Binding Player.Presence}" FontSize="11" FontFamily="Segoe UI Semibold" Foreground="{StaticResource Muted}" />
                            </Border>
                            <Border Style="{StaticResource Tag}" BorderBrush="{StaticResource Gold}"
                                    Visibility="{Binding Player.NeedsLook, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="A REVISAR" FontSize="11" FontFamily="Segoe UI Semibold" Foreground="{StaticResource Gold}" />
                            </Border>
                            <Border Style="{StaticResource Tag}">
                                <TextBlock FontSize="11" Foreground="{StaticResource Muted}"><Run Text="v" /><Run Text="{Binding Player.VersionText, Mode=OneWay}" /></TextBlock>
                            </Border>
                            <Border Style="{StaticResource Tag}">
                                <TextBlock Text="{Binding Player.RoleText}" FontSize="11" Foreground="{StaticResource Muted}" />
                            </Border>
                            <Border Style="{StaticResource Tag}">
                                <TextBlock FontSize="11" Foreground="{StaticResource Faint}"><Run Text="Discord " /><Run Text="{Binding Player.DiscordId, Mode=OneWay}" /></TextBlock>
                            </Border>
                            <TextBlock Text="{Binding Player.Standing}" Foreground="{StaticResource Gold}" FontFamily="Segoe UI Semibold" FontSize="11.5"
                                       VerticalAlignment="Center" />
                        </WrapPanel>
                        <TextBlock Text="{Binding Uploaded}" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Las cifras de su última subida -->
            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Figures}" Focusable="False" Margin="18,10,18,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="74" Margin="0,0,4,6">
                            <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding Value}" FontSize="17" FontFamily="Segoe UI Semibold" Margin="0,2,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Lo que acaba de pasar al pulsar algo -->
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Margin="18,6,18,10" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Foreground" Value="{StaticResource Good}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Bad}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Grid Margin="10,8,10,0">
                <ProgressBar VerticalAlignment="Top" Height="2" IsIndeterminate="True" BorderThickness="0" Background="Transparent" Panel.ZIndex="2"
                             Foreground="{StaticResource Accent}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

                <!-- Las pestañas en una sola fila (si no caben, se deslizan): partidas en dos, la marcada saltaba de fila. -->
                <TabControl SelectedIndex="{Binding Tab}" Background="Transparent">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,-1">
                                        <StackPanel IsItemsHost="True" Orientation="Horizontal" />
                                    </ScrollViewer>
                                </Border>
                                <Border Padding="4,12,4,4">
                                    <ContentPresenter ContentSource="SelectedContent" />
                                </Border>
                            </DockPanel>
                        </ControlTemplate>
                    </TabControl.Template>
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="Tab" Background="Transparent" Padding="12,9" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                                            <ContentPresenter ContentSource="Header" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Tab" Property="Background" Value="{StaticResource Hover}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.ItemContainerStyle>
                    <!-- ================================================== RESUMEN -->
                    <TabItem Header="RESUMEN">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Background="#FF2A1F14" BorderBrush="{StaticResource Gold}" BorderThickness="1" CornerRadius="4" Padding="12,9" Margin="0,0,0,12"
                                        Visibility="{Binding HasRunProblem, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding RunProblem}" Foreground="{StaticResource Gold}" TextWrapping="Wrap" />
                                </Border>

                                <TextBlock Text="REQUIERE ATENCIÓN" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding Attentions}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Raised}" CornerRadius="4" Padding="10,6" Margin="0,0,0,4">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="VER" Style="{StaticResource Link}" CommandParameter="{Binding Tab}"
                                                            Visibility="{Binding Tab, Converter={StaticResource EmptyToHidden}}"
                                                            Command="{Binding DataContext.ShowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                    <Border DockPanel.Dock="Left" Width="4" Margin="0,0,10,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource Gold}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Severe}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource Bad}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <TextBlock Text="{Binding Text}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Nada pendiente con este jugador." Style="{StaticResource Hint}">
                                    <TextBlock.Visibility>
                                        <Binding Path="Attentions.Count" Converter="{StaticResource ZeroToVisible}" />
                                    </TextBlock.Visibility>
                                </TextBlock>

                                <StackPanel Visibility="{Binding HasFlags, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="AVISOS DE RECARGA" Style="{StaticResource Caption}" Margin="0,16,0,4" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                               Text="Estados guardados, partida jugada sin PermaLocke o restaurada, emulador cerrado en mitad de un combate. Solo los ves tú. Para sancionar: AJUSTAR en ACCIONES, MARCAR CAÍDO en POKÉMON o un MENSAJE." />
                                    <DataGrid ItemsSource="{Binding Flags}" Style="{StaticResource Grid}" HeadersVisibility="None" VerticalScrollBarVisibility="Disabled">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Binding="{Binding When}" Width="90" />
                                            <DataGridTextColumn Binding="{Binding Description}" Width="*" ElementStyle="{StaticResource Wrap}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>

                                <TextBlock Text="ÚLTIMO EN SU HISTORIAL" Style="{StaticResource Caption}" Margin="0,16,0,6" />
                                <DataGrid ItemsSource="{Binding RecentEvents}" Style="{StaticResource Grid}" HeadersVisibility="None" IsHitTestVisible="False"
                                          VerticalScrollBarVisibility="Disabled">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding When}" Width="90" />
                                        <DataGridTextColumn Binding="{Binding Type}" Width="160" />
                                        <DataGridTextColumn Binding="{Binding Points}" Width="50" />
                                        <DataGridTextColumn Binding="{Binding Description}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Button Content="VER TODO EL HISTORIAL" Style="{StaticResource Link}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                        Command="{Binding ShowCommand}" CommandParameter="HISTORIAL" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ================================================== POKÉMON -->
                    <TabItem Header="POKÉMON">
                        <DataGrid ItemsSource="{Binding Pokemon}" Style="{StaticResource Grid}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Pokémon" Width="*" MinWidth="120" SortMemberPath="Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock FontFamily="Segoe UI Semibold" TextTrimming="CharacterEllipsis"><Run Text="{Binding Name, Mode=OneWay}" /><Run
                                                    Text="{Binding ShinyMark, Mode=OneWay}" Foreground="{StaticResource Gold}" /></TextBlock>
                                                <TextBlock Text="{Binding Species}" Foreground="{StaticResource Faint}" FontSize="10.5" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Nv." Binding="{Binding Level}" Width="40" />
                                <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="74" />
                                <DataGridTextColumn Header="Origen" Binding="{Binding Origin}" Width="78" />
                                <DataGridTextColumn Header="Obtenido" Binding="{Binding Obtained}" Width="84" />
                                <DataGridTextColumn Header="Caído" Binding="{Binding Died}" Width="84" />
                                <DataGridTemplateColumn Header="" Width="118">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Button Content="REVIVIR" Margin="2" Padding="8,2" MinHeight="24" CommandParameter="{Binding}"
                                                        Visibility="{Binding Dead, Converter={StaticResource BoolToVisibility}}"
                                                        Command="{Binding DataContext.ReviveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                <Button Content="MARCAR CAÍDO" Margin="2" Padding="8,2" MinHeight="24" Style="{StaticResource Danger}" CommandParameter="{Binding}"
                                                        Visibility="{Binding Alive, Converter={StaticResource BoolToVisibility}}"
                                                        Command="{Binding DataContext.KillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <!-- ================================================== HISTORIAL -->
                    <TabItem Header="HISTORIAL">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <ComboBox DockPanel.Dock="Left" Width="220" ItemsSource="{Binding EventTypes}" SelectedItem="{Binding EventType}"
                                          AutomationProperties.Name="Tipo de evento" />
                                <TextBox Text="{Binding EventSearch, UpdateSourceTrigger=PropertyChanged, Delay=150}" Margin="8,0,0,0"
                                         ToolTip="Buscar en la descripción" AutomationProperties.Name="Buscar en el historial" />
                            </DockPanel>
                            <DataGrid ItemsSource="{Binding Events}" Style="{StaticResource Grid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Cuándo" Binding="{Binding When}" Width="90" SortMemberPath="At" />
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="160" />
                                    <DataGridTextColumn Header="Quién" Binding="{Binding Source}" Width="90" />
                                    <DataGridTextColumn Header="Puntos" Binding="{Binding Points}" Width="58" />
                                    <DataGridTextColumn Header="Descripción" Binding="{Binding Description}" Width="*" ElementStyle="{StaticResource Wrap}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <!-- ================================================== RUTAS Y WIPES -->
                    <TabItem Header="RUTAS">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="RUTAS GASTADAS" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Zones}" Style="{StaticResource Grid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ruta" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="Desde" Binding="{Binding When}" Width="100" />
                                    <DataGridTemplateColumn Header="" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="LIBERAR" Margin="2" Padding="8,2" MinHeight="24" CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.FreeZoneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Grid.Row="2" Text="EQUIPOS CAÍDOS QUE CUENTAN" Style="{StaticResource Caption}" Margin="0,12,0,6" />
                            <DataGrid Grid.Row="3" ItemsSource="{Binding Wipes}" Style="{StaticResource Grid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Cuándo" Binding="{Binding When}" Width="100" />
                                    <DataGridTextColumn Header="Descripción" Binding="{Binding Description}" Width="*" />
                                    <DataGridTemplateColumn Header="" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="REVOCAR" Margin="2" Padding="8,2" MinHeight="24" CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.RevokeWipeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- ================================================== MANDADO -->
                    <TabItem Header="MANDADO">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                                       Text="Regalos, ajustes y órdenes para este jugador (y los de «todos»). CERRADA quiere decir que su app ya lo aplicó o lo rechazó: el resultado dice qué. Sale de su historial subido, no de algo que él pueda marcar." />
                            <DataGrid ItemsSource="{Binding Orders}" Style="{StaticResource Grid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Enviado" Binding="{Binding SentText}" Width="90" SortMemberPath="Sent" />
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="140" />
                                    <DataGridTextColumn Header="Qué" Binding="{Binding What}" Width="*" MinWidth="120" ElementStyle="{StaticResource Wrap}" />
                                    <DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="*" ElementStyle="{StaticResource Wrap}" />
                                    <DataGridTemplateColumn Header="Estado" Width="96" SortMemberPath="Closed">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding State}" FontFamily="Segoe UI Semibold" FontSize="11.5">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Closed}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Good}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Resultado" Binding="{Binding Result}" Width="*" ElementStyle="{StaticResource Wrap}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <!-- ================================================== COPIAS -->
                    <TabItem Header="COPIAS">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                                       Text="Su app sube cada 6 horas, si algo ha cambiado, un zip con su run y su partida de Ultra Luna. Si pierde el PC o la carpeta, descarga la última: dentro va un LEEME con dónde va cada cosa. La LIMPIEZA deja las 5 últimas." />
                            <DataGrid ItemsSource="{Binding Copies}" Style="{StaticResource Grid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Cuándo" Binding="{Binding When}" Width="140" />
                                    <DataGridTextColumn Header="Tamaño" Binding="{Binding Size}" Width="80" />
                                    <DataGridTextColumn Header="Fichero" Binding="{Binding FileName}" Width="*" />
                                    <DataGridTemplateColumn Header="" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="DESCARGAR" Margin="2" Padding="8,2" MinHeight="24" CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <!-- ================================================== NOTAS -->
                    <TabItem Header="NOTAS">
                        <Grid IsEnabled="{Binding ControlCentre}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="GUARDAR NOTA" Style="{StaticResource Primary}" Command="{Binding AddNoteCommand}" Margin="8,0,0,0"
                                        VerticalAlignment="Top" />
                                <TextBox Text="{Binding NewNote, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" MaxLength="2000"
                                         AutomationProperties.Name="Nueva nota" ToolTip="Una incidencia, lo que habéis hablado... Solo la ven los organizadores." />
                            </DockPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource Hint}" Margin="0,0,0,8"
                                       Text="Notas internas: el jugador no las ve. Las notas y el registro necesitan 21-admin.sql en el servidor." />
                            <ItemsControl Grid.Row="2" ItemsSource="{Binding Notes}" Focusable="False">
                                <ItemsControl.Template>
                                    <ControlTemplate>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Raised}" CornerRadius="4" Padding="12,8" Margin="0,0,0,6">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="BORRAR" Style="{StaticResource Link}" VerticalAlignment="Top" CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.DeleteNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource Caption}"><Run Text="{Binding WhenText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding By, Mode=OneWay}" /></TextBlock>
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Grid.Row="3" Margin="0,12,0,6">
                                <TextBlock Text="REGISTRO DE ESTE JUGADOR" Style="{StaticResource Caption}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                           Text="Lo que los organizadores le han hecho, apuntado por el servidor con quién lo hizo. Empieza el día que se ejecutó 21-admin.sql." />
                            </StackPanel>
                            <DataGrid Grid.Row="4" ItemsSource="{Binding Log}" Style="{StaticResource Grid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Cuándo" Binding="{Binding WhenText}" Width="90" SortMemberPath="When" />
                                    <DataGridTextColumn Header="Quién" Binding="{Binding ByText}" Width="110" />
                                    <DataGridTextColumn Header="Qué" Binding="{Binding What}" Width="140" />
                                    <DataGridTextColumn Header="Detalle" Binding="{Binding Summary}" Width="*" ElementStyle="{StaticResource Wrap}" />
                                    <DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="*" ElementStyle="{StaticResource Wrap}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- ================================================== ACCIONES -->
                    <TabItem Header="ACCIONES">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                           Text="Cada acción te dice qué va a pasar y te pide el motivo antes de mandarla. Las del juego las aplica su PermaLocke, con su evento en el historial; míralas en MANDADO." />
                                <WrapPanel IsEnabled="{Binding CanOrder}">
                                    <Border Style="{StaticResource ActionCard}">
                                        <StackPanel>
                                            <pixel:PixelText Text="PUNTOS" Style="{StaticResource Heading}" />
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="AJUSTAR" Command="{Binding AdjustCommand}" Margin="8,0,0,0" />
                                                <TextBox Text="{Binding AdjustPoints, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Puntos" />
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="En negativo para quitar. Se aplica solo, sin que lo recoja." />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource ActionCard}">
                                        <StackPanel>
                                            <pixel:PixelText Text="PRUEBAS SUPERADAS" Style="{StaticResource Heading}" />
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="CORREGIR" Command="{Binding SetStagesCommand}" Margin="8,0,0,0" />
                                                <TextBox Text="{Binding Stages, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pruebas superadas" />
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Mueve también su cap de nivel." />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource ActionCard}">
                                        <StackPanel>
                                            <pixel:PixelText Text="DAR UN OBJETO" Style="{StaticResource Heading}" />
                                            <ComboBox ItemsSource="{Binding ItemChoices}" SelectedItem="{Binding Item}" IsEditable="True" IsTextSearchEnabled="True"
                                                      AutomationProperties.Name="Objeto" />
                                            <DockPanel Margin="0,6,0,0">
                                                <Button DockPanel.Dock="Right" Content="DAR" Command="{Binding GiveItemCommand}" Margin="8,0,0,0" />
                                                <TextBlock Text="o id" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource Faint}" />
                                                <TextBox Text="{Binding ManualItemId, UpdateSourceTrigger=PropertyChanged}" Width="60" ToolTip="Cualquier objeto por su id; 0 = el de la lista" />
                                                <TextBlock Text="cantidad" VerticalAlignment="Center" Margin="10,0,6,0" Foreground="{StaticResource Faint}" />
                                                <TextBox Text="{Binding ItemAmount, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Cantidad" />
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Llega a su mochila la próxima vez que tenga el juego abierto con la partida cargada." />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource ActionCard}">
                                        <StackPanel>
                                            <pixel:PixelText Text="DAR UN POKÉMON" Style="{StaticResource Heading}" />
                                            <ComboBox ItemsSource="{Binding SpeciesChoices}" SelectedItem="{Binding GiftSpecies}" IsEditable="True" IsTextSearchEnabled="True"
                                                      AutomationProperties.Name="Especie" />
                                            <DockPanel Margin="0,6,0,0">
                                                <Button DockPanel.Dock="Right" Content="DAR" Command="{Binding GivePokemonCommand}" Margin="8,0,0,0" />
                                                <TextBlock Text="Nv." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource Faint}" />
                                                <TextBox Text="{Binding GiftLevel, UpdateSourceTrigger=PropertyChanged}" Width="50" AutomationProperties.Name="Nivel" />
                                                <TextBlock Text="Forma" VerticalAlignment="Center" Margin="10,0,6,0" Foreground="{StaticResource Faint}" />
                                                <TextBox Text="{Binding GiftForm, UpdateSourceTrigger=PropertyChanged}" Width="44" AutomationProperties.Name="Forma" />
                                                <CheckBox Content="Vario" IsChecked="{Binding GiftShiny}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Entra en sus cajas con el juego cerrado, como el gacha." />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource ActionCard}">
                                        <StackPanel>
                                            <pixel:PixelText Text="MENSAJE PRIVADO" Style="{StaticResource Heading}" />
                                            <TextBox Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"
                                                     MaxLength="500" AutomationProperties.Name="Mensaje" />
                                            <Button Content="MANDAR" Command="{Binding SendMessageCommand}" HorizontalAlignment="Right" Margin="0,6,0,0" />
                                            <TextBlock Style="{StaticResource Hint}" Text="Le sale encima del juego y en su buzón. El motivo va de asunto." />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource ActionCard}">
                                        <StackPanel>
                                            <pixel:PixelText Text="JUEGO" Style="{StaticResource Heading}" />
                                            <UniformGrid Columns="2">
                                                <Button Content="CERRAR EL JUEGO" Style="{StaticResource Danger}" Command="{Binding LockCommand}" Margin="0,0,4,0" />
                                                <Button Content="VOLVER A ABRIRLO" Command="{Binding UnlockCommand}" Margin="4,0,0,0" />
                                            </UniformGrid>
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Cerrado, no puede pulsar JUGAR hasta que lo vuelvas a abrir." />
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>

                                <Border Style="{StaticResource ActionCard}" Width="580" HorizontalAlignment="Left" BorderBrush="{StaticResource Bad}"
                                        IsEnabled="{Binding ControlCentre}">
                                    <StackPanel>
                                        <pixel:PixelText Text="CUENTA" Style="{StaticResource Heading}" Colour="{StaticResource PxBad}" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{Binding SuspendText}" Style="{StaticResource Danger}" Command="{Binding ToggleSuspendCommand}" MinWidth="130" />
                                            <Button Content="REINICIAR SU RUN" Style="{StaticResource Danger}" Command="{Binding ResetRunCommand}" Margin="8,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                                   Text="SUSPENDER: sigue en la lista con todo lo suyo, pero no entra ni sube nada hasta que lo reactives. REINICIAR: su run pasa a archivada (no se borra) y puede empezar otra; AUDITORÍA la puede reactivar." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
