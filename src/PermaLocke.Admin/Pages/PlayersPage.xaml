<UserControl x:Class="PermaLocke.Admin.Pages.PlayersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel"
             xmlns:vm="clr-namespace:PermaLocke.Admin.ViewModels"
             xmlns:pages="clr-namespace:PermaLocke.Admin.Pages">
    <!-- JUGADORES (2026-09-28): la lista a la izquierda y la ficha del que pulses al lado, sin abrir ventanas. -->
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:PlayerSheetViewModel}"><pages:PlayerSheetPage /></DataTemplate>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <pixel:PixelWindow Grid.Column="0" Title="JUGADORES" Icon="IconPeople">
            <ListBox ItemsSource="{Binding Players}" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                     SelectionChanged="OnPlayerChosen">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Row" Background="{StaticResource FaceHigh}" BorderBrush="{StaticResource Canvas}"
                                            BorderThickness="1" Padding="12,9" CornerRadius="6">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Hover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Presence}" VerticalAlignment="Center" FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FF898989" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="Playing">
                                                <Setter Property="Foreground" Value="#FF90BA3C" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="InApp">
                                                <Setter Property="Foreground" Value="#FF57CBDE" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="15" />
                                <TextBlock Foreground="{StaticResource Faint}" FontSize="11.5" Margin="0,2,0,0">
                                    <Run Text="{Binding Points, Mode=OneWay}" /><Run Text=" pts · " /><Run
                                        Text="{Binding Alive, Mode=OneWay}" /><Run Text=" en pie · " /><Run
                                        Text="{Binding Dead, Mode=OneWay}" /><Run Text=" caídos" />
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </pixel:PixelWindow>

        <Grid Grid.Column="2">
            <Border Background="{StaticResource Surface}" CornerRadius="10" Padding="30"
                    Visibility="{Binding Sheet, Converter={StaticResource NullToVisible}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <pixel:PixelIcon Icon="IconPeople" Scale="5" HorizontalAlignment="Center" />
                    <pixel:PixelText Text="ELIGE UN JUGADOR" Scale="3" Tight="True" Colour="{StaticResource PxTextDim}" Margin="0,16,0,0"
                                     HorizontalAlignment="Center" />
                    <TextBlock Text="Pulsa uno de la lista para ver su run y mandarle órdenes." Foreground="{StaticResource Faint}"
                               Margin="0,10,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
            <ContentControl Content="{Binding Sheet}" Focusable="False" />
        </Grid>
    </Grid>
</UserControl>
