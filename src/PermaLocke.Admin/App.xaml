<Application x:Class="PermaLocke.Admin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel">
    <Application.Resources>
        <!-- El mismo kit pixel que la app del jugador (Themes/Pixel.xaml y los controles, enlazados desde PermaLocke.App,
             no copiados): Admin se ve igual. Lo de abajo solo pone ese aspecto a los controles de siempre. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Pixel.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <SolidColorBrush x:Key="Canvas" Color="#FF120E20" />
            <SolidColorBrush x:Key="Text" Color="{StaticResource PxText}" />
            <SolidColorBrush x:Key="Muted" Color="{StaticResource PxTextDim}" />
            <SolidColorBrush x:Key="Faint" Color="{StaticResource PxTextFaint}" />
            <SolidColorBrush x:Key="Accent" Color="{StaticResource PxAccent}" />
            <SolidColorBrush x:Key="Gold" Color="{StaticResource PxGold}" />
            <SolidColorBrush x:Key="Good" Color="{StaticResource PxGood}" />
            <SolidColorBrush x:Key="Bad" Color="{StaticResource PxBad}" />
            <SolidColorBrush x:Key="Well" Color="{StaticResource PxWell}" />
            <SolidColorBrush x:Key="FaceHigh" Color="{StaticResource PxFaceHigh}" />

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Text}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="Heading" TargetType="pixel:PixelText">
                <Setter Property="Scale" Value="2" />
                <Setter Property="Tight" Value="True" />
                <Setter Property="Colour" Value="{StaticResource PxGold}" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style TargetType="Button" BasedOn="{StaticResource PxSubtleButton}" />
            <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource PxButton}" />
            <Style TargetType="TextBox" BasedOn="{StaticResource PxTextBox}" />
            <Style TargetType="CheckBox" BasedOn="{StaticResource PxCheckBox}" />
            <Style TargetType="ScrollBar" BasedOn="{StaticResource PxScrollBar}" />

            <Style TargetType="ListBox">
                <Setter Property="Background" Value="{StaticResource Well}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource Text}" />
            </Style>

            <Style TargetType="DataGrid">
                <Setter Property="Background" Value="{StaticResource Well}" />
                <Setter Property="RowBackground" Value="{StaticResource Well}" />
                <Setter Property="Foreground" Value="{StaticResource Text}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource FaceHigh}" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{StaticResource FaceHigh}" />
                <Setter Property="Foreground" Value="{StaticResource Gold}" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style TargetType="DataGridCell">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="6,4" />
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource FaceHigh}" />
                        <Setter Property="Foreground" Value="{StaticResource Text}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
