<Window x:Class="PermaLocke.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PermaLocke Admin" Height="780" Width="1180" Icon="Assets/PermaLocke.Admin.ico"
        Background="{StaticResource Canvas}" WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================================== LA CARPETA -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Content="ACTUALIZAR" Command="{Binding RefreshCommand}" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="ELEGIR CARPETA" Command="{Binding ChooseFolderCommand}" />
            <Button DockPanel.Dock="Right" Content="AUDITORÍA DEL TORNEO" Click="OnAudit" Margin="0,0,8,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="PERMALOCKE · ADMIN" FontFamily="{StaticResource Display}" FontSize="17" />
                <TextBlock Text="{Binding SharedFolder}" Foreground="{StaticResource Faint}" FontSize="11.5"
                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="430" />
            </Grid.ColumnDefinitions>

            <!-- ================================================== QUIÉN HAY -->
            <Border Grid.Column="0" Background="{StaticResource Panel}" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="JUGADORES" Style="{StaticResource Heading}" />

                    <ListBox Grid.Row="1" ItemsSource="{Binding Players}" SelectedItem="{Binding To}"
                             MaxHeight="300" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Row" Background="{StaticResource PanelHigh}"
                                                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                                                    Padding="12,9">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Row" Property="BorderBrush"
                                                            Value="{StaticResource Accent}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Display}"
                                                   FontSize="15" />
                                        <TextBlock Foreground="{StaticResource Faint}" FontSize="11.5" Margin="0,2,0,0">
                                            <Run Text="{Binding Points, Mode=OneWay}" /><Run Text=" puntos · " /><Run
                                                Text="{Binding Alive, Mode=OneWay}" /><Run Text=" en pie · " /><Run
                                                Text="{Binding Dead, Mode=OneWay}" /><Run Text=" caídos · publicó " /><Run
                                                Text="{Binding Ago, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding Verdict}" VerticalAlignment="Center"
                                               FontFamily="{StaticResource Display}" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Bad}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Verdict}" Value="Cuadra">
                                                        <Setter Property="Foreground" Value="{StaticResource Good}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- ================================================== LO MANDADO -->
                    <DockPanel Grid.Row="2" Margin="0,16,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="REGALOS MANDADOS" Style="{StaticResource Heading}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Sent}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource PanelHigh}" BorderBrush="{StaticResource Line}"
                                                BorderThickness="1" Padding="12,9" Margin="0,0,0,6">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="RETIRAR" Padding="10,5"
                                                        VerticalAlignment="Center" Margin="10,0,0,0"
                                                        Command="{Binding DataContext.WithdrawCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Gift.Reason}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Foreground="{StaticResource Gold}" FontSize="12"
                                                               Margin="0,2,0,0" Text="{Binding Gift.Say}" />
                                                    <TextBlock Foreground="{StaticResource Faint}" FontSize="11.5"
                                                               Margin="0,2,0,0">
                                                        <Run Text="{Binding State, Mode=OneWay}" /><Run Text=" " /><Run
                                                            Text="{Binding Detail, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- ================================================== EL REGALO -->
            <Border Grid.Column="2" Background="{StaticResource Panel}" Padding="16,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="MANDAR UN REGALO" Style="{StaticResource Heading}" />

                        <CheckBox Content="A todos" IsChecked="{Binding ToEverybody}" Margin="0,0,0,6" />
                        <TextBlock Foreground="{StaticResource Faint}" FontSize="11.5"
                                   Text="Si lo quitas, va al jugador elegido en la lista de la izquierda." />

                        <TextBlock Text="MOTIVO" Style="{StaticResource Heading}" Margin="0,16,0,6" />
                        <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap" MinHeight="46" AcceptsReturn="True" />
                        <TextBlock Foreground="{StaticResource Faint}" FontSize="11.5" Margin="0,4,0,0"
                                   Text="Lo lee el jugador, y queda en su historial." />

                        <TextBlock Text="PUNTOS" Style="{StaticResource Heading}" Margin="0,16,0,6" />
                        <TextBox Text="{Binding Points, UpdateSourceTrigger=PropertyChanged}" Width="110"
                                 HorizontalAlignment="Left" />
                        <TextBlock Foreground="{StaticResource Faint}" FontSize="11.5" Margin="0,4,0,0"
                                   Text="En negativo también, para quitar." />

                        <TextBlock Text="OBJETOS" Style="{StaticResource Heading}" Margin="0,16,0,6" />
                        <DockPanel>
                            <TextBox DockPanel.Dock="Left" Width="60" Margin="0,0,6,0"
                                     Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Text="{Binding ItemSearch, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <ListBox ItemsSource="{Binding Matches}" SelectedItem="{Binding Match}" MaxHeight="130"
                                 Margin="0,6,0,0" DisplayMemberPath="Name" />
                        <Button Content="AÑADIR OBJETO" Command="{Binding AddItemCommand}" HorizontalAlignment="Left"
                                Margin="0,6,0,0" />

                        <ItemsControl ItemsSource="{Binding Items}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,4">
                                        <Button DockPanel.Dock="Right" Content="QUITAR" Padding="8,3" FontSize="11"
                                                Command="{Binding DataContext.RemoveItemCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="TIRADAS DE GACHA" Style="{StaticResource Heading}" Margin="0,16,0,6" />
                        <ItemsControl ItemsSource="{Binding Banners}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,5">
                                        <TextBox DockPanel.Dock="Right" Width="60"
                                                 Text="{Binding Rolls, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="WONDER TRADES" Style="{StaticResource Heading}" Margin="0,16,0,6" />
                        <TextBox Text="{Binding WonderTrades, UpdateSourceTrigger=PropertyChanged}" Width="60"
                                 HorizontalAlignment="Left" />

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="MANDAR" Style="{StaticResource Primary}" Command="{Binding SendCommand}"
                                    IsEnabled="{Binding CanSend}" MinWidth="120" />
                            <Button Content="LIMPIAR" Command="{Binding ClearCommand}" Margin="8,0,0,0" />
                        </StackPanel>

                        <TextBlock Foreground="{StaticResource Faint}" FontSize="11.5" Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Text="Los objetos los recoge el jugador con Azahar abierto. Lo demás, cuando abra PermaLocke." />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{StaticResource Muted}" Margin="2,12,0,0" />
    </Grid>
</Window>
