<Window x:Class="PermaLocke.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel"
        xmlns:vm="clr-namespace:PermaLocke.Admin.ViewModels"
        xmlns:pages="clr-namespace:PermaLocke.Admin.Pages"
        Title="PermaLocke Admin" Height="860" Width="1440" MinWidth="1100" MinHeight="640" Icon="Assets/PermaLocke.Admin.ico"
        Background="{StaticResource PxBaseBrush}" WindowStartupLocation="CenterScreen">

    <!-- Admin (2026-09-28): un menú a la izquierda, agrupado, y cada cosa en su página a la derecha; lo que antes eran
         ventanas sueltas son ahora páginas. Cada página es un view model y estas plantillas eligen su vista. -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeSection}"><pages:HomePage DataContext="{Binding Admin}" /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlayersSection}"><pages:PlayersPage DataContext="{Binding Admin}" /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:GiftsSection}"><pages:GiftsPage DataContext="{Binding Admin}" /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TournamentSection}"><pages:TournamentPage DataContext="{Binding Admin}" /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RulesViewModel}"><pages:RulesPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AnnouncementsViewModel}"><pages:AnnouncementsPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditViewModel}"><pages:AuditPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}"><pages:ReportsPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SuggestionsViewModel}"><pages:SuggestionsPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MotesViewModel}"><pages:MotesPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:FallenViewModel}"><pages:FallenPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:WhitelistViewModel}"><pages:WhitelistPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsageViewModel}"><pages:UsagePage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CleanupViewModel}"><pages:CleanupPage /></DataTemplate>

        <CollectionViewSource x:Key="Menu" Source="{Binding Sections}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================================================== EL MENÚ -->
        <Border Grid.Column="0" Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,20,18,14">
                    <pixel:PixelText Text="PERMALOCKE" Scale="3" Tight="True" Colour="{StaticResource PxText}" Shadow="{StaticResource PxShadow}" />
                    <pixel:PixelText Text="ADMIN" Scale="3" Tight="True" Colour="{StaticResource PxGold}" Shadow="{StaticResource PxShadow}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- La cuenta, abajo del todo -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" Padding="14,12" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Button Content="ENTRAR CON DISCORD" Style="{StaticResource Primary}" Command="{Binding SignInCommand}"
                                Visibility="{Binding IsSignedOut, Converter={StaticResource BoolToVisibility}}" />
                        <DockPanel Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}">
                            <Image DockPanel.Dock="Left" Source="{Binding Photo, TargetNullValue={x:Null}}" Width="34" Height="34" Margin="0,0,10,0" />
                            <Button DockPanel.Dock="Right" Content="SALIR" Command="{Binding SignOutCommand}" Padding="10,4" MinHeight="28"
                                    ToolTip="Cierra la sesión de Discord en este PC." />
                            <StackPanel VerticalAlignment="Center">
                                <pixel:PixelText Text="{Binding AdminName}" Scale="2" Tight="True" Colour="{StaticResource PxGold}" />
                                <TextBlock Text="organizador" Foreground="{StaticResource Faint}" FontSize="11" Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>

                <ListBox ItemsSource="{Binding Source={StaticResource Menu}}" SelectedItem="{Binding SelectedSection}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Faint}" FontSize="10.5"
                                               FontFamily="Segoe UI Semibold" Margin="20,14,0,4" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="ToolTip" Value="{Binding Help}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row" Background="Transparent" Margin="10,1" Padding="10,8" CornerRadius="6">
                                            <DockPanel>
                                                <Border x:Name="Mark" DockPanel.Dock="Left" Width="3" Margin="-10,0,9,0" Background="Transparent" />
                                                <pixel:PixelIcon x:Name="Glyph" DockPanel.Dock="Left" Icon="{Binding Icon}" Scale="2" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <pixel:PixelText x:Name="Label" Text="{Binding Title}" Scale="2" Tight="True" VerticalAlignment="Center"
                                                                 Colour="{StaticResource PxTextDim}" />
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Hover}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentDeep}" />
                                                <Setter TargetName="Mark" Property="Background" Value="{StaticResource Gold}" />
                                                <Setter TargetName="Label" Property="Colour" Value="{StaticResource PxText}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ================================================== LA PÁGINA -->
        <DockPanel Grid.Column="1">
            <!-- Arriba: lo de hoy y ACTUALIZAR, siempre a la vista -->
            <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" Padding="18,10" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="ACTUALIZAR" Command="{Binding RefreshAllCommand}"
                            ToolTip="Vuelve a leer todo del servidor (se hace solo cada minuto)." />
                    <StackPanel VerticalAlignment="Center">
                        <pixel:PixelText Text="{Binding SelectedSection.Title}" Scale="3" Tight="True" Colour="{StaticResource PxText}"
                                         Shadow="{StaticResource PxShadow}" />
                        <TextBlock Text="{Binding SelectedSection.Help}" Foreground="{StaticResource Faint}" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource Canvas}" Padding="18,6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Today}" Foreground="{StaticResource Gold}" FontSize="11.5" />
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="11.5" />
                </DockPanel>
            </Border>

            <ContentControl Content="{Binding SelectedSection.Page}" Margin="4,0,4,0" Focusable="False" />
        </DockPanel>
    </Grid>
</Window>
