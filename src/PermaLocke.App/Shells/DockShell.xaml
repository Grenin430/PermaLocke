<shells:ShellBase x:Class="PermaLocke.App.Shells.DockShell"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:shells="clr-namespace:PermaLocke.App.Shells"
                  xmlns:views="clr-namespace:PermaLocke.App.Views"
                  xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel">

    <!-- DISEÑO «CABINA Y MUELLE» (ULTRAUMBRAL). Arriba, tu estado como un HUD: dónde estás a la izquierda; a la derecha lo
         que cambia mientras juegas (jugar, regalos, buzón, rol y puntos). Abajo, un muelle de iconos donde solo la sección
         elegida enseña su nombre, con las páginas del grupo en pastillas justo encima. Todo el espacio de en medio es
         de la pantalla: la franja de lo que pide el juego es fina y el título no se repite. -->
    <shells:ShellBase.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource PxScrollBar}" />
    </shells:ShellBase.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <views:PixelPanel Grid.RowSpan="4" Fill="{DynamicResource PxSidebar}" HasShadow="False" />
        <pixel:PixelBackdrop Grid.Row="1" Grid.RowSpan="3" Margin="6,0,6,6" Base="{DynamicResource PxBase}" />

        <shells:ShellCaption Grid.Row="0" />

        <!-- EL HUD -->
        <DockPanel Grid.Row="1" Margin="18,12,18,0">
            <shells:PointsBadge DockPanel.Dock="Right" Margin="12,0,0,0" />
            <shells:HeaderActions DockPanel.Dock="Right" />
            <Grid HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                <views:PixelPanel Fill="{DynamicResource PxGlass}" HasShadow="False" />
                <StackPanel Margin="12,8,18,13">
                    <StackPanel Orientation="Horizontal">
                        <pixel:PixelIcon Icon="{Binding SelectedSection.IconKey}" Scale="3" Bob="True" VerticalAlignment="Center"
                                         Margin="0,0,14,0" />
                        <pixel:PixelText Text="{Binding SelectedSection.HeaderTitle}" Scale="3" Tight="True" Trim="True"
                                         Colour="{DynamicResource PxText}" Shadow="{DynamicResource PxShadow}" VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- Lo que pide la sección del juego, en una línea bajo el título: así no gasta una franja de la pantalla. -->
                    <shells:NeedLine Margin="0,8,0,0" Visibility="{Binding ShowsNeed, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </DockPanel>

        <!-- LA PANTALLA -->
        <Grid Grid.Row="2" Margin="18,14,18,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <shells:Banners ShowNeed="False" />
            <ContentControl x:Name="Section" Grid.Row="1" Content="{Binding SelectedSection}" />
        </Grid>

        <!-- LAS PÁGINAS Y EL MUELLE -->
        <StackPanel Grid.Row="3" Margin="18,10,18,16">
            <Grid x:Name="Pages" HorizontalAlignment="Center" Margin="0,0,0,10">
                <ListBox Background="Transparent" BorderThickness="0"
                         ItemsSource="{Binding SelectedSection.AsGroup.Pages}"
                         SelectedItem="{Binding SelectedSection.AsGroup.SelectedPage, Mode=OneWay}"
                         SelectionChanged="OnPageChosen" ItemContainerStyle="{StaticResource PxPill}"
                         shells:ShellSupport.ReleaseCapture="True" AutomationProperties.Name="Páginas">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSection.AsGroup}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
            </Grid>

            <ListBox HorizontalAlignment="Center" Background="Transparent" BorderThickness="0"
                     ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource PxDockItem}" shells:ShellSupport.ReleaseCapture="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Secciones">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </StackPanel>

        <shells:ShellOverlays Grid.Row="1" Grid.RowSpan="3" Offset="0,14,26,0" />
    </Grid>
</shells:ShellBase>
