<UserControl x:Class="PermaLocke.App.Shells.PointsBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PermaLocke.App.Views"
             xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel"
             xmlns:svc="clr-namespace:PermaLocke.App.Services">

    <!-- LOS PUNTOS, la moneda del sistema: el rombo y la cifra, que rueda hasta su valor y da un destello verde o rojo.
         Grande (con su rótulo debajo) o compacto (una sola línea), según donde lo ponga el diseño. -->
    <Grid VerticalAlignment="Center">
        <views:PixelPanel x:Name="Plate" Fill="{DynamicResource PxGlass}" HasShadow="False" />
        <StackPanel x:Name="Row" Orientation="Horizontal" Margin="9,6,12,8">
            <pixel:PixelIcon x:Name="Gem" Icon="IconPoints" Scale="2" VerticalAlignment="Center" Margin="0,0,8,0" />
            <StackPanel x:Name="Stack" VerticalAlignment="Center">
                <pixel:PixelText x:Name="Number" Scale="3" Tight="True"
                                 Colour="{DynamicResource PxAccentInk}" Shadow="{DynamicResource PxShadow}"
                                 svc:Rolling.To="{Binding PointsValue}"
                                 Visibility="{Binding HasPoints, Converter={StaticResource BoolToVisibility}}" />
                <!-- Sin run, la raya: un contador no puede contar hasta un guion. -->
                <pixel:PixelText x:Name="Dash" Text="{Binding PointsText}" Scale="3" Tight="True"
                                 Colour="{DynamicResource PxAccentInk}" Shadow="{DynamicResource PxShadow}"
                                 Visibility="{Binding HasPoints, Converter={StaticResource InverseBoolToVisibility}}" />
                <pixel:PixelText x:Name="Caption" Text="PUNTOS" Scale="2" Tight="True" Margin="0,3,0,0"
                                 Colour="{DynamicResource PxTextDim}" Shadow="{DynamicResource PxShadow}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
