<shells:ShellBase x:Class="PermaLocke.App.Shells.MenuShell"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:shells="clr-namespace:PermaLocke.App.Shells"
                  xmlns:views="clr-namespace:PermaLocke.App.Views"
                  xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel">

    <!-- DISEÑO «MENÚ DE INICIO» (GAME BOY). No hay barra de navegación: el menú de inicio es una cuadrícula de baldosas, y
         cada pantalla trae arriba su botón ◀ MENÚ, el sitio donde estás (SECCIÓN ▸ PÁGINA) y lo de siempre a la derecha.
         Menos cosas a la vez en pantalla: lo que se ve es lo que estás haciendo. El menú se abre con ◀ MENÚ o con Escape. -->
    <shells:ShellBase.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource PxScrollBar}" />
    </shells:ShellBase.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <views:PixelPanel Grid.RowSpan="2" Fill="{DynamicResource PxSidebar}" HasShadow="False" />
        <pixel:PixelBackdrop Grid.Row="1" Margin="6,0,6,6" Base="{DynamicResource PxBase}" />

        <shells:ShellCaption Grid.Row="0" />

        <!-- LA PANTALLA EN CURSO -->
        <Grid x:Name="PageLayer" Grid.Row="1" Margin="18,12,18,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- La barra de atrás: volver, dónde estás, y a la derecha lo de siempre. -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <views:PixelPanel Fill="{DynamicResource PxFace}" HasShadow="False" />
                <DockPanel Margin="12,9,14,15">
                    <shells:HeaderActions DockPanel.Dock="Right" Compact="True" Margin="12,0,0,0" />
                    <shells:PointsBadge DockPanel.Dock="Right" Compact="True" Margin="12,0,0,0" />
                    <Button DockPanel.Dock="Left" Content="◀ MENÚ" Style="{StaticResource PxButton}" Padding="12,3,16,8"
                            Click="OnMenu" ToolTip="Abrir el menú de inicio (Escape)" AutomationProperties.Name="Abrir el menú de inicio" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <pixel:PixelIcon Icon="{Binding SelectedSection.IconKey}" Scale="2" Bob="True" VerticalAlignment="Center"
                                         Margin="0,0,10,0" />
                        <pixel:PixelText Text="{Binding SelectedSection.Title}" Scale="2" Tight="True" VerticalAlignment="Center"
                                         Colour="{DynamicResource PxTextDim}">
                            <pixel:PixelText.Style>
                                <Style TargetType="pixel:PixelText">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSection.AsGroup}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </pixel:PixelText.Style>
                        </pixel:PixelText>
                        <pixel:PixelText Text="▶" Scale="2" Tight="True" Margin="10,0,10,0" VerticalAlignment="Center"
                                         Colour="{DynamicResource PxTextFaint}">
                            <pixel:PixelText.Style>
                                <Style TargetType="pixel:PixelText">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSection.AsGroup}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </pixel:PixelText.Style>
                        </pixel:PixelText>
                        <pixel:PixelText Text="{Binding SelectedSection.HeaderTitle}" Scale="3" Tight="True" Trim="True"
                                         Colour="{DynamicResource PxText}" Shadow="{DynamicResource PxShadow}" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Grid>

            <!-- Las páginas del grupo, solo si la sección las tiene -->
            <Grid x:Name="Pages" Grid.Row="1" Margin="0,0,0,10">
                <views:PixelPanel Fill="{DynamicResource PxFace}" HasShadow="False" />
                <ListBox Margin="8,4,8,6" Background="Transparent" BorderThickness="0"
                         ItemsSource="{Binding SelectedSection.AsGroup.Pages}"
                         SelectedItem="{Binding SelectedSection.AsGroup.SelectedPage, Mode=OneWay}"
                         SelectionChanged="OnPageChosen" ItemContainerStyle="{StaticResource PxSubTab}"
                         shells:ShellSupport.ReleaseCapture="True" AutomationProperties.Name="Páginas">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSection.AsGroup}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
            </Grid>

            <shells:Banners Grid.Row="2" />
            <ContentControl x:Name="Section" Grid.Row="3" Content="{Binding SelectedSection}" />
        </Grid>

        <!-- EL MENÚ DE INICIO: tapa la pantalla mientras está abierto. -->
        <Grid x:Name="MenuLayer" Grid.Row="1" Margin="18,12,18,18" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="324" />
            </Grid.ColumnDefinitions>

            <pixel:PixelWindow Title="MENÚ DE INICIO" Icon="IconGacha">
                <pixel:PixelWindow.HeaderContent>
                    <pixel:PixelText Text="ESCAPE PARA VOLVER" Scale="2" Tight="True" Colour="{DynamicResource PxTextDim}" />
                </pixel:PixelWindow.HeaderContent>
                <ListBox x:Name="Tiles" Background="Transparent" BorderThickness="0" Margin="0,4,0,0"
                         ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection, Mode=OneWay}"
                         ItemContainerStyle="{StaticResource PxTile}" shells:ShellSupport.ReleaseCapture="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         PreviewMouseLeftButtonUp="OnTileClicked" KeyDown="OnTileKey" AutomationProperties.Name="Secciones">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </pixel:PixelWindow>

            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <pixel:PixelWindow Title="ENTRENADOR" Icon="IconPeople">
                    <StackPanel>
                        <shells:PointsBadge HorizontalAlignment="Left" />
                        <Grid HorizontalAlignment="Left" Margin="0,12,0,0">
                            <views:PixelPanel Fill="{DynamicResource PxFaceLift}" HasShadow="False" />
                            <pixel:PixelText Text="{Binding RoleText}" Scale="2" Tight="True" Margin="11,8,11,8"
                                             Colour="{DynamicResource PxText}" />
                        </Grid>
                        <Button Style="{StaticResource PxButton}" Padding="22,10,26,15" HorizontalAlignment="Stretch" Margin="0,14,0,0"
                                Content="{Binding Launcher.HeaderText}" Command="{Binding OpenLauncherCommand}"
                                Click="OnPlay" />
                    </StackPanel>
                </pixel:PixelWindow>

                <pixel:PixelWindow Title="ALOLA" Icon="IconStar" Margin="0,12,0,0"
                                   DataContext="{Binding Sky}"
                                   Visibility="{Binding IsKnown, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <views:AlolaWindow Hour="{Binding Hour}" HorizontalAlignment="Left" />
                        <DockPanel Margin="0,10,0,0">
                            <pixel:PixelText DockPanel.Dock="Right" Text="{Binding TimeText}" Scale="3" Tight="True"
                                             Colour="{DynamicResource PxText}" Shadow="{DynamicResource PxShadow}" />
                            <pixel:PixelText Text="{Binding PeriodText}" Scale="2" Tight="True" VerticalAlignment="Bottom"
                                             Colour="{DynamicResource PxTextDim}" />
                        </DockPanel>
                    </StackPanel>
                </pixel:PixelWindow>
            </StackPanel>
        </Grid>

        <shells:ShellOverlays Grid.Row="1" Offset="0,12,24,0" />
    </Grid>
</shells:ShellBase>
