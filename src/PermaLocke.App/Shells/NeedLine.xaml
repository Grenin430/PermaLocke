<UserControl x:Class="PermaLocke.App.Shells.NeedLine"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel">

    <!-- LO QUE PIDE LA SECCIÓN DEL JUEGO, en una línea, para el cuadro de diálogo, el rótulo o la barra de atrás. Si la
         sección no pide nada dice Idle (o nada). El color sigue la misma regla: ámbar lo pedido, verde y rojo lo comprobado. -->
    <Grid>
        <DockPanel Visibility="{Binding ShowsNeed, Converter={StaticResource BoolToVisibility}}">
            <pixel:PixelText DockPanel.Dock="Left" Text="{Binding NeedLabel}" Scale="2" Tight="True" VerticalAlignment="Center"
                             Margin="0,0,14,0">
                <pixel:PixelText.Style>
                    <Style TargetType="pixel:PixelText">
                        <Setter Property="Colour" Value="{DynamicResource PxTextDim}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NeedState}" Value="ok">
                                <Setter Property="Colour" Value="{DynamicResource PxGood}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NeedState}" Value="problem">
                                <Setter Property="Colour" Value="{DynamicResource PxBad}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NeedState}" Value="closed">
                                <Setter Property="Colour" Value="{DynamicResource PxWarn}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </pixel:PixelText.Style>
            </pixel:PixelText>
            <pixel:PixelText x:Name="Hint" Text="{Binding NeedHint}" Scale="2" Trim="True" VerticalAlignment="Center"
                             Colour="{DynamicResource PxText}" />
        </DockPanel>

        <pixel:PixelText Text="{Binding Idle, RelativeSource={RelativeSource AncestorType=UserControl}}" Scale="2" Trim="True"
                         VerticalAlignment="Center" Colour="{DynamicResource PxTextDim}"
                         Visibility="{Binding ShowsNeed, Converter={StaticResource InverseBoolToVisibility}}" />
    </Grid>
</UserControl>
