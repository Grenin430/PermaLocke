<UserControl x:Class="PermaLocke.App.Shells.ShellOverlays"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PermaLocke.App.Views"
             xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel">

    <!-- LAS DOS BANDEJAS que se abren desde la cabecera, regalos y buzón de sugerencias: una capa de la ventana y no un
         menú del sistema, así se dibujan con el mismo pixel art. Las mismas de siempre; Offset las baja o las sube según
         donde el diseño tenga sus botones. -->
    <Grid>
        <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Width="400"
              Margin="{Binding Offset, RelativeSource={RelativeSource AncestorType=UserControl}}"
              Visibility="{Binding Gifts.IsOpen, Converter={StaticResource BoolToVisibility}}">
            <pixel:PixelWindow Title="REGALOS" Icon="IconGift">
                <pixel:PixelWindow.HeaderContent>
                    <Button Content="CERRAR" Style="{StaticResource PxSubtleButton}" Command="{Binding Gifts.CloseCommand}" />
                </pixel:PixelWindow.HeaderContent>

                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Gifts.Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <views:PixelPanel Fill="{DynamicResource PxWell}" IsSunken="True" HasShadow="False" />
                                    <StackPanel Margin="14,10,16,14">
                                        <DockPanel>
                                            <pixel:PixelText DockPanel.Dock="Right" Text="{Binding When}" Scale="2" Tight="True"
                                                             Margin="10,0,0,0" Colour="{DynamicResource PxTextFaint}" />
                                            <pixel:PixelText Text="{Binding From}" Scale="2" Tight="True" Trim="True"
                                                             Colour="{DynamicResource PxText}" Shadow="{DynamicResource PxShadow}" />
                                        </DockPanel>

                                        <pixel:PixelText Text="{Binding What}" Scale="2" Wrap="True" Margin="0,8,0,0"
                                                         Colour="{DynamicResource PxGold}" />

                                        <pixel:PixelText Text="{Binding Reason}" Scale="2" Wrap="True" Margin="0,6,0,0"
                                                         Colour="{DynamicResource PxTextDim}" />

                                        <pixel:PixelText Text="Necesita Azahar abierto." Scale="2" Tight="True" Margin="0,6,0,0"
                                                         Colour="{DynamicResource PxTextFaint}"
                                                         Visibility="{Binding NeedsTheGame, Converter={StaticResource BoolToVisibility}}" />

                                        <Button Content="RECOGER" Style="{StaticResource PxButton}" Margin="0,10,0,0"
                                                HorizontalAlignment="Left"
                                                Command="{Binding DataContext.Gifts.ClaimCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsCollected, Converter={StaticResource InverseBoolToVisibility}}" />

                                        <pixel:PixelText Text="RECOGIDO" Scale="2" Tight="True" Margin="0,10,0,0"
                                                         Colour="{DynamicResource PxGood}"
                                                         Visibility="{Binding IsCollected, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <pixel:PixelText Text="{Binding Gifts.Status}" Scale="2" Wrap="True" Margin="0,4,0,0"
                                     Colour="{DynamicResource PxText}" />
                </StackPanel>
            </pixel:PixelWindow>
        </Grid>

        <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Width="420"
              Margin="{Binding Offset, RelativeSource={RelativeSource AncestorType=UserControl}}"
              Visibility="{Binding Suggestions.IsOpen, Converter={StaticResource BoolToVisibility}}">
            <pixel:PixelWindow Title="SUGERENCIAS" Icon="IconMailbox">
                <pixel:PixelWindow.HeaderContent>
                    <Button Content="CERRAR" Style="{StaticResource PxSubtleButton}" Command="{Binding Suggestions.CloseCommand}" />
                </pixel:PixelWindow.HeaderContent>

                <StackPanel>
                    <pixel:PixelText Text="Escribe lo que quieras: ideas, fallos, quejas. Le llega al organizador." Scale="2"
                                     Wrap="True" Margin="0,0,0,10" Colour="{DynamicResource PxTextDim}" />
                    <TextBox Text="{Binding Suggestions.Text, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PxTextBox}"
                             AcceptsReturn="True" TextWrapping="Wrap" MaxLength="1000" Height="150"
                             VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
                    <DockPanel Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right" Content="ENVIAR" Style="{StaticResource PxButton}"
                                Command="{Binding Suggestions.SendCommand}" />
                        <pixel:PixelText Text="{Binding Suggestions.Status}" Scale="2" Wrap="True" VerticalAlignment="Center"
                                         Margin="0,0,10,0" Colour="{DynamicResource PxText}" />
                    </DockPanel>
                </StackPanel>
            </pixel:PixelWindow>
        </Grid>
    </Grid>
</UserControl>
