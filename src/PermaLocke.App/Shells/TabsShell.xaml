<shells:ShellBase x:Class="PermaLocke.App.Shells.TabsShell"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:shells="clr-namespace:PermaLocke.App.Shells"
                  xmlns:views="clr-namespace:PermaLocke.App.Views"
                  xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel">

    <!-- DISEÑO «PESTAÑAS DE MOCHILA» (ESMERALDA). La navegación no es una barra a un lado: son pestañas a lo ancho, como los
         bolsillos de la mochila de los juegos de Game Boy Advance. Las páginas de un grupo van en una segunda fila.
         Lo que pide la sección del juego no es una franja encima: se dice en el cuadro de diálogo de abajo, como cuando
         el juego te habla. Los puntos y los botones suben a la barra de la ventana, para que el contenido tenga sitio. -->
    <shells:ShellBase.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource PxScrollBar}" />
    </shells:ShellBase.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <views:PixelPanel Grid.RowSpan="5" Fill="{DynamicResource PxSidebar}" HasShadow="False" />
        <pixel:PixelBackdrop Grid.Row="1" Grid.RowSpan="4" Margin="6,0,6,6" Base="{DynamicResource PxBase}" />

        <shells:ShellCaption Grid.Row="0" ShowSubtitle="False">
            <shells:ShellCaption.Centre>
                <StackPanel Orientation="Horizontal">
                    <shells:HeaderActions Compact="True" />
                    <shells:PointsBadge Compact="True" Margin="12,0,0,0" />
                </StackPanel>
            </shells:ShellCaption.Centre>
        </shells:ShellCaption>

        <!-- LAS PESTAÑAS -->
        <ListBox x:Name="Tabs" Grid.Row="1" Margin="16,2,10,0" Background="Transparent" BorderThickness="0"
                 ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource PxPocketTab}" shells:ShellSupport.ReleaseCapture="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="Secciones">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <!-- LAS PÁGINAS DEL GRUPO, solo si la sección las tiene -->
        <Grid x:Name="Pages" Grid.Row="2" Margin="16,6,16,0">
            <views:PixelPanel Fill="{DynamicResource PxFace}" HasShadow="False" />
            <ListBox Margin="8,4,8,6" Background="Transparent" BorderThickness="0"
                     ItemsSource="{Binding SelectedSection.AsGroup.Pages}"
                     SelectedItem="{Binding SelectedSection.AsGroup.SelectedPage, Mode=OneWay}"
                     SelectionChanged="OnPageChosen" ItemContainerStyle="{StaticResource PxSubTab}"
                     shells:ShellSupport.ReleaseCapture="True" AutomationProperties.Name="Páginas">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedSection.AsGroup}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
        </Grid>

        <!-- LA SECCIÓN -->
        <Grid Grid.Row="3" Margin="16,12,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <shells:Banners ShowNeed="False" />
            <ContentControl x:Name="Section" Grid.Row="1" Content="{Binding SelectedSection}" />
        </Grid>

        <!-- EL CUADRO DE DIÁLOGO -->
        <Grid Grid.Row="4" Margin="16,10,16,16">
            <views:PixelPanel Fill="{DynamicResource PxFace}" HasShadow="False" />
            <DockPanel Margin="20,11,20,17">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0"
                            DataContext="{Binding Sky}"
                            Visibility="{Binding IsKnown, Converter={StaticResource BoolToVisibility}}">
                    <pixel:PixelText Text="ALOLA" Scale="2" Tight="True" Colour="{DynamicResource PxTextFaint}"
                                     VerticalAlignment="Center" />
                    <pixel:PixelText Text="{Binding TimeText}" Scale="3" Tight="True" Margin="10,0,0,0"
                                     Colour="{DynamicResource PxText}" Shadow="{DynamicResource PxShadow}" VerticalAlignment="Center" />
                    <pixel:PixelText Text="{Binding PeriodText}" Scale="2" Tight="True" Margin="10,0,0,0"
                                     Colour="{DynamicResource PxTextDim}" VerticalAlignment="Center" />
                </StackPanel>
                <pixel:PixelText x:Name="Blink" DockPanel.Dock="Left" Text="▼" Scale="2" Tight="True" Margin="0,0,12,0"
                                 Colour="{DynamicResource PxCursor}" VerticalAlignment="Center" />
                <shells:NeedLine Idle="¿Qué quieres hacer?" VerticalAlignment="Center" />
            </DockPanel>
        </Grid>

        <shells:ShellOverlays Grid.RowSpan="5" Offset="0,48,22,0" />
    </Grid>
</shells:ShellBase>
