<UserControl x:Class="PermaLocke.App.Shells.HeaderActions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PermaLocke.App.Views"
             xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel">

    <!-- LO QUE SE VE DESDE CUALQUIER PANTALLA, a la derecha: JUGAR en pequeño, los regalos (si hay), el buzón de
         sugerencias y el rol. Los mismos cuatro de la cabecera de siempre, para que cada diseño los ponga donde quiera. -->
    <UserControl.Resources>
        <Style x:Key="PlateButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="{Binding BoxHeight, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="Width" Value="{Binding IconWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Body" Background="Transparent">
                            <views:PixelPanel x:Name="Plate" Fill="{DynamicResource PxFaceLift}" />
                            <pixel:PixelIcon x:Name="Face" Icon="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                             Scale="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,6" />
                            <views:PixelCursor x:Name="Focus" Margin="-3" Visibility="Collapsed" Colour="{DynamicResource PxCursor}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Fill" Value="{DynamicResource PxAccentDeep}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Plate" Property="HasShadow" Value="False" />
                                <Setter TargetName="Plate" Property="Margin" Value="6,6,0,0" />
                                <Setter TargetName="Face" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="6" Y="6" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <!-- JUGAR, EN PEQUEÑO: en todas las pantallas menos en la del lanzador, que tiene el grande. -->
        <Button x:Name="Play" Cursor="Hand" FocusVisualStyle="{x:Null}" Command="{Binding OpenLauncherCommand}"
                Height="{Binding BoxHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Padding="{Binding PlayPadding, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Visibility="{Binding ShowsPlayButton, Converter={StaticResource BoolToVisibility}}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Body" Background="Transparent">
                        <views:PixelPanel x:Name="Plate" Fill="{DynamicResource PxAccent}" />
                        <StackPanel x:Name="Face" Orientation="Horizontal" Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                            <pixel:PixelText x:Name="Glyph" Text="▶" Scale="2" Tight="True"
                                             Colour="{DynamicResource PxOnAccent}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <pixel:PixelText x:Name="Label" Text="{Binding Launcher.HeaderText}" Scale="2" Tight="True"
                                             Colour="{DynamicResource PxOnAccent}" VerticalAlignment="Center" />
                        </StackPanel>
                        <views:PixelCursor x:Name="Focus" Margin="-3" Visibility="Collapsed" Colour="{DynamicResource PxCursor}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="Fill" Value="{DynamicResource PxAccentLight}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!-- En juego se vuelve verde con letra clara: no es una llamada a pulsar, es un aviso de que esta abierto. -->
                        <DataTrigger Binding="{Binding Launcher.IsRunning}" Value="True">
                            <Setter TargetName="Plate" Property="Fill" Value="{DynamicResource PxRunning}" />
                            <Setter TargetName="Label" Property="Colour" Value="{DynamicResource PxRunningText}" />
                            <Setter TargetName="Glyph" Property="Colour" Value="{DynamicResource PxRunningGlyph}" />
                        </DataTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Plate" Property="HasShadow" Value="False" />
                            <Setter TargetName="Plate" Property="Margin" Value="6,6,0,0" />
                            <Setter TargetName="Face" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="6" Y="6" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- LA BANDEJA DE REGALOS, solo si hay alguno, con la cuenta en una chapa roja. -->
        <Grid VerticalAlignment="Center" Visibility="{Binding Gifts.HasGifts, Converter={StaticResource BoolToVisibility}}">
            <Button Style="{StaticResource PlateButton}" Tag="IconGift" Command="{Binding Gifts.ToggleCommand}"
                    ToolTip="Regalos" AutomationProperties.Name="Regalos" />
            <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,-8,0" IsHitTestVisible="False">
                <views:PixelPanel Fill="#FFB8433A" HasShadow="False" />
                <pixel:PixelText Text="{Binding Gifts.Count}" Scale="2" Tight="True" Margin="7,5,7,5" Colour="#FFFFFFFF" />
            </Grid>
        </Grid>

        <Button Style="{StaticResource PlateButton}" Tag="IconMailbox" Command="{Binding Suggestions.ToggleCommand}"
                ToolTip="Buzón de sugerencias" AutomationProperties.Name="Buzón de sugerencias" />

        <Grid x:Name="Role" Margin="10,0,0,0" VerticalAlignment="Center">
            <views:PixelPanel Fill="{DynamicResource PxFaceLift}" HasShadow="False" />
            <pixel:PixelText Text="{Binding RoleText}" Scale="2" Tight="True" Margin="11,8,11,8"
                             Colour="{DynamicResource PxText}" />
        </Grid>
    </StackPanel>
</UserControl>
