<UserControl x:Class="PermaLocke.App.Shells.Banners"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PermaLocke.App.Views"
             xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel">

    <!-- LAS DOS FRANJAS de encima de cada sección, como en el diseño de siempre: la versión nueva (ámbar, con su ACTUALIZAR)
         y lo que pide la sección del juego (abierto o cerrado, y por qué). Ámbar lo pedido, verde y rojo solo lo
         comprobado. Cada diseño decide si va esta (Mode Banner, a todo lo ancho) o la línea (Mode Line, una sola fila). -->
    <StackPanel>
        <!-- LA VERSIÓN NUEVA (§202) -->
        <Grid Margin="0,0,0,10" DataContext="{Binding Update}"
              Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
            <views:PixelPanel HasShadow="False" Fill="{DynamicResource PxWarnDeep}" />
            <DockPanel Margin="14,10,12,10">
                <pixel:PixelIcon DockPanel.Dock="Left" Icon="IconWarning" Scale="2" Bob="True"
                                 VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button DockPanel.Dock="Right" Content="ACTUALIZAR" Style="{StaticResource PxButton}"
                        Command="{Binding UpdateCommand}" VerticalAlignment="Center" Margin="12,0,0,0" />
                <StackPanel VerticalAlignment="Center">
                    <pixel:PixelText Text="{Binding Text}" Scale="3" Tight="True" Colour="{DynamicResource PxWarn}"
                                     Shadow="{DynamicResource PxShadow}" />
                    <pixel:PixelText Text="{Binding Hint}" Scale="2" Tight="True" Margin="0,5,0,0"
                                     Colour="{DynamicResource PxText}" />
                </StackPanel>
            </DockPanel>
        </Grid>

        <!-- LO QUE PIDE LA SECCIÓN -->
        <Grid x:Name="NeedHost">
        <Grid Margin="0,0,0,10" Visibility="{Binding ShowsNeed, Converter={StaticResource BoolToVisibility}}">
            <views:PixelPanel HasShadow="False">
                <views:PixelPanel.Style>
                    <Style TargetType="views:PixelPanel">
                        <Setter Property="Fill" Value="{DynamicResource PxFaceLift}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NeedState}" Value="ok">
                                <Setter Property="Fill" Value="{DynamicResource PxGoodDeep}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NeedState}" Value="problem">
                                <Setter Property="Fill" Value="{DynamicResource PxBadDeep}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NeedState}" Value="closed">
                                <Setter Property="Fill" Value="{DynamicResource PxWarnDeep}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:PixelPanel.Style>
            </views:PixelPanel>
            <DockPanel Margin="16,10,16,12">
                <pixel:PixelText DockPanel.Dock="Left" Text="{Binding NeedLabel}" Scale="3" Tight="True" VerticalAlignment="Center"
                                 Shadow="{DynamicResource PxShadow}" Margin="0,0,18,0">
                    <pixel:PixelText.Style>
                        <Style TargetType="pixel:PixelText">
                            <Setter Property="Colour" Value="{DynamicResource PxTextDim}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NeedState}" Value="ok">
                                    <Setter Property="Colour" Value="{DynamicResource PxGood}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NeedState}" Value="problem">
                                    <Setter Property="Colour" Value="{DynamicResource PxBad}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NeedState}" Value="closed">
                                    <Setter Property="Colour" Value="{DynamicResource PxWarn}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </pixel:PixelText.Style>
                </pixel:PixelText>
                <pixel:PixelText Text="{Binding NeedHint}" Scale="2" Wrap="True" VerticalAlignment="Center"
                                 Colour="{DynamicResource PxText}" />
            </DockPanel>
        </Grid>
        </Grid>
    </StackPanel>
</UserControl>
