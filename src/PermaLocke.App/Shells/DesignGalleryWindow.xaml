<Window x:Class="PermaLocke.App.Shells.DesignGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shells="clr-namespace:PermaLocke.App.Shells"
        xmlns:views="clr-namespace:PermaLocke.App.Views"
        xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel"
        Title="PermaLocke — Diseño" Width="930" Height="840" ShowInTaskbar="False" ResizeMode="NoResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True" Background="{DynamicResource PxBaseBrush}">
    <!-- LA GALERÍA DE DISEÑOS (2026-10-01): a la izquierda los cinco, con un boceto de cómo se compone cada ventana; a la derecha
         el que está señalado, en grande y con para qué sirve. Señalar no cambia nada: USAR cambia al momento, en la misma
         pantalla y con los mismos datos. La ventana se queda abierta para comparar y se vuelve a abrir con el botón DISEÑO de la
         barra de cualquiera de ellos. Con el teclado: flechas para señalar, Intro para usar, Escape para cerrar. -->
    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource PxScrollBar}" />

        <Style x:Key="Card" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Theme.Name}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid x:Name="Root" Margin="0,0,0,8" Background="Transparent">
                            <views:PixelPanel x:Name="Plate" Fill="{DynamicResource PxFace}" />
                            <DockPanel Margin="10,8,12,14">
                                <shells:LayoutSketch DockPanel.Dock="Left" Theme="{Binding Theme}" CellSize="2" VerticalAlignment="Center"
                                                     Margin="0,0,12,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <pixel:PixelText Text="{Binding Theme.Name}" Scale="2" Tight="True" Trim="True"
                                                     Colour="{DynamicResource PxText}" Shadow="{DynamicResource PxShadow}" />
                                    <pixel:PixelText x:Name="Now" Text="EN USO" Scale="2" Tight="True" Margin="0,6,0,0"
                                                     Colour="{DynamicResource PxGood}" Visibility="Collapsed" />
                                </StackPanel>
                            </DockPanel>
                            <views:PixelCursor x:Name="Focus" Margin="-2" Visibility="Collapsed" Colour="{DynamicResource PxCursor}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="Now" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Fill" Value="{DynamicResource PxFaceLift}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Plate" Property="Fill" Value="{DynamicResource PxAccentDeep}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <pixel:PixelBackdrop Base="{DynamicResource PxBase}" />
        <DockPanel Margin="18">
            <pixel:PixelText DockPanel.Dock="Top" Text="DISEÑO" Scale="4" Tight="True" Colour="{DynamicResource PxGold}"
                             Shadow="{DynamicResource PxShadow}" Margin="2,0,0,8" />
            <pixel:PixelText DockPanel.Dock="Top" Scale="2" Wrap="True" Margin="2,0,0,14" Colour="{DynamicResource PxText}"
                             Text="Señala uno para verlo en grande. USAR cambia al momento y sigues en la misma pantalla, con los mismos datos." />
            <Button DockPanel.Dock="Bottom" Content="CERRAR" Style="{StaticResource PxButton}" HorizontalAlignment="Right"
                    Margin="0,12,0,0" IsCancel="True" Click="OnClose" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="332" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ListBox x:Name="List" Grid.Column="0" Background="Transparent" BorderThickness="0" Margin="0,0,14,0"
                         ItemContainerStyle="{StaticResource Card}" KeyDown="OnListKey" MouseDoubleClick="OnListDouble"
                         AutomationProperties.Name="Diseños" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                <Grid Grid.Column="1" DataContext="{Binding SelectedItem, ElementName=List}">
                    <views:PixelPanel Fill="{DynamicResource PxFace}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,4,6">
                    <StackPanel Margin="18,16,14,20">
                        <shells:LayoutSketch Theme="{Binding Theme}" CellSize="5" HorizontalAlignment="Center" />
                        <pixel:PixelText Text="{Binding Theme.Name}" Scale="4" Tight="True" Trim="True" Margin="0,16,0,0"
                                         Colour="{DynamicResource PxText}" Shadow="{DynamicResource PxShadow}" />
                        <pixel:PixelText Text="{Binding Theme.Tagline}" Scale="2" Tight="True" Margin="0,6,0,0"
                                         Colour="{DynamicResource PxAccentInk}" />
                        <pixel:PixelText Text="{Binding Theme.About}" Scale="2" Wrap="True" Margin="0,10,0,0"
                                         Colour="{DynamicResource PxTextDim}" />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="USAR ESTE DISEÑO" Style="{StaticResource PxButton}" Click="OnUse"
                                    Visibility="{Binding IsCurrent, Converter={StaticResource InverseBoolToVisibility}}" />
                            <pixel:PixelText Text="ES EL QUE USAS AHORA" Scale="2" Tight="True" VerticalAlignment="Center"
                                             Colour="{DynamicResource PxGood}"
                                             Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
