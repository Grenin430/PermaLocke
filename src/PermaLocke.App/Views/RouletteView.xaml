<UserControl x:Class="PermaLocke.App.Views.RouletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="330" />
        </Grid.ColumnDefinitions>

        <!-- LA RUEDA -->
        <Border Grid.Column="0" Style="{StaticResource Inset}" Padding="18,16">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <Border DockPanel.Dock="Right" Style="{StaticResource Chip}"
                            Background="{StaticResource WarningDeepBrush}"
                            BorderBrush="{StaticResource WarningBrush}">
                        <TextBlock Style="{StaticResource ChipText}"
                                   Foreground="{StaticResource WarningBrush}">
                            <Run Text="DEBES" />
                            <Run Text="{Binding Owed, Mode=OneWay}" FontWeight="Bold" />
                        </TextBlock>
                    </Border>
                    <TextBlock Text="LA RULETA" Style="{StaticResource StatLabel}" VerticalAlignment="Center" />
                </DockPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Style="{StaticResource Body}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" />

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,14,0,0"
                            HorizontalAlignment="Center">
                    <Button Content="GIRAR" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SpinCommand}" MinWidth="180" Padding="20,12" FontSize="14" />
                    <Button Content="ACTUALIZAR" Style="{StaticResource GhostButton}"
                            Command="{Binding RefreshCommand}" Padding="16,12" FontSize="11.5"
                            Margin="10,0,0,0" />
                </StackPanel>

                <!-- La rueda vive en un Grid de tamaño fijo: las cuñas son geometría en píxeles y
                     estirarlas las descuadraría con las etiquetas, que se sitúan por coordenadas. -->
                <Grid Width="340" Height="368" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="340" />
                    </Grid.RowDefinitions>

                    <!-- La marca. Apunta a la cuña que gana, y por eso la rueda gira hasta ponerla
                         justo debajo. -->
                    <Path Grid.Row="0" Data="M 12,0 L 24,26 L 0,26 Z" HorizontalAlignment="Center"
                          Fill="{StaticResource AccentBrightBrush}"
                          Stroke="{StaticResource BackgroundBrush}" StrokeThickness="2" />

                    <Grid Grid.Row="1" Width="340" Height="340">
                        <Ellipse Width="336" Height="336" Fill="{StaticResource SurfaceBrush}"
                                 Stroke="{StaticResource BorderStrongBrush}" StrokeThickness="2" />

                        <Grid x:Name="Wheel" Width="340" Height="340" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <RotateTransform x:Name="WheelSpin" Angle="0" />
                            </Grid.RenderTransform>

                            <ItemsControl ItemsSource="{Binding Slots}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Width="340" Height="340" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Path Data="{Binding Wedge}" Fill="{Binding Colour}"
                                              Stroke="{StaticResource BackgroundBrush}" StrokeThickness="2">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Opacity" Value="0.42" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Revealed}" Value="True">
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Las etiquetas van en su propio Canvas por encima de las cuñas: una
                                 cuña es un Path y no puede llevar contenido dentro. -->
                            <ItemsControl ItemsSource="{Binding Slots}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Width="340" Height="340" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding LabelX}" />
                                        <Setter Property="Canvas.Top" Value="{Binding LabelY}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Horizontal y sin girar: una etiqueta orientada al radio
                                             queda boca abajo en media rueda y no se lee. Gira con
                                             la rueda, que es lo que tiene que hacer. -->
                                        <Grid Width="104" Height="40" Margin="-52,-20,0,0">
                                            <TextBlock Text="{Binding Text}" TextAlignment="Center"
                                                       TextWrapping="Wrap" MaxHeight="38"
                                                       FontFamily="{StaticResource UiFont}"
                                                       FontSize="11.5" FontWeight="Bold"
                                                       Foreground="{StaticResource OnAccentBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <!-- El eje: la Poké Ball del propio cartucho, quieta mientras la rueda gira. -->
                        <Ellipse Width="86" Height="86" Fill="{StaticResource BackgroundBrush}"
                                 Stroke="{StaticResource BorderStrongBrush}" StrokeThickness="2"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding Hub}" Width="58" Height="58"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </DockPanel>
        </Border>

        <!-- LO QUE HA SALIDO, Y LO QUE PUEDE SALIR -->
        <Border Grid.Column="2" Style="{StaticResource Inset}" Padding="16,14">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="14,12" Margin="0,0,0,12"
                        CornerRadius="{StaticResource RadiusMedium}" BorderThickness="1"
                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource DangerDeepBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ResultIsGood}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SuccessDeepBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel>
                        <TextBlock Text="{Binding ResultName}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding ResultDetail}" Style="{StaticResource Muted}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />

                        <ItemsControl ItemsSource="{Binding Lines}" Margin="0,9,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Mono}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,3" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock DockPanel.Dock="Top" Text="LO QUE PUEDE SALIR"
                           Style="{StaticResource StatLabel}" Margin="0,0,0,8" />

                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Faint}" Margin="0,10,0,0"
                           Text="La rueda enseña seis de las dieciséis, sorteadas entre todas juntas: pueden salirte seis buenas o seis malas. La tirada se calcula con la seed de la run y su número, así que se puede recomputar y comprobar después." />

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Pool}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,7" Margin="0,0,0,5"
                                        CornerRadius="{StaticResource RadiusSmall}"
                                        Background="{StaticResource SurfaceBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderThickness" Value="0,0,0,0" />
                                            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Good}" Value="True">
                                                    <Setter Property="BorderBrush"
                                                            Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="4" Margin="0,0,9,0"
                                                CornerRadius="2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background"
                                                            Value="{StaticResource DangerBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Good}" Value="True">
                                                            <Setter Property="Background"
                                                                    Value="{StaticResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Body}"
                                                       FontSize="12" FontWeight="Bold" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Faint}"
                                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
