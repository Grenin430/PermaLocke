<UserControl x:Class="PermaLocke.App.Views.RouletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PermaLocke.App.Views"
             xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="300" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
        <views:PixelPanel Fill="{StaticResource PxInk}" />
        <Border Margin="3,3,9,9" ClipToBounds="True">
            <!-- LA RULETA DE LA SALA RECREATIVA (§175). Se dibuja entera en píxeles, en la misma sala que la máquina
                 de cápsulas y la cabina del intercambio: la rueda con su aro de bombillas, las clavijas que golpean
                 la flecha, el tablero de premios y castigos, el marcador de lo que se debe, las fichas, la ranura y
                 la palanca. Encima solo va la ficha de lo que ha salido. -->
            <Grid MinHeight="300" Background="{StaticResource SunkenBrush}">
                <views:RouletteMachine x:Name="Machine" Play="{Binding CurrentPlay}" Board="{Binding Board}"
                                       Owed="{Binding Owed}" />

                <!-- LA FICHA DE LO QUE HA SALIDO, abajo a la derecha, encima del neón y de las fichas: la rueda, el tablero
                     y el marcador se quedan a la vista con la ganadora encendida. Se va sola a los ocho segundos. -->
                <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="286" Margin="0,0,22,22"
                      RenderTransformOrigin="0.5,0.5"
                      Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                    </Grid.RenderTransform>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasResult}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.3" />
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                    From="0.86" To="1" Duration="0:0:0.35">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase EasingMode="EaseOut" Amplitude="0.5" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                    From="0.86" To="1" Duration="0:0:0.35">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase EasingMode="EaseOut" Amplitude="0.5" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <views:PixelPanel Fill="#FF16112A" />

                    <!-- La franja del bando: verde si paga, rojo si cuesta, como la cuña que ha ganado. -->
                    <views:PixelPanel Height="15" VerticalAlignment="Top" Margin="0,0,6,0" HasShadow="False">
                        <views:PixelPanel.Style>
                            <Style TargetType="views:PixelPanel">
                                <Setter Property="Fill" Value="{StaticResource PxBad}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ResultIsGood}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource PxGood}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:PixelPanel.Style>
                    </views:PixelPanel>

                    <StackPanel Margin="18,24,24,22">
                        <pixel:PixelText Scale="2" Tight="True">
                            <pixel:PixelText.Style>
                                <Style TargetType="pixel:PixelText">
                                    <Setter Property="Text" Value="CASTIGO" />
                                    <Setter Property="Colour" Value="{StaticResource PxBad}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ResultIsGood}" Value="True">
                                            <Setter Property="Text" Value="PREMIO" />
                                            <Setter Property="Colour" Value="{StaticResource PxGood}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </pixel:PixelText.Style>
                        </pixel:PixelText>
                        <pixel:PixelText Text="{Binding ResultName}" Scale="3" Wrap="True" Margin="0,6,0,0"
                                         Colour="{StaticResource PxText}" Shadow="{StaticResource PxShadow}" />
                        <pixel:PixelText Text="{Binding ResultDetail}" Scale="2" Wrap="True" Margin="0,6,0,0"
                                         Colour="{StaticResource PxTextDim}" />

                        <ItemsControl ItemsSource="{Binding Lines}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <pixel:PixelText Text="{Binding}" Scale="2" Wrap="True" Margin="0,0,0,4"
                                                     Colour="{StaticResource PxText}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        </Grid>

        <!-- LOS BOTONES y lo que se debe, dicho con palabras. -->
        <StackPanel Grid.Row="1" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="GIRAR" Style="{StaticResource PxButton}" Command="{Binding SpinCommand}" MinWidth="220"
                        Padding="26,10,32,15" />
                <Button Content="ACTUALIZAR" Style="{StaticResource PxSubtleButton}" Command="{Binding RefreshCommand}"
                        Padding="16,10,22,15" Margin="10,0,0,0" />
            </StackPanel>
            <pixel:PixelText Text="{Binding Status}" Scale="2" Wrap="True" TextAlignment="Center" HorizontalAlignment="Center"
                             Margin="0,10,0,0" Colour="{StaticResource PxTextDim}" />
        </StackPanel>
    </Grid>
</UserControl>
