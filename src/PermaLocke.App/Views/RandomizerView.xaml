<UserControl x:Class="PermaLocke.App.Views.RandomizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,10,0">

            <!-- What has to be in place before anything can be generated, as three cards rather
                 than a list of labels: each one is either ready or it is not. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.4*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Inset}" Padding="16,13">
                    <StackPanel>
                        <TextBlock Text="SEED DE LA RUN" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="{Binding SeedLabel}" Style="{StaticResource Mono}"
                                   FontSize="17" Foreground="{StaticResource AccentBrush}"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Inset}" Padding="16,13">
                    <StackPanel>
                        <TextBlock Text="ROM" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="{Binding RomText}" Style="{StaticResource Body}"
                                   FontSize="12" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Inset}" Padding="16,13">
                    <StackPanel>
                        <TextBlock Text="AZAHAR" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="{Binding AzaharText}" Style="{StaticResource Mono}"
                                   FontSize="11.5" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Generar e instalar son dos pasos a propósito: instalar cambia la partida. -->
            <Border Style="{StaticResource Inset}" Padding="18,16" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="CÓMO SE RANDOMIZA" Style="{StaticResource StatLabel}" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="1." Style="{StaticResource CardTitle}"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"
                                   VerticalAlignment="Top" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Body}" Margin="0,0,0,10"
                                   Text="GENERAR. Lee tu ROM y escribe una copia randomizada en la carpeta Randomized, con la seed de la run. Tarda un rato y ocupa unos 460 MB. Tu ROM original no se toca nunca, ni aquí ni después." />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="2." Style="{StaticResource CardTitle}"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"
                                   VerticalAlignment="Top" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Body}" Margin="0,0,0,10"
                                   Text="INSTALAR EN AZAHAR. Copia lo generado a la carpeta de mods del emulador. El juego lo carga por encima de la ROM, así que a partir del siguiente arranque juegas la versión randomizada. Si ya había un mod instalado no se borra: se aparta a load/permalocke-mod-anterior." />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="3." Style="{StaticResource CardTitle}"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"
                                   VerticalAlignment="Top" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Body}"
                                   Text="QUITAR. Desinstala el mod y te deja jugando la ROM tal cual salió del cartucho. Lo generado sigue en Randomized, así que volver a instalarlo es inmediato y no hay que generar otra vez." />
                    </Grid>

                    <Border Style="{StaticResource Divider}" Margin="0,14" />

                    <TextBlock Style="{StaticResource Faint}"
                               Text="Se randomiza con la seed de la run, así que la misma seed da siempre exactamente el mismo mundo: se puede regenerar y comprobar. Qué se randomiza —salvajes, objetos del suelo, iniciales y fósiles, entrenadores, datos de Pokémon y tiendas— lo decide Data/randomizer.json, no esta pantalla. Cierra Azahar antes de instalar o quitar." />

                    <Border Style="{StaticResource Divider}" Margin="0,15" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="GENERAR" Style="{StaticResource PrimaryButton}"
                                Command="{Binding GenerateCommand}" MinWidth="140" Padding="16,10" />
                        <Button Content="INSTALAR EN AZAHAR" Style="{StaticResource PrimaryButton}"
                                Command="{Binding InstallCommand}" MinWidth="190" Padding="16,10"
                                Margin="10,0,0,0" />
                        <Button Content="QUITAR" Style="{StaticResource GhostButton}"
                                Command="{Binding RemoveCommand}" MinWidth="110" Padding="16,10"
                                Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Status. Hidden entirely when there is nothing to say, so the screen is not left
                 with an empty line where a message used to be. -->
            <Border Padding="14,10" Margin="0,12,0,0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource AccentDimBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMedium}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Body}" FontSize="12" />
            </Border>

            <Border Margin="0,12,0,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Inset}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGenerated}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="ÚLTIMO RESULTADO" Style="{StaticResource StatLabel}" Margin="0,0,0,8" />

                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Ellipse DockPanel.Dock="Left" Width="5" Height="5"
                                             Fill="{StaticResource AccentDimBrush}"
                                             VerticalAlignment="Center" Margin="0,0,9,0" />
                                    <TextBlock Text="{Binding}" Style="{StaticResource Mono}"
                                               FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource Divider}" />

                    <TextBlock Text="{Binding OutputText}" Style="{StaticResource Faint}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
