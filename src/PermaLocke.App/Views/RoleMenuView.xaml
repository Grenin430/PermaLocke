<UserControl x:Class="PermaLocke.App.Views.RoleMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PermaLocke.App.Views"
             xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel">

    <!-- El menú de roles de la creación de la run y del cambio de rol (§220): las tarjetas de siempre, y al elegir MONOTYPE
         un segundo menú con los tipos, cada uno con su icono. -->
    <StackPanel>
        <ItemsControl ItemsSource="{Binding Cards}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- La tarjeta entera es el radio: un objetivo grande para un botón que solo se pulsa una vez. -->
                    <RadioButton GroupName="RolTarjeta" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                 Style="{StaticResource PxRadioCard}" Margin="0,0,0,8">
                        <StackPanel>
                            <pixel:PixelText Text="{Binding Name}" Scale="3" Tight="True"
                                             Colour="{DynamicResource PxAccentInkLight}" Shadow="{DynamicResource PxShadow}" />
                            <pixel:PixelText Text="{Binding Description}" Scale="2" Wrap="True" Margin="0,7,0,0"
                                             Colour="{DynamicResource PxTextDim}" />
                            <pixel:PixelText Text="{Binding Effects}" Scale="2" Wrap="True" Margin="0,6,0,0"
                                             Colour="{DynamicResource PxWarn}" />
                        </StackPanel>
                    </RadioButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- El segundo menú: solo mientras MONOTYPE está elegido. Sin tipo no hay rol, y el botón de la ventana lo sabe. -->
        <StackPanel Margin="0,6,0,0">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowTypes}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <pixel:PixelText Text="ELIGE TU TIPO" Scale="3" Tight="True" Colour="{DynamicResource PxText}"
                             Shadow="{DynamicResource PxShadow}" Margin="2,6,0,4" />
            <pixel:PixelText Text="Solo podrás tener Pokémon de este tipo." Scale="2" Wrap="True"
                             Colour="{DynamicResource PxTextDim}" Margin="2,0,0,10" />

            <ItemsControl ItemsSource="{Binding Types}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton GroupName="RolTipo" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                     Style="{StaticResource PxRadioCard}" Margin="0,0,10,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- El icono: el sprite de un Pokémon del tipo, de la propia ROM del jugador. -->
                                <Image Grid.Column="0" Source="{Binding Sprite}" Width="72" Height="72" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor" VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <Grid>
                                        <views:PixelPanel Fill="{Binding Colour}" HasShadow="False" />
                                        <pixel:PixelText Text="{Binding Name}" Scale="2" Tight="True" Margin="10,7,10,10"
                                                         Colour="#FFFFFFFF" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>
