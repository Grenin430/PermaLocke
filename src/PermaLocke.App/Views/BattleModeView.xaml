<UserControl x:Class="PermaLocke.App.Views.BattleModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PermaLocke.App.Views"
             xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel">

    <UserControl.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource PxScrollBar}" />

        <!-- El número de un paso, en su placa. -->
        <Style x:Key="StepNumber" TargetType="pixel:PixelText">
            <Setter Property="Scale" Value="2" />
            <Setter Property="Tight" Value="True" />
            <Setter Property="Colour" Value="{StaticResource PxInk}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <Style x:Key="StepText" TargetType="pixel:PixelText">
            <Setter Property="Scale" Value="2" />
            <Setter Property="Wrap" Value="True" />
            <Setter Property="Colour" Value="{StaticResource PxText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,10,0">

            <!-- ================================================== EL ESTADO
                 Lo mas ruidoso de la pantalla, y a proposito. Todo el riesgo de esta funcion es
                 OLVIDARSE de que la tienes puesta: jugar media hora sobre el cartucho sin darte
                 cuenta, extranado de que los salvajes sean los de siempre.

                 Por eso el estado no dice solo COMO esta, dice QUE HACER AHORA. Con el mundo guardado, la ventana entera
                 se vuelve ámbar. -->
            <pixel:PixelWindow Title="COMBATE LINK" Icon="IconSwords">
                <pixel:PixelWindow.Style>
                    <Style TargetType="pixel:PixelWindow" BasedOn="{StaticResource {x:Type pixel:PixelWindow}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInBattle}" Value="True">
                                <Setter Property="Fill" Value="{StaticResource PxWarnDeep}" />
                                <Setter Property="HeaderFill" Value="#FF5C4012" />
                                <Setter Property="HeaderAccent" Value="{StaticResource PxWarn}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </pixel:PixelWindow.Style>

                <pixel:PixelWindow.HeaderContent>
                    <Grid Visibility="{Binding IsInBattle, Converter={StaticResource BoolToVisibility}}">
                        <views:PixelPanel Fill="{StaticResource PxWarn}" HasShadow="False" />
                        <pixel:PixelText Text="MUNDO GUARDADO" Scale="2" Tight="True" Margin="9,5,10,6"
                                         Colour="{StaticResource PxInk}" />
                    </Grid>
                </pixel:PixelWindow.HeaderContent>

                <StackPanel>
                    <pixel:PixelText Text="{Binding Headline}" Scale="3" Wrap="True" Shadow="{StaticResource PxShadow}">
                        <pixel:PixelText.Style>
                            <Style TargetType="pixel:PixelText">
                                <Setter Property="Colour" Value="{StaticResource PxText}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInBattle}" Value="True">
                                        <Setter Property="Colour" Value="{StaticResource PxWarn}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </pixel:PixelText.Style>
                    </pixel:PixelText>

                    <pixel:PixelText Text="{Binding Explanation}" Scale="2" Wrap="True" Margin="0,10,0,0"
                                     Colour="{StaticResource PxTextDim}" />

                    <pixel:PixelRule Margin="0,16,0,14" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="PREPARAR PARA COMBATIR" Style="{StaticResource PxButton}"
                                Command="{Binding PrepareCommand}"
                                Visibility="{Binding IsInBattle, Converter={StaticResource InverseBoolToVisibility}}" />
                        <Button Content="DEVOLVER MI MUNDO" Style="{StaticResource PxButton}"
                                Command="{Binding RestoreCommand}"
                                Visibility="{Binding IsInBattle, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <pixel:PixelText Text="{Binding Status}" Scale="2" Wrap="True" Margin="0,14,0,0"
                                     Colour="{StaticResource PxText}" />
                </StackPanel>
            </pixel:PixelWindow>

            <!-- ================================================== CÓMO SE HACE -->
            <pixel:PixelWindow Title="CÓMO SE PELEA" Icon="IconDocument" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Width="33" Height="33" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <views:PixelPanel Fill="{StaticResource PxGold}" HasShadow="False" />
                        <pixel:PixelText Text="1" Style="{StaticResource StepNumber}" />
                    </Grid>
                    <pixel:PixelText Grid.Row="0" Grid.Column="1" Style="{StaticResource StepText}" Margin="0,0,0,10"
                                     Text="Guarda dentro del juego y cierra Azahar." />

                    <Grid Grid.Row="1" Width="33" Height="33" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <views:PixelPanel Fill="{StaticResource PxGold}" HasShadow="False" />
                        <pixel:PixelText Text="2" Style="{StaticResource StepNumber}" />
                    </Grid>
                    <pixel:PixelText Grid.Row="1" Grid.Column="1" Style="{StaticResource StepText}" Margin="0,0,0,10"
                                     Text="Pulsa PREPARAR PARA COMBATIR. Tenéis que hacerlo todos." />

                    <Grid Grid.Row="2" Width="33" Height="33" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <views:PixelPanel Fill="{StaticResource PxGold}" HasShadow="False" />
                        <pixel:PixelText Text="3" Style="{StaticResource StepNumber}" />
                    </Grid>
                    <pixel:PixelText Grid.Row="2" Grid.Column="1" Style="{StaticResource StepText}" Margin="0,0,0,10"
                                     Text="Abrid Azahar, conectaos en Multijugador y en el juego id a X → Plaza Festival → Combate → Combate Link." />

                    <Grid Grid.Row="3" Width="33" Height="33" HorizontalAlignment="Left">
                        <views:PixelPanel Fill="{StaticResource PxGold}" HasShadow="False" />
                        <pixel:PixelText Text="4" Style="{StaticResource StepNumber}" />
                    </Grid>
                    <pixel:PixelText Grid.Row="3" Grid.Column="1" Style="{StaticResource StepText}"
                                     Text="Al terminar, cerrad Azahar y pulsad DEVOLVER MI MUNDO." />
                </Grid>
            </pixel:PixelWindow>
        </StackPanel>
    </ScrollViewer>
</UserControl>
