<Window x:Class="PermaLocke.App.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PermaLocke.App.Views"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        Topmost="True"
        SizeToContent="Manual"
        ResizeMode="NoResize"
        UseLayoutRounding="True">

    <!-- LOS AVISOS, encima del juego. Abajo a la derecha y apilados hacia arriba, que es donde
         nadie esta mirando mientras juega y donde todo el mundo espera encontrarlos.

         Pixel art, como el cementerio y la franja de Alola: la caja, la pestaña, la placa del
         sprite y la cuenta atras se dibujan celda a celda en ToastPixels.cs. Aqui solo se
         colocan, y el texto va con fuente de verdad porque tiene que leerse de un vistazo.

         La ventana entera es transparente y no recibe raton: lo que se ve son las tarjetas. -->
    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Bottom" HorizontalAlignment="Right">
    <ItemsControl ItemsSource="{Binding Showing}" Width="440">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Grid HorizontalAlignment="Right">
                <!-- LA PEQUEÑA (1.0.4.5): «X está jugando a PermaLocke», como la de un amigo en Steam. Sin pestaña ni cuenta atrás. -->
                <Grid x:Name="Compact" Width="300" Margin="0,8,0,0" HorizontalAlignment="Right" Visibility="Collapsed">
                    <views:ToastScroll Kind="{Binding Kind}">
                        <Grid>
                            <DockPanel Margin="23,10,27,16">
                                <Border DockPanel.Dock="Left" Width="34" Height="34" Background="#FF3A2818" Margin="0,0,10,0">
                                    <Image Source="{Binding Sprite}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                               FontFamily="{StaticResource DisplayFont}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#FF3A2410" />
                                    <TextBlock Text="{Binding Message}" FontSize="11.5" Margin="0,2,0,0" Foreground="#FF5A4026" />
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </views:ToastScroll>
                </Grid>

                <Grid x:Name="Full" Width="440" Margin="0,8,0,0" HorizontalAlignment="Right">
                    <!-- Entra desenrollandose hacia la izquierda, a saltos (ToastScroll): el rollo de la
                         derecha se queda y el de la izquierda viaja, y el texto se va destapando. -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- LA CAJA -->
                    <Grid Grid.Row="1">
                      <views:ToastScroll Kind="{Binding Kind}">
                        <Grid>
                        <!-- Los margenes dejan sitio a los rollos (ocho celdas), a la sombra (dos) y al sello del lacre. -->
                        <Grid Margin="33,18,36,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <views:ToastPlate Kind="{Binding Kind}" Sprite="{Binding Sprite}" Parchment="True"
                                              VerticalAlignment="Top" />

                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap"
                                           FontFamily="{StaticResource DisplayFont}" FontSize="15.5"
                                           FontWeight="SemiBold" Foreground="#FF3A2410" />
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           FontSize="12.5" LineHeight="17"
                                           Foreground="#FF5A4026">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasMessage}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- Lo que le queda en pantalla: una mecha que se consume de derecha a izquierda.
                                 Acaba antes del sello, que cuelga abajo a la derecha. -->
                            <views:ToastCountdown Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,18,0" Fuse="True"
                                                  Kind="{Binding Kind}" Shown="{Binding Shown}"
                                                  Linger="{Binding Linger}">
                                <!-- Un aviso fijo (§202) no se acaba: sin cuenta atrás. -->
                                <views:ToastCountdown.Style>
                                    <Style TargetType="views:ToastCountdown">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </views:ToastCountdown.Style>
                            </views:ToastCountdown>
                        </Grid>
                        </Grid>
                      </views:ToastScroll>
                    </Grid>

                    <!-- LA PESTAÑA. Se mete seis unidades en el pergamino y va por encima, asi que sale
                         de el en vez de estar apoyada. -->
                    <Grid x:Name="Tab" Visibility="Hidden" Grid.Row="0" HorizontalAlignment="Left" Margin="33,0,0,-6" Panel.ZIndex="1">
                        <views:ToastFrame Kind="{Binding Kind}" IsTab="True" />
                        <TextBlock Text="{Binding Label}" Margin="11,6,18,8"
                                   FontFamily="{StaticResource DisplayFont}" FontSize="11"
                                   FontWeight="Bold" Foreground="#FF09070E" />
                    </Grid>
                </Grid>
                </Grid>

                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsCompact}" Value="True">
                        <Setter TargetName="Compact" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Full" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <!-- La pestaña salta a su sitio cuando el pergamino acaba de abrirse (seis pasos de 55 ms). -->
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Tab" Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.33" Value="{x:Static Visibility.Visible}" />
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
    </Viewbox>
</Window>

