<Window x:Class="PermaLocke.App.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PermaLocke.App.Views"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        Topmost="True"
        SizeToContent="Manual"
        ResizeMode="NoResize"
        UseLayoutRounding="True">

    <!-- LOS AVISOS, encima del juego. Abajo a la derecha y apilados hacia arriba, que es donde
         nadie esta mirando mientras juega y donde todo el mundo espera encontrarlos.

         Pixel art, como el cementerio y la franja de Alola: la caja, la pestaña, la placa del
         sprite y la cuenta atras se dibujan celda a celda en ToastPixels.cs. Aqui solo se
         colocan, y el texto va con fuente de verdad porque tiene que leerse de un vistazo.

         La ventana entera es transparente y no recibe raton: lo que se ve son las tarjetas. -->
    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Bottom" HorizontalAlignment="Right">
    <ItemsControl ItemsSource="{Binding Showing}" Width="440">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Grid Width="440" Margin="0,8,0,0" HorizontalAlignment="Right">
                    <!-- Entra a saltos desde la derecha, tres pasos: se abre como un cuadro de texto
                         de consola, no se desliza como una notificacion de sistema. -->
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="Slide" X="36" />
                    </Grid.RenderTransform>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- LA CAJA -->
                    <Grid Grid.Row="1">
                        <views:ToastFrame Kind="{Binding Kind}" />

                        <!-- El margen derecho y el de abajo dejan sitio a la sombra, que son dos celdas. -->
                        <Grid Margin="15,17,21,17">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <views:ToastPlate Kind="{Binding Kind}" Sprite="{Binding Sprite}"
                                              VerticalAlignment="Top" />

                            <StackPanel Grid.Column="1" Margin="14,0,4,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap"
                                           FontFamily="{StaticResource DisplayFont}" FontSize="15.5"
                                           FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           FontSize="12.5" LineHeight="17"
                                           Foreground="{StaticResource TextMutedBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasMessage}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- Lo que le queda en pantalla. Doce segmentos que se apagan de uno en uno. -->
                            <views:ToastCountdown Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0"
                                                  Kind="{Binding Kind}" Shown="{Binding Shown}"
                                                  Linger="{Binding Linger}">
                                <!-- Un aviso fijo (§202) no se acaba: sin cuenta atrás. -->
                                <views:ToastCountdown.Style>
                                    <Style TargetType="views:ToastCountdown">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </views:ToastCountdown.Style>
                            </views:ToastCountdown>
                        </Grid>
                    </Grid>

                    <!-- LA PESTAÑA. Se mete seis unidades en la caja -contorno y relieve- y va por
                         encima, asi que sale de ella en vez de estar apoyada. -->
                    <Grid Grid.Row="0" HorizontalAlignment="Left" Margin="15,0,0,-6" Panel.ZIndex="1">
                        <views:ToastFrame Kind="{Binding Kind}" IsTab="True" />
                        <TextBlock Text="{Binding Label}" Margin="11,6,18,8"
                                   FontFamily="{StaticResource DisplayFont}" FontSize="11"
                                   FontWeight="Bold" Foreground="#FF09070E" />
                    </Grid>
                </Grid>

                <DataTemplate.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Slide"
                                                               Storyboard.TargetProperty="X">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="36" />
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.05" Value="22" />
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.10" Value="8" />
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.15" Value="0" />
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
    </Viewbox>
</Window>

