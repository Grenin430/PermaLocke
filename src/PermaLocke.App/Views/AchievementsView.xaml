<UserControl x:Class="PermaLocke.App.Views.AchievementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PermaLocke.App.Views"
             xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel">

    <!-- LOS LOGROS EN PÍXELES (§176). Una placa por logro con su medalla del cartucho en un hueco -en silueta mientras
         no se ha ganado, en color cuando sí, saltando cuando se puede cobrar-, la barra de lo que falta y los puntos.
         Mismas órdenes que antes. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style TargetType="ScrollBar" BasedOn="{StaticResource PxScrollBar}" />

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource PxSubtleButton}">
            <Setter Property="Padding" Value="10,5,16,10" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <DataTemplate x:Key="AchievementTemplate">
            <Grid Margin="0,0,10,10">
                <views:PixelPanel>
                    <views:PixelPanel.Style>
                        <Style TargetType="views:PixelPanel">
                            <Setter Property="Fill" Value="{DynamicResource PxFace}" />
                            <Style.Triggers>
                                <!-- Listo para cobrar: se enciende, que es lo que hay que mirar. -->
                                <DataTrigger Binding="{Binding CanClaim}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource PxGoodDeep}" />
                                </DataTrigger>
                                <!-- Cobrado: más oscuro, sin niebla por encima: quien dice el estado es la medalla. -->
                                <DataTrigger Binding="{Binding Claimed}" Value="True">
                                    <Setter Property="Fill" Value="#FF141024" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:PixelPanel.Style>
                </views:PixelPanel>

                <Grid Margin="12,12,18,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- LA MEDALLA, en su hueco. El dibujo del cartucho -el cristal Z de cada prueba-, y si no lo hay,
                         la inicial. -->
                    <Grid Grid.Column="0" Width="66" Height="66" VerticalAlignment="Top">
                        <views:PixelPanel Fill="{DynamicResource PxWell}" IsSunken="True" HasShadow="False" />
                        <pixel:PixelText Text="{Binding Initial}" Scale="4" Tight="True" Colour="{DynamicResource PxTextFaint}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVisibility}}" />
                        <pixel:PixelSprite Source="{Binding Icon}" Scale="2" TrimEmpty="True" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Bob="{Binding CanClaim}">
                            <pixel:PixelSprite.Style>
                                <Style TargetType="pixel:PixelSprite">
                                    <Setter Property="Silhouette" Value="{DynamicResource PxFaceLift}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Unlocked}" Value="True">
                                            <Setter Property="Silhouette" Value="Transparent" />
                                            <Setter Property="Outline" Value="{DynamicResource PxShadow}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </pixel:PixelSprite.Style>
                        </pixel:PixelSprite>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <DockPanel>
                            <pixel:PixelText DockPanel.Dock="Right" Text="{Binding Reward}" Scale="2" Tight="True"
                                             Colour="{DynamicResource PxGold}" Shadow="{DynamicResource PxShadow}" Margin="8,0,0,0" />
                            <pixel:PixelText Text="{Binding Name}" Scale="2" Tight="True" Trim="True"
                                             Colour="{DynamicResource PxText}" Shadow="{DynamicResource PxShadow}" />
                        </DockPanel>

                        <pixel:PixelText Text="{Binding Description}" Scale="2" Wrap="True" Margin="0,6,0,0" MinHeight="40"
                                         Colour="{DynamicResource PxTextDim}" />

                        <!-- Quién cuenta este número: el juego, PermaLocke o la mano. -->
                        <Grid HorizontalAlignment="Left" Margin="0,4,0,0">
                            <views:PixelPanel Fill="{DynamicResource PxFaceLift}" HasShadow="False" />
                            <pixel:PixelText Text="{Binding Source}" Scale="2" Tight="True" Margin="7,4,8,5"
                                             Colour="{DynamicResource PxTextDim}" />
                        </Grid>

                        <DockPanel Margin="0,10,0,0">
                            <pixel:PixelText DockPanel.Dock="Left" Text="{Binding Label}" Scale="2" Tight="True"
                                             VerticalAlignment="Center" Margin="0,0,10,0" Colour="{DynamicResource PxText}" />
                            <views:PixelBar Height="15" VerticalAlignment="Center" Value="{Binding Share, Mode=OneWay}">
                                <views:PixelBar.Style>
                                    <Style TargetType="views:PixelBar">
                                        <Setter Property="Fill" Value="{DynamicResource PxAccent}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanClaim}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource PxGood}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Claimed}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource PxGood}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </views:PixelBar.Style>
                            </views:PixelBar>
                        </DockPanel>

                        <!-- Los botones. "+1" y "COMPLETAR" solo salen en los logros que PermaLocke no sabe contar
                             todavía; "COBRAR" cuando está al completo. -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="+1" Style="{StaticResource SmallButton}"
                                    Command="{Binding DataContext.MarkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding CanMark, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="COMPLETAR" Style="{StaticResource SmallButton}"
                                    Command="{Binding DataContext.CompleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding CanMark, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="COBRAR" Style="{StaticResource PxButton}" Padding="12,5,18,10"
                                    Command="{Binding DataContext.ClaimCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding CanClaim, Converter={StaticResource BoolToVisibility}}" />

                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding Claimed, Converter={StaticResource BoolToVisibility}}">
                                <pixel:PixelIcon Icon="IconCheck" Scale="2" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <pixel:PixelText Text="COBRADO" Scale="2" Tight="True" VerticalAlignment="Center"
                                                 Colour="{DynamicResource PxGood}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- LO QUE CUESTA PERDER. -->
        <pixel:PixelWindow Grid.Row="0" Title="PENALIZACIONES" Icon="IconGrave" Margin="0,0,0,12"
                           HeaderAccent="{DynamicResource PxBad}">
            <pixel:PixelText Text="{Binding PenaltyText}" Scale="2" Wrap="True" Colour="{DynamicResource PxTextDim}" />
        </pixel:PixelWindow>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource AchievementTemplate}" Margin="0,0,6,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <views:PixelPanel Fill="{DynamicResource PxFace}" />
            <StackPanel Margin="14,11,20,17">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Content="ACTUALIZAR" Style="{StaticResource PxButton}"
                            Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
                    <pixel:PixelText Text="{Binding Summary}" Scale="2" Wrap="True" VerticalAlignment="Center" Margin="14,0,0,0"
                                     Colour="{DynamicResource PxText}" />
                </DockPanel>
                <pixel:PixelText Text="{Binding RecordsText}" Scale="2" Wrap="True" Margin="0,10,0,0"
                                 Colour="{DynamicResource PxTextFaint}" />
                <pixel:PixelText Text="{Binding Status}" Scale="2" Wrap="True" Margin="0,8,0,0"
                                 Colour="{DynamicResource PxGood}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
