<UserControl x:Class="PermaLocke.App.Views.AchievementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Una tarjeta de logro: medalla, texto, progreso, puntos y botón. -->
        <DataTemplate x:Key="AchievementTemplate">
            <Border Margin="5" Padding="12" CornerRadius="6" BorderThickness="1"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceAltBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <!-- Cobrado: se apaga, ya no pide nada. -->
                            <DataTrigger Binding="{Binding Claimed}" Value="True">
                                <Setter Property="Opacity" Value="0.5" />
                            </DataTrigger>
                            <!-- Listo para cobrar: se enciende, que es lo que hay que mirar. -->
                            <DataTrigger Binding="{Binding CanClaim}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- LA MEDALLA. Un rombo, como los cristales del recorrido insular, con la
                         inicial del logro. Dibujado, no extraído: los cristales Z del cartucho no
                         se pueden emparejar con nada sin adivinar por color (ver §34). -->
                    <Grid Grid.Column="0" VerticalAlignment="Top" Width="46" Height="46">
                        <Path Data="M 23,2 L 44,23 L 23,44 L 2,23 Z" StrokeThickness="2"
                              Stroke="{StaticResource SurfaceAltBrush}"
                              Fill="{Binding Medal}" />
                        <TextBlock Text="{Binding Initial}" Style="{StaticResource PanelHeading}"
                                   FontSize="16" Foreground="#FF0B0E17"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Body}"
                                   TextWrapping="Wrap" MinHeight="52" VerticalAlignment="Top" />

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Label}" Style="{StaticResource Mono}"
                                           FontSize="12" />
                                <TextBlock Text="{Binding Source}" Style="{StaticResource Muted}"
                                           FontSize="9" />
                            </StackPanel>

                            <ProgressBar Grid.Column="1" Height="6" Margin="8,0" VerticalAlignment="Center"
                                         Minimum="0" Maximum="{Binding Target, Mode=OneWay}"
                                         Value="{Binding Count, Mode=OneWay}"
                                         Background="#22FFFFFF" Foreground="{StaticResource AccentBrush}">
                                <ProgressBar.Template>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Grid>
                                            <Border CornerRadius="3" Background="{TemplateBinding Background}" />
                                            <Border x:Name="PART_Track" />
                                            <Border x:Name="PART_Indicator" CornerRadius="3"
                                                    HorizontalAlignment="Left"
                                                    Background="{TemplateBinding Foreground}" />
                                        </Grid>
                                    </ControlTemplate>
                                </ProgressBar.Template>
                            </ProgressBar>

                            <TextBlock Grid.Column="2" Text="{Binding Reward}" Style="{StaticResource Mono}"
                                       FontSize="12" VerticalAlignment="Center"
                                       Foreground="{StaticResource AccentBrush}" />
                        </Grid>

                        <!-- Los botones. "+1" y "COMPLETAR" solo salen en los logros que
                             PermaLocke no sabe contar todavía; "COBRAR" cuando está al completo. -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="+1" Style="{StaticResource PrimaryButton}" MinWidth="40"
                                    Padding="6,3" FontSize="11" Margin="0,0,5,0"
                                    Command="{Binding DataContext.MarkCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding CanMark, Converter={StaticResource BoolToVisibility}}" />

                            <Button Content="COMPLETAR" Style="{StaticResource PrimaryButton}" MinWidth="88"
                                    Padding="6,3" FontSize="11" Margin="0,0,5,0"
                                    Command="{Binding DataContext.CompleteCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding CanMark, Converter={StaticResource BoolToVisibility}}" />

                            <Button Content="COBRAR" Style="{StaticResource PrimaryButton}" MinWidth="88"
                                    Padding="6,3" FontSize="11"
                                    Command="{Binding DataContext.ClaimCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding CanClaim, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Text="COMPLETADO" Style="{StaticResource Mono}" FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource SuccessBrush}"
                                       Visibility="{Binding Claimed, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- LO QUE CUESTA PERDER, con el saldo al lado. -->
        <Border Grid.Row="0" Style="{StaticResource Panel}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="PENALIZACIONES" Style="{StaticResource Mono}" FontSize="11"
                               Foreground="{StaticResource DangerBrush}" />
                    <TextBlock Text="{Binding PenaltyText}" Style="{StaticResource Body}"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="SALDO" Style="{StaticResource Muted}" FontSize="10"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Balance}" Style="{StaticResource PanelHeading}"
                               FontSize="34" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource AchievementTemplate}"
                          Margin="0,0,8,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="ACTUALIZAR" Style="{StaticResource PrimaryButton}" MinWidth="150"
                        Command="{Binding RefreshCommand}" />
                <TextBlock Style="{StaticResource Body}" VerticalAlignment="Center" Margin="14,0,0,0"
                           Text="{Binding Summary}" />
            </StackPanel>

            <TextBlock Text="{Binding RecordsText}" Style="{StaticResource Mono}" FontSize="11"
                       TextWrapping="Wrap" Margin="0,8,0,0" Opacity="0.75" />

            <TextBlock Text="{Binding Status}" Style="{StaticResource Body}" TextWrapping="Wrap"
                       Margin="0,10,0,0" />

            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="11"
                       Text="Cada tarjeta dice de dónde sale su número. «Lo cuenta el juego» son contadores del propio cartucho, los mismos que enseña la ficha de entrenador. «Lo dice tu mochila» son los que se reconocen por su premio: cada prueba entrega su cristal Z, y cuál da cuál lo dice el texto del propio juego. Los dos se leen de la partida guardada, así que no se mueven hasta que guardes. «Lo cuenta PermaLocke» sale del historial de la run, y «a mano» solo aparecería en un logro que todavía no se supiera detectar. Cobrar es aparte, para que el log diga de dónde salió cada punto." />
        </StackPanel>
    </Grid>
</UserControl>
