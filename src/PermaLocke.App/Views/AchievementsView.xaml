<UserControl x:Class="PermaLocke.App.Views.AchievementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <DataTemplate x:Key="AchievementTemplate">
            <Border Margin="0,0,0,8" Padding="14" CornerRadius="6" BorderThickness="1"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceAltBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <!-- Cobrado: se apaga, ya no pide nada. -->
                            <DataTrigger Binding="{Binding Claimed}" Value="True">
                                <Setter Property="Opacity" Value="0.55" />
                            </DataTrigger>
                            <!-- Listo para cobrar: se enciende, que es lo que hay que mirar. -->
                            <DataTrigger Binding="{Binding CanClaim}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                            <!-- Sin detectar: se dice, no se esconde. -->
                            <DataTrigger Binding="{Binding IsDetectable}" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                                <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource PanelHeading}" FontSize="15" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}"
                                   TextWrapping="Wrap" Margin="0,3,0,0" />

                        <TextBlock Text="{Binding Pending}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{StaticResource WarningBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Mono}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDetectable}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Grid Margin="0,8,0,0" Visibility="{Binding IsDetectable,
                                                           Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ProgressBar Grid.Column="0" Height="7" VerticalAlignment="Center"
                                         Minimum="0" Maximum="{Binding Target, Mode=OneWay}"
                                         Value="{Binding Count, Mode=OneWay}"
                                         Background="#22FFFFFF" Foreground="{StaticResource AccentBrush}">
                                <ProgressBar.Template>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Grid>
                                            <Border CornerRadius="4" Background="{TemplateBinding Background}" />
                                            <Border x:Name="PART_Track" />
                                            <Border x:Name="PART_Indicator" CornerRadius="4"
                                                    HorizontalAlignment="Left"
                                                    Background="{TemplateBinding Foreground}" />
                                        </Grid>
                                    </ControlTemplate>
                                </ProgressBar.Template>
                            </ProgressBar>

                            <TextBlock Grid.Column="1" Text="{Binding Label}" Style="{StaticResource Mono}"
                                       FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Reward}" Style="{StaticResource PanelHeading}"
                                   FontSize="20" HorizontalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}" />

                        <Button Content="COBRAR" Style="{StaticResource PrimaryButton}" MinWidth="110"
                                Margin="0,6,0,0"
                                Command="{Binding DataContext.ClaimCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding CanClaim, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Text="COBRADO" Style="{StaticResource Mono}" FontSize="11"
                                   Margin="0,6,0,0" HorizontalAlignment="Center"
                                   Foreground="{StaticResource SuccessBrush}"
                                   Visibility="{Binding Claimed, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- LO QUE CUESTA PERDER. Arriba del todo, porque es lo que más pesa en el marcador. -->
        <Border Grid.Row="0" Style="{StaticResource Panel}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="PENALIZACIONES" Style="{StaticResource Mono}" FontSize="11"
                               Foreground="{StaticResource DangerBrush}" />
                    <TextBlock Text="{Binding PenaltyText}" Style="{StaticResource Body}"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="SALDO" Style="{StaticResource Muted}" FontSize="10"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Balance}" Style="{StaticResource PanelHeading}"
                               FontSize="34" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource AchievementTemplate}"
                          Margin="0,0,8,0" />
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="ACTUALIZAR" Style="{StaticResource PrimaryButton}" MinWidth="150"
                        Command="{Binding RefreshCommand}" />
                <TextBlock Style="{StaticResource Body}" VerticalAlignment="Center" Margin="14,0,0,0"
                           Text="{Binding Summary}" />
            </StackPanel>

            <TextBlock Text="{Binding Status}" Style="{StaticResource Body}" TextWrapping="Wrap"
                       Margin="0,10,0,0" />

            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="11"
                       Text="El progreso se recalcula desde el historial cada vez que se abre esta pantalla, así que no puede desviarse de lo que pasó. Los puntos se cobran a mano: el evento del cobro queda en el log con el logro que lo pagó. Los logros que cuentan algo que PermaLocke todavía no detecta salen marcados en vez de desaparecer." />
        </StackPanel>
    </Grid>
</UserControl>
