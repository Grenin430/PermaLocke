<Window x:Class="PermaLocke.App.Views.EdgeTabWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="58" Height="76"
        Cursor="Hand">

    <!-- LA PESTAÑA. Pegada al borde y medio escondida: en reposo solo asoma lo justo para saber
         que PermaLocke sigue ahi, y al acercar el raton sale entera. Se puede arrastrar arriba y
         abajo, y donde la dejes se recuerda. -->
    <Grid x:Name="Root" Opacity="0.55" RenderTransformOrigin="0,0.5">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Peek" X="-16" />
        </Grid.RenderTransform>

        <Border CornerRadius="0,14,14,0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="0,1,1,1"
                Margin="0,6">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="0"
                                  Opacity="0.5" Color="Black" />
            </Border.Effect>

            <Grid Margin="20,0,8,0">
                <!-- El PNG y NO el .ico: un .ico guarda nueve tamaños y WPF se queda con el
                     primero, que es el de 16 pixeles, asi que estirado a veintiseis se le contaban
                     los pixeles. El PNG es de 256 y bajar siempre sale liso. -->
                <Image Source="/Assets/PermaLocke.png" Width="28" Height="28"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />

                <!-- El punto rojo: algo ha pasado mientras no mirabas. Se apaga al abrir. -->
                <Ellipse Width="10" Height="10" Fill="{StaticResource DangerBrush}"
                         Stroke="{StaticResource SidebarBrush}" StrokeThickness="2"
                         HorizontalAlignment="Right" VerticalAlignment="Top"
                         Margin="0,10,-2,0"
                         Visibility="{Binding Pending, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>
    </Grid>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Grid.MouseEnter" SourceName="Root">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.14" />
                    <DoubleAnimation Storyboard.TargetName="Peek" Storyboard.TargetProperty="X"
                                     To="0" Duration="0:0:0.16">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>

        <EventTrigger RoutedEvent="Grid.MouseLeave" SourceName="Root">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                                     To="0.55" Duration="0:0:0.2" />
                    <DoubleAnimation Storyboard.TargetName="Peek" Storyboard.TargetProperty="X"
                                     To="-16" Duration="0:0:0.2" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
