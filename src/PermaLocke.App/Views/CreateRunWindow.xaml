<Window x:Class="PermaLocke.App.Views.CreateRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PermaLocke.App.Views"
        xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel"
        Title="PermaLocke — Nueva run"
        Height="720" Width="640"
        MinHeight="480" MinWidth="540"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource PxBaseBrush}">

    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource PxScrollBar}" />
        <Style x:Key="Label" TargetType="pixel:PixelText">
            <Setter Property="Scale" Value="2" />
            <Setter Property="Tight" Value="True" />
            <Setter Property="Colour" Value="{DynamicResource PxTextFaint}" />
            <Setter Property="Margin" Value="2,0,0,7" />
        </Style>
    </Window.Resources>

    <!-- En píxeles, como el resto de la aplicación (§176). La fila de abajo va clavada y el formulario se desplaza,
         así que un mensaje largo de la ROM no puede empujar el botón fuera de la ventana. -->
    <Grid>
        <pixel:PixelBackdrop Base="{DynamicResource PxBase}" />

        <Grid Margin="18,16,18,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="2,0,0,14">
                <pixel:PixelText Text="NUEVA RUN" Scale="4" Tight="True" Colour="{DynamicResource PxText}"
                                 Shadow="{DynamicResource PxShadow}" />
                <pixel:PixelText Text="Elige tu rol y tu nombre." Scale="2" Tight="True" Margin="0,8,0,0"
                                 Colour="{DynamicResource PxTextDim}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">
                    <!-- EL ROL VA PRIMERO. No es orden estético: parte del rol se cuece en la ROM, así que elegirlo
                         después de randomizar significaría randomizar otra vez, y eso le cambia el mundo a una run
                         ya empezada. -->
                    <pixel:PixelWindow Title="ROL" Icon="IconPeople">
                        <StackPanel>
                            <pixel:PixelText Text="El rol decide la dificultad." Scale="2" Wrap="True"
                                             Colour="{DynamicResource PxTextDim}" Margin="2,0,0,12" />

                            <views:RoleMenuView DataContext="{Binding Menu}" />

                            <pixel:PixelText Text="{Binding RoleProblem}" Scale="2" Wrap="True" Colour="{DynamicResource PxBad}"
                                             Margin="2,4,0,0" />
                        </StackPanel>
                    </pixel:PixelWindow>

                    <pixel:PixelWindow Title="TU PARTIDA" Icon="IconDocument" Margin="0,12,0,0">
                        <StackPanel>
                            <pixel:PixelText Text="ROM" Style="{StaticResource Label}" />
                            <Grid Margin="0,0,0,16">
                                <views:PixelPanel Fill="{DynamicResource PxWell}" IsSunken="True" HasShadow="False" />
                                <pixel:PixelText Text="{Binding RomStatus}" Scale="2" Wrap="True" Margin="12,9,12,11"
                                                 Colour="{DynamicResource PxText}" />
                            </Grid>

                            <pixel:PixelText Text="NOMBRE DE LA RUN" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding RunName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource PxTextBox}" Margin="0,0,0,16" />

                            <pixel:PixelText Text="NICKNAME DEL JUGADOR" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource PxTextBox}" />
                            <pixel:PixelText Text="El nombre de tu entrenador en el juego." Scale="2" Tight="True" Margin="2,8,0,0"
                                             Colour="{DynamicResource PxTextFaint}" />
                        </StackPanel>
                    </pixel:PixelWindow>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,14,0,0">
                <views:PixelPanel Fill="{DynamicResource PxFace}" />
                <StackPanel Margin="14,12,20,17">
                    <pixel:PixelText Text="{Binding ErrorMessage}" Scale="2" Wrap="True" Colour="{DynamicResource PxBad}"
                                     Margin="0,0,0,10">
                        <pixel:PixelText.Style>
                            <Style TargetType="pixel:PixelText">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </pixel:PixelText.Style>
                    </pixel:PixelText>

                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="CREAR RUN" Command="{Binding CreateCommand}"
                                Style="{StaticResource PxButton}" VerticalAlignment="Center" />
                        <pixel:PixelText Text="Necesitas tu ROM de Ultra Luna, un nombre de run y tu nombre." Scale="2" Wrap="True"
                                         Colour="{DynamicResource PxTextFaint}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
