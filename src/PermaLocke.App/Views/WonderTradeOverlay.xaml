<UserControl x:Class="PermaLocke.App.Views.WonderTradeOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- La Poké Ball, dibujada con formas: media esfera roja, media blanca, la banda y el
             botón. Nada de assets; es geometría, como los portales del gacha. -->
        <ControlTemplate x:Key="PokeBall" TargetType="ContentControl">
            <Grid Width="64" Height="64">
                <Ellipse Stroke="#101014" StrokeThickness="3">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#E8404A" />
                            <GradientStop Offset="0.5" Color="#C42A34" />
                            <GradientStop Offset="0.5" Color="#F4F4F6" />
                            <GradientStop Offset="1" Color="#C9C9D2" />
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Rectangle Height="7" VerticalAlignment="Center" Fill="#101014" />
                <Ellipse Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Fill="#101014" />
                <Ellipse Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Fill="#F4F4F6" Stroke="#7A7A85" StrokeThickness="1" />
            </Grid>
        </ControlTemplate>
    </UserControl.Resources>

    <Grid Background="#E60A0A0F">
        <!-- Campo de la animación. Todo se posiciona respecto al centro. -->
        <Grid x:Name="Stage">

            <!-- Fogonazo del momento: al cerrarse la bola y al abrirse. -->
            <Rectangle x:Name="Flash" Opacity="0" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.7" RadiusY="0.9">
                        <GradientStop Offset="0" Color="{StaticResource AccentColor}" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <TextBlock x:Name="Caption" Style="{StaticResource Mono}" FontSize="12" Opacity="0.55"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0"
                       Text="INTERCAMBIO PRODIGIOSO" />

            <!-- EL POKÉMON QUE SE VA. Se encoge y entra en su bola. -->
            <Image x:Name="GivenSprite" Source="{Binding GivenSprite}" Width="96" Height="96"
                   Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="GivenScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="GivenShift" X="0" Y="0" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>

            <!-- LA BOLA QUE SE VA. -->
            <ContentControl x:Name="OutgoingBall" Template="{StaticResource PokeBall}" Opacity="0"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                <ContentControl.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="OutgoingScale" ScaleX="1" ScaleY="1" />
                        <RotateTransform x:Name="OutgoingSpin" Angle="0" />
                        <TranslateTransform x:Name="OutgoingShift" X="0" Y="0" />
                    </TransformGroup>
                </ContentControl.RenderTransform>
            </ContentControl>

            <!-- LA BOLA QUE LLEGA, del otro lado y en el mismo plano. -->
            <ContentControl x:Name="IncomingBall" Template="{StaticResource PokeBall}" Opacity="0"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                <ContentControl.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="IncomingScale" ScaleX="1" ScaleY="1" />
                        <RotateTransform x:Name="IncomingSpin" Angle="0" />
                        <TranslateTransform x:Name="IncomingShift" X="0" Y="0" />
                    </TransformGroup>
                </ContentControl.RenderTransform>
            </ContentControl>

            <!-- LOS TRES AVISOS, en orden y sin el Pokémon todavía. -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,120,0,0">

                <ItemsControl ItemsSource="{Binding Types}" HorizontalAlignment="Center"
                              Visibility="{Binding ShowTypes, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Colour}" CornerRadius="4" Padding="16,5"
                                    Margin="4,0" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </Border.RenderTransform>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Mono}"
                                           FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" />
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.3" />
                                                <DoubleAnimation From="2.2" To="1" Duration="0:0:0.55"
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase EasingMode="EaseOut" Amplitude="0.8" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation From="2.2" To="1" Duration="0:0:0.55"
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase EasingMode="EaseOut" Amplitude="0.8" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="Generation" Text="{Binding GenerationText}" Margin="0,14,0,0"
                           Style="{StaticResource Mono}" FontSize="17" HorizontalAlignment="Center"
                           Foreground="{StaticResource TextBrush}" RenderTransformOrigin="0.5,0.5"
                           Visibility="{Binding ShowGeneration, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                    </TextBlock.RenderTransform>
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard />
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>

                <StackPanel Margin="0,14,0,0" HorizontalAlignment="Center"
                            Visibility="{Binding ShowTotal, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Center"
                               Text="TOTAL DE ESTADÍSTICAS BASE" />
                    <TextBlock Text="{Binding TotalText}" Style="{StaticResource PanelHeading}"
                               FontSize="34" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding DifferenceText}" Style="{StaticResource Mono}"
                               FontSize="11" Opacity="0.7" HorizontalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <!-- Y POR ÚLTIMO EL POKÉMON. -->
            <StackPanel x:Name="Result" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="0,0,0,150" RenderTransformOrigin="0.5,0.5"
                        Visibility="{Binding ShowPokemon, Converter={StaticResource BoolToVisibility}}">
                <StackPanel.RenderTransform>
                    <ScaleTransform x:Name="ResultScale" ScaleX="1" ScaleY="1" />
                </StackPanel.RenderTransform>

                <Image Source="{Binding ReceivedSprite}" Width="128" Height="128" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" HorizontalAlignment="Center" />

                <TextBlock Text="{Binding Offer.Name}" Style="{StaticResource PanelHeading}"
                           FontSize="26" HorizontalAlignment="Center" />

                <TextBlock Style="{StaticResource Mono}" FontSize="11" HorizontalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}" Text="SHINY" Margin="0,2,0,0"
                           Visibility="{Binding Offer.IsShiny, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Style="{StaticResource Body}" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <Run Text="Nv." /><Run Text="{Binding Offer.Level, Mode=OneWay}" />
                    <Run Text=" · " /><Run Text="{Binding Offer.NatureName, Mode=OneWay}" />
                    <Run Text=" · IV " /><Run Text="{Binding Offer.IvTotal, Mode=OneWay}" />
                </TextBlock>

                <Button Content="LISTO" Style="{StaticResource PrimaryButton}" MinWidth="150"
                        Margin="0,16,0,0" HorizontalAlignment="Center"
                        Command="{Binding DismissCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
