<UserControl x:Class="PermaLocke.App.Views.WonderTradeOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <!-- El fondo del intercambio del juego es claro y azul, no negro: azul profundo abajo,
         turquesa en el centro, con rayos girando detrás. -->
    <Grid ClipToBounds="True">
        <Grid.Background>
            <RadialGradientBrush GradientOrigin="0.5,0.45" Center="0.5,0.45" RadiusX="0.95" RadiusY="1.15">
                <GradientStop Offset="0" Color="#FF1E6FA8" />
                <GradientStop Offset="0.45" Color="#FF10396A" />
                <GradientStop Offset="1" Color="#FF060B1E" />
            </RadialGradientBrush>
        </Grid.Background>

        <!-- Rayos de luz girando despacio, como el fondo del intercambio. -->
        <Path x:Name="Rays" Opacity="0.16" IsHitTestVisible="False" Fill="#FFCDEBFF"
              HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
              Data="M 0,0 L 900,-150 L 900,150 Z
                    M 0,0 L 780,480 L 600,760 Z
                    M 0,0 L 250,880 L -80,900 Z
                    M 0,0 L -520,760 L -760,520 Z
                    M 0,0 L -900,110 L -880,-190 Z
                    M 0,0 L -640,-680 L -380,-830 Z
                    M 0,0 L 130,-900 L 430,-800 Z">
            <Path.RenderTransform>
                <RotateTransform x:Name="RaySpin" Angle="0" />
            </Path.RenderTransform>
            <Path.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="RaySpin"
                                             Storyboard.TargetProperty="Angle"
                                             From="0" To="360" Duration="0:0:26" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Path.Triggers>
        </Path>

        <!-- El color del tipo inunda el fondo al abrirse la bola. El relleno lleva el color y la
             máscara le da la forma: un degradado no se puede colorear desde un binding, y la
             OpacityMask con degradado sí funciona (la que no pinta nada es la de ImageBrush, §31). -->
        <Rectangle x:Name="TypeFlood" Opacity="0" IsHitTestVisible="False" Fill="{Binding TypeColour}">
            <Rectangle.OpacityMask>
                <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.85" RadiusY="1.1">
                    <GradientStop Offset="0" Color="#FFFFFFFF" />
                    <GradientStop Offset="1" Color="#00000000" />
                </RadialGradientBrush>
            </Rectangle.OpacityMask>
        </Rectangle>

        <!-- Barras de cine. -->
        <Rectangle Height="44" VerticalAlignment="Top" Fill="#0A0A0D" IsHitTestVisible="False" />
        <Rectangle Height="44" VerticalAlignment="Bottom" Fill="#0A0A0D" IsHitTestVisible="False" />

        <Grid x:Name="Stage" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="StageShake" X="0" Y="0" />
            </Grid.RenderTransform>

            <Rectangle x:Name="Flash" Opacity="0" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.8" RadiusY="1">
                        <GradientStop Offset="0" Color="#FFFFFFFF" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <TextBlock Style="{StaticResource Mono}" FontSize="13" Opacity="0.6"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,13,0,0"
                       Foreground="#FFCDEBFF" Text="I N T E R C A M B I O   P R O D I G I O S O" />

            <Ellipse x:Name="Shockwave" Width="200" Height="200" Opacity="0" StrokeThickness="5"
                     Stroke="#FFEAF6FF" IsHitTestVisible="False"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="ShockwaveScale" ScaleX="0.15" ScaleY="0.15" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <!-- EL POKÉMON QUE SE VA. -->
            <Image x:Name="GivenSprite" Source="{Binding GivenSprite}" Width="200" Height="200"
                   Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <ScaleTransform x:Name="GivenScale" ScaleX="1" ScaleY="1" />
                </Image.RenderTransform>
            </Image>

            <!-- LA BOLA QUE SE VA, en arco. -->
            <Image x:Name="OutgoingBall" Source="{Binding BallSprite}" Width="140" Height="140"
                   Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" Opacity="0"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="OutgoingScale" ScaleX="1" ScaleY="1" />
                        <RotateTransform x:Name="OutgoingSpin" Angle="0" />
                        <TranslateTransform x:Name="OutgoingShift" X="0" Y="0" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>

            <!-- LA BOLA QUE LLEGA: cruza en arco y cae con rebote. -->
            <Image x:Name="IncomingBall" Source="{Binding BallSprite}" Width="140" Height="140"
                   Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" Opacity="0"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="IncomingScale" ScaleX="1" ScaleY="1" />
                        <RotateTransform x:Name="IncomingSpin" Angle="0" />
                        <TranslateTransform x:Name="IncomingShift" X="0" Y="0" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>

            <!-- LOS TRES AVISOS. En su propia capa, y se apagan antes de que salga el Pokémon. -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,70">

                <TextBlock Text="{Binding GenerationText}" Margin="0,20,0,0"
                           Style="{StaticResource PanelHeading}" FontSize="30" HorizontalAlignment="Center"
                           RenderTransformOrigin="0.5,0.5"
                           Visibility="{Binding ShowGeneration, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="0" Opacity="0.9" />
                    </TextBlock.Effect>
                    <TextBlock.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                    </TextBlock.RenderTransform>
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1" Duration="0:0:0.3" />
                                    <DoubleAnimation From="2.6" To="1" Duration="0:0:0.6"
                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                        <DoubleAnimation.EasingFunction>
                                            <BackEase EasingMode="EaseOut" Amplitude="0.9" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation From="2.6" To="1" Duration="0:0:0.6"
                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                        <DoubleAnimation.EasingFunction>
                                            <BackEase EasingMode="EaseOut" Amplitude="0.9" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding Types}" HorizontalAlignment="Center"
                              Visibility="{Binding ShowTypes, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Colour}" CornerRadius="7" Padding="30,10"
                                    Margin="7,0" RenderTransformOrigin="0.5,0.5"
                                    BorderThickness="2" BorderBrush="#66FFFFFF">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.8" />
                                </Border.Effect>
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </Border.RenderTransform>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Mono}"
                                           FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" />
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.3" />
                                                <DoubleAnimation From="3" To="1" Duration="0:0:0.6"
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase EasingMode="EaseOut" Amplitude="0.9" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation From="3" To="1" Duration="0:0:0.6"
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase EasingMode="EaseOut" Amplitude="0.9" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Margin="0,18,0,0" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                            Visibility="{Binding ShowTotal, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                    </StackPanel.RenderTransform>
                    <StackPanel.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="0" Opacity="0.9" />
                    </StackPanel.Effect>
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center"
                               Foreground="#FFCDEBFF" Text="TOTAL DE ESTADÍSTICAS BASE" />
                    <TextBlock Text="{Binding TotalText}" Style="{StaticResource PanelHeading}"
                               FontSize="72" HorizontalAlignment="Center" Margin="0,-6,0,0" />
                    <TextBlock Text="{Binding DifferenceText}" Style="{StaticResource Mono}"
                               FontSize="14" Opacity="0.9" HorizontalAlignment="Center" />
                    <StackPanel.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1" Duration="0:0:0.3" />
                                    <DoubleAnimation From="2.4" To="1" Duration="0:0:0.7"
                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                        <DoubleAnimation.EasingFunction>
                                            <BackEase EasingMode="EaseOut" Amplitude="0.9" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation From="2.4" To="1" Duration="0:0:0.7"
                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                        <DoubleAnimation.EasingFunction>
                                            <BackEase EasingMode="EaseOut" Amplitude="0.9" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </StackPanel.Triggers>
                </StackPanel>
            </StackPanel>

            <!-- Y POR ÚLTIMO EL POKÉMON. La ficha va sobre su propio panel oscuro: encima del
                 fondo claro y de la bola no se leía. -->
            <Grid x:Name="Result" HorizontalAlignment="Center" VerticalAlignment="Center"
                  RenderTransformOrigin="0.5,0.5"
                  Visibility="{Binding ShowPokemon, Converter={StaticResource BoolToVisibility}}">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="ResultScale" ScaleX="1" ScaleY="1" />
                </Grid.RenderTransform>

                <StackPanel>
                    <Image Source="{Binding ReceivedSprite}" Width="240" Height="240" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" HorizontalAlignment="Center" />

                    <Border Background="#D9080B16" CornerRadius="10" Padding="30,16" Margin="0,-16,0,0"
                            BorderThickness="2" BorderBrush="{Binding TypeColour}"
                            HorizontalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="{Binding Offer.Name}" Style="{StaticResource PanelHeading}"
                                       FontSize="42" HorizontalAlignment="Center" />

                            <TextBlock Style="{StaticResource Mono}" FontSize="14" HorizontalAlignment="Center"
                                       Foreground="{StaticResource AccentBrush}" Text="★ SHINY ★" Margin="0,2,0,0"
                                       Visibility="{Binding Offer.IsShiny, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Style="{StaticResource Body}" FontSize="16" HorizontalAlignment="Center"
                                       Margin="0,6,0,0">
                                <Run Text="Nv." /><Run Text="{Binding Offer.Level, Mode=OneWay}" />
                                <Run Text=" · " /><Run Text="{Binding Offer.NatureName, Mode=OneWay}" />
                                <Run Text=" · IV " /><Run Text="{Binding Offer.IvTotal, Mode=OneWay}" />
                            </TextBlock>

                            <TextBlock Style="{StaticResource Mono}" FontSize="12" HorizontalAlignment="Center"
                                       Opacity="0.75" Margin="0,4,0,0" Text="{Binding DifferenceText}" />

                            <Button Content="LISTO" Style="{StaticResource PrimaryButton}" MinWidth="180"
                                    Margin="0,16,0,0" HorizontalAlignment="Center"
                                    Command="{Binding DismissCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
