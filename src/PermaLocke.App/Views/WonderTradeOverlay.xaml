<UserControl x:Class="PermaLocke.App.Views.WonderTradeOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PermaLocke.App.Views"
             xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Aparecer como un sello: dos saltos de alto, sin escalas suaves ni rebotes. -->
        <Storyboard x:Key="Stamp">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.25" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.06" Value="0.65" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.12" Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.2" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.06" Value="1.08" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.12" Value="1" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

    </UserControl.Resources>

    <Grid ClipToBounds="True" Background="#FF0D0A16">

        <!-- LA CABINA (§174): la sala, los tubos, la pantalla con sus tres pistas y las dos plataformas, dibujado
             celda a celda en TradeMachineScene.cs a partir de CurrentPlay. -->
        <views:TradeMachine x:Name="Machine" Play="{Binding CurrentPlay}" />

        <!-- LA FICHA DEL QUE LLEGA, a la izquierda: encima de la plataforma de envío, que ya está vacía, y lejos de la
             pantalla, que sigue diciendo generación, tipos y total al lado. -->
        <Grid HorizontalAlignment="Left" VerticalAlignment="Center" Width="300" Margin="28,0,0,24"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform />
            </Grid.RenderTransform>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowPokemon}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource Stamp}" />
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <views:PixelPanel Fill="#FF16112A" />
            <!-- La franja del color de su tipo, arriba, como la del tier en la ficha del gacha. -->
            <Rectangle Height="6" VerticalAlignment="Top" Margin="6,6,12,0" Fill="{Binding TypeColour}" />

            <StackPanel Margin="20,22,26,26">
                <pixel:PixelText Text="HA LLEGADO" Scale="2" Tight="True" Colour="#FF9EC3F0" />

                <pixel:PixelText Text="{Binding Offer.DisplayName}" Scale="4" Tight="True" Trim="True" Margin="0,8,0,0"
                                 Colour="#FFFFFFFF" Shadow="#FF05070F" />

                <!-- Variocolor y legendario en el oro de las estrellas y los rayos que lo acompañan en la escena. -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <pixel:PixelText Text="VARIOCOLOR" Scale="2" Tight="True" Colour="#FFD8A83C" Margin="0,0,12,0"
                                     Visibility="{Binding Offer.IsShiny, Converter={StaticResource BoolToVisibility}}" />
                    <pixel:PixelText Text="LEGENDARIO" Scale="2" Tight="True" Colour="#FFD8A83C"
                                     Visibility="{Binding Offer.Legendary, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Types}" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,8,0">
                                <views:PixelPanel Fill="{Binding Colour.Color}" />
                                <pixel:PixelText Text="{Binding Name}" Scale="2" Tight="True" Margin="12,7,18,12"
                                                 Colour="#FFFFFFFF" Shadow="#FF05070F" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <pixel:PixelText Text="{Binding Offer.Ability}" Scale="2" Wrap="True" Margin="0,14,0,0" Colour="#FFEEEAF8" />
                <WrapPanel Margin="0,7,0,0">
                    <pixel:PixelText Text="Total base" Scale="2" Tight="True" Colour="#FF9E96B8" />
                    <pixel:PixelText Text="{Binding TotalText}" Scale="2" Tight="True" Margin="6,0" Colour="#FFEEEAF8" />
                    <pixel:PixelText Text="·" Scale="2" Tight="True" Margin="0,0,6,0" Colour="#FF9E96B8" />
                    <pixel:PixelText Text="{Binding DifferenceText}" Scale="2" Tight="True" Colour="#FFEEEAF8" />
                </WrapPanel>

                <Button Content="LISTO" Style="{StaticResource PxButton}" Margin="0,18,0,0"
                        HorizontalAlignment="Left" Command="{Binding DismissCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
