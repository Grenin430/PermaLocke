<UserControl x:Class="PermaLocke.App.Views.PokePasteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Qué se exporta. El equipo primero, y después solo las cajas con algo dentro: una lista
             de treinta y dos entradas de las que veinte están vacías no ayuda a elegir. -->
        <Border Grid.Column="0" Style="{StaticResource Inset}" Padding="14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="QUÉ EXPORTAR" Style="{StaticResource StatLabel}"
                           Margin="0,0,0,10" />

                <Button DockPanel.Dock="Bottom" Content="RELEER LA PARTIDA"
                        Style="{StaticResource GhostButton}" Command="{Binding LoadCommand}"
                        Padding="12,8" FontSize="11.5" Margin="0,10,0,0"
                        HorizontalAlignment="Stretch" />

                <ListBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"
                         Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ItemContainerStyle="{StaticResource NavItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}"
                                           Style="{StaticResource Mono}" FontSize="11"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Inset}" Padding="16,14">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Content="COPIAR" Style="{StaticResource PrimaryButton}"
                            Command="{Binding CopyCommand}" Padding="18,8" FontSize="11.5" />
                    <TextBlock Text="FORMATO POKEPAST.ES" Style="{StaticResource StatLabel}"
                               VerticalAlignment="Center" />
                </DockPanel>

                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Faint}" Margin="0,10,0,0"
                           Text="Los nombres van en inglés a propósito: la web se guía por ellos, y un pegado con los nombres en español entra vacío. Se lee de la partida guardada, así que refleja lo último que guardaste. Los huevos no se exportan." />

                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}"
                           FontSize="12" Margin="0,10,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Editable a propósito: es texto que el jugador puede querer retocar antes de
                     pegarlo, y de solo lectura no se deja ni seleccionar cómodamente. Nada de lo
                     que se escriba aquí vuelve a la partida. -->
                <TextBox Text="{Binding Paste, Mode=OneWay}"
                         Style="{StaticResource Field}"
                         FontFamily="{StaticResource MonoFont}" FontSize="12"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top" Padding="12,10" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
