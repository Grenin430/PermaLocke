<UserControl x:Class="PermaLocke.App.Views.PokePasteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel">

    <!-- Solo el equipo. Un pegado es un EQUIPO -seis Pokémon que otro puede cargar y combatir- y
         una caja de treinta no lo es; para el PC está el visor. En píxeles desde el §176: una ventana con el texto en
         su casilla y las dos órdenes encima. -->
    <pixel:PixelWindow Title="EL EQUIPO, EN FORMATO POKEPAST.ES" Icon="IconDocument">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                <Button Content="RELEER LA PARTIDA" Style="{StaticResource PxSubtleButton}" Padding="12,6,18,11"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0" />
                <Button Content="COPIAR" Style="{StaticResource PxButton}" Padding="14,6,20,11"
                        Command="{Binding CopyCommand}" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <pixel:PixelText Text="{Binding Status}" Scale="2" Wrap="True" Margin="0,0,0,8"
                                 Colour="{StaticResource PxGood}" />
                <StackPanel Orientation="Horizontal">
                    <pixel:PixelText Text="▶" Scale="2" Tight="True" Colour="{StaticResource PxGold}" />
                    <pixel:PixelText Text="Tu equipo guardado."
                                     Scale="2" Tight="True" Margin="8,0,0,0" Colour="{StaticResource PxTextDim}" />
                </StackPanel>
            </StackPanel>

            <!-- Editable a propósito: es texto que el jugador puede querer retocar antes de
                 pegarlo, y de solo lectura no se deja ni seleccionar cómodamente. Nada de lo
                 que se escriba aquí vuelve a la partida. -->
            <TextBox Text="{Binding Paste, Mode=OneWay}" Style="{StaticResource PxTextBox}"
                     AcceptsReturn="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top" Padding="16,14" />
        </DockPanel>
    </pixel:PixelWindow>
</UserControl>
