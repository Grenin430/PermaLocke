<UserControl x:Class="PermaLocke.App.Views.MiscellaneousView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PermaLocke.App.Views"
             xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel">

    <!-- MISCELÁNEA EN PÍXELES (§176). Mismas órdenes que antes, en ventanas: los premios y las
         herramientas de pruebas. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style TargetType="ScrollBar" BasedOn="{StaticResource PxScrollBar}" />

        <Style x:Key="Explain" TargetType="pixel:PixelText">
            <Setter Property="Scale" Value="2" />
            <Setter Property="Wrap" Value="True" />
            <Setter Property="Colour" Value="{DynamicResource PxTextDim}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,10,0">

            <!-- Los premios de la competición. No son herramientas de pruebas y por eso van en su
                 propio panel: se ganan, se dan una vez, y lo que hace que «una vez» sea verdad es
                 el evento que queda en el historial, no este botón. -->
            <pixel:PixelWindow Title="PREMIOS DE LA COMPETICIÓN" Icon="IconTrophy" Margin="0,0,0,12"
                               Visibility="{Binding HasRewards, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <pixel:PixelText Style="{StaticResource Explain}" Text="Se recogen una vez." />

                    <ItemsControl ItemsSource="{Binding Rewards}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <views:PixelPanel Fill="{DynamicResource PxFaceHigh}" />
                                    <DockPanel Margin="16,12,22,18">
                                        <Button DockPanel.Dock="Right" Content="{Binding Action}"
                                                Style="{StaticResource PxButton}" MinWidth="150" Margin="14,0,0,0"
                                                VerticalAlignment="Center" IsEnabled="{Binding CanClaim}"
                                                Command="{Binding DataContext.ClaimRewardCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />

                                        <!-- CUANTO FALTA, en barra, con la cifra encima. -->
                                        <StackPanel DockPanel.Dock="Right" Width="110" VerticalAlignment="Center" Margin="14,0,0,0">
                                            <pixel:PixelText Text="{Binding Progress}" Scale="2" Tight="True"
                                                             HorizontalAlignment="Center" Margin="0,0,0,6"
                                                             Colour="{DynamicResource PxTextDim}" />
                                            <views:PixelBar Height="15" Value="{Binding Share, Mode=OneWay}">
                                                <views:PixelBar.Style>
                                                    <Style TargetType="views:PixelBar">
                                                        <Setter Property="Fill" Value="{DynamicResource PxAccent}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanClaim}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource PxGood}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Claimed}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource PxGood}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </views:PixelBar.Style>
                                            </views:PixelBar>
                                        </StackPanel>

                                        <StackPanel>
                                            <pixel:PixelText Text="{Binding Name}" Scale="2" Tight="True"
                                                             Colour="{DynamicResource PxText}" Shadow="{DynamicResource PxShadow}" />
                                            <pixel:PixelText Text="{Binding Description}" Style="{StaticResource Explain}"
                                                             Margin="0,5,0,0" />

                                            <!-- LO QUE DA, dibujado. Los iconos salen de la ROM del propio jugador. -->
                                            <ItemsControl ItemsSource="{Binding Gives}" Margin="0,10,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,8,6">
                                                            <views:PixelPanel Fill="{DynamicResource PxWell}" IsSunken="True"
                                                                              HasShadow="False" />
                                                            <StackPanel Orientation="Horizontal" Margin="8,5,11,5">
                                                                <pixel:PixelSprite Source="{Binding Icon}" Scale="1" TrimEmpty="True"
                                                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                <pixel:PixelText Text="{Binding Amount}" Scale="2" Tight="True"
                                                                                 VerticalAlignment="Center"
                                                                                 Colour="{DynamicResource PxAccentInkLight}" />
                                                                <pixel:PixelText Text="{Binding Name}" Scale="2" Tight="True"
                                                                                 VerticalAlignment="Center" Margin="6,0,0,0"
                                                                                 Colour="{DynamicResource PxText}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </pixel:PixelWindow>

            <pixel:PixelWindow Title="DARSE OBJETOS" Icon="IconTools">
                <pixel:PixelWindow.HeaderContent>
                    <Grid>
                        <views:PixelPanel Fill="{DynamicResource PxWarnDeep}" HasShadow="False" />
                        <pixel:PixelText Text="HERRAMIENTAS DE PRUEBAS" Scale="2" Tight="True" Margin="9,5,10,6"
                                         Colour="{DynamicResource PxWarn}" />
                    </Grid>
                </pixel:PixelWindow.HeaderContent>

                <StackPanel>
                    <pixel:PixelText Style="{StaticResource Explain}"
                                     Text="Se suman a lo que llevas." />

                    <pixel:PixelRule Margin="0,14,0,14" />

                    <WrapPanel>
                        <Button Content="+10 CARAMELOS RAROS" Style="{StaticResource PxButton}"
                                Command="{Binding GrantCandiesCommand}" ToolTip="Diez más cada vez." Margin="0,0,10,6" />
                        <Button Content="+10 SUPERCARAMELORAROS" Style="{StaticResource PxButton}"
                                Command="{Binding GrantSuperCandiesCommand}" ToolTip="Diez más cada vez. Cada uno sube cinco niveles, sin pasar del cap." Margin="0,0,10,6" />
                        <Button Content="AMULETO IRIS" Style="{StaticResource PxButton}"
                                Command="{Binding GrantShinyCharmCommand}" ToolTip="Solo se puede llevar uno." Margin="0,0,10,6" />
                    </WrapPanel>
                </StackPanel>
            </pixel:PixelWindow>

            <Grid Margin="0,12,0,0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <views:PixelPanel Fill="{DynamicResource PxAccentDeep}" />
                <pixel:PixelText Text="{Binding Status}" Scale="2" Wrap="True" Margin="16,10,22,16"
                                 Colour="{DynamicResource PxText}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
