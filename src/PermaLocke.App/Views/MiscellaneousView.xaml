<UserControl x:Class="PermaLocke.App.Views.MiscellaneousView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,10,0">

            <Border Style="{StaticResource Inset}" Padding="18,16">
                <StackPanel>
                    <TextBlock Text="MOCHILA DEL JUEGO" Style="{StaticResource StatLabel}" />
                    <TextBlock Style="{StaticResource Body}" Margin="0,7,0,0"
                               Text="PermaLocke localiza la mochila por su estructura: el juego guarda los siete bolsillos seguidos y, justo detrás, una tabla de punteros a cada uno. Solo se acepta como mochila lo que cumple esa condición, así que no hay falsos positivos." />

                    <Button Content="LEER LA MOCHILA" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ReadBagCommand}" HorizontalAlignment="Left"
                            MinWidth="210" Padding="16,9" Margin="0,14,0,0" />

                    <Border Margin="0,14,0,0" Padding="14,11"
                            Background="{StaticResource BackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMedium}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BagAddress}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding BagAddress}" Style="{StaticResource Mono}"
                                       FontSize="12" Foreground="{StaticResource AccentBrush}" />

                            <ItemsControl ItemsSource="{Binding BagContents}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Mono}"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="0,1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Inset}" Padding="18,16" Margin="0,14,0,0">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Chip}"
                                Background="{StaticResource WarningDeepBrush}"
                                BorderBrush="{StaticResource WarningBrush}">
                            <TextBlock Text="HERRAMIENTAS DE PRUEBAS" Style="{StaticResource ChipText}"
                                       Foreground="{StaticResource WarningBrush}" />
                        </Border>
                        <TextBlock Text="DARSE OBJETOS" Style="{StaticResource StatLabel}"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Style="{StaticResource Body}" Margin="0,9,0,0"
                               Text="Cada pulsación añade a lo que ya llevas, no lo reemplaza. Después de escribir se vuelve a leer la mochila del juego, y solo se da por buena si ha cambiado de verdad." />

                    <Border Style="{StaticResource Divider}" Margin="0,15" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="+10 CARAMELOS RAROS" Style="{StaticResource PrimaryButton}"
                                Command="{Binding GrantCandiesCommand}" MinWidth="210" Padding="16,10"
                                ToolTip="Diez más cada vez que lo pulses. El bolsillo de medicinas admite 999 como mucho." />

                        <Button Content="AMULETO IRIS" Style="{StaticResource PrimaryButton}"
                                Command="{Binding GrantShinyCharmCommand}" MinWidth="170" Padding="16,10"
                                Margin="10,0,0,0"
                                ToolTip="Objeto clave: la mochila solo admite uno, así que pulsarlo dos veces no da dos." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Padding="14,10" Margin="0,14,0,0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource AccentDimBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMedium}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Body}" FontSize="12" />
            </Border>

            <TextBlock Style="{StaticResource Faint}" Margin="2,14,0,0"
                       Text="Escribir exige el fork propio de Azahar: el oficial acepta la escritura y no la aplica, y eso se detecta releyendo. Cada escritura guarda antes una copia de los bytes en Saves/backup y queda registrada como evento auditable de la run." />

        </StackPanel>
    </ScrollViewer>
</UserControl>
