<!-- MOVIMIENTOS, el recuerda-movimientos, con el estilo en píxeles del resto de la aplicación (§176): a la izquierda el
     equipo y las cajas; a la derecha la ficha -retrato, tipos y estadísticas-, los cuatro movimientos que sabe como
     los botones de combate del juego -del color de su tipo- y lo que puede recordar, todo seguido. Cada movimiento
     enseña su tipo, su categoría con el icono oficial del cartucho (§144) y su potencia, precisión y PP.
     Sustituye al aspecto naranja de la bolsa del §143. Solo cambia el aspecto: las órdenes y los enlaces son los
     de §142. -->
<UserControl x:Class="PermaLocke.App.Views.MoveReminderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PermaLocke.App.Views"
             xmlns:conv="clr-namespace:PermaLocke.App.Converters"
             xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:WidthToColumnsConverter x:Key="WidthToColumns" />
        <conv:WidthSwitchConverter x:Key="WidthSwitch" />

        <Style TargetType="ScrollBar" BasedOn="{StaticResource PxScrollBar}" />

        <Color x:Key="UpColor">#FFFF8A6A</Color>
        <Color x:Key="DownColor">#FF7AB0FF</Color>
        <!-- La sombra del texto blanco sobre el color de un tipo, que puede ser cualquiera. -->
        <Color x:Key="TypeShadowColor">#B0101010</Color>

        <!-- El texto blanco con sombra encima del color de un tipo. -->
        <Style x:Key="OnType" TargetType="pixel:PixelText">
            <Setter Property="Scale" Value="2" />
            <Setter Property="Tight" Value="True" />
            <Setter Property="Colour" Value="#FFFFFFFF" />
            <Setter Property="Shadow" Value="{StaticResource TypeShadowColor}" />
        </Style>

        <Style x:Key="Label" TargetType="pixel:PixelText">
            <Setter Property="Scale" Value="2" />
            <Setter Property="Tight" Value="True" />
            <Setter Property="Colour" Value="{StaticResource PxTextFaint}" />
        </Style>

        <!-- Una lista sin barra propia: la columna entera se desplaza de una vez. -->
        <ControlTemplate x:Key="PlainList" TargetType="ListBox">
            <ItemsPresenter />
        </ControlTemplate>

        <!-- Una lista que no se puede tocar se atenúa. -->
        <Style x:Key="Dimmable" TargetType="ListBox">
            <Setter Property="Opacity" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanEdit}" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- La placa del tipo: su color con el nombre en blanco. -->
        <DataTemplate x:Key="TypePlate">
            <Grid MinWidth="96" HorizontalAlignment="Left">
                <views:PixelPanel Fill="{Binding TypeColour}" HasShadow="False" />
                <pixel:PixelText Text="{Binding TypeName}" Style="{StaticResource OnType}"
                                 HorizontalAlignment="Center" Margin="10,6,10,7" />
            </Grid>
        </DataTemplate>

        <!-- La categoría: el icono oficial del cartucho al doble, o cinco guiones para uno de estado. -->
        <DataTemplate x:Key="CategoryBox">
            <Grid Width="64" Height="30" HorizontalAlignment="Left">
                <pixel:PixelSprite Source="{Binding CategoryIcon}" Scale="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasCategoryIcon, Converter={StaticResource BoolToVisibility}}" />
                <Grid Visibility="{Binding HasCategoryIcon, Converter={StaticResource InverseBoolToVisibility}}">
                    <views:PixelPanel Fill="{StaticResource PxWell}" IsSunken="True" HasShadow="False" />
                    <pixel:PixelText Text="{Binding CategoryText}" Scale="2" Tight="True" Colour="{StaticResource PxTextDim}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- Una estadística de la ficha: el nombre del color de la naturaleza (rojo sube, azul baja) y la cifra. -->
        <DataTemplate x:Key="StatCell">
            <Grid Margin="0,0,6,6">
                <views:PixelPanel Fill="{StaticResource PxFaceHigh}" HasShadow="False" />
                <DockPanel Margin="10,6,10,7">
                    <pixel:PixelText DockPanel.Dock="Right" Text="{Binding Text}" Scale="2" Tight="True" Margin="6,0,0,0"
                                     Colour="{StaticResource PxText}" />
                    <pixel:PixelText Text="{Binding Name}" Scale="2" Tight="True" Trim="True">
                        <pixel:PixelText.Style>
                            <Style TargetType="pixel:PixelText">
                                <Setter Property="Colour" Value="{StaticResource PxTextDim}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NatureState}" Value="up">
                                        <Setter Property="Colour" Value="{StaticResource UpColor}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding NatureState}" Value="down">
                                        <Setter Property="Colour" Value="{StaticResource DownColor}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </pixel:PixelText.Style>
                    </pixel:PixelText>
                </DockPanel>
            </Grid>
        </DataTemplate>

        <!-- ============================================ UNO DE LOS CUATRO QUE SABE -->
        <Style x:Key="KnownStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent" MinHeight="118">
                            <views:PixelPanel x:Name="Plate">
                                <views:PixelPanel.Style>
                                    <Style TargetType="views:PixelPanel">
                                        <Setter Property="Fill" Value="{Binding TypeColour}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource PxWell}" />
                                                <Setter Property="IsSunken" Value="True" />
                                                <Setter Property="HasShadow" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </views:PixelPanel.Style>
                            </views:PixelPanel>
                            <Rectangle x:Name="Hover" Fill="#1EFFFFFF" Margin="3,3,9,9" Visibility="Collapsed" />
                            <ContentPresenter Margin="14,10,18,15" />
                            <views:PixelCursor x:Name="Cursor" Margin="-4" Visibility="Collapsed" Colour="#FFFFF08A" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Cursor" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="KnownTemplate">
            <Grid>
                <!-- Uno que sabe: el nombre, la categoría con el tipo, y las tres cifras, en blanco sobre su tipo. -->
                <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                    <pixel:PixelText Text="{Binding Name}" Style="{StaticResource OnType}" Trim="True" />

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CategoryBox}" VerticalAlignment="Center" />
                        <pixel:PixelText Text="{Binding TypeName}" Style="{StaticResource OnType}" Margin="10,0,0,0" Trim="True"
                                         VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <StackPanel Margin="0,0,14,0">
                            <pixel:PixelText Text="POT." Style="{StaticResource OnType}" Colour="#FFE8E0F8" />
                            <pixel:PixelText Text="{Binding Power}" Style="{StaticResource OnType}" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,0">
                            <pixel:PixelText Text="PREC." Style="{StaticResource OnType}" Colour="#FFE8E0F8" />
                            <pixel:PixelText Text="{Binding Accuracy}" Style="{StaticResource OnType}" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <pixel:PixelText Text="PP" Style="{StaticResource OnType}" Colour="#FFE8E0F8" />
                            <pixel:PixelText Text="{Binding PP}" Style="{StaticResource OnType}" Margin="0,5,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Un hueco libre: hundido, y dice que ahí aprenderá. -->
                <StackPanel VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <pixel:PixelText Text="- libre -" Scale="3" Tight="True" Colour="{StaticResource PxTextFaint}" />
                    <pixel:PixelText Text="aquí aprenderá" Scale="2" Tight="True" Colour="{StaticResource PxTextFaint}" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Una cifra en su hueco: el rótulo encima, pequeño; el número debajo. -->
        <DataTemplate x:Key="Figure">
            <Grid Width="68" Margin="6,0,0,0">
                <views:PixelPanel Fill="{StaticResource PxWell}" IsSunken="True" HasShadow="False" />
                <StackPanel Margin="0,7,0,9">
                    <pixel:PixelText Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                     Style="{StaticResource Label}" HorizontalAlignment="Center" />
                    <pixel:PixelText Text="{Binding}" Scale="2" Tight="True" Colour="{StaticResource PxText}"
                                     HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ============================================ UNO QUE PUEDE RECORDAR -->
        <Style x:Key="OptionItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent">
                            <views:PixelPanel x:Name="Plate" Fill="{StaticResource PxFaceHigh}" />
                            <ContentPresenter Margin="0,0,6,6" />
                            <views:PixelCursor x:Name="Cursor" Margin="-4" Visibility="Collapsed" Colour="#FFFFF08A" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Fill" Value="{StaticResource PxFaceLift}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Plate" Property="Fill" Value="{StaticResource PxAccentDeep}" />
                                <Setter TargetName="Cursor" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="OptionTemplate">
            <Grid Margin="14,9,14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <!-- Por qué lo puede recordar, y el nombre. -->
                    <StackPanel Orientation="Horizontal">
                        <Grid MinWidth="58" VerticalAlignment="Center">
                            <views:PixelPanel Fill="{StaticResource PxFaceLift}" HasShadow="False" />
                            <pixel:PixelText Text="{Binding Badge}" Scale="2" Tight="True" Colour="{StaticResource PxAccentLight}"
                                             HorizontalAlignment="Center" Margin="9,5,9,6" />
                        </Grid>
                        <pixel:PixelText Text="{Binding Name}" Scale="3" Tight="True" Trim="True" Colour="{StaticResource PxText}"
                                         Shadow="{StaticResource PxShadow}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>

                    <!-- Su tipo y su categoría, a la vista. -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource TypePlate}" />
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CategoryBox}" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Potencia, precisión y PP, cada una en su hueco. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentPresenter Content="{Binding Power}" Tag="POT." ContentTemplate="{StaticResource Figure}" />
                    <ContentPresenter Content="{Binding Accuracy}" Tag="PREC." ContentTemplate="{StaticResource Figure}" />
                    <ContentPresenter Content="{Binding PP}" Tag="PP" ContentTemplate="{StaticResource Figure}" />
                </StackPanel>

                <!-- Qué hace, con las palabras del propio juego: solo el elegido. -->
                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Value="True"
                                                   Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                        <Condition Binding="{Binding HasDescription}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <views:PixelPanel Fill="{StaticResource PxWell}" IsSunken="True" HasShadow="False" />
                    <pixel:PixelText Text="{Binding Description}" Scale="2" Wrap="True" Colour="{StaticResource PxText}"
                                     Margin="12,8,12,10" />
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="300" MaxWidth="360" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <views:PokemonPickerPanel Grid.Column="0" />

        <DockPanel Grid.Column="2">
            <!-- ====================================== QUÉ PASARÁ Y RECORDAR, SIEMPRE A LA VISTA -->
            <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0"
                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                <views:PixelPanel Fill="{StaticResource PxFace}" />
                <DockPanel Margin="14,12,20,17">
                    <Button DockPanel.Dock="Left" Content="RECORDAR" Style="{StaticResource PxButton}"
                            Command="{Binding RememberCommand}" VerticalAlignment="Center" />

                    <Grid Margin="14,0,0,0" VerticalAlignment="Center">
                        <pixel:PixelText Text="{Binding Plan}" Scale="2" Wrap="True" Colour="{StaticResource PxTextDim}"
                                         VerticalAlignment="Center"
                                         Visibility="{Binding HasStatus, Converter={StaticResource InverseBoolToVisibility}}" />

                        <!-- Lo que pasó al escribir: verde si entró, rojo si no. -->
                        <Grid HorizontalAlignment="Left" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                            <views:PixelPanel HasShadow="False">
                                <views:PixelPanel.Style>
                                    <Style TargetType="views:PixelPanel">
                                        <Setter Property="Fill" Value="{StaticResource PxGoodDeep}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Failed}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource PxBadDeep}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </views:PixelPanel.Style>
                            </views:PixelPanel>
                            <pixel:PixelText Text="{Binding Status}" Scale="2" Wrap="True" Margin="12,7,14,9"
                                             Colour="{StaticResource PxText}" />
                        </Grid>
                    </Grid>
                </DockPanel>
            </Grid>

            <!-- Todo lo demás en una sola columna que se desplaza entera. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">
                    <!-- ====================================== LA FICHA -->
                    <pixel:PixelWindow Title="FICHA" Icon="IconSwords">
                        <Grid x:Name="Ficha" MinHeight="160">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}">
                                <pixel:PixelIcon Icon="IconSwords" Scale="4" Bob="True" HorizontalAlignment="Center" />
                                <pixel:PixelText Text="Elige un Pokémon del equipo o de una caja." Scale="2" Tight="True"
                                                 Margin="0,12,0,0" Colour="{StaticResource PxTextDim}" />
                            </StackPanel>

                            <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Column="0" Grid.RowSpan="2" Width="150" Height="150" VerticalAlignment="Top">
                                    <views:PixelPanel Fill="{StaticResource PxWell}" IsSunken="True" HasShadow="False" />
                                    <pixel:PixelSprite Source="{Binding SelectedSprite}" Scale="4" TrimEmpty="True" Bob="True"
                                                       Outline="{StaticResource PxShadow}" Stone="{Binding IsFallen}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <pixel:PixelIcon Icon="IconStar" Scale="2" Bob="True" HorizontalAlignment="Right"
                                                     VerticalAlignment="Top" Margin="0,8,8,0"
                                                     Visibility="{Binding Selected.IsShiny, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>

                                <StackPanel Grid.Column="1" Margin="16,2,12,0">
                                    <pixel:PixelText Text="{Binding Selected.DisplayName}" Scale="3" Tight="True" Trim="True"
                                                     Colour="{StaticResource PxText}" Shadow="{StaticResource PxShadow}" />
                                    <pixel:PixelText Text="{Binding Where}" Scale="2" Tight="True" Margin="0,6,0,0"
                                                     Colour="{StaticResource PxTextDim}" />

                                    <!-- Nivel, tipos y caído, en sus placas. -->
                                    <WrapPanel Margin="0,10,0,0">
                                        <Grid Margin="0,0,6,6">
                                            <views:PixelPanel Fill="{StaticResource PxFaceLift}" HasShadow="False" />
                                            <StackPanel Orientation="Horizontal" Margin="9,6,10,7">
                                                <pixel:PixelText Text="Nv." Scale="2" Tight="True" Colour="{StaticResource PxTextDim}" />
                                                <pixel:PixelText Text="{Binding Level}" Scale="2" Tight="True" Margin="4,0,0,0"
                                                                 Colour="{StaticResource PxText}" />
                                            </StackPanel>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding SelectedTypes}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,6,6">
                                                        <views:PixelPanel Fill="{Binding Colour}" HasShadow="False" />
                                                        <pixel:PixelText Text="{Binding Name}" Scale="2" Tight="True" Margin="9,6,10,7"
                                                                         Colour="{StaticResource PxText}" Shadow="{StaticResource PxShadow}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid Margin="0,0,6,6" Visibility="{Binding IsFallen, Converter={StaticResource BoolToVisibility}}">
                                            <views:PixelPanel Fill="{StaticResource PxBadDeep}" HasShadow="False" />
                                            <pixel:PixelText Text="CAÍDO" Scale="2" Tight="True" Margin="9,6,10,7"
                                                             Colour="{StaticResource PxBad}" />
                                        </Grid>
                                    </WrapPanel>

                                    <pixel:PixelText Text="{Binding Blocked}" Scale="2" Wrap="True" Colour="{StaticResource PxBad}"
                                                     Visibility="{Binding CanEdit, Converter={StaticResource InverseBoolToVisibility}}" />
                                </StackPanel>

                                <!-- Sus seis estadísticas, para saber si le conviene un físico o un especial: al lado del
                                     nombre si cabe, y debajo en las ventanas estrechas. -->
                                <StackPanel VerticalAlignment="Center" Width="252" HorizontalAlignment="Left"
                                            Grid.Column="{Binding ActualWidth, ElementName=Ficha, Converter={StaticResource WidthSwitch}, ConverterParameter=720;2;1}"
                                            Grid.Row="{Binding ActualWidth, ElementName=Ficha, Converter={StaticResource WidthSwitch}, ConverterParameter=720;0;1}"
                                            Margin="0,6,0,0">
                                    <pixel:PixelText Text="ESTADÍSTICAS" Style="{StaticResource Label}" Margin="2,0,0,7" />
                                    <ItemsControl ItemsSource="{Binding Stats}" ItemTemplate="{StaticResource StatCell}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </pixel:PixelWindow>

                    <!-- ====================================== LOS CUATRO QUE SABE -->
                    <pixel:PixelWindow Title="SABE AHORA · ELIGE CUÁL OLVIDA" Icon="IconSwords" Margin="0,12,0,0"
                                       Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <ListBox ItemsSource="{Binding Known}" SelectedItem="{Binding SelectedKnown}"
                                     Template="{StaticResource PlainList}"
                                     Background="Transparent" BorderThickness="0" Margin="0,0,-10,0"
                                     IsHitTestVisible="{Binding CanEdit}" Focusable="{Binding CanEdit}"
                                     Style="{StaticResource Dimmable}"
                                     ItemContainerStyle="{StaticResource KnownStyle}"
                                     ItemTemplate="{StaticResource KnownTemplate}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding ActualWidth,
                                                     RelativeSource={RelativeSource AncestorType=ListBox},
                                                     Converter={StaticResource WidthToColumns}, ConverterParameter=760}" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>

                            <!-- Qué hace el que se va a olvidar, para no olvidar a ciegas. -->
                            <Grid Margin="0,2,0,0"
                                  Visibility="{Binding SelectedKnown.HasDescription, FallbackValue=Collapsed,
                                               Converter={StaticResource BoolToVisibility}}">
                                <views:PixelPanel Fill="{StaticResource PxWell}" IsSunken="True" HasShadow="False" />
                                <StackPanel Margin="12,9,12,11">
                                    <pixel:PixelText Text="{Binding SelectedKnown.Name}" Scale="2" Tight="True"
                                                     Colour="{StaticResource PxAccentLight}" />
                                    <pixel:PixelText Text="{Binding SelectedKnown.Description}" Scale="2" Wrap="True" Margin="0,6,0,0"
                                                     Colour="{StaticResource PxText}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </pixel:PixelWindow>

                    <!-- ====================================== LO QUE PUEDE RECORDAR, TODO SEGUIDO -->
                    <pixel:PixelWindow Title="PUEDE RECORDAR" Icon="IconRefresh" Margin="0,12,0,0"
                                       Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <pixel:PixelText Text="{Binding SourceNote}" Scale="2" Wrap="True" Colour="{StaticResource PxTextDim}"
                                             Margin="2,0,0,10" />

                            <pixel:PixelText Scale="2" Wrap="True" Margin="2,0,0,0" Colour="{StaticResource PxTextDim}"
                                             Text="Ahora mismo no puede recordar nada: ya sabe todo lo que su especie aprende hasta su nivel."
                                             Visibility="{Binding HasOptions, Converter={StaticResource InverseBoolToVisibility}}" />

                            <ListBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"
                                     Template="{StaticResource PlainList}"
                                     IsHitTestVisible="{Binding CanEdit}" Focusable="{Binding CanEdit}"
                                     Style="{StaticResource Dimmable}"
                                     Background="Transparent" BorderThickness="0"
                                     ItemContainerStyle="{StaticResource OptionItem}"
                                     ItemTemplate="{StaticResource OptionTemplate}"
                                     Visibility="{Binding HasOptions, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </pixel:PixelWindow>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- Problemas y avisos, encima de todo. -->
        <Grid Grid.ColumnSpan="3" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,46,0,0" MaxWidth="760"
              Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
            <views:PixelPanel Fill="{StaticResource PxWarnDeep}" />
            <pixel:PixelText Text="{Binding Message}" Scale="2" Wrap="True" Margin="16,10,22,16" Colour="{StaticResource PxText}" />
        </Grid>
    </Grid>
</UserControl>
