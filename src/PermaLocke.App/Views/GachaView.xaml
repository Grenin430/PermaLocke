<UserControl x:Class="PermaLocke.App.Views.GachaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="Star" TargetType="Ellipse">
            <Setter Property="Fill" Value="{StaticResource TextBrush}" />
            <Setter Property="Width" Value="2" />
            <Setter Property="Height" Value="2" />
            <Setter Property="Opacity" Value="0.45" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">

            <Border Style="{StaticResource Panel}" Padding="0" ClipToBounds="True">
                <Grid Height="250">
                    <Grid.Background>
                        <RadialGradientBrush GradientOrigin="0.5,0.55" Center="0.5,0.55" RadiusX="0.85" RadiusY="0.85">
                            <GradientStop Color="{StaticResource SurfaceAltColor}" Offset="0" />
                            <GradientStop Color="{StaticResource BackgroundColor}" Offset="1" />
                        </RadialGradientBrush>
                    </Grid.Background>

                    <Canvas>
                        <Ellipse Style="{StaticResource Star}" Canvas.Left="40"  Canvas.Top="28" />
                        <Ellipse Style="{StaticResource Star}" Canvas.Left="132" Canvas.Top="64" />
                        <Ellipse Style="{StaticResource Star}" Canvas.Left="214" Canvas.Top="22" />
                        <Ellipse Style="{StaticResource Star}" Canvas.Left="322" Canvas.Top="92" />
                        <Ellipse Style="{StaticResource Star}" Canvas.Left="410" Canvas.Top="40" />
                        <Ellipse Style="{StaticResource Star}" Canvas.Left="502" Canvas.Top="16" />
                        <Ellipse Style="{StaticResource Star}" Canvas.Left="564" Canvas.Top="118" />
                        <Ellipse Style="{StaticResource Star}" Canvas.Left="92"  Canvas.Top="186" />
                        <Ellipse Style="{StaticResource Star}" Canvas.Left="252" Canvas.Top="206" />
                        <Ellipse Style="{StaticResource Star}" Canvas.Left="452" Canvas.Top="192" />
                        <Ellipse Style="{StaticResource Star}" Canvas.Left="624" Canvas.Top="62" />
                        <Ellipse Style="{StaticResource Star}" Canvas.Left="688" Canvas.Top="146" />
                    </Canvas>

                    <TextBlock Text="ULTRAESPACIO" Style="{StaticResource Muted}" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Top"
                               Margin="0,12,0,0" Opacity="0.5" />

                    <!-- Un portal por rareza. Cada uno se anima a sí mismo: un Storyboard dentro
                         de un Style no puede apuntar a otro elemento por nombre. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Margin="0,0,0,30">
                        <Ellipse Width="52" Height="52" Margin="16,0" Stroke="{StaticResource Tier1Brush}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Opacity" Value="0.35" />
                                    <Setter Property="StrokeThickness" Value="3" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LastTier}" Value="tier1">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         To="1" Duration="0:0:1.4" />
                                                        <DoubleAnimation Storyboard.TargetProperty="StrokeThickness"
                                                                         To="10" Duration="0:0:1.4" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         To="0.35" Duration="0:0:0.6" />
                                                        <DoubleAnimation Storyboard.TargetProperty="StrokeThickness"
                                                                         To="3" Duration="0:0:0.6" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Ellipse Width="52" Height="52" Margin="16,0" Stroke="{StaticResource Tier2Brush}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Opacity" Value="0.35" />
                                    <Setter Property="StrokeThickness" Value="3" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LastTier}" Value="tier2">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         To="1" Duration="0:0:1.4" />
                                                        <DoubleAnimation Storyboard.TargetProperty="StrokeThickness"
                                                                         To="10" Duration="0:0:1.4" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         To="0.35" Duration="0:0:0.6" />
                                                        <DoubleAnimation Storyboard.TargetProperty="StrokeThickness"
                                                                         To="3" Duration="0:0:0.6" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Ellipse Width="52" Height="52" Margin="16,0" Stroke="{StaticResource Tier3Brush}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Opacity" Value="0.35" />
                                    <Setter Property="StrokeThickness" Value="3" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LastTier}" Value="tier3">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         To="1" Duration="0:0:1.4" />
                                                        <DoubleAnimation Storyboard.TargetProperty="StrokeThickness"
                                                                         To="10" Duration="0:0:1.4" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         To="0.35" Duration="0:0:0.6" />
                                                        <DoubleAnimation Storyboard.TargetProperty="StrokeThickness"
                                                                         To="3" Duration="0:0:0.6" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Ellipse Width="52" Height="52" Margin="16,0" Stroke="{StaticResource Tier4Brush}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Opacity" Value="0.35" />
                                    <Setter Property="StrokeThickness" Value="3" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LastTier}" Value="tier4">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         To="1" Duration="0:0:1.4" />
                                                        <DoubleAnimation Storyboard.TargetProperty="StrokeThickness"
                                                                         To="10" Duration="0:0:1.4" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         To="0.35" Duration="0:0:0.6" />
                                                        <DoubleAnimation Storyboard.TargetProperty="StrokeThickness"
                                                                         To="3" Duration="0:0:0.6" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Ellipse Width="52" Height="52" Margin="16,0" Stroke="{StaticResource Tier5Brush}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Opacity" Value="0.35" />
                                    <Setter Property="StrokeThickness" Value="3" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LastTier}" Value="tier5">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         To="1" Duration="0:0:1.4" />
                                                        <DoubleAnimation Storyboard.TargetProperty="StrokeThickness"
                                                                         To="10" Duration="0:0:1.4" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         To="0.35" Duration="0:0:0.6" />
                                                        <DoubleAnimation Storyboard.TargetProperty="StrokeThickness"
                                                                         To="3" Duration="0:0:0.6" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </StackPanel>

                    <!-- La nave. Se anima a sí misma por el mismo motivo que los portales. -->
                    <Grid Width="64" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center"
                          Margin="0,0,0,30">
                        <Grid.RenderTransform>
                            <TranslateTransform X="-120" />
                        </Grid.RenderTransform>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Opacity" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRolling}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="1" Duration="0:0:0.25" />
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                        From="-120" To="740" Duration="0:0:2.4"
                                                        AccelerationRatio="0.3" DecelerationRatio="0.45" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="0" Duration="0:0:0.5" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Rectangle Height="3" VerticalAlignment="Center" RadiusX="2" RadiusY="2">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="{StaticResource BackgroundColor}" Offset="0" />
                                    <GradientStop Color="{StaticResource AccentColor}" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Ellipse Width="13" Height="13" HorizontalAlignment="Right"
                                 Fill="{StaticResource AccentBrush}" />
                    </Grid>

                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Center"
                            Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                            Padding="18,10" Margin="0,0,0,14" BorderThickness="1"
                            BorderBrush="{StaticResource AccentDimBrush}"
                            Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PanelHeading}" HorizontalAlignment="Center"
                                       FontSize="20" Text="{Binding LastPull.SpeciesName}" />
                            <TextBlock Style="{StaticResource Body}" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <Run Text="Nv." /><Run Text="{Binding LastPull.Level, Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{Binding LastPull.NatureName, Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{Binding LastPull.Ability, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Mono}" HorizontalAlignment="Center" Margin="0,4,0,0"
                                       FontSize="11"
                                       Text="{Binding LastPull.IvTotal, StringFormat='IV total {0} de 186'}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- BANNERS. La selección va al view model; la lista no decide nada. -->
            <ListBox ItemsSource="{Binding Banners}" SelectedItem="{Binding SelectedBanner}"
                     Background="Transparent" BorderThickness="0" Margin="0,14,0,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="4" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Card" Background="{StaticResource SurfaceBrush}"
                                            CornerRadius="6" BorderThickness="1" Padding="14"
                                            BorderBrush="{StaticResource SurfaceAltBrush}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush"
                                                    Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="Background"
                                                    Value="{StaticResource SurfaceAltBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource PanelHeading}" />
                            <TextBlock Text="{Binding Cost}" Style="{StaticResource Body}" Margin="0,2,0,6" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Odds}" Style="{StaticResource Mono}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button Content="TIRAR" Style="{StaticResource PrimaryButton}"
                        Command="{Binding RollCommand}" MinWidth="180" />
                <TextBlock Style="{StaticResource Body}" VerticalAlignment="Center" Margin="16,0,0,0"
                           Text="{Binding Balance, StringFormat='Saldo: {0} puntos'}" />
            </StackPanel>

            <TextBlock Text="{Binding Status}" Style="{StaticResource Body}" TextWrapping="Wrap"
                       Margin="0,14,0,0" />

            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0"
                       Text="Las probabilidades están a la vista y salen de Data/gacha.json. Cada tirada se calcula con la seed de la run y su número de tirada, así que cualquiera puede recomputarla y comprobar que salió lo que dice el historial. El Pokémon queda registrado en la run: todavía no se escribe dentro del juego." />

        </StackPanel>
    </ScrollViewer>
</UserControl>
