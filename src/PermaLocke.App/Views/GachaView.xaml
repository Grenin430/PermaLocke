<UserControl x:Class="PermaLocke.App.Views.GachaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PermaLocke.App.Converters"
             xmlns:views="clr-namespace:PermaLocke.App.Views"
             xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel">

    <!-- EL GACHA EN PÍXELES (§176). La máquina de cápsulas ya lo era (§171); ahora también lo que va encima y debajo:
         los portales de tier, la ficha de lo que ha salido, la lista de quién puede salir, lo que da cada prueba, los
         banners y el botón de tirar. Mismas órdenes que antes. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:ResourceKeyConverter x:Key="ResourceKey" />
        <conv:BallIconConverter x:Key="BallIcon" />

        <Style TargetType="ScrollBar" BasedOn="{StaticResource PxScrollBar}" />

        <!-- La escalera de rareza: un portal por tier de Data/gacha.json, con la ball en la que sale ese tier en la
             máquina. Se enciende el de la ball que hay en la alfombrilla, y se pulsa para ver quién puede salir. -->
        <DataTemplate x:Key="PortalTemplate">
            <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" AutomationProperties.Name="{Binding Name}"
                    Command="{Binding DataContext.ShowPoolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Button.Template>
                <Grid Margin="0,0,6,0" ToolTip="{Binding Name}" Background="Transparent">
                    <views:PixelPanel x:Name="Plate" Fill="{StaticResource PxWell}" IsSunken="True" HasShadow="False" />
                    <StackPanel Margin="8,6,10,8" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="Ball" Width="24" Height="24" Opacity="0.85" Margin="0,0,6,0" VerticalAlignment="Center"
                                   Source="{Binding BrushKey, Converter={StaticResource BallIcon}}"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </Image.RenderTransform>
                            </Image>
                            <pixel:PixelText x:Name="ChanceText" Text="{Binding Chance}" Scale="2" Tight="True" VerticalAlignment="Center"
                                             Shadow="{StaticResource PxShadow}"
                                             Colour="{Binding BrushKey, Converter={StaticResource ResourceKey}, ConverterParameter=color}" />
                            <pixel:PixelText x:Name="NoChance" Text="NO SALE" Scale="2" Tight="True"
                                             Colour="{StaticResource PxTextFaint}" Visibility="Collapsed" VerticalAlignment="Center" />
                        </StackPanel>
                        <pixel:PixelText x:Name="Label" Text="{Binding Range}" Scale="2" Tight="True" Margin="0,6,0,0"
                                         Colour="{StaticResource PxTextDim}" />
                    </StackPanel>
                </Grid>
            </Button>

            <DataTemplate.Triggers>
                <!-- Un tier que este banner no da: sin ball, para que «NO SALE» quepa en GRANDE. -->
                <DataTrigger Binding="{Binding Chance}" Value="">
                    <Setter TargetName="Ball" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="ChanceText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="NoChance" Property="Visibility" Value="Visible" />
                </DataTrigger>

                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter TargetName="Plate" Property="Fill" Value="{StaticResource PxFaceLift}" />
                </DataTrigger>

                <!-- Se queda encendido donde cayó la última tirada. -->
                <DataTrigger Binding="{Binding IsLanded}" Value="True">
                    <Setter TargetName="Ball" Property="Opacity" Value="1" />
                    <Setter TargetName="Label" Property="Opacity" Value="1" />
                    <Setter TargetName="Plate" Property="Fill" Value="{StaticResource PxAccentDeep}" />
                </DataTrigger>

                <!-- La ball de la alfombrilla: salta cuando la de verdad cambia. -->
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Ball" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.1" />
                                <DoubleAnimation Storyboard.TargetName="Ball"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="1.45" To="1.2" Duration="0:0:0.45">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut" Amplitude="0.8" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Ball"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="1.45" To="1.2" Duration="0:0:0.45">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut" Amplitude="0.8" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Label" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Ball"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.25" />
                                <DoubleAnimation Storyboard.TargetName="Ball"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.25" />
                                <DoubleAnimation Storyboard.TargetName="Ball" Storyboard.TargetProperty="Opacity"
                                                 Duration="0:0:0.25" />
                                <DoubleAnimation Storyboard.TargetName="Label" Storyboard.TargetProperty="Opacity"
                                                 Duration="0:0:0.25" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource PxSubtleButton}">
            <Setter Property="Padding" Value="10,5,16,10" />
        </Style>
    </UserControl.Resources>

    <!-- Rejilla, no una pila con barra de desplazamiento: el botón de TIRAR y los banners tienen que estar siempre a
         la vista, y la máquina se queda con lo que sobre. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="300" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <views:PixelPanel Fill="{StaticResource PxInk}" />
            <Border Margin="3,3,9,9" ClipToBounds="True">
                <!-- LA MÁQUINA DE CÁPSULAS (§171). Lo que se pulsa va encima: los portales, la ficha, el bote y la
                     tabla de premios. -->
                <Grid MinHeight="300" Background="{StaticResource SunkenBrush}">
                    <views:CapsuleMachine x:Name="Machine" Play="{Binding CurrentPlay}" />

                    <Grid x:Name="Stage">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>


                        <!-- LA FICHA, en la pared de la derecha, con el color de su tier arriba. -->
                        <Grid Grid.Row="2" Grid.RowSpan="3" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Width="286" Margin="0,0,20,0" RenderTransformOrigin="0.5,0.5"
                              Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasResult}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0" To="1" Duration="0:0:0.3" />
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                            From="0.86" To="1" Duration="0:0:0.35">
                                                            <DoubleAnimation.EasingFunction>
                                                                <BackEase EasingMode="EaseOut" Amplitude="0.5" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                            From="0.86" To="1" Duration="0:0:0.35">
                                                            <DoubleAnimation.EasingFunction>
                                                                <BackEase EasingMode="EaseOut" Amplitude="0.5" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <views:PixelPanel Fill="#FF16112A" HeaderHeight="15"
                                              HeaderFill="{Binding LastTierBrushKey, Converter={StaticResource ResourceKey}, ConverterParameter=color}" />

                            <StackPanel Margin="18,24,24,22">
                                <pixel:PixelText Text="{Binding LastTierName}" Scale="2" Tight="True"
                                                 Colour="{Binding LastTierBrushKey, Converter={StaticResource ResourceKey}, ConverterParameter=color}" />
                                <pixel:PixelText Text="{Binding LastPull.DisplayName}" Scale="3" Wrap="True" Margin="0,6,0,0"
                                                 Colour="{StaticResource PxText}" Shadow="{StaticResource PxShadow}" />
                                <!-- La marca de shiny o legendario late tres veces al aparecer. -->
                                <pixel:PixelText Text="{Binding LastBadge}" Scale="2" Tight="True" Margin="0,5,0,0"
                                                 Colour="{StaticResource PxGold}">
                                    <pixel:PixelText.Style>
                                        <Style TargetType="pixel:PixelText">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasBadge}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation BeginTime="0:0:0.3" From="0.25" To="1"
                                                                                 Duration="0:0:0.45" AutoReverse="True"
                                                                                 RepeatBehavior="3x"
                                                                                 Storyboard.TargetProperty="Opacity" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </pixel:PixelText.Style>
                                </pixel:PixelText>
                                <pixel:PixelText Text="{Binding LastPull.Ability}" Scale="2" Wrap="True" Margin="0,10,0,0"
                                                 Colour="{StaticResource PxText}" />
                            </StackPanel>
                        </Grid>


                        <!-- LO QUE DA CADA PRUEBA, de Data/grants.json. Lo conseguido se marca y no se quita. -->
                        <Grid Grid.Row="0" Grid.RowSpan="5" Margin="10"
                              Visibility="{Binding ShowingGrants, Converter={StaticResource BoolToVisibility}}">
                            <views:PixelPanel Fill="#F2100C1C" HeaderHeight="36" HeaderFill="{StaticResource PxFaceHigh}"
                                              HeaderAccent="{StaticResource PxAccent}" />
                            <DockPanel Margin="14,4,20,18">
                                <DockPanel DockPanel.Dock="Top" Height="34" Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Content="CERRAR" Style="{StaticResource SmallButton}"
                                            VerticalAlignment="Center" Margin="0,4,0,0" Command="{Binding ToggleGrantsCommand}" />
                                    <pixel:PixelIcon Icon="IconTrophy" Scale="2" VerticalAlignment="Center" Margin="0,0,9,0" />
                                    <pixel:PixelText Text="LO QUE DA CADA PRUEBA" Scale="2" Tight="True" VerticalAlignment="Center"
                                                     Colour="{StaticResource PxText}" Shadow="{StaticResource PxShadow}" />
                                </DockPanel>

                                <pixel:PixelText DockPanel.Dock="Top" Text="Se consiguen solos al superar cada prueba." Scale="2"
                                                 Tight="True" Margin="0,0,0,12" Colour="{StaticResource PxTextDim}" />

                                <pixel:PixelText DockPanel.Dock="Bottom" Text="{Binding GrantsSummary}" Scale="2" Wrap="True"
                                                 Margin="0,10,0,0" Colour="{StaticResource PxTextDim}" />

                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Grants}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid x:Name="Row" Margin="0,0,8,6">
                                                    <views:PixelPanel Fill="{StaticResource PxFace}" HasShadow="False" />
                                                    <DockPanel Margin="11,7,11,8">
                                                        <!-- Encendida cuando ya se consiguió, apagada cuando falta. -->
                                                        <views:PixelPanel x:Name="Dot" DockPanel.Dock="Left" Width="18" Height="18"
                                                                          Margin="0,0,10,0" VerticalAlignment="Center"
                                                                          Fill="{StaticResource PxWell}" IsSunken="True" HasShadow="False" />

                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ItemsControl ItemsSource="{Binding Rolls}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="4,0,0,0">
                                                                            <views:PixelPanel Fill="{StaticResource PxWell}" HasShadow="False" />
                                                                            <pixel:PixelText Text="{Binding Text}" Scale="2" Tight="True" Margin="7,4,8,5"
                                                                                             Colour="{Binding BrushKey, Converter={StaticResource ResourceKey}, ConverterParameter=color}" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <Grid Margin="4,0,0,0"
                                                                  Visibility="{Binding HasWonderTrades, Converter={StaticResource BoolToVisibility}}">
                                                                <views:PixelPanel Fill="{StaticResource PxWell}" HasShadow="False" />
                                                                <pixel:PixelText Text="{Binding WonderTradeText}" Scale="2" Tight="True"
                                                                                 Margin="7,4,8,5" Colour="{StaticResource PxTextDim}" />
                                                            </Grid>
                                                        </StackPanel>

                                                        <pixel:PixelText Text="{Binding Name}" Scale="2" Tight="True" Trim="True"
                                                                         VerticalAlignment="Center" Colour="{StaticResource PxText}" />
                                                    </DockPanel>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Reached}" Value="True">
                                                        <Setter TargetName="Dot" Property="Fill" Value="{StaticResource PxGood}" />
                                                        <Setter TargetName="Dot" Property="IsSunken" Value="False" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Reached}" Value="False">
                                                        <Setter TargetName="Row" Property="Opacity" Value="0.5" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- BANNERS. La selección va al view model; la lista no decide nada. -->
        <ListBox Grid.Row="1" ItemsSource="{Binding Banners}" SelectedItem="{Binding SelectedBanner}"
                 Background="Transparent" BorderThickness="0" Margin="0,10,0,0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Template>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                </ControlTemplate>
            </ListBox.Template>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0,0,10,0" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Grid Background="Transparent">
                                    <views:PixelPanel x:Name="Card" Fill="{StaticResource PxFace}" />
                                    <pixel:PixelText x:Name="Arrow" Text="▶" Scale="2" Tight="True" Visibility="Hidden"
                                                     Colour="{StaticResource PxGold}" VerticalAlignment="Top" Margin="-6,16,0,0" />
                                    <ContentPresenter Margin="14,8,20,13" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Card" Property="Fill" Value="{StaticResource PxFaceHigh}" />
                                    </Trigger>
                                    <!-- El banner elegido se enciende entero: es el que va a cobrar al pulsar TIRAR. -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Card" Property="Fill" Value="{StaticResource PxAccentDeep}" />
                                        <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <DockPanel>
                            <!-- La chapa dice lo que cuesta, y con tiradas gratis lo dice en verde. -->
                            <Grid DockPanel.Dock="Right">
                                <views:PixelPanel HasShadow="False">
                                    <views:PixelPanel.Style>
                                        <Style TargetType="views:PixelPanel">
                                            <Setter Property="Fill" Value="{StaticResource PxWell}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasFree}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource PxGoodDeep}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </views:PixelPanel.Style>
                                </views:PixelPanel>
                                <pixel:PixelText Text="{Binding Cost}" Scale="2" Tight="True" Margin="8,5,9,6">
                                    <pixel:PixelText.Style>
                                        <Style TargetType="pixel:PixelText">
                                            <Setter Property="Colour" Value="{StaticResource PxAccentLight}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasFree}" Value="True">
                                                    <Setter Property="Colour" Value="{StaticResource PxGood}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </pixel:PixelText.Style>
                                </pixel:PixelText>
                            </Grid>
                            <pixel:PixelText Text="{Binding Name}" Scale="3" Tight="True" VerticalAlignment="Center"
                                             Colour="{StaticResource PxText}" Shadow="{StaticResource PxShadow}" />
                        </DockPanel>
                        <!-- LA FORMA DEL BANNER, en los colores de los tiers, en su ranura hundida. Los tramos suman
                             cien unidades y el Viewbox los estira al ancho que haya. -->
                        <Grid Margin="0,8,0,0" ToolTip="{Binding Odds}">
                            <views:PixelPanel Fill="{StaticResource PxInk}" HasShadow="False" />
                            <Viewbox Stretch="Fill" Height="9" Margin="3">
                                <ItemsControl ItemsSource="{Binding Slices}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Rectangle Width="{Binding Width}" Height="9" ToolTip="{Binding Label}"
                                                       Fill="{Binding BrushKey, Converter={StaticResource ResourceKey}}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Viewbox>
                        </Grid>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- LA BARRA DE ABAJO, en una sola fila (2026-09-24): TIRAR, las probabilidades del banner elegido a lo ancho y,
             a la derecha, los puntos y lo que da cada prueba. Así la máquina se queda con el alto. -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <views:PixelPanel Fill="{StaticResource PxFace}" />
            <StackPanel Margin="12,10,18,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" VerticalAlignment="Center" Command="{Binding RollCommand}" Cursor="Hand" MinWidth="200">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid x:Name="Body" Background="Transparent">
                                    <views:PixelPanel x:Name="Plate" Fill="{StaticResource PxAccent}" />
                                    <StackPanel x:Name="Face" Margin="18,8,24,13" HorizontalAlignment="Center">
                                        <pixel:PixelText x:Name="Label" Text="{Binding RollLabel}" Scale="3" Tight="True"
                                                         HorizontalAlignment="Center" Colour="{StaticResource PxInk}" />
                                        <pixel:PixelText x:Name="Cost" Text="{Binding RollCost}" Scale="2" Tight="True"
                                                         HorizontalAlignment="Center" Margin="0,4,0,0" Colour="{StaticResource PxAccentDeep}" />
                                    </StackPanel>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Plate" Property="Fill" Value="{StaticResource PxAccentLight}" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Plate" Property="HasShadow" Value="False" />
                                        <Setter TargetName="Plate" Property="Margin" Value="6,6,0,0" />
                                        <Setter TargetName="Face" Property="RenderTransform">
                                            <Setter.Value>
                                                <TranslateTransform X="6" Y="6" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Plate" Property="Fill" Value="{StaticResource PxFaceLift}" />
                                        <Setter TargetName="Label" Property="Colour" Value="{StaticResource PxTextFaint}" />
                                        <Setter TargetName="Cost" Property="Colour" Value="{StaticResource PxTextFaint}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- LA ESCALERA DE RAREZA: cada tier con su ball, su probabilidad en este banner y la banda del total
                         base de la evolución final. Se pulsa para ver quién puede salir. -->
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Portals}" ItemTemplate="{StaticResource PortalTemplate}"
                                  Margin="12,0,4,0" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0">
                        <Grid HorizontalAlignment="Stretch">
                            <views:PixelPanel Fill="{StaticResource PxWell}" IsSunken="True" HasShadow="False" />
                            <StackPanel Orientation="Horizontal" Margin="10,7,12,8" HorizontalAlignment="Center">
                                <pixel:PixelIcon Icon="IconPoints" Scale="1" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <pixel:PixelText Text="{Binding Balance, StringFormat='{}{0} puntos'}" Scale="2" Tight="True"
                                                 VerticalAlignment="Center" Colour="{StaticResource PxAccentLight}" />
                            </StackPanel>
                        </Grid>
                        <Button Content="PREMIOS POR PRUEBA" Style="{StaticResource SmallButton}" Margin="0,8,0,0"
                                HorizontalAlignment="Stretch" Command="{Binding ToggleGrantsCommand}" />
                    </StackPanel>
                </Grid>

                <pixel:PixelText Text="{Binding Status}" Scale="2" Wrap="True" Margin="0,8,0,0"
                                 Colour="{StaticResource PxText}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="0" Grid.RowSpan="3" Visibility="{Binding ShowingPool, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.52*" />
                <ColumnDefinition Width="0.48*" />
            </Grid.ColumnDefinitions>
                    <!-- EL BOTE: quién puede salir de un tier, por familias. A la izquierda y de arriba abajo, encima de la
                         estantería y la máquina, dejando a la vista la alfombrilla con la ball y su ficha (2026-09-24). -->
                    <Grid Grid.Column="0" Margin="0,0,0,0">
                                <views:PixelPanel Fill="#F2100C1C" HeaderHeight="36" HeaderFill="{StaticResource PxFaceHigh}"
                                                  HeaderAccent="{Binding PoolBrushKey, Converter={StaticResource ResourceKey}, ConverterParameter=color}" />
                                <DockPanel Margin="14,4,20,18">
                                    <DockPanel DockPanel.Dock="Top" Height="34" Margin="0,0,0,12">
                                        <Button DockPanel.Dock="Right" Content="CERRAR" Style="{StaticResource SmallButton}"
                                                VerticalAlignment="Center" Margin="0,4,0,0"
                                                Command="{Binding ShowPoolCommand}" CommandParameter="{x:Null}" />
                                        <pixel:PixelText Text="{Binding PoolTitle}" Scale="2" Tight="True" VerticalAlignment="Center"
                                                         Shadow="{StaticResource PxShadow}"
                                                         Colour="{Binding PoolBrushKey, Converter={StaticResource ResourceKey}, ConverterParameter=color}" />
                                    </DockPanel>
            
                                    <!-- EL BUSCADOR. -->
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
            
                                        <TextBox Grid.Column="0" Style="{StaticResource PxTextBox}" Padding="12,8"
                                                 Tag="Buscar un Pokémon…"
                                                 Text="{Binding PoolSearch, UpdateSourceTrigger=PropertyChanged, Delay=120}" />
                                        <Button Grid.Column="1" Content="×" Margin="8,0,0,0" Style="{StaticResource SmallButton}"
                                                Command="{Binding ClearPoolSearchCommand}" ToolTip="Borrar la búsqueda" />
                                        <pixel:PixelText Grid.Column="2" Text="{Binding PoolCount}" Scale="2" Tight="True"
                                                         VerticalAlignment="Center" Margin="12,0,2,0" Colour="{StaticResource PxTextDim}" />
                                    </Grid>
            
                                    <!-- Qué etapa de cada familia te toca AHORA. -->
                                    <pixel:PixelText DockPanel.Dock="Bottom" Text="{Binding StageOdds}" Scale="2" Wrap="True"
                                                     Margin="0,10,0,0" Colour="{StaticResource PxTextDim}" />
            
                                    <pixel:PixelText DockPanel.Dock="Top" Text="Ninguna familia de este tier se llama así."
                                                     Scale="2" Tight="True" Margin="2,4,0,0" Colour="{StaticResource PxTextFaint}"
                                                     Visibility="{Binding PoolNothingFound, Converter={StaticResource BoolToVisibility}}" />
            
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding VisiblePool}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- LA FAMILIA ENTERA, no un Pokémon: el tier es la banda del FINAL de
                                                         la línea y lo que te dan es una de sus etapas. -->
                                                    <Grid x:Name="Cell" Margin="0,0,8,8" Background="Transparent">
                                                        <views:PixelPanel x:Name="CellPlate" Fill="{StaticResource PxFace}" HasShadow="False" />
                                                        <StackPanel Margin="10,8,10,10">
                                                            <ItemsControl ItemsSource="{Binding Stages}" HorizontalAlignment="Center">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <pixel:PixelText Text="▶" Scale="2" Tight="True"
                                                                                             VerticalAlignment="Center" Margin="2,0,2,16"
                                                                                             Colour="{StaticResource PxTextFaint}"
                                                                                             Visibility="{Binding Arrow, Converter={StaticResource BoolToVisibility}}" />
                                                                            <StackPanel Width="90">
                                                                                <Grid Height="52">
                                                                                    <pixel:PixelSprite Source="{Binding Sprite}" Scale="2" TrimEmpty="True"
                                                                                                       Outline="{StaticResource PxShadow}"
                                                                                                       HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                                                                                </Grid>
                                                                                <pixel:PixelText Text="{Binding Name}" Scale="2" Tight="True" Trim="True"
                                                                                                 HorizontalAlignment="Center" Margin="0,4,0,0"
                                                                                                 Colour="{StaticResource PxText}" />
                                                                                <pixel:PixelText Text="{Binding Total}" Scale="2" Tight="True"
                                                                                                 HorizontalAlignment="Center" Margin="0,3,0,0"
                                                                                                 Colour="{StaticResource PxTextFaint}" />
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
            
                                                            <!-- Los legendarios se dicen. -->
                                                            <Grid HorizontalAlignment="Center" Margin="0,6,0,0"
                                                                  Visibility="{Binding Legendary, Converter={StaticResource BoolToVisibility}}">
                                                                <views:PixelPanel Fill="{StaticResource PxAccentDeep}" HasShadow="False" />
                                                                <pixel:PixelText Text="LEGENDARIO" Scale="2" Tight="True" Margin="7,4,8,5"
                                                                                 Colour="{StaticResource PxAccentLight}" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <Trigger SourceName="Cell" Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="CellPlate" Property="Fill" Value="{StaticResource PxFaceLift}" />
                                                        </Trigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Grid>
        </Grid>
    </Grid>
</UserControl>
