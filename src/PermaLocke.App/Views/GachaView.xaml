<UserControl x:Class="PermaLocke.App.Views.GachaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PermaLocke.App.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:ResourceKeyConverter x:Key="ResourceKey" />

        <!-- Campo de estrellas: un mosaico que se repite y se desplaza. Sale más barato y más
             corto que sembrar elipses a mano, y no hay ningún asset de por medio. -->
        <DrawingBrush x:Key="StarfieldNear" TileMode="Tile" Viewport="0,0,180,130"
                      ViewportUnits="Absolute" Stretch="None">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="{StaticResource TextBrush}">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="18,22"  RadiusX="1.4" RadiusY="1.4" />
                            <EllipseGeometry Center="96,14"  RadiusX="1"   RadiusY="1" />
                            <EllipseGeometry Center="142,74" RadiusX="1.6" RadiusY="1.6" />
                            <EllipseGeometry Center="54,102" RadiusX="1.1" RadiusY="1.1" />
                            <EllipseGeometry Center="120,56" RadiusX="0.9" RadiusY="0.9" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <DrawingBrush x:Key="StarfieldFar" TileMode="Tile" Viewport="0,0,110,86"
                      ViewportUnits="Absolute" Stretch="None">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="{StaticResource TextBrush}">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="12,58" RadiusX="0.8" RadiusY="0.8" />
                            <EllipseGeometry Center="70,26" RadiusX="0.7" RadiusY="0.7" />
                            <EllipseGeometry Center="94,70" RadiusX="0.8" RadiusY="0.8" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- La escalera de rareza: un portal por tier de Data/gacha.json. Añadir o quitar un
             tier cambia la animación sin tocar el XAML. Cada plantilla tiene su propio ámbito de
             nombres, que es lo que permite animar sus hijos por nombre (ARCHITECTURE.md §29). -->
        <DataTemplate x:Key="PortalTemplate">
            <StackPanel Margin="12,0" VerticalAlignment="Center">
                <Grid Width="52" Height="52">
                    <Ellipse x:Name="Glow" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Offset="0"
                                              Color="{Binding BrushKey, Converter={StaticResource ResourceKey},
                                                              ConverterParameter=color, FallbackValue=White}" />
                                <GradientStop Offset="1" Color="#00000000" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.RenderTransform>
                            <ScaleTransform ScaleX="0.5" ScaleY="0.5" />
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <Ellipse x:Name="Pulse" Width="48" Height="48" StrokeThickness="1" Opacity="0.18"
                             Stroke="{Binding BrushKey, Converter={StaticResource ResourceKey}}" />

                    <Ellipse x:Name="Ring" Width="36" Height="36" StrokeThickness="2.5" Opacity="0.4"
                             Stroke="{Binding BrushKey, Converter={StaticResource ResourceKey}}"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>

                <TextBlock x:Name="Label" Text="{Binding Name}" Style="{StaticResource Mono}"
                           FontSize="9" HorizontalAlignment="Center" Opacity="0.3" Margin="0,2,0,0" />
            </StackPanel>

            <DataTemplate.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="Opacity"
                                             From="0.10" To="0.30" Duration="0:0:2.2"
                                             AutoReverse="True" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>

                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.35" />
                                <DoubleAnimation Storyboard.TargetName="Ring"
                                                 Storyboard.TargetProperty="StrokeThickness"
                                                 To="6" Duration="0:0:0.35" />
                                <DoubleAnimation Storyboard.TargetName="Ring"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.2" Duration="0:0:1.2" AutoReverse="True"
                                                 RepeatBehavior="Forever" />
                                <DoubleAnimation Storyboard.TargetName="Ring"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.2" Duration="0:0:1.2" AutoReverse="True"
                                                 RepeatBehavior="Forever" />
                                <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                                 From="0.85" To="0.25" Duration="0:0:0.9" />
                                <DoubleAnimation Storyboard.TargetName="Glow"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="0.4" To="1.5" Duration="0:0:0.6" />
                                <DoubleAnimation Storyboard.TargetName="Glow"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.4" To="1.5" Duration="0:0:0.6" />
                                <DoubleAnimation Storyboard.TargetName="Label" Storyboard.TargetProperty="Opacity"
                                                 To="0.9" Duration="0:0:0.3" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity"
                                                 To="0.4" Duration="0:0:0.3" />
                                <DoubleAnimation Storyboard.TargetName="Ring"
                                                 Storyboard.TargetProperty="StrokeThickness"
                                                 To="2.5" Duration="0:0:0.3" />
                                <DoubleAnimation Storyboard.TargetName="Ring"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.3" />
                                <DoubleAnimation Storyboard.TargetName="Ring"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.3" />
                                <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.3" />
                                <DoubleAnimation Storyboard.TargetName="Label" Storyboard.TargetProperty="Opacity"
                                                 To="0.3" Duration="0:0:0.3" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Una celda de la ruleta. Todo pasa volando a color: no son candidatos, y la pantalla
             lo dice por escrito, porque la tirada ya estaba decidida antes de girar. -->
        <DataTemplate x:Key="ReelCellTemplate">
            <Grid Width="72" Height="104">
                <Image x:Name="Sprite" Source="{Binding Sprite}" Width="56" Height="56"
                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor"
                       Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                    </Image.RenderTransform>
                </Image>

                <!-- Especies cuyo icono no se sabe localizar todavía: se dice, no se inventa. -->
                <TextBlock x:Name="Unknown" Text="?" FontSize="34" FontWeight="Bold" Opacity="0"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource TextBrush}" />
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasSprite}" Value="False">
                    <Setter TargetName="Unknown" Property="Opacity" Value="0.55" />
                </DataTrigger>

                <!-- El que ha tocado: crece y se queda. -->
                <DataTrigger Binding="{Binding IsRevealed}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Sprite"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.3" Duration="0:0:0.5">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Sprite"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.3" Duration="0:0:0.5">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>

                <!-- Los demás siguen a color, solo bajan la voz. -->
                <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Sprite" Storyboard.TargetProperty="Opacity"
                                                 To="0.42" Duration="0:0:0.4" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">

            <Border Style="{StaticResource Panel}" Padding="0" ClipToBounds="True">
                <!-- Dos capas: el fondo va aparte del contenido a propósito. Metido en el mismo
                     Grid de filas, un rectángulo con RowSpan infla las filas Auto y descoloca
                     todo lo demás. -->
                <Grid Height="392">
                    <Grid.Background>
                        <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
                            <GradientStop Color="{StaticResource SurfaceAltColor}" Offset="0" />
                            <GradientStop Color="{StaticResource BackgroundColor}" Offset="1" />
                        </RadialGradientBrush>
                    </Grid.Background>

                    <!-- Dos capas de estrellas a distinta velocidad: el paralaje da profundidad
                         sin dibujar nada. Se mueve el rectángulo, no el mosaico: animar un pincel
                         de un diccionario de recursos falla porque WPF los congela. -->
                    <Rectangle Fill="{StaticResource StarfieldFar}" Opacity="0.3"
                               Width="1000" HorizontalAlignment="Left" IsHitTestVisible="False">
                        <Rectangle.RenderTransform>
                            <TranslateTransform X="0" />
                        </Rectangle.RenderTransform>
                        <Rectangle.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                            From="0" To="-110" Duration="0:0:24" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Rectangle.Triggers>
                    </Rectangle>

                    <Rectangle Fill="{StaticResource StarfieldNear}" Opacity="0.45"
                               Width="1000" HorizontalAlignment="Left" IsHitTestVisible="False">
                        <Rectangle.RenderTransform>
                            <TranslateTransform X="0" />
                        </Rectangle.RenderTransform>
                        <Rectangle.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                            From="0" To="-180" Duration="0:0:13" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Rectangle.Triggers>
                    </Rectangle>

                    <!-- Fogonazo del color del tier. Lo dispara el code-behind: en cada subida
                         del engaño y otra vez al parar la rueda. -->
                    <Rectangle x:Name="Flash" Opacity="0" IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.75" RadiusY="0.95">
                                <GradientStop Offset="0"
                                              Color="{Binding LastTierBrushKey, Converter={StaticResource ResourceKey},
                                                              ConverterParameter=color, FallbackValue=White}" />
                                <GradientStop Offset="1" Color="#00000000" />
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="ULTRAESPACIO" Style="{StaticResource Muted}" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,10,0,4" Opacity="0.5" />

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Portals}"
                                  ItemTemplate="{StaticResource PortalTemplate}"
                                  HorizontalAlignment="Center" Margin="0,0,0,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- LA RULETA. El desplazamiento, el frenado y el desenfoque los monta el
                         code-behind, que es el único que sabe el ancho real del visor. -->
                    <Border x:Name="ReelViewport" Grid.Row="2" Height="104" Margin="14,0" CornerRadius="3"
                            ClipToBounds="True" Background="#22000000" BorderThickness="1"
                            BorderBrush="{StaticResource SurfaceAltBrush}">
                        <Grid>
                            <!-- Dentro de un Canvas a propósito: en un Grid, WPF le recorta el
                                 ancho al del visor, y entonces la tira entera se sale de vista en
                                 cuanto se desplaza. El Canvas mide a sus hijos con espacio
                                 infinito, que es lo que una tira de 46 celdas necesita. -->
                            <Canvas IsHitTestVisible="False">
                                <ItemsControl x:Name="ReelStrip" ItemsSource="{Binding Reel}"
                                              ItemTemplate="{StaticResource ReelCellTemplate}"
                                              Canvas.Left="0" Canvas.Top="0">
                                    <ItemsControl.RenderTransform>
                                        <TranslateTransform X="0" />
                                    </ItemsControl.RenderTransform>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </Canvas>

                            <!-- Los bordes se funden con el fondo, para que las siluetas entren
                                 y salgan en vez de aparecer cortadas. -->
                            <Rectangle IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="{StaticResource BackgroundColor}" Offset="0" />
                                        <GradientStop Color="#00000000" Offset="0.22" />
                                        <GradientStop Color="#00000000" Offset="0.78" />
                                        <GradientStop Color="{StaticResource BackgroundColor}" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <!-- El marcador: enmarca la celda que va a quedarse, y lleva el color
                                 del tier que la pantalla está enseñando en cada momento. -->
                            <Grid x:Name="Marker" Width="76" HorizontalAlignment="Center"
                                  IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </Grid.RenderTransform>
                                <!-- Solo el contorno: cualquier relleno aquí taparía el icono, que
                                     es justo lo que se ha venido a ver. -->
                                <Rectangle Stroke="{Binding LastTierBrushKey, Converter={StaticResource ResourceKey}}"
                                           StrokeThickness="2" RadiusX="3" RadiusY="3" Opacity="0.9" />
                                <Path Data="M 0,0 L 12,0 L 6,8 Z" VerticalAlignment="Top" HorizontalAlignment="Center"
                                      Margin="0,-1,0,0"
                                      Fill="{Binding LastTierBrushKey, Converter={StaticResource ResourceKey}}" />
                                <Path Data="M 0,8 L 12,8 L 6,0 Z" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                      Margin="0,0,0,-1"
                                      Fill="{Binding LastTierBrushKey, Converter={StaticResource ResourceKey}}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Resultado. Entra con su propia animación; los datos ya estaban decididos
                         y guardados antes de que la rueda empezase a girar. -->
                    <Border Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                            Padding="20,8" Margin="0,6,0,8" BorderThickness="1"
                            RenderTransformOrigin="0.5,0.5"
                            BorderBrush="{Binding LastTierBrushKey, Converter={StaticResource ResourceKey}}"
                            Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasResult}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0" To="1" Duration="0:0:0.4" />
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                        From="0.88" To="1" Duration="0:0:0.4" />
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                        From="0.88" To="1" Duration="0:0:0.4" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <!-- Sin icono aquí: el sprite ya lo enseña la ruleta, grande y a color, y
                             repetirlo dos veces en la misma pantalla no aporta nada. -->
                        <StackPanel>
                            <TextBlock Style="{StaticResource Mono}" HorizontalAlignment="Center" FontSize="10"
                                       Opacity="0.75" Text="{Binding LastTierName}"
                                       Foreground="{Binding LastTierBrushKey, Converter={StaticResource ResourceKey}}" />
                            <TextBlock Style="{StaticResource PanelHeading}" HorizontalAlignment="Center"
                                       FontSize="21" Margin="0,1,0,0" Text="{Binding LastPull.SpeciesName}" />
                            <TextBlock HorizontalAlignment="Center" FontSize="10" Margin="0,1,0,0"
                                       Text="{Binding LastBadge}" Foreground="{StaticResource AccentBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Mono}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LastBadge}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Style="{StaticResource Body}" HorizontalAlignment="Center" Margin="0,3,0,0">
                                <Run Text="Nv." /><Run Text="{Binding LastPull.Level, Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{Binding LastPull.NatureName, Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{Binding LastPull.Ability, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Mono}" HorizontalAlignment="Center" Margin="0,2,0,0"
                                       FontSize="11"
                                       Text="{Binding LastPull.IvTotal, StringFormat='IV total {0} de 186'}" />
                        </StackPanel>
                    </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- BANNERS. La selección va al view model; la lista no decide nada. -->
            <ListBox ItemsSource="{Binding Banners}" SelectedItem="{Binding SelectedBanner}"
                     Background="Transparent" BorderThickness="0" Margin="0,14,0,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="4" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Card" Background="{StaticResource SurfaceBrush}"
                                            CornerRadius="6" BorderThickness="1" Padding="14"
                                            BorderBrush="{StaticResource SurfaceAltBrush}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush"
                                                    Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="Background"
                                                    Value="{StaticResource SurfaceAltBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource PanelHeading}" />
                            <TextBlock Text="{Binding Cost}" Style="{StaticResource Body}" Margin="0,2,0,6" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Odds}" Style="{StaticResource Mono}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button Content="TIRAR" Style="{StaticResource PrimaryButton}"
                        Command="{Binding RollCommand}" MinWidth="180" />
                <TextBlock Style="{StaticResource Body}" VerticalAlignment="Center" Margin="16,0,0,0"
                           Text="{Binding Balance, StringFormat='Saldo: {0} puntos'}" />
            </StackPanel>

            <TextBlock Text="{Binding Status}" Style="{StaticResource Body}" TextWrapping="Wrap"
                       Margin="0,14,0,0" />

            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0"
                       Text="Las probabilidades están a la vista y salen de Data/gacha.json. Cada tirada se calcula con la seed de la run y su número de tirada, así que cualquiera puede recomputarla y comprobar que salió lo que dice el historial. La ruleta es presentación: el Pokémon ya está decidido, guardado y entregado antes de que empiece a girar, y las siluetas que pasan no son candidatas. El Pokémon se entrega al PC del juego escribiendo en la partida, lo que exige tener el juego cerrado; si no se puede, la línea de estado dice por qué." />

        </StackPanel>
    </ScrollViewer>
</UserControl>
