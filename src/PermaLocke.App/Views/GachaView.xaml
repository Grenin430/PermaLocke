<UserControl x:Class="PermaLocke.App.Views.GachaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PermaLocke.App.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:ResourceKeyConverter x:Key="ResourceKey" />

        <!-- Campo de estrellas: un mosaico que se repite y se desplaza. Sale más barato y más
             corto que sembrar elipses a mano, y no hay ningún asset de por medio. -->
        <DrawingBrush x:Key="StarfieldNear" TileMode="Tile" Viewport="0,0,180,130"
                      ViewportUnits="Absolute" Stretch="None">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="{StaticResource TextBrush}">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="18,22"  RadiusX="1.4" RadiusY="1.4" />
                            <EllipseGeometry Center="96,14"  RadiusX="1"   RadiusY="1" />
                            <EllipseGeometry Center="142,74" RadiusX="1.6" RadiusY="1.6" />
                            <EllipseGeometry Center="54,102" RadiusX="1.1" RadiusY="1.1" />
                            <EllipseGeometry Center="120,56" RadiusX="0.9" RadiusY="0.9" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <DrawingBrush x:Key="StarfieldFar" TileMode="Tile" Viewport="0,0,110,86"
                      ViewportUnits="Absolute" Stretch="None">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="{StaticResource TextBrush}">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="12,58" RadiusX="0.8" RadiusY="0.8" />
                            <EllipseGeometry Center="70,26" RadiusX="0.7" RadiusY="0.7" />
                            <EllipseGeometry Center="94,70" RadiusX="0.8" RadiusY="0.8" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- Rayas de velocidad. Solo se encienden durante el crucero de la ruleta y se apagan al
             frenar, así que la pantalla dice a qué velocidad va sin necesidad de leer nada. -->
        <DrawingBrush x:Key="Hyperstreaks" TileMode="Tile" Viewport="0,0,320,124"
                      ViewportUnits="Absolute" Stretch="None">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="{StaticResource TextBrush}">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,16,96,1" />
                            <RectangleGeometry Rect="146,40,62,1" />
                            <RectangleGeometry Rect="40,68,124,1" />
                            <RectangleGeometry Rect="212,94,74,1" />
                            <RectangleGeometry Rect="256,24,52,1" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- La escalera de rareza: un portal por tier de Data/gacha.json. Añadir o quitar un
             tier cambia la animación sin tocar el XAML. Cada plantilla tiene su propio ámbito de
             nombres, que es lo que permite animar sus hijos por nombre (ARCHITECTURE.md §29). -->
        <DataTemplate x:Key="PortalTemplate">
            <StackPanel Margin="12,0" VerticalAlignment="Center">
                <Grid Width="52" Height="52">
                    <Ellipse x:Name="Glow" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Offset="0"
                                              Color="{Binding BrushKey, Converter={StaticResource ResourceKey},
                                                              ConverterParameter=color, FallbackValue=White}" />
                                <GradientStop Offset="1" Color="#00000000" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.RenderTransform>
                            <ScaleTransform ScaleX="0.5" ScaleY="0.5" />
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <Ellipse x:Name="Pulse" Width="48" Height="48" StrokeThickness="1" Opacity="0.18"
                             Stroke="{Binding BrushKey, Converter={StaticResource ResourceKey}}" />

                    <Ellipse x:Name="Ring" Width="36" Height="36" StrokeThickness="2.5" Opacity="0.4"
                             Stroke="{Binding BrushKey, Converter={StaticResource ResourceKey}}"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>

                <TextBlock x:Name="Label" Text="{Binding Name}" Style="{StaticResource Mono}"
                           FontSize="9" HorizontalAlignment="Center" Opacity="0.3" Margin="0,2,0,0" />

                <!-- La probabilidad en el banner elegido y la banda de estadisticas base. Estaban
                     repartidas entre la tarjeta del banner y cinco chapas al pie de la pantalla, en
                     tres idiomas visuales distintos; aqui van sobre la cosa que YA es el tier. -->
                <TextBlock x:Name="Chance" Text="{Binding Chance}" Style="{StaticResource Mono}"
                           FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"
                           Foreground="{Binding BrushKey, Converter={StaticResource ResourceKey}}"
                           Opacity="0.85" />

                <TextBlock Text="{Binding Range}" Style="{StaticResource Mono}"
                           FontSize="9" HorizontalAlignment="Center" Opacity="0.35" />
            </StackPanel>

            <DataTemplate.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="Opacity"
                                             From="0.10" To="0.30" Duration="0:0:2.2"
                                             AutoReverse="True" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>

                <!-- Se queda encendido donde cayo la ultima tirada, hasta la siguiente. Es lo que
                     une la animacion con la escalera de rareza: de un vistazo, en que peldaño. -->
                <DataTrigger Binding="{Binding IsLanded}" Value="True">
                    <Setter TargetName="Ring" Property="Opacity" Value="1" />
                    <Setter TargetName="Ring" Property="StrokeThickness" Value="3.5" />
                    <Setter TargetName="Label" Property="Opacity" Value="0.9" />
                    <Setter TargetName="Glow" Property="Opacity" Value="0.30" />
                </DataTrigger>

                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.35" />
                                <DoubleAnimation Storyboard.TargetName="Ring"
                                                 Storyboard.TargetProperty="StrokeThickness"
                                                 To="6" Duration="0:0:0.35" />
                                <DoubleAnimation Storyboard.TargetName="Ring"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.2" Duration="0:0:1.2" AutoReverse="True"
                                                 RepeatBehavior="Forever" />
                                <DoubleAnimation Storyboard.TargetName="Ring"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.2" Duration="0:0:1.2" AutoReverse="True"
                                                 RepeatBehavior="Forever" />
                                <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                                 From="0.85" To="0.25" Duration="0:0:0.9" />
                                <DoubleAnimation Storyboard.TargetName="Glow"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="0.4" To="1.5" Duration="0:0:0.6" />
                                <DoubleAnimation Storyboard.TargetName="Glow"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.4" To="1.5" Duration="0:0:0.6" />
                                <DoubleAnimation Storyboard.TargetName="Label" Storyboard.TargetProperty="Opacity"
                                                 To="0.9" Duration="0:0:0.3" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity"
                                                 To="0.4" Duration="0:0:0.3" />
                                <DoubleAnimation Storyboard.TargetName="Ring"
                                                 Storyboard.TargetProperty="StrokeThickness"
                                                 To="2.5" Duration="0:0:0.3" />
                                <DoubleAnimation Storyboard.TargetName="Ring"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.3" />
                                <DoubleAnimation Storyboard.TargetName="Ring"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.3" />
                                <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.3" />
                                <DoubleAnimation Storyboard.TargetName="Label" Storyboard.TargetProperty="Opacity"
                                                 To="0.3" Duration="0:0:0.3" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Una celda de la ruleta. Todo pasa volando a color: no son candidatos, y la pantalla
             lo dice por escrito, porque la tirada ya estaba decidida antes de girar. -->
        <DataTemplate x:Key="ReelCellTemplate">
            <Grid Width="72" Height="104">
                <Image x:Name="Sprite" Source="{Binding Sprite}" Width="56" Height="56"
                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor"
                       Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                    </Image.RenderTransform>
                </Image>

                <!-- Especies cuyo icono no se sabe localizar todavía: se dice, no se inventa. -->
                <TextBlock x:Name="Unknown" Text="?" FontSize="34" FontWeight="Bold" Opacity="0"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource TextBrush}" />
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasSprite}" Value="False">
                    <Setter TargetName="Unknown" Property="Opacity" Value="0.55" />
                </DataTrigger>

                <!-- El que ha tocado: crece y se queda. -->
                <DataTrigger Binding="{Binding IsRevealed}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Sprite"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.3" Duration="0:0:0.5">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Sprite"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.3" Duration="0:0:0.5">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>

                <!-- Los demás siguen a color, solo bajan la voz. -->
                <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Sprite" Storyboard.TargetProperty="Opacity"
                                                 To="0.42" Duration="0:0:0.4" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Rejilla, no una pila con barra de desplazamiento: el botón de TIRAR y los banners tienen
         que estar siempre a la vista, y el escenario del ultraespacio se queda con lo que sobre. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="300" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Inset}" Padding="0" ClipToBounds="True">
                <!-- Dos capas: el fondo va aparte del contenido a propósito. Metido en el mismo
                     Grid de filas, un rectángulo con RowSpan infla las filas Auto y descoloca
                     todo lo demás. -->
                <Grid MinHeight="300">
                    <Grid.Background>
                        <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
                            <GradientStop Color="{StaticResource SurfaceAltColor}" Offset="0" />
                            <GradientStop Color="{StaticResource BackgroundColor}" Offset="1" />
                        </RadialGradientBrush>
                    </Grid.Background>

                    <!-- El color del tier, lavado sobre el fondo. El pincel se crea en el
                         code-behind y no aquí: WPF congela los que vienen de XAML compartido y un
                         pincel congelado no se puede animar. -->
                    <Rectangle x:Name="TierWash" Opacity="0" IsHitTestVisible="False" />

                    <!-- EL TÚNEL.
 Las estrellas salen del centro y crecen hacia fuera, en vez de
                         deslizarse de lado como antes: el deslizamiento lateral se lee como papel
                         pintado pasando por detrás, y el ultraespacio es un sitio al que ENTRAS.
                         Es el mismo mosaico y el mismo coste; lo que cambia es qué se anima.

                         Dos capas desfasadas media vuelta, que es lo que evita el latido: con una
                         sola, cada vez que reinicia el ciclo el campo parpadea entero. El
                         code-behind las acelera durante el giro por su SpeedRatio, así que no hace
                         falta reiniciar nada y no dan tirones. -->
                    <Rectangle x:Name="StarsNear" Fill="{StaticResource StarfieldNear}" Opacity="0"
                               IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                        <Rectangle.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Rectangle.RenderTransform>
                    </Rectangle>

                    <Rectangle x:Name="StarsFar" Fill="{StaticResource StarfieldFar}" Opacity="0"
                               IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                        <Rectangle.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Rectangle.RenderTransform>
                    </Rectangle>

                    <!-- EL VÓRTICE, detrás de todo. Sin él el panel es un campo uniforme y la
                         ruleta flota encima sin estar en ninguna parte; con él hay un fondo del
                         que la tirada sale. Gira muy despacio y va muy apagado a propósito: es
                         escenografía, no un elemento que compita con el visor. -->
                    <Grid x:Name="Vortex" Width="520" Height="520" Opacity="0.16"
                          IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="VortexScale" ScaleX="1" ScaleY="1" />
                                <RotateTransform x:Name="VortexSpin" Angle="0" />
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <Ellipse Width="520" Height="520" StrokeThickness="1.5"
                                 Stroke="{StaticResource AccentBrush}" Opacity="0.30" />
                        <Ellipse Width="400" Height="400" StrokeThickness="1.5"
                                 Stroke="{StaticResource AccentBrush}" Opacity="0.45" />
                        <Ellipse Width="280" Height="280" StrokeThickness="2"
                                 Stroke="{StaticResource AccentBrightBrush}" Opacity="0.55" />
                        <Ellipse Width="160" Height="160" StrokeThickness="2"
                                 Stroke="{StaticResource AccentBrightBrush}" Opacity="0.75" />

                        <!-- Cuatro radios: son los que hacen que el giro se vea. Con aros solos,
                             un círculo girando es un círculo quieto. -->
                        <Path Stroke="{StaticResource AccentBrush}" StrokeThickness="1" Opacity="0.35"
                              Data="M 260,0 L 260,520 M 0,260 L 520,260 M 84,84 L 436,436 M 436,84 L 84,436" />
                    </Grid>

                    <!-- Rayas de velocidad
. Corren siempre, pero con opacidad 0: el code-behind
                         solo las enciende mientras la rueda va lanzada. -->
                    <Rectangle x:Name="Streaks" Fill="{StaticResource Hyperstreaks}" Opacity="0"
                               Width="1400" HorizontalAlignment="Left" IsHitTestVisible="False">
                        <Rectangle.RenderTransform>
                            <TranslateTransform X="0" />
                        </Rectangle.RenderTransform>
                        <Rectangle.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                            From="0" To="-320" Duration="0:0:0.5" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Rectangle.Triggers>
                    </Rectangle>

                    <!-- Fogonazo del color del tier. Lo dispara el code-behind: en cada subida
                         del engaño y otra vez al parar la rueda. -->
                    <Rectangle x:Name="Flash" Opacity="0" IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.75" RadiusY="0.95">
                                <GradientStop Offset="0"
                                              Color="{Binding LastTierBrushKey, Converter={StaticResource ResourceKey},
                                                              ConverterParameter=color, FallbackValue=White}" />
                                <GradientStop Offset="1" Color="#00000000" />
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Todo el contenido va sobre este Grid porque el code-behind lo sacude: al
                         subir un tier y al parar la rueda. Sacudir el fondo también movería las
                         estrellas, que es justo lo que da la sensación de que están quietas. -->
                    <Grid x:Name="Stage">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="StageShake" X="0" Y="0" />
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Portals}"
                                  ItemTemplate="{StaticResource PortalTemplate}"
                                  HorizontalAlignment="Center" Margin="0,14,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- LA RULETA. El desplazamiento, el frenado y el desenfoque los monta el
                         code-behind, que es el único que sabe el ancho real del visor.
                         El acercamiento y el tirón de cada clic van en este envoltorio, no en el
                         visor, para que la onda y el destello los acompañen sin recortarse. -->
                    <!-- Altura fijada a la del visor a propósito. La fila es Auto, así que sin
                         esto la ráfaga de 300 px la infla hasta 300 y la fila del resultado se
                         queda sin sitio: la ficha desaparece sin que nada falle ni se registre.
                         Con la altura puesta, la ráfaga sigue dibujándose fuera —este Grid no
                         recorta— y solo la recorta el panel, que es lo que se quiere. -->
                    <Grid x:Name="ReelStage" Grid.Row="2" Height="104" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ReelZoom" ScaleX="1" ScaleY="1" />
                                <TranslateTransform x:Name="ReelJolt" X="0" Y="0" />
                            </TransformGroup>
                        </Grid.RenderTransform>

                    <Border x:Name="ReelViewport" Height="104" Margin="14,0" CornerRadius="3"
                            ClipToBounds="True" Background="{StaticResource SunkenBrush}" BorderThickness="1"
                            BorderBrush="{StaticResource SurfaceAltBrush}">
                        <Grid>
                            <!-- Dentro de un Canvas a propósito: en un Grid, WPF le recorta el
                                 ancho al del visor, y entonces la tira entera se sale de vista en
                                 cuanto se desplaza. El Canvas mide a sus hijos con espacio
                                 infinito, que es lo que una tira de 46 celdas necesita. -->
                            <Canvas IsHitTestVisible="False">
                                <ItemsControl x:Name="ReelStrip" ItemsSource="{Binding Reel}"
                                              ItemTemplate="{StaticResource ReelCellTemplate}"
                                              Canvas.Left="0" Canvas.Top="0">
                                    <ItemsControl.RenderTransform>
                                        <TranslateTransform X="0" />
                                    </ItemsControl.RenderTransform>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </Canvas>

                            <!-- Los bordes se funden con el fondo, para que las siluetas entren
                                 y salgan en vez de aparecer cortadas. -->
                            <Rectangle IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="{StaticResource BackgroundColor}" Offset="0" />
                                        <GradientStop Color="#00000000" Offset="0.22" />
                                        <GradientStop Color="#00000000" Offset="0.78" />
                                        <GradientStop Color="{StaticResource BackgroundColor}" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <!-- El marcador: enmarca la celda que va a quedarse, y lleva el color
                                 del tier que la pantalla está enseñando en cada momento. -->
                            <Grid x:Name="Marker" Width="76" HorizontalAlignment="Center"
                                  IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </Grid.RenderTransform>
                                <!-- Solo el contorno: cualquier relleno aquí taparía el icono, que
                                     es justo lo que se ha venido a ver. -->
                                <Rectangle Stroke="{Binding LastTierBrushKey, Converter={StaticResource ResourceKey}}"
                                           StrokeThickness="2" RadiusX="3" RadiusY="3" Opacity="0.9" />
                                <Path Data="M 0,0 L 12,0 L 6,8 Z" VerticalAlignment="Top" HorizontalAlignment="Center"
                                      Margin="0,-1,0,0"
                                      Fill="{Binding LastTierBrushKey, Converter={StaticResource ResourceKey}}" />
                                <Path Data="M 0,8 L 12,8 L 6,0 Z" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                      Margin="0,0,0,-1"
                                      Fill="{Binding LastTierBrushKey, Converter={StaticResource ResourceKey}}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- La onda de choque. Fuera del visor a propósito: dentro la recortaría el
                         ClipToBounds que la ruleta necesita. -->
                    <Ellipse x:Name="Shockwave" Width="150" Height="150" Opacity="0"
                             IsHitTestVisible="False" StrokeThickness="4"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             RenderTransformOrigin="0.5,0.5"
                             Stroke="{Binding LastTierBrushKey, Converter={StaticResource ResourceKey}}">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="ShockwaveScale" ScaleX="0.2" ScaleY="0.2" />
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <!-- El destello del premio: ocho rayos y un aro de luz alrededor de la casilla
                         que ha tocado. El centro va hueco a propósito —los rayos arrancan más
                         afuera que la celda— porque lo que se ha venido a ver es el Pokémon, y una
                         estrella maciza encima lo tapaba. Como el marcador está centrado, esto
                         también. -->
                    <Grid x:Name="Burst" Width="300" Height="300" Opacity="0" IsHitTestVisible="False"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="BurstSpin" Angle="0" />
                                <ScaleTransform x:Name="BurstScale" ScaleX="0.55" ScaleY="0.55" />
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <Ellipse Width="300" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Offset="0" Color="#00000000" />
                                    <GradientStop Offset="0.34" Color="#00000000" />
                                    <GradientStop Offset="0.55"
                                                  Color="{Binding LastTierBrushKey, Converter={StaticResource ResourceKey},
                                                                  ConverterParameter=color, FallbackValue=White}" />
                                    <GradientStop Offset="1" Color="#00000000" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <Path HorizontalAlignment="Center" VerticalAlignment="Center"
                              Fill="{Binding LastTierBrushKey, Converter={StaticResource ResourceKey}}"
                              Data="M -5,-58 L 5,-58 L 0,-124 Z
                                    M 5,58 L -5,58 L 0,124 Z
                                    M 58,-5 L 58,5 L 124,0 Z
                                    M -58,5 L -58,-5 L -124,0 Z
                                    M 37,-45 L 45,-37 L 88,-88 Z
                                    M 45,37 L 37,45 L 88,88 Z
                                    M -37,45 L -45,37 L -88,88 Z
                                    M -45,-37 L -37,-45 L -88,-88 Z" />
                    </Grid>
                    </Grid>

                    <!-- Resultado. Entra con su propia animación; los datos ya estaban decididos
                         y guardados antes de que la rueda empezase a girar. -->
                    <Border Grid.Row="3" VerticalAlignment="Top" HorizontalAlignment="Center"
                            Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                            Padding="20,8" Margin="0,6,0,8" BorderThickness="1"
                            RenderTransformOrigin="0.5,0.5"
                            BorderBrush="{Binding LastTierBrushKey, Converter={StaticResource ResourceKey}}"
                            Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasResult}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0" To="1" Duration="0:0:0.4" />
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                        From="0.88" To="1" Duration="0:0:0.4" />
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                        From="0.88" To="1" Duration="0:0:0.4" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <!-- CON icono, y es una correccion. Antes no lo llevaba «porque ya lo
                             enseña la ruleta», y eso vale mientras la ruleta gira: parada, la
                             casilla ganadora mide 56 px dentro de una banda de 104 y compite con
                             las de al lado. La ficha es donde se mira al final, asi que es donde
                             el Pokemon tiene que verse. -->
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding LastSprite}" Width="64" Height="64"
                                   Margin="0,0,14,0" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Mono}" HorizontalAlignment="Center" FontSize="10"
                                       Opacity="0.75" Text="{Binding LastTierName}"
                                       Foreground="{Binding LastTierBrushKey, Converter={StaticResource ResourceKey}}" />
                            <!-- El nombre entra con su propio golpe y un pelín más tarde que la
                                 ficha, para que sean dos impactos y no uno. -->
                            <TextBlock HorizontalAlignment="Center" FontSize="21" Margin="0,1,0,0"
                                       Text="{Binding LastPull.SpeciesName}" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </TextBlock.RenderTransform>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PanelHeading}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasResult}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation BeginTime="0:0:0.12" From="1.5" To="1"
                                                                Duration="0:0:0.55"
                                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <BackEase EasingMode="EaseOut" Amplitude="0.7" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation BeginTime="0:0:0.12" From="1.5" To="1"
                                                                Duration="0:0:0.55"
                                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <BackEase EasingMode="EaseOut" Amplitude="0.7" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- La marca de shiny o legendario late tres veces al aparecer. Solo
                                 se pone cuando de verdad lo es, así que el ruido está ganado. -->
                            <TextBlock HorizontalAlignment="Center" FontSize="10" Margin="0,1,0,0"
                                       Text="{Binding LastBadge}" Foreground="{StaticResource AccentBrush}"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </TextBlock.RenderTransform>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Mono}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LastBadge}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasBadge}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation BeginTime="0:0:0.3" From="2.2" To="1"
                                                                Duration="0:0:0.6"
                                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <BackEase EasingMode="EaseOut" Amplitude="0.9" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation BeginTime="0:0:0.3" From="2.2" To="1"
                                                                Duration="0:0:0.6"
                                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <BackEase EasingMode="EaseOut" Amplitude="0.9" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation BeginTime="0:0:0.3" From="0.25" To="1"
                                                                Duration="0:0:0.45" AutoReverse="True"
                                                                RepeatBehavior="3x"
                                                                Storyboard.TargetProperty="Opacity" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Style="{StaticResource Body}" HorizontalAlignment="Center" Margin="0,3,0,0">
                                <Run Text="Nv." /><Run Text="{Binding LastPull.Level, Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{Binding LastPull.NatureName, Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{Binding LastPull.Ability, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Mono}" HorizontalAlignment="Center" Margin="0,2,0,0"
                                       FontSize="11"
                                       Text="{Binding LastPull.IvTotal, StringFormat='IV total {0} de 186'}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- LO QUE YA HA SALIDO. Llena los cuatrocientos y pico pixeles que la
                         pantalla tenia en negro, y de paso contesta la pregunta que un gacha
                         siempre levanta y esta no contestaba: que llevas. Cada uno con el borde
                         de su tier, asi que la racha se lee de un vistazo. -->
                    <StackPanel Grid.Row="4" VerticalAlignment="Bottom" Margin="0,0,0,16"
                                Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="LO QUE HA SALIDO" Style="{StaticResource Mono}" FontSize="9"
                                   HorizontalAlignment="Center" Opacity="0.35" Margin="0,0,0,6" />

                        <ItemsControl ItemsSource="{Binding History}" HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="46" Height="46" Margin="3,0" CornerRadius="4"
                                            BorderThickness="1.5"
                                            Background="{StaticResource SunkenBrush}"
                                            ToolTip="{Binding SpeciesName}"
                                            BorderBrush="{Binding BrushKey,
                                                Converter={StaticResource ResourceKey}}">
                                        <Image Source="{Binding Sprite}" Width="38" Height="38"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- BANNERS. La selección va al view model; la lista no decide nada. -->
            <ListBox Grid.Row="1" ItemsSource="{Binding Banners}" SelectedItem="{Binding SelectedBanner}"
                     Background="Transparent" BorderThickness="0" Margin="-4,12,-4,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="4" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Card" Background="{StaticResource PanelBrush}"
                                            CornerRadius="8" BorderThickness="1" Padding="14,12"
                                            BorderBrush="{StaticResource BorderStrongBrush}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="Background"
                                                    Value="{StaticResource SurfaceHighBrush}" />
                                            <Setter TargetName="Card" Property="BorderBrush"
                                                    Value="{StaticResource AccentDimBrush}" />
                                        </Trigger>
                                        <!-- El banner elegido se enciende entero: es el que va a
                                             cobrar cuando se pulse TIRAR, y eso hay que verlo. -->
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush"
                                                    Value="{StaticResource AccentBrush}" />
                                            <Setter TargetName="Card" Property="Background"
                                                    Value="{StaticResource AccentDeepBrush}" />
                                            <!-- Y con grosor, que el tono solo no se veia: en la
                                                 captura el elegido y los otros dos se distinguian
                                                 por un gris de diferencia. -->
                                            <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <DockPanel>
                                <!-- La chapa dice lo que cuesta, y cuando hay tiradas gratis dice
                                     eso y se pone verde: es el aviso de que ese banner no cobra. -->
                                <Border DockPanel.Dock="Right">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                            <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentDimBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasFree}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SuccessDeepBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Cost}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource ChipText}">
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrightBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasFree}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource PanelHeading}"
                                           Margin="0" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}"
                                       FontSize="12" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding Odds}" Style="{StaticResource Mono}" FontSize="10.5"
                                       Foreground="{StaticResource TextFaintBrush}" Margin="0,8,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="2" Style="{StaticResource Inset}" Padding="14,12" Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel>
                        <!-- El precio va EN el boton. Antes ponia «TIRAR» y al lado una chapa con
                             los puntos, que es el SALDO y no lo que cuesta: para saber que te iban
                             a cobrar habia que mirar a otro sitio, la insignia del banner elegido,
                             y cual estaba elegido se distinguia por un fondo un tono mas claro. -->
                        <Button DockPanel.Dock="Left" Command="{Binding RollCommand}"
                                Style="{StaticResource PrimaryButton}"
                                MinWidth="200" Padding="18,9">
                            <StackPanel>
                                <TextBlock Text="{Binding RollLabel}" FontSize="14" FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding RollCost}" FontSize="10.5" Opacity="0.8"
                                           HorizontalAlignment="Center" Margin="0,1,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- Las cinco chapas de tier vivian aqui, con «T1 · ≤400» y compañia escritos
                             A MANO en el XAML: editar Data/gacha.json las dejaba mintiendo. Ahora
                             cada rango va bajo su portal, calculado de los propios tiers. -->

                        <Border Style="{StaticResource Chip}" HorizontalAlignment="Left" Margin="14,0,0,0"
                                Padding="12,5"
                                Background="{StaticResource BackgroundBrush}"
                                BorderBrush="{StaticResource AccentDimBrush}">
                            <TextBlock Style="{StaticResource ChipText}" FontSize="12"
                                       Foreground="{StaticResource AccentBrush}"
                                       Text="{Binding Balance, StringFormat='{}{0} puntos'}" />
                        </Border>
                    </DockPanel>

                    <TextBlock Text="{Binding Status}" FontSize="12" Margin="0,12,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

    </Grid>
</UserControl>
