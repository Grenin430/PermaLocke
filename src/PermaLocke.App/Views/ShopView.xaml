<UserControl x:Class="PermaLocke.App.Views.ShopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PermaLocke.App.Views"
             xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel">

    <!-- LA TIENDA EN PÍXELES (§176): el mostrador de una tienda de juego. Mismas órdenes que antes.

         LA PLACA ENTERA ES EL BOTÓN: en una tienda de juego se pulsa el objeto, y el precio es lo que es, un precio.
         No llegar al precio no es lo mismo que «no se puede pulsar», así que se dice con el precio en rojo y la placa
         apagada, no solo atenuada. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style TargetType="ScrollBar" BasedOn="{StaticResource PxScrollBar}" />

        <Style x:Key="ShopCard" TargetType="Button">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Body" Background="Transparent">
                            <views:PixelPanel x:Name="Plate" Fill="{StaticResource PxFace}" />
                            <ContentPresenter x:Name="Face" Margin="10,10,16,16" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Fill" Value="{StaticResource PxAccentDeep}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Plate" Property="HasShadow" Value="False" />
                                <Setter TargetName="Plate" Property="Margin" Value="6,6,0,0" />
                                <Setter TargetName="Face" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="6" Y="6" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Plate" Property="Fill" Value="#FF141024" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ShopItemTemplate">
            <Button Style="{StaticResource ShopCard}" IsEnabled="{Binding Affordable}"
                    Command="{Binding DataContext.BuyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
                <StackPanel>
                    <!-- EL ICONO, del cartucho, al doble y en su hueco. -->
                    <Grid Height="72">
                        <views:PixelPanel Fill="{StaticResource PxWell}" IsSunken="True" HasShadow="False" />
                        <pixel:PixelText Text="{Binding Initial}" Scale="4" Tight="True" Colour="{StaticResource PxTextFaint}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <pixel:PixelSprite Source="{Binding Icon}" Scale="2" TrimEmpty="True" Outline="{StaticResource PxShadow}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Bob="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Grid>

                    <pixel:PixelText Text="{Binding Name}" Scale="2" Wrap="True" TextAlignment="Center"
                                     HorizontalAlignment="Stretch" MinHeight="44" Margin="0,8,0,0"
                                     Colour="{StaticResource PxText}" Shadow="{StaticResource PxShadow}" />

                    <!-- Lo que ya llevas: evita comprar de más. -->
                    <pixel:PixelText Text="{Binding Carried}" Scale="2" Tight="True" HorizontalAlignment="Center"
                                     Margin="0,2,0,6" Colour="{StaticResource PxTextFaint}" />

                    <!-- El precio, con el rombo de los puntos. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <pixel:PixelIcon Icon="IconPoints" Scale="1" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <pixel:PixelText Text="{Binding PriceText}" Scale="2" Tight="True" VerticalAlignment="Center"
                                         Shadow="{StaticResource PxShadow}">
                            <pixel:PixelText.Style>
                                <Style TargetType="pixel:PixelText">
                                    <Setter Property="Colour" Value="{StaticResource PxGold}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Affordable}" Value="False">
                                            <Setter Property="Colour" Value="{StaticResource PxBad}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </pixel:PixelText.Style>
                        </pixel:PixelText>
                    </StackPanel>
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- Una pestaña del mostrador: placa, encendida cuando es la que está a la vista. -->
        <Style x:Key="CounterTab" TargetType="Button" BasedOn="{StaticResource PxSubtleButton}">
            <Setter Property="Padding" Value="14,7,20,12" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- CABECERA: qué es y los avisos. El saldo vive en la cabecera de la ventana. -->
        <pixel:PixelWindow Grid.Row="0" Title="TIENDA DE LA COMPETICIÓN" Icon="IconShop" Margin="0,0,0,12">
            <StackPanel>
                <pixel:PixelText Text="Lo que compres se escribe en la mochila de tu partida." Scale="2" Wrap="True"
                                 Colour="{StaticResource PxTextDim}" />
                <pixel:PixelText Text="{Binding Problem}" Scale="2" Wrap="True" Margin="0,8,0,0" Colour="{StaticResource PxWarn}" />
                <pixel:PixelText Text="{Binding Status}" Scale="2" Wrap="True" Margin="0,8,0,0" Colour="{StaticResource PxGood}" />
            </StackPanel>
        </pixel:PixelWindow>

        <!-- Dos mostradores, y el buscador en los dos. -->
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <!-- Cada pestaña en dos versiones, encendida y apagada, y se ve la que toca. -->
            <Grid DockPanel.Dock="Left">
                <Button Content="{Binding BattleTab}" Command="{Binding ShowBattleCommand}" Style="{StaticResource CounterTab}"
                        Visibility="{Binding ShowingMegaStones, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="{Binding BattleTab}" Command="{Binding ShowBattleCommand}" Style="{StaticResource PxButton}"
                        Padding="14,7,20,12"
                        Visibility="{Binding ShowingMegaStones, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>
            <Grid DockPanel.Dock="Left" Margin="8,0,0,0">
                <Button Content="{Binding MegaTab}" Command="{Binding ShowMegaStonesCommand}" Style="{StaticResource CounterTab}"
                        Visibility="{Binding ShowingMegaStones, Converter={StaticResource InverseBoolToVisibility}}" />
                <Button Content="{Binding MegaTab}" Command="{Binding ShowMegaStonesCommand}" Style="{StaticResource PxButton}"
                        Padding="14,7,20,12"
                        Visibility="{Binding ShowingMegaStones, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <Grid DockPanel.Dock="Left" Width="260" Margin="16,0,0,0" VerticalAlignment="Top">
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PxTextBox}"
                         Padding="14,9,10,9" ToolTip="Escribe parte del nombre. No hacen falta tildes." />
                <pixel:PixelText Text="Buscar objeto…" Scale="2" Tight="True" IsHitTestVisible="False"
                                 VerticalAlignment="Center" Margin="16,0,0,0" Colour="{StaticResource PxTextFaint}">
                    <pixel:PixelText.Style>
                        <Style TargetType="pixel:PixelText">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Search}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </pixel:PixelText.Style>
                </pixel:PixelText>
            </Grid>

            <Button DockPanel.Dock="Left" Content="×" Command="{Binding ClearSearchCommand}" Margin="6,0,0,0"
                    ToolTip="Quitar el filtro">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource CounterTab}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Search}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Lo que la pantalla no puede saber por ti: la piedra vale para UNA especie, y para la forma final. -->
            <pixel:PixelText Scale="2" Wrap="True" VerticalAlignment="Center" Margin="16,0,0,0"
                             Colour="{StaticResource PxTextFaint}"
                             Text="Cada megapiedra sirve para un solo Pokémon en su última evolución. Necesitas la Piedra Activadora."
                             Visibility="{Binding ShowingMegaStones, Converter={StaticResource BoolToVisibility}}" />
        </DockPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <ItemsControl ItemsSource="{Binding Visible}" ItemTemplate="{StaticResource ShopItemTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <Button DockPanel.Dock="Left" Content="ACTUALIZAR" Style="{StaticResource PxButton}"
                    Command="{Binding RefreshCommand}" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <pixel:PixelText Text="!" Scale="2" Tight="True" Colour="{StaticResource PxWarn}" />
                <pixel:PixelText Text="Necesita Azahar abierto con la partida cargada." Scale="2" Tight="True"
                                 Margin="8,0,0,0" Colour="{StaticResource PxTextDim}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
