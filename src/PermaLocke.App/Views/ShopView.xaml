<UserControl x:Class="PermaLocke.App.Views.ShopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Una tarjeta: icono del cartucho, nombre y el precio como botón. -->
        <DataTemplate x:Key="ShopItemTemplate">
            <Border Margin="4" Padding="10" CornerRadius="6" BorderThickness="1"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceAltBrush}">
                <StackPanel>
                    <Grid Height="52" Margin="0,2,0,8">
                        <!-- El icono sale de la ROM del propio jugador. Si el cartucho no lo
                             tiene medido, queda la inicial en vez de un hueco vacío. -->
                        <TextBlock Text="{Binding Initial}" FontSize="26" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource SurfaceAltBrush}" />
                        <Image Source="{Binding Icon}" Stretch="None"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center"
                               MinHeight="34" FontSize="12"
                               Foreground="{StaticResource TextBrush}" />

                    <TextBlock Text="{Binding Carried}" TextAlignment="Center" FontSize="10"
                               Margin="0,0,0,6" Foreground="{StaticResource TextMutedBrush}" />

                    <Button Content="{Binding PriceText}"
                            IsEnabled="{Binding Affordable}"
                            Command="{Binding DataContext.BuyCommand,
                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Saldo y avisos. -->
        <Border Grid.Row="0" Padding="14,10" Margin="0,0,0,10" CornerRadius="6"
                Background="{StaticResource SurfaceBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Problem}" TextWrapping="Wrap"
                               Foreground="{StaticResource WarningBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Problem}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap"
                               Foreground="{StaticResource SuccessBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="SALDO" FontSize="10" HorizontalAlignment="Right"
                               Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding Balance}" FontSize="26" FontWeight="Bold"
                               HorizontalAlignment="Right"
                               Foreground="{StaticResource AccentBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ShopItemTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <Button Content="ACTUALIZAR" HorizontalAlignment="Left" Padding="18,8"
                    Command="{Binding RefreshCommand}" />
            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="11"
                       Foreground="{StaticResource TextMutedBrush}"
                       Text="Lo comprado se escribe en la mochila del juego, así que hace falta Azahar abierto con la partida cargada. El objeto se entrega primero y se cobra después: si la escritura falla no se te quita nada. Los iconos salen de tu propia ROM." />
        </StackPanel>
    </Grid>
</UserControl>
