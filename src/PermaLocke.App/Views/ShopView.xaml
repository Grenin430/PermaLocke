<UserControl x:Class="PermaLocke.App.Views.ShopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- El botón del precio: relleno de acento, y en rojo apagado cuando no llega el saldo,
             para que la tarjeta diga por qué no se puede comprar sin tener que leer nada. -->
        <!-- El precio ES el boton de compra: no hay una etiqueta con el precio y aparte un boton
             que diga COMPRAR, porque en una tienda de juego se pulsa el precio. Comparte la forma
             del boton primario del tema (relleno de laton, radio y alto), asi que cuesta lo mismo
             de reconocer que cualquier otra accion de la aplicacion.

             No se lo puedes pagar: se apaga a rojo apagado en vez de simplemente atenuarse. La
             diferencia importa, porque "no llegas" y "esto no se puede pulsar" son cosas
             distintas y el jugador necesita saber cual de las dos es. -->
        <Style x:Key="PriceButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="Padding" Value="{StaticResource PadTight}" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip" CornerRadius="{StaticResource RadiusMedium}"
                                Padding="{TemplateBinding Padding}"
                                Background="{StaticResource AccentBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource AccentBrightBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource AccentDimBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource DangerDeepBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Una tarjeta: el icono del cartucho sobre un halo, el nombre, lo que llevas y el precio. -->
        <!-- LA TARJETA ENTERA ES EL BOTON. Antes cada objeto llevaba un boton violeta macizo con
             el precio dentro, o sea DIECIOCHO barras de acento en pantalla: el acento significa
             valor o accion, y puesto en todas partes no significa nada. Ahora el precio es lo que
             es -un precio, texto con el rombo de puntos al lado- y lo que se pulsa es el objeto.

             Y se LEVANTA al pasar por encima. La transformacion va dentro de la plantilla, que es
             lo unico que le da una propia a cada tarjeta: puesta en un Setter, WPF la congela y la
             comparten todas, asi que se moverian las dieciocho a la vez. -->
        <Style x:Key="ShopCard" TargetType="Button">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Padding="{StaticResource PadPanel}"
                                CornerRadius="{StaticResource RadiusMedium}" BorderThickness="1"
                                Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="Lift" />
                            </Border.RenderTransform>
                            <ContentPresenter />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Card" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{StaticResource AccentColor}"
                                                          BlurRadius="18" ShadowDepth="0" Opacity="0.45" />
                                    </Setter.Value>
                                </Setter>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Lift"
                                                             Storyboard.TargetProperty="Y"
                                                             To="-3" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Lift"
                                                             Storyboard.TargetProperty="Y"
                                                             To="0" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!-- Sin saldo, la tarjeta entera se apaga y deja de pulsarse. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Card" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ShopItemTemplate">
            <Button Style="{StaticResource ShopCard}" IsEnabled="{Binding Affordable}"
                    Command="{Binding DataContext.BuyCommand,
                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">

                <StackPanel>
                    <!-- EL ICONO. Un halo detrás para que el pixel art no flote sobre el fondo,
                         y el sprite al doble de tamaño con vecino más próximo: escalado suave
                         convierte 32x32 del cartucho en una mancha. -->
                    <Grid Height="74" Margin="0,0,0,8">
                        <Ellipse Width="70" Height="70" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Offset="0" Color="#26FFFFFF" />
                                    <GradientStop Offset="0.55" Color="#12000000" />
                                    <GradientStop Offset="1" Color="#00000000" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <TextBlock Text="{Binding Initial}" FontSize="30" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextDisabledBrush}" />

                        <Image Source="{Binding Icon}" Stretch="Uniform" MaxHeight="64" MaxWidth="64"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image.LayoutTransform>
                                <ScaleTransform ScaleX="2" ScaleY="2" />
                            </Image.LayoutTransform>
                        </Image>
                    </Grid>

                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center"
                               MinHeight="32" FontSize="12.5" FontWeight="SemiBold"
                               FontFamily="{StaticResource UiFont}"
                               Foreground="{StaticResource TextBrush}" />

                    <!-- Lo que ya llevas, discreto pero visible: evita comprar de más. -->
                    <Border Margin="0,4,0,9" Padding="8,2" CornerRadius="9"
                            HorizontalAlignment="Center" Background="{StaticResource BackgroundBrush}">
                        <TextBlock Text="{Binding Carried}" FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Carried}" Value="">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <!-- El precio, como precio. El rombo es el simbolo del recurso en toda la
                         aplicacion, asi que aqui dice «esto cuesta» sin escribir la palabra. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,2,0,2">
                        <Path Style="{StaticResource IconSmall}" Data="{StaticResource IconPoints}"
                              Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"
                              Margin="0,0,7,0" />
                        <TextBlock Text="{Binding PriceText}" Style="{StaticResource Numeric}"
                                   Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- CABECERA: saldo grande a la derecha, avisos a la izquierda. -->
        <Border Grid.Row="0" Padding="18,14" Margin="0,0,0,12" CornerRadius="10"
                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0" Color="{StaticResource SurfaceAltColor}" />
                    <GradientStop Offset="1" Color="{StaticResource SurfaceColor}" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="TIENDA DE LA COMPETICIÓN" FontSize="10" FontWeight="Bold"
                               FontFamily="{StaticResource UiFont}"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="Lo que compres se escribe en la mochila de tu partida." />

                    <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" Margin="0,8,0,0"
                               FontSize="12" Foreground="{StaticResource WarningBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Problem}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0"
                               FontSize="12" Foreground="{StaticResource SuccessBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- El saldo se quito de aqui: vive en la cabecera y se ve desde cualquier
                     pantalla. Ensenar el mismo numero dos veces en la misma pantalla no informa
                     el doble, solo hace dudar de cual de los dos es el bueno. -->
            </Grid>
        </Border>

        <!-- Dos mostradores. Las cuarenta y siete megapiedras mezcladas con los objetos de
             combate enterrarían a estos últimos, que son los que se compran a diario. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="{Binding BattleTab}" Command="{Binding ShowBattleCommand}"
                    Padding="16,7" MinWidth="150">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowingMegaStones}" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="{Binding MegaTab}" Command="{Binding ShowMegaStonesCommand}"
                    Padding="16,7" MinWidth="180" Margin="10,0,0,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowingMegaStones}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- El buscador, en los DOS mostradores. Con noventa y tres megapiedras, dar con
                 Dragoninite pasando la rueda es una faena; el de combate tiene dieciocho y no lo
                 necesita, pero una caja que aparece y desaparece es peor que una que siempre esta
                 en el mismo sitio.

                 Con lupa y con texto de ayuda dentro, y no por adorno: una caja vacia al lado de
                 dos pestanas con nombre se leia como una TERCERA pestana rota. WPF no trae texto de
                 ayuda en TextBox, asi que va detras y se esconde en cuanto escribes. -->
            <Grid Width="230" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                         Padding="32,7,10,7"
                         ToolTip="Escribe parte del nombre. No hacen falta tildes." />

                <Path Data="M 4.6,9.2 A 4.6,4.6 0 1 1 4.6,0 A 4.6,4.6 0 1 1 4.6,9.2 Z M 8.2,8.2 L 11.6,11.6"
                      Stroke="{StaticResource TextFaintBrush}" StrokeThickness="1.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      HorizontalAlignment="Left" VerticalAlignment="Center"
                      Margin="11,0,0,0" IsHitTestVisible="False" />

                <TextBlock Text="Buscar objeto…" IsHitTestVisible="False" VerticalAlignment="Center"
                           Margin="33,0,0,0" Foreground="{StaticResource TextFaintBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Search}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Button Content="✕" Command="{Binding ClearSearchCommand}" Padding="12,7"
                    Margin="6,0,0,0" ToolTip="Quitar el filtro">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Search}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Lo que la pantalla no puede saber por ti: la piedra vale para UNA especie, y para
                 la forma final. Callarlo sería vender quinientos puntos de nada. -->
            <TextBlock Style="{StaticResource Faint}" VerticalAlignment="Center" FontSize="11"
                       Margin="16,0,0,0" TextWrapping="Wrap" MaxWidth="270"
                       Text="Cada piedra sirve para una sola especie, y para su forma FINAL: una Swampertita no hace nada en un Marshtomp. Y hace falta la Piedra Activadora en la mochila."
                       Visibility="{Binding ShowingMegaStones, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <ItemsControl ItemsSource="{Binding Visible}" ItemTemplate="{StaticResource ShopItemTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <Button DockPanel.Dock="Left" Content="ACTUALIZAR" Style="{StaticResource PrimaryButton}"
                    Command="{Binding RefreshCommand}" />
            <TextBlock VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap" FontSize="11"
                       Foreground="{StaticResource TextFaintBrush}"
                       Text="Hace falta Azahar abierto con la partida cargada. El objeto se entrega primero y se cobra después: si la escritura falla, no se te quita nada. Los iconos salen de tu propia ROM." />
        </DockPanel>
    </Grid>
</UserControl>
