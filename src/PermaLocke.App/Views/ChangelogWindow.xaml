<Window x:Class="PermaLocke.App.Views.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PermaLocke.App.Views"
        xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel"
        Title="PermaLocke — Novedades" Width="620" Height="700" WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True" Background="{DynamicResource PxBaseBrush}">
    <!-- NOVEDADES (1.0.7): lo que trae cada versión, contado para quien juega (Novedades.txt, dentro del exe). -->
    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource PxScrollBar}" />
    </Window.Resources>
    <Grid>
        <pixel:PixelBackdrop Base="{DynamicResource PxBase}" />
        <DockPanel Margin="18">
            <pixel:PixelText x:Name="Heading" DockPanel.Dock="Top" Text="NOVEDADES" Scale="4" Tight="True" Colour="{DynamicResource PxGold}"
                             Shadow="{DynamicResource PxShadow}" Margin="2,0,0,14" />
            <Button DockPanel.Dock="Bottom" Content="CERRAR" Style="{StaticResource PxButton}" HorizontalAlignment="Right"
                    Margin="0,14,0,0" IsCancel="True" IsDefault="True" Click="OnClose" />
            <Grid>
                <views:PixelPanel Fill="{DynamicResource PxFace}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16,14,10,18">
                    <ItemsControl x:Name="Lines" Margin="0,0,10,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <pixel:PixelText Text="{Binding Text}" Scale="{Binding Scale}" Wrap="True" Margin="{Binding Margin}"
                                                 Colour="{Binding Colour}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
