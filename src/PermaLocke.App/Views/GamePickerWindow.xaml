<Window x:Class="PermaLocke.App.Views.GamePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PermaLocke.App.Views"
        xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel"
        Title="PermaLocke"
        Width="900" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource PxBaseBrush}">

    <!-- El launcher (2026-11-10): antes de abrir nada, a qué juego se va a jugar. Una tarjeta por juego con su portada; los que
         están en desarrollo se ven, pero dicen que aún no se pueden jugar. -->
    <Grid>
        <pixel:PixelBackdrop Base="{DynamicResource PxBase}" />

        <StackPanel Margin="22,18,22,22">
            <pixel:PixelText Text="¿A QUÉ VAS A JUGAR?" Scale="4" Tight="True" Colour="{DynamicResource PxText}"
                             Shadow="{DynamicResource PxShadow}" HorizontalAlignment="Center" />
            <pixel:PixelText Text="Elige el juego. Cada uno tiene sus runs, su mundo y sus reglas." Scale="2" Tight="True"
                             Colour="{DynamicResource PxTextDim}" HorizontalAlignment="Center" Margin="0,10,0,18" />

            <ItemsControl x:Name="Games">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Click="OnGame" Tag="{Binding}" Cursor="Hand" Margin="10,0" Padding="0" BorderThickness="0"
                                Background="Transparent" FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Background="Transparent">
                                        <views:PixelPanel x:Name="Plate" Fill="{DynamicResource PxFace}" />
                                        <StackPanel Margin="14,14,18,18">
                                            <Grid>
                                                <Image Source="{Binding Cover}" Height="300" Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                <Border Background="#99000000" Visibility="{Binding Shade}" />
                                            </Grid>
                                            <DockPanel Margin="2,12,0,0">
                                                <Grid DockPanel.Dock="Right" VerticalAlignment="Center">
                                                    <views:PixelPanel Fill="{Binding BadgeColour}" HasShadow="False" />
                                                    <pixel:PixelText Text="{Binding Platform}" Scale="2" Tight="True" Margin="8,5,8,8"
                                                                     Colour="#FFFFFFFF" />
                                                </Grid>
                                                <pixel:PixelText Text="{Binding Name}" Scale="3" Tight="True"
                                                                 Colour="{DynamicResource PxAccentInkLight}" Shadow="{DynamicResource PxShadow}"
                                                                 VerticalAlignment="Center" />
                                            </DockPanel>
                                            <pixel:PixelText Text="{Binding State}" Scale="2" Tight="True" Margin="2,8,0,0"
                                                             Colour="{Binding StateColour}" />
                                        </StackPanel>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Plate" Property="Fill" Value="{DynamicResource PxFaceHigh}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="SALIR" Style="{StaticResource PxSubtleButton}" HorizontalAlignment="Right" Margin="0,18,10,0"
                    IsCancel="True" Click="OnQuit" />
        </StackPanel>
    </Grid>
</Window>
