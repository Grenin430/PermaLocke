<UserControl x:Class="PermaLocke.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PermaLocke.App.Views"
             xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel">
    <!-- CONFIGURACIÓN (sustituye a MANTENIMIENTO el 2026-09-24): el tamaño de la ventana y unos pocos ajustes que se
         guardan en Config/ajustes.json. -->
    <UserControl.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource PxScrollBar}" />
        <Style x:Key="Explain" TargetType="pixel:PixelText">
            <Setter Property="Scale" Value="2" />
            <Setter Property="Wrap" Value="True" />
            <Setter Property="Colour" Value="{DynamicResource PxTextFaint}" />
            <Setter Property="Margin" Value="34,4,0,12" />
        </Style>
        <Style x:Key="Check" TargetType="CheckBox" BasedOn="{StaticResource PxCheckBox}" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,10,0">
            <!-- ================================================== VENTANA -->
            <pixel:PixelWindow Title="TAMAÑO DE LA VENTANA" Icon="IconTools">
                <pixel:PixelWindow.HeaderContent>
                    <pixel:PixelText Text="{Binding CurrentSizeName}" Scale="2" Tight="True" Colour="{DynamicResource PxAccentInkLight}" />
                </pixel:PixelWindow.HeaderContent>
                <ItemsControl ItemsSource="{Binding WindowSizes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Left" Content="{Binding Name}" Style="{StaticResource PxSubtleButton}"
                                        MinWidth="140"
                                        Command="{Binding DataContext.SetWindowSizeCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <pixel:PixelText Text="{Binding Why}" Scale="2" Wrap="True" VerticalAlignment="Center"
                                                 Margin="14,0,0,0" Colour="{DynamicResource PxTextDim}" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </pixel:PixelWindow>

            <!-- ================================================== DISEÑO (2026-10-01) -->
            <pixel:PixelWindow Title="DISEÑO DE LA APLICACIÓN" Icon="IconPalette" Margin="0,12,0,0">
                <pixel:PixelWindow.HeaderContent>
                    <pixel:PixelText x:Name="DesignName" Scale="2" Tight="True" Colour="{DynamicResource PxAccentInkLight}" />
                </pixel:PixelWindow.HeaderContent>
                <DockPanel>
                    <Button DockPanel.Dock="Left" Content="ABRIR LA GALERÍA" Style="{StaticResource PxSubtleButton}" MinWidth="140"
                            Click="OnDesign" />
                    <pixel:PixelText Text="Cinco maneras de ver PermaLocke: cambia al momento, sin perder la pantalla. También está el botón DISEÑO arriba, en la barra de la ventana."
                                     Scale="2" Wrap="True" VerticalAlignment="Center" Margin="14,0,0,0" Colour="{DynamicResource PxTextDim}" />
                </DockPanel>
            </pixel:PixelWindow>

            <!-- ================================================== TORNEO: entrar con Discord (fase 1, solo identidad) -->
            <pixel:PixelWindow Title="TORNEO" Icon="IconTrophy" Margin="0,12,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}">
                        <Image Source="{Binding DiscordAvatar, TargetNullValue={x:Null}}" Width="48" Height="48" Margin="0,0,12,0" />
                        <pixel:PixelText Text="{Binding DiscordName}" Scale="3" Tight="True" VerticalAlignment="Center"
                                         Colour="{DynamicResource PxText}" Shadow="{DynamicResource PxShadow}" />
                        <Button Content="SALIR" Style="{StaticResource PxSubtleButton}" Command="{Binding SignOutCommand}"
                                VerticalAlignment="Center" Margin="18,0,0,0" />
                    </StackPanel>
                    <Button Content="ENTRAR CON DISCORD" Style="{StaticResource PxButton}" Command="{Binding SignInCommand}"
                            HorizontalAlignment="Left" Visibility="{Binding IsSignedIn, Converter={StaticResource InverseBoolToVisibility}}" />
                    <pixel:PixelText Style="{StaticResource Explain}" Margin="0,10,0,0"
                                     Text="Solo para el torneo. PermaLocke no ve tu contraseña." />
                </StackPanel>
            </pixel:PixelWindow>

            <!-- ================================================== MIENTRAS JUEGAS -->
            <pixel:PixelWindow Title="MIENTRAS JUEGAS" Icon="IconPlay" Margin="0,12,0,0">
                <StackPanel>
                    <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Notifications}" Content="Avisos encima del juego" />
                    <pixel:PixelText Style="{StaticResource Explain}" Text="Avisos encima de Azahar." />

                    <CheckBox Style="{StaticResource Check}" IsChecked="{Binding DeathScene}" Content="Escena de muerte" />
                    <pixel:PixelText Style="{StaticResource Explain}" Text="Al caer un Pokémon." />

                    <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Ghosts}" Content="Fantasmas" />
                    <pixel:PixelText Style="{StaticResource Explain}" Text="Los caídos de tus amigos cruzan tu emulador, y el tuyo se va hacia ellos. Si alguien pierde el equipo, llueve sangre." />

                    <CheckBox Style="{StaticResource Check}" IsChecked="{Binding CatchCard}" Content="Carta al capturar" />
                    <pixel:PixelText Style="{StaticResource Explain}" Text="Al atrapar un Pokémon salvaje, su carta sale de una Poké Ball y se mete en el álbum." />

                    <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Nicknames}" Content="Motes entre todos" />
                    <pixel:PixelText Style="{StaticResource Explain}" Text="Al capturar te pregunta si los demás eligen el mote, y te salen las votaciones de los motes de tus amigos. Apagado, no te sale ninguna de las dos." />

                    <CheckBox Style="{StaticResource Check}" IsChecked="{Binding CapPanel}" Content="Cap de nivel encima del juego" />
                    <pixel:PixelText Style="{StaticResource Explain}" Text="Un mar de luz en la banda negra del emulador: cada Pokémon es una criatura, el cap está escrito en una boya, el hilo de luz que baja hasta la criatura de más nivel es el nivel de tu equipo, y los caídos se quedan como fósiles en el fondo. Nunca tapa las pantallas del juego: si no cabe, se hace más pequeño o se esconde." />

                    <pixel:PixelText Text="{Binding CapSizeText}" Scale="2" Tight="True" Margin="0,6,0,4" Colour="{DynamicResource PxAccentInkLight}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <Button Content="Solo" Style="{StaticResource PxSubtleButton}" MinWidth="60" Margin="0,0,8,0" Command="{Binding SetCapSizeCommand}" CommandParameter="0" />
                        <Button Content="Reducido" Style="{StaticResource PxSubtleButton}" MinWidth="60" Margin="0,0,8,0" Command="{Binding SetCapSizeCommand}" CommandParameter="1" />
                        <Button Content="Estrecho" Style="{StaticResource PxSubtleButton}" MinWidth="60" Margin="0,0,8,0" Command="{Binding SetCapSizeCommand}" CommandParameter="2" />
                        <Button Content="Completo" Style="{StaticResource PxSubtleButton}" MinWidth="60" Command="{Binding SetCapSizeCommand}" CommandParameter="3" />
                    </StackPanel>
                    <pixel:PixelText Style="{StaticResource Explain}" Text="«Solo» elige el mayor que quepa. Los demás son un máximo: si la banda es más pequeña, baja solo." />

                    <pixel:PixelText Text="{Binding CapMaxCellText}" Scale="2" Tight="True" Margin="0,6,0,4" Colour="{DynamicResource PxAccentInkLight}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <Button Content="Solo" Style="{StaticResource PxSubtleButton}" MinWidth="60" Margin="0,0,8,0" Command="{Binding SetCapMaxCellCommand}" CommandParameter="0" />
                        <Button Content="x2" Style="{StaticResource PxSubtleButton}" MinWidth="60" Margin="0,0,8,0" Command="{Binding SetCapMaxCellCommand}" CommandParameter="2" />
                        <Button Content="x3" Style="{StaticResource PxSubtleButton}" MinWidth="60" Margin="0,0,8,0" Command="{Binding SetCapMaxCellCommand}" CommandParameter="3" />
                        <Button Content="x4" Style="{StaticResource PxSubtleButton}" MinWidth="60" Command="{Binding SetCapMaxCellCommand}" CommandParameter="4" />
                    </StackPanel>
                    <pixel:PixelText Style="{StaticResource Explain}" Text="Cuántos píxeles de pantalla mide cada celda del panel. Más pequeño, más discreto." />

                    <CheckBox Style="{StaticResource Check}" IsChecked="{Binding CapMemorial}" Content="El fondo del mar en la otra banda" />
                    <pixel:PixelText Style="{StaticResource Explain}" Text="Si hay banda negra a los dos lados del juego, la otra sigue el mismo mar: el sol o la luna a la hora de Alola, las linternas de las pruebas superadas, los estratos del suelo y cada caído como un fósil con su propio dibujo, sin una sola letra: un rayo de luz los va recorriendo del más nuevo al más viejo. Apagado, solo se ve el mar del equipo." />

                    <CheckBox Style="{StaticResource Check}" IsChecked="{Binding CapDetails}" Content="Tipos, objeto, estado y experiencia" />
                    <pixel:PixelText Style="{StaticResource Explain}" Text="Lo que se lee del juego de cada Pokémon además del nivel y los PS. El estado solo se ve fuera de combate." />

                    <CheckBox Style="{StaticResource Check}" IsChecked="{Binding CapAnimations}" Content="Animaciones del panel" />
                    <pixel:PixelText Style="{StaticResource Explain}" Text="Las olas, el polvo marino, las criaturas que respiran, los golpes, las curas, las subidas de nivel, el Pokémon que cae y se hunde hasta el fondo, el suelo que se abre al cambiar de cap, el estado del mar (calma, combate, peligro, luto, cap) y los bichos raros que cruzan el mar por detrás del juego. Apagado, queda quieto." />

                    <pixel:PixelText Text="{Binding CapHpSyncText}" Scale="2" Tight="True" Margin="0,6,0,4" Colour="{DynamicResource PxAccentInkLight}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <Button Content="Sincronizada" Style="{StaticResource PxSubtleButton}" MinWidth="60" Margin="0,0,8,0" Command="{Binding SetCapHpSyncCommand}" CommandParameter="0" />
                        <Button Content="Instantánea" Style="{StaticResource PxSubtleButton}" MinWidth="60" Margin="0,0,8,0" Command="{Binding SetCapHpSyncCommand}" CommandParameter="1" />
                        <Button Content="Retrasada" Style="{StaticResource PxSubtleButton}" MinWidth="60" Command="{Binding SetCapHpSyncCommand}" CommandParameter="2" />
                    </StackPanel>
                    <pixel:PixelText Style="{StaticResource Explain}" Text="Cuándo enseña el panel que a un Pokémon le han quitado o dado vida. Sincronizada: cuando la barra del juego empieza a moverse (si no se ve la barra, con un retraso calculado del daño). Instantánea: en cuanto se lee, antes de que el juego lo enseñe, así que adelanta el daño. Retrasada: tres segundos después, como antes." />

                    <pixel:PixelText Text="{Binding CapKeyText}" Scale="2" Tight="True" Margin="0,6,0,4" Colour="{DynamicResource PxAccentInkLight}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <Button Content="Pausa" Style="{StaticResource PxSubtleButton}" MinWidth="60" Margin="0,0,8,0" Command="{Binding SetCapKeyCommand}" CommandParameter="19" />
                        <Button Content="Insert" Style="{StaticResource PxSubtleButton}" MinWidth="60" Margin="0,0,8,0" Command="{Binding SetCapKeyCommand}" CommandParameter="45" />
                        <Button Content="Bloq Despl" Style="{StaticResource PxSubtleButton}" MinWidth="60" Margin="0,0,8,0" Command="{Binding SetCapKeyCommand}" CommandParameter="145" />
                        <Button Content="Ninguna" Style="{StaticResource PxSubtleButton}" MinWidth="60" Command="{Binding SetCapKeyCommand}" CommandParameter="0" />
                    </StackPanel>
                    <pixel:PixelText Style="{StaticResource Explain}" Text="Con el juego delante, la tecla pasa el panel de completo a reducido, a escondido y otra vez a completo. No cambia nada del juego." />

                    <pixel:PixelText Text="{Binding ResolutionText}" Scale="2" Tight="True" Margin="0,6,0,4" Colour="{DynamicResource PxAccentInkLight}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <Button Content="x1" Style="{StaticResource PxSubtleButton}" MinWidth="60" Margin="0,0,8,0" Command="{Binding SetResolutionCommand}" CommandParameter="1" />
                        <Button Content="x2" Style="{StaticResource PxSubtleButton}" MinWidth="60" Margin="0,0,8,0" Command="{Binding SetResolutionCommand}" CommandParameter="2" />
                        <Button Content="x3" Style="{StaticResource PxSubtleButton}" MinWidth="60" Margin="0,0,8,0" Command="{Binding SetResolutionCommand}" CommandParameter="3" />
                        <Button Content="x4" Style="{StaticResource PxSubtleButton}" MinWidth="60" Command="{Binding SetResolutionCommand}" CommandParameter="4" />
                    </StackPanel>
                    <pixel:PixelText Style="{StaticResource Explain}" Text="Calidad de imagen del emulador, de 1 a 4 veces la de la consola. Se aplica al abrir el juego: cámbiala con el juego cerrado, porque cambiarla dentro hace que la imagen se ponga negra o parpadee." />

                    <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Vulkan}" Content="Usar Vulkan en el emulador" />
                    <pixel:PixelText Style="{StaticResource Explain}" Text="Con una resolución alta, en algunas tarjetas gráficas Vulkan recorta la imagen por arriba y por abajo (la caja de PS se corta): si te pasa, apágala. Se aplica al abrir el juego." />

                    <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Background}" Content="Seguir en segundo plano al cerrar" />
                    <pixel:PixelText Style="{StaticResource Explain}" Text="Al cerrar, PermaLocke se queda junto al reloj y te sigue avisando de los caídos de tus amigos. Sin marcar, se cierra del todo." />

                    <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Killcam}" Content="Grabar killcams" />
                    <pixel:PixelText Style="{StaticResource Explain}" Text="Repetición de cada muerte en el CEMENTERIO." />

                    <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Follower}" Content="Pokémon que te sigue" />
                    <pixel:PixelText Style="{StaticResource Explain}" Text="El primero del equipo anda detrás de ti. Se aplica al abrir el juego." />

                    <CheckBox Style="{StaticResource Check}" IsChecked="{Binding StepAside}" Content="Minimizar PermaLocke al abrir el juego" />
                    <pixel:PixelText Style="{StaticResource Explain}" Text="Se aparta solo cuando se abre Azahar." />

                    <Button Content="VER UN AVISO" Style="{StaticResource PxSubtleButton}" Command="{Binding TestNotificationCommand}"
                            HorizontalAlignment="Left" Margin="0,4,0,0" />
                </StackPanel>
            </pixel:PixelWindow>

            <!-- ================================================== CARPETAS -->
            <pixel:PixelWindow Title="CARPETAS" Icon="IconDocument" Margin="0,12,0,0">
                <WrapPanel>
                    <Button Content="CARPETA DE PERMALOCKE" Style="{StaticResource PxSubtleButton}" Margin="0,0,10,6"
                            Command="{Binding OpenFolderCommand}" CommandParameter="root" />
                    <Button Content="PARTIDAS Y COPIAS" Style="{StaticResource PxSubtleButton}" Margin="0,0,10,6"
                            Command="{Binding OpenFolderCommand}" CommandParameter="saves" />
                    <Button Content="REGISTROS" Style="{StaticResource PxSubtleButton}" Margin="0,0,10,6"
                            Command="{Binding OpenFolderCommand}" CommandParameter="logs" />
                </WrapPanel>
            </pixel:PixelWindow>

            <pixel:PixelText Text="{Binding Status}" Scale="2" Wrap="True" Margin="4,12,0,0" Colour="{DynamicResource PxGood}" />

            <!-- La versión que corre: lo que se mira para saber si una actualización (§196) ha entrado. -->
            <StackPanel Orientation="Horizontal" Margin="4,12,0,0">
                <pixel:PixelText Text="{Binding VersionText}" Scale="2" VerticalAlignment="Center" Colour="{DynamicResource PxTextDim}" />
                <Button Content="NOVEDADES" Style="{StaticResource PxSubtleButton}" Margin="14,0,0,0" Click="OnChangelog"
                        ToolTip="Lo que trae esta versión" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
