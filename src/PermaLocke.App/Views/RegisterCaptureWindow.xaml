<Window x:Class="PermaLocke.App.Views.RegisterCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rules="clr-namespace:PermaLocke.Rules;assembly=PermaLocke.Rules"
        xmlns:conv="clr-namespace:PermaLocke.App.Converters"
        xmlns:views="clr-namespace:PermaLocke.App.Views"
        xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel"
        Title="PermaLocke — Registrar captura"
        Height="760" Width="680"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{StaticResource PxBaseBrush}">

    <Window.Resources>
        <conv:DisplayNameConverter x:Key="DisplayName" />
        <Style TargetType="ScrollBar" BasedOn="{StaticResource PxScrollBar}" />
        <Style x:Key="Label" TargetType="pixel:PixelText">
            <Setter Property="Scale" Value="2" />
            <Setter Property="Tight" Value="True" />
            <Setter Property="Colour" Value="{StaticResource PxTextFaint}" />
            <Setter Property="Margin" Value="2,0,0,7" />
        </Style>
        <DataTemplate x:Key="PlainItem">
            <pixel:PixelText Text="{Binding}" Scale="2" Tight="True" Colour="{StaticResource PxText}" />
        </DataTemplate>
    </Window.Resources>

    <!-- En píxeles, como el resto de la aplicación (§176). -->
    <Grid>
        <pixel:PixelBackdrop Base="{StaticResource PxBase}" />

        <Grid Margin="18,16,18,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="2,0,0,14">
                <pixel:PixelText Text="REGISTRAR CAPTURA" Scale="4" Tight="True" Colour="{StaticResource PxText}"
                                 Shadow="{StaticResource PxShadow}" />
                <pixel:PixelText Text="Abajo verás si cumple las reglas." Scale="2" Tight="True" Margin="0,8,0,0"
                                 Colour="{StaticResource PxTextDim}" />
            </StackPanel>

            <!-- El formulario -->
            <pixel:PixelWindow Grid.Row="1" Title="LA CAPTURA" Icon="IconGacha" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <pixel:PixelText Text="ESPECIE" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding Species}"
                                  SelectedItem="{Binding SelectedSpecies, Mode=TwoWay}"
                                  Style="{StaticResource PxEditableComboBox}"
                                  IsTextSearchEnabled="True"
                                  TextSearch.TextPath="Name"
                                  MaxDropDownHeight="260">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <pixel:PixelText Text="{Binding Name}" Scale="2" Tight="True" Colour="{StaticResource PxText}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <pixel:PixelText Text="ZONA" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding KnownLocations}"
                                  Text="{Binding LocationName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                  Style="{StaticResource PxEditableComboBox}"
                                  ItemTemplate="{StaticResource PlainItem}" MaxDropDownHeight="260" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,0,0">
                        <pixel:PixelText Text="TIPO DE ENCUENTRO" Style="{StaticResource Label}" />
                        <!-- El dominio está en inglés y el jugador lee español: la lista sigue siendo de enums, y solo
                             la etiqueta pasa por el traductor. -->
                        <ComboBox ItemsSource="{Binding EncounterTypes}"
                                  SelectedItem="{Binding EncounterType, Mode=TwoWay}"
                                  Style="{StaticResource PxComboBox}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <pixel:PixelText Text="{Binding Converter={StaticResource DisplayName}}" Scale="2" Tight="True"
                                                     Colour="{StaticResource PxText}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
                        <pixel:PixelText Text="NIVEL" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding Level, Mode=TwoWay}" Style="{StaticResource PxTextBox}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,14,0,0">
                        <pixel:PixelText Text="MOTE (OPCIONAL)" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding Nickname, Mode=TwoWay}" Style="{StaticResource PxTextBox}" />
                    </StackPanel>

                    <CheckBox Grid.Row="2" Grid.Column="2" Margin="2,14,0,10" VerticalAlignment="Bottom"
                              Content="Es variocolor" Style="{StaticResource PxCheckBox}"
                              IsChecked="{Binding IsShiny, Mode=TwoWay}" />
                </Grid>
            </pixel:PixelWindow>

            <!-- El veredicto. El color lo pone el resultado de las reglas, así que la ventana dice si va a pasar
                 antes de que se pulse nada. -->
            <Grid Grid.Row="2">
                <views:PixelPanel>
                    <views:PixelPanel.Style>
                        <Style TargetType="views:PixelPanel">
                            <Setter Property="Fill" Value="{StaticResource PxFace}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Outcome}" Value="{x:Static rules:RuleOutcome.Blocked}">
                                    <Setter Property="Fill" Value="{StaticResource PxBadDeep}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Outcome}" Value="{x:Static rules:RuleOutcome.Warning}">
                                    <Setter Property="Fill" Value="{StaticResource PxWarnDeep}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Outcome}" Value="{x:Static rules:RuleOutcome.AllowedWithException}">
                                    <Setter Property="Fill" Value="{StaticResource PxGoodDeep}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:PixelPanel.Style>
                </views:PixelPanel>

                <DockPanel Margin="16,13,22,18">
                    <pixel:PixelText DockPanel.Dock="Top" Text="{Binding VerdictTitle}" Scale="3" Tight="True"
                                     Shadow="{StaticResource PxShadow}">
                        <pixel:PixelText.Style>
                            <Style TargetType="pixel:PixelText">
                                <Setter Property="Colour" Value="{StaticResource PxAccentLight}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Outcome}" Value="{x:Static rules:RuleOutcome.Blocked}">
                                        <Setter Property="Colour" Value="{StaticResource PxBad}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Outcome}" Value="{x:Static rules:RuleOutcome.Warning}">
                                        <Setter Property="Colour" Value="{StaticResource PxWarn}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Outcome}" Value="{x:Static rules:RuleOutcome.AllowedWithException}">
                                        <Setter Property="Colour" Value="{StaticResource PxGood}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </pixel:PixelText.Style>
                    </pixel:PixelText>
                    <pixel:PixelText DockPanel.Dock="Top" Text="{Binding VerdictMessage}" Scale="2" Wrap="True"
                                     Colour="{StaticResource PxText}" Margin="0,8,0,12" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Details}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3,8,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <pixel:PixelText Grid.Column="0" Text="{Binding Label}" Scale="2" Tight="True" Trim="True"
                                                         Colour="{StaticResource PxAccent}" />
                                        <pixel:PixelText Grid.Column="1" Text="{Binding Value}" Scale="2" Wrap="True"
                                                         Colour="{StaticResource PxText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Grid>

            <StackPanel Grid.Row="3" Margin="0,14,0,0">
                <pixel:PixelText Text="{Binding ErrorMessage}" Scale="2" Wrap="True" Colour="{StaticResource PxBad}"
                                 Margin="2,0,0,10">
                    <pixel:PixelText.Style>
                        <Style TargetType="pixel:PixelText">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </pixel:PixelText.Style>
                </pixel:PixelText>

                <Button Content="{Binding RegisterLabel}" Command="{Binding RegisterCommand}"
                        Style="{StaticResource PxButton}" HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
