<Window x:Class="PermaLocke.App.Views.RegisterCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rules="clr-namespace:PermaLocke.Rules;assembly=PermaLocke.Rules"
        xmlns:conv="clr-namespace:PermaLocke.App.Converters"
        Title="PermaLocke — Registrar captura"
        Height="660" Width="640"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        Background="{StaticResource AppBackgroundBrush}">

    <Window.Resources>
        <conv:DisplayNameConverter x:Key="DisplayName" />
    </Window.Resources>

    <Grid Margin="20,18,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="REGISTRAR CAPTURA" Style="{StaticResource SectionTitle}" FontSize="24" />
            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"
                       Text="Las reglas se evalúan mientras escribes; el veredicto de abajo es el que se guardará." />
        </StackPanel>

        <!-- Form -->
        <Border Grid.Row="1" Style="{StaticResource Inset}" Padding="16,14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="ESPECIE" Style="{StaticResource StatLabel}" Margin="0,0,0,5" />
                    <ComboBox ItemsSource="{Binding Species}"
                              SelectedItem="{Binding SelectedSpecies, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              TextSearch.TextPath="Name"
                              MaxDropDownHeight="240" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="ZONA" Style="{StaticResource StatLabel}" Margin="0,0,0,5" />
                    <ComboBox ItemsSource="{Binding KnownLocations}"
                              Text="{Binding LocationName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                              IsEditable="True" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,0,0">
                    <TextBlock Text="TIPO DE ENCUENTRO" Style="{StaticResource StatLabel}" Margin="0,0,0,5" />
                    <!-- El dominio está en inglés y el jugador lee español: la lista sigue siendo
                         de enums, y solo la etiqueta pasa por el traductor. -->
                    <ComboBox ItemsSource="{Binding EncounterTypes}"
                              SelectedItem="{Binding EncounterType, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource DisplayName}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
                    <TextBlock Text="NIVEL" Style="{StaticResource StatLabel}" Margin="0,0,0,5" />
                    <TextBox Text="{Binding Level, Mode=TwoWay}" Style="{StaticResource Field}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,14,0,0">
                    <TextBlock Text="MOTE (OPCIONAL)" Style="{StaticResource StatLabel}" Margin="0,0,0,5" />
                    <TextBox Text="{Binding Nickname, Mode=TwoWay}" Style="{StaticResource Field}" />
                </StackPanel>

                <CheckBox Grid.Row="2" Grid.Column="2" Margin="0,14,0,0"
                          Content="✨ Es variocolor"
                          IsChecked="{Binding IsShiny, Mode=TwoWay}"
                          VerticalAlignment="Bottom" Height="34" />
            </Grid>
        </Border>

        <!-- Verdict. El borde lo pinta el resultado de las reglas, así que la ventana dice si va
             a pasar antes de que se pulse nada. -->
        <Border Grid.Row="2" BorderThickness="1.5" Padding="16"
                CornerRadius="{StaticResource RadiusMedium}"
                Background="{StaticResource SurfaceBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentDimBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Outcome}" Value="{x:Static rules:RuleOutcome.Blocked}">
                            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                            <Setter Property="Background" Value="{StaticResource DangerDeepBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Outcome}" Value="{x:Static rules:RuleOutcome.Warning}">
                            <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                            <Setter Property="Background" Value="{StaticResource WarningDeepBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Outcome}"
                                     Value="{x:Static rules:RuleOutcome.AllowedWithException}">
                            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                            <Setter Property="Background" Value="{StaticResource SuccessDeepBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding VerdictTitle}"
                           Style="{StaticResource CardTitle}" FontSize="16" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding VerdictMessage}"
                           Style="{StaticResource Muted}" FontSize="12.5" Margin="0,4,0,12" />

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Details}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                                               Style="{StaticResource Mono}" FontSize="11.5"
                                               Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}"
                                               Style="{StaticResource Body}" FontSize="12" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="{Binding ErrorMessage}" FontSize="12"
                       Foreground="{StaticResource DangerBrush}" Margin="0,0,0,10">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Button Content="{Binding RegisterLabel}" Command="{Binding RegisterCommand}"
                    Style="{StaticResource PrimaryButton}" Padding="22,10"
                    HorizontalAlignment="Right" />
        </StackPanel>
    </Grid>
</Window>
