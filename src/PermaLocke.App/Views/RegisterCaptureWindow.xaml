<Window x:Class="PermaLocke.App.Views.RegisterCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rules="clr-namespace:PermaLocke.Rules;assembly=PermaLocke.Rules"
        Title="PermaLocke — Registrar captura"
        Height="640" Width="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Border Style="{StaticResource Panel}" Margin="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="REGISTRAR CAPTURA" Style="{StaticResource SectionTitle}"
                       FontSize="24" Margin="0,0,0,16" />

            <!-- Form -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="ESPECIE" Style="{StaticResource PanelHeading}" />
                    <ComboBox ItemsSource="{Binding Species}"
                              SelectedItem="{Binding SelectedSpecies, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              TextSearch.TextPath="Name"
                              MaxDropDownHeight="240" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="ZONA" Style="{StaticResource PanelHeading}" />
                    <ComboBox ItemsSource="{Binding KnownLocations}"
                              Text="{Binding LocationName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                              IsEditable="True" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                    <TextBlock Text="TIPO DE ENCUENTRO" Style="{StaticResource PanelHeading}" />
                    <ComboBox ItemsSource="{Binding EncounterTypes}"
                              SelectedItem="{Binding EncounterType, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                    <TextBlock Text="NIVEL" Style="{StaticResource PanelHeading}" />
                    <TextBox Text="{Binding Level, Mode=TwoWay}" Style="{StaticResource Field}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,12,0,0">
                    <TextBlock Text="MOTE (OPCIONAL)" Style="{StaticResource PanelHeading}" />
                    <TextBox Text="{Binding Nickname, Mode=TwoWay}" Style="{StaticResource Field}" />
                </StackPanel>

                <CheckBox Grid.Row="2" Grid.Column="2" Margin="0,32,0,0"
                          Content="✨ Es shiny"
                          IsChecked="{Binding IsShiny, Mode=TwoWay}"
                          Foreground="{StaticResource TextBrush}"
                          FontFamily="{StaticResource UiFont}"
                          VerticalAlignment="Center" />
            </Grid>

            <!-- Verdict -->
            <Border Grid.Row="2" BorderThickness="1.5" Padding="14" Background="{StaticResource SurfaceAltBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource AccentDimBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Outcome}" Value="{x:Static rules:RuleOutcome.Blocked}">
                                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Outcome}" Value="{x:Static rules:RuleOutcome.Warning}">
                                <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Outcome}"
                                         Value="{x:Static rules:RuleOutcome.AllowedWithException}">
                                <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding VerdictTitle}"
                               Style="{StaticResource PanelHeading}" FontSize="15" />
                    <TextBlock DockPanel.Dock="Top" Text="{Binding VerdictMessage}"
                               Style="{StaticResource Body}" Margin="0,0,0,10" />

                    <ItemsControl ItemsSource="{Binding Details}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                                               Style="{StaticResource Mono}" FontSize="12"
                                               Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}"
                                               Style="{StaticResource Body}" FontSize="12" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="3" Margin="0,14,0,0">
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Body}"
                           Foreground="{StaticResource DangerBrush}" Margin="0,0,0,8" />
                <Button Content="{Binding RegisterLabel}" Command="{Binding RegisterCommand}"
                        Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
