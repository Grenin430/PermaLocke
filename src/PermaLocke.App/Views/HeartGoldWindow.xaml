<Window x:Class="PermaLocke.App.Views.HeartGoldWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PermaLocke.App.Views"
        xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel"
        Title="PermaLocke — HeartGold"
        Width="760" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource PxBaseBrush}">

    <Window.Resources>
        <Style x:Key="Label" TargetType="pixel:PixelText">
            <Setter Property="Scale" Value="2" />
            <Setter Property="Tight" Value="True" />
            <Setter Property="Colour" Value="{DynamicResource PxTextFaint}" />
            <Setter Property="Margin" Value="2,0,0,6" />
        </Style>
        <Style x:Key="Value" TargetType="pixel:PixelText">
            <Setter Property="Scale" Value="2" />
            <Setter Property="Wrap" Value="True" />
            <Setter Property="Colour" Value="{DynamicResource PxText}" />
            <Setter Property="Margin" Value="12,9,12,11" />
        </Style>
    </Window.Resources>

    <!-- HeartGold, lo más básico (2026-11-10): randomizar con el Universal Randomizer y jugar con melonDS. Nada más. -->
    <Grid>
        <pixel:PixelBackdrop Base="{DynamicResource PxBase}" />

        <StackPanel Margin="20,16,20,20">
            <DockPanel Margin="2,0,0,16">
                <Button DockPanel.Dock="Right" Content="JUEGOS" Style="{StaticResource PxSubtleButton}" VerticalAlignment="Center"
                        Command="{Binding BackToMenuCommand}" ToolTip="Volver al menú de juegos" />
                <Image Source="pack://application:,,,/Assets/Games/heartgold.png" Height="64" Margin="0,0,14,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <pixel:PixelText Text="HEARTGOLD" Scale="4" Tight="True" Colour="{DynamicResource PxText}"
                                 Shadow="{DynamicResource PxShadow}" VerticalAlignment="Center" />
            </DockPanel>

            <!-- Una copia sin las herramientas (melonDS, el Randomizer y Java) las descarga una vez. -->
            <Grid Margin="0,0,0,12" Visibility="{Binding ToolsMissing, Converter={StaticResource BoolToVisibility}}">
                <views:PixelPanel Fill="{DynamicResource PxWarnDeep}" />
                <DockPanel Margin="14,11,16,14">
                    <Button DockPanel.Dock="Right" Content="DESCARGAR" Style="{StaticResource PxButton}" VerticalAlignment="Center"
                            Margin="12,0,0,0" Command="{Binding DownloadToolsCommand}" />
                    <pixel:PixelText Scale="2" Wrap="True" Colour="{DynamicResource PxText}" VerticalAlignment="Center"
                                     Text="Faltan las herramientas de HeartGold: melonDS, el Randomizer y Java (unos 60 MB, una sola vez)." />
                </DockPanel>
            </Grid>

            <pixel:PixelWindow Title="RANDOMIZAR" Icon="IconRandomizer">
                <StackPanel>
                    <pixel:PixelText Text="TU ROM" Style="{StaticResource Label}" />
                    <Grid Margin="0,0,0,12">
                        <views:PixelPanel Fill="{DynamicResource PxWell}" IsSunken="True" HasShadow="False" />
                        <pixel:PixelText Text="{Binding RomText}" Style="{StaticResource Value}" />
                    </Grid>

                    <pixel:PixelText Text="AJUSTES DEL RANDOMIZER" Style="{StaticResource Label}" />
                    <DockPanel Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" Content="AJUSTES" Style="{StaticResource PxSubtleButton}" Margin="10,0,0,0"
                                VerticalAlignment="Center" Click="OnChooseSettings" />
                        <Grid>
                            <views:PixelPanel Fill="{DynamicResource PxWell}" IsSunken="True" HasShadow="False" />
                            <pixel:PixelText Text="{Binding SettingsText}" Style="{StaticResource Value}" />
                        </Grid>
                    </DockPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="ABRIR EL RANDOMIZER" Style="{StaticResource PxSubtleButton}" Command="{Binding OpenRandomizerCommand}" />
                        <Button Content="RANDOMIZAR" Style="{StaticResource PxButton}" Margin="10,0,0,0" Command="{Binding RandomizeCommand}" />
                    </StackPanel>
                </StackPanel>
            </pixel:PixelWindow>

            <pixel:PixelWindow Title="JUGAR" Icon="IconPlay" Margin="0,12,0,0">
                <StackPanel>
                    <pixel:PixelText Text="ROM RANDOMIZADA" Style="{StaticResource Label}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="▶ JUGAR" Style="{StaticResource PxButton}" Margin="10,0,0,0"
                                VerticalAlignment="Center" Command="{Binding PlayCommand}" />
                        <!-- +10 Caramelos Raros en la partida guardada de esa ROM, con melonDS cerrado (2026-11-10) -->
                        <Button DockPanel.Dock="Right" Content="+10 CARAMELOS RAROS" Style="{StaticResource PxSubtleButton}" Margin="10,0,0,0"
                                VerticalAlignment="Center" Command="{Binding AddRareCandiesCommand}"
                                ToolTip="Guarda en el juego y cierra melonDS antes. Luego carga la partida guardada, no un estado guardado." />
                        <Grid>
                            <views:PixelPanel Fill="{DynamicResource PxWell}" IsSunken="True" HasShadow="False" />
                            <pixel:PixelText Text="{Binding RandomizedText}" Style="{StaticResource Value}" />
                        </Grid>
                    </DockPanel>
                </StackPanel>
            </pixel:PixelWindow>

            <pixel:PixelText Text="{Binding Status}" Scale="2" Wrap="True" Colour="{DynamicResource PxTextDim}" Margin="4,14,4,0" />
        </StackPanel>
    </Grid>
</Window>
