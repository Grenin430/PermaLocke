<Window x:Class="PermaLocke.App.Views.GhostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PermaLocke.App.Views"
        Title="PermaLocke"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize"
        Focusable="False" IsHitTestVisible="False" UseLayoutRounding="True"
        Width="800" Height="600">

    <!-- LOS FANTASMAS DE LOS DEMÁS (§183), encima del emulador. Primero el aviso arriba a la izquierda, con el
         mismo dibujo que el resto de avisos; cuando se va, el fantasma cruza la pantalla de derecha a izquierda.
         Transparente y sin ratón: el juego sigue debajo. -->
    <Grid>
        <Canvas x:Name="Sky" ClipToBounds="True">
            <Image x:Name="Ghost" Opacity="0" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
        </Canvas>

        <Viewbox x:Name="Card" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top"
                 HorizontalAlignment="Left" Margin="12" MaxWidth="440" Visibility="Collapsed">
            <Grid Width="440">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="Slide" X="0" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="1">
                    <views:ToastFrame Kind="{Binding Kind}" />

                    <Grid Margin="15,17,21,17">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <views:ToastPlate Kind="{Binding Kind}" Sprite="{Binding Sprite}" VerticalAlignment="Top" />

                        <StackPanel Grid.Column="1" Margin="14,0,4,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap"
                                       FontFamily="{StaticResource DisplayFont}" FontSize="15.5"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       FontSize="12.5" LineHeight="17" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>

                        <views:ToastCountdown Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0"
                                              Kind="{Binding Kind}" Shown="{Binding Shown}" Linger="{Binding Linger}" />
                    </Grid>
                </Grid>

                <Grid Grid.Row="0" HorizontalAlignment="Left" Margin="15,0,0,-6" Panel.ZIndex="1">
                    <views:ToastFrame Kind="{Binding Kind}" IsTab="True" />
                    <TextBlock Text="{Binding Label}" Margin="11,6,18,8"
                               FontFamily="{StaticResource DisplayFont}" FontSize="11"
                               FontWeight="Bold" Foreground="#FF09070E" />
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
