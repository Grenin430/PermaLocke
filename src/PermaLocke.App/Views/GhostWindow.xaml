<Window x:Class="PermaLocke.App.Views.GhostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PermaLocke"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize"
        Focusable="False" IsHitTestVisible="False" UseLayoutRounding="True"
        Width="800" Height="600">

    <!-- La lluvia de sangre cuando cae el equipo entero (§184), encima del emulador. Transparente y sin ratón: el juego sigue debajo. -->
    <Grid ClipToBounds="True">
        <Image x:Name="Rain" Visibility="Collapsed" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top"
               RenderOptions.BitmapScalingMode="NearestNeighbor" />
    </Grid>
</Window>
