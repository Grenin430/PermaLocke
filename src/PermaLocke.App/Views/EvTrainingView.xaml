<!-- ENTRENAR EV (rehecho el 2026-09-25): a la izquierda el equipo y las cajas; a la derecha la ficha en una franja, y
     debajo las seis estadísticas en filas compactas junto a la gráfica. Cada estadística tiene su color, el de los
     juegos, en la fila y en la gráfica. El presupuesto de 510 y las órdenes van abajo y no se desplazan: siempre a la
     vista. Solo cambia el aspecto: las órdenes y los enlaces son los de siempre. -->
<UserControl x:Class="PermaLocke.App.Views.EvTrainingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PermaLocke.App.Views"
             xmlns:conv="clr-namespace:PermaLocke.App.Converters"
             xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <Style TargetType="ScrollBar" BasedOn="{StaticResource PxScrollBar}" />

        <Color x:Key="UpColor">#FFFF8A6A</Color>
        <Color x:Key="DownColor">#FF7AB0FF</Color>

        <!-- El nombre de una estadística, del color de la naturaleza: rojo sube, azul baja, como en el juego. -->
        <Style x:Key="StatName" TargetType="pixel:PixelText">
            <Setter Property="Scale" Value="2" />
            <Setter Property="Tight" Value="True" />
            <Setter Property="Colour" Value="{DynamicResource PxText}" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="up">
                    <Setter Property="Colour" Value="{StaticResource UpColor}" />
                </Trigger>
                <Trigger Property="Tag" Value="down">
                    <Setter Property="Colour" Value="{StaticResource DownColor}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource PxSubtleButton}">
            <Setter Property="Padding" Value="7,2,10,6" />
            <Setter Property="MinWidth" Value="30" />
        </Style>

        <!-- La casilla del EV: un hueco con la cifra; en ámbar si la has cambiado, en rojo si no vale. -->
        <Style x:Key="EvField" TargetType="TextBox" BasedOn="{StaticResource PxTextBox}">
            <Setter Property="Width" Value="50" />
            <Setter Property="MaxLength" Value="3" />
            <Setter Property="Padding" Value="2,2" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                    <Setter Property="Foreground" Value="#FFFFC04A" />
                </DataTrigger>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="Foreground" Value="#FFFF6A55" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Una etiqueta de la gráfica: el nombre, del color de la naturaleza. Los EV ya están en las filas. -->
        <DataTemplate x:Key="ChartLabel">
            <StackPanel>
                <pixel:PixelText Text="{Binding Short}" Style="{StaticResource StatName}" Tag="{Binding NatureState}"
                                 HorizontalAlignment="{Binding HorizontalAlignment, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
            </StackPanel>
        </DataTemplate>

        <!-- ================================================== UNA ESTADÍSTICA, EN UNA LÍNEA -->
        <DataTemplate x:Key="RowTemplate">
            <Grid Margin="0,0,0,3">
                <views:PixelPanel HasShadow="False">
                    <views:PixelPanel.Style>
                        <Style TargetType="views:PixelPanel">
                            <Setter Property="Fill" Value="{DynamicResource PxFaceHigh}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource PxAccentDeep}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:PixelPanel.Style>
                </views:PixelPanel>

                <Grid Margin="6,2,12,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="124" />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" MinWidth="70" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="92" />
                    </Grid.ColumnDefinitions>

                    <!-- La franja del color de la estadística. -->
                    <Rectangle Grid.Column="0" Width="6" Margin="0,0,10,0" SnapsToDevicePixels="True">
                        <Rectangle.Fill>
                            <SolidColorBrush Color="{Binding Colour}" />
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- El nombre con su flecha de naturaleza. -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <pixel:PixelText Text="{Binding Name}" Style="{StaticResource StatName}" Tag="{Binding NatureState}" />
                            <pixel:PixelText Scale="2" Tight="True" Margin="4,0,0,0">
                                <pixel:PixelText.Style>
                                    <Style TargetType="pixel:PixelText">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NatureState}" Value="up">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Setter Property="Text" Value="▲" />
                                                <Setter Property="Colour" Value="{StaticResource UpColor}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding NatureState}" Value="down">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Setter Property="Text" Value="▼" />
                                                <Setter Property="Colour" Value="{StaticResource DownColor}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </pixel:PixelText.Style>
                            </pixel:PixelText>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <pixel:PixelText Text="IV" Scale="2" Tight="True" Colour="{DynamicResource PxTextFaint}" VerticalAlignment="Center" />
                        <pixel:PixelText Text="{Binding Iv}" Scale="2" Tight="True" Margin="4,0,0,0">
                            <pixel:PixelText.Style>
                                <Style TargetType="pixel:PixelText">
                                    <Setter Property="Colour" Value="{DynamicResource PxTextDim}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Iv}" Value="31">
                                            <Setter Property="Colour" Value="{DynamicResource PxGood}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Iv}" Value="0">
                                            <Setter Property="Colour" Value="{DynamicResource PxBad}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </pixel:PixelText.Style>
                        </pixel:PixelText>
                    </StackPanel>
                    <!-- Los EV en celdas, de 0 a 252, del color de la estadística; en ámbar si has cambiado algo. -->
                    <views:PixelBar Grid.Column="3" Height="14" Margin="0,0,10,0" VerticalAlignment="Center"
                                    Track="{DynamicResource PxInk}" Value="{Binding Fill, Mode=OneWay}">
                        <views:PixelBar.Style>
                            <Style TargetType="views:PixelBar">
                                <Setter Property="Fill" Value="{Binding Colour}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource PxWarn}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:PixelBar.Style>
                    </views:PixelBar>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="-" Style="{StaticResource Small}" AutomationProperties.Name="Quitar cuatro"
                                IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Command="{Binding DataContext.SubtractCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                        <TextBox Style="{StaticResource EvField}" Margin="4,0"
                                 IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Text="{Binding Ev, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                        <Button Content="+" Style="{StaticResource Small}" AutomationProperties.Name="Sumar cuatro"
                                IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>

                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Button Content="MÁX" Style="{StaticResource Small}"
                                IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Command="{Binding DataContext.MaxCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                        <Button Content="0" Style="{StaticResource Small}" Margin="4,0,0,0"
                                IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Command="{Binding DataContext.ClearCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>

                    <!-- La estadística hoy y, si has movido algo, la que quedaría. -->
                    <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <pixel:PixelText Text="{Binding NowText}" Scale="2" Tight="True" VerticalAlignment="Center">
                            <pixel:PixelText.Style>
                                <Style TargetType="pixel:PixelText">
                                    <Setter Property="Colour" Value="{DynamicResource PxText}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowsAfter}" Value="True">
                                            <Setter Property="Colour" Value="{DynamicResource PxTextFaint}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </pixel:PixelText.Style>
                        </pixel:PixelText>
                        <pixel:PixelText Text="▶" Scale="2" Tight="True" Margin="5,0" Colour="{DynamicResource PxTextFaint}"
                                         VerticalAlignment="Center"
                                         Visibility="{Binding ShowsAfter, Converter={StaticResource BoolToVisibility}}" />
                        <pixel:PixelText Text="{Binding After}" Scale="2" Tight="True" VerticalAlignment="Center"
                                         Shadow="{DynamicResource PxShadow}"
                                         Visibility="{Binding ShowsAfter, Converter={StaticResource BoolToVisibility}}">
                            <pixel:PixelText.Style>
                                <Style TargetType="pixel:PixelText">
                                    <Setter Property="Colour" Value="{DynamicResource PxText}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Trend}" Value="up">
                                            <Setter Property="Colour" Value="{DynamicResource PxGood}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Trend}" Value="down">
                                            <Setter Property="Colour" Value="{DynamicResource PxBad}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </pixel:PixelText.Style>
                        </pixel:PixelText>
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="280" MaxWidth="330" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <views:PokemonPickerPanel Grid.Column="0" />

        <!-- Nada elegido. -->
        <pixel:PixelWindow Grid.Column="2" Title="FICHA" Icon="IconDumbbell" VerticalAlignment="Top"
                           Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" Margin="0,28">
                <pixel:PixelIcon Icon="IconDumbbell" Scale="4" Bob="True" HorizontalAlignment="Center" />
                <pixel:PixelText Text="Elige un Pokémon del equipo o de una caja." Scale="2" Tight="True" Margin="0,12,0,0"
                                 Colour="{DynamicResource PxTextDim}" />
            </StackPanel>
        </pixel:PixelWindow>

        <Grid Grid.Column="2" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ====================================== LA FICHA, EN UNA FRANJA -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <views:PixelPanel Fill="{DynamicResource PxFace}" />
                <Grid Margin="12,12,16,14" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="128" Height="128">
                        <views:PixelPanel Fill="{DynamicResource PxWell}" IsSunken="True" HasShadow="False" />
                        <pixel:PixelSprite Source="{Binding SelectedSprite}" Scale="3" TrimEmpty="True" Bob="True"
                                           Outline="{DynamicResource PxShadow}" Stone="{Binding IsFallen}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <pixel:PixelIcon Icon="IconStar" Scale="1" Bob="True" HorizontalAlignment="Right" VerticalAlignment="Top"
                                         Margin="0,6,6,0"
                                         Visibility="{Binding Selected.IsShiny, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="14,2,0,0" VerticalAlignment="Center">
                        <pixel:PixelText Text="{Binding Selected.DisplayName}" Scale="3" Tight="True" Trim="True"
                                         Colour="{DynamicResource PxText}" Shadow="{DynamicResource PxShadow}" />
                        <pixel:PixelText Text="{Binding Where}" Scale="2" Tight="True" Trim="True" Margin="0,5,0,0"
                                         Colour="{DynamicResource PxTextDim}" />

                        <!-- Nivel, tipos, naturaleza con lo que mueve, y caído, en una sola fila de placas. -->
                        <WrapPanel Margin="0,8,0,0">
                            <Grid Margin="0,0,6,4">
                                <views:PixelPanel Fill="{DynamicResource PxFaceLift}" HasShadow="False" />
                                <StackPanel Orientation="Horizontal" Margin="8,5,9,6">
                                    <pixel:PixelText Text="Nv." Scale="2" Tight="True" Colour="{DynamicResource PxTextDim}" />
                                    <pixel:PixelText Text="{Binding Selected.LevelForStats}" Scale="2" Tight="True" Margin="4,0,0,0"
                                                     Colour="{DynamicResource PxText}" />
                                </StackPanel>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding SelectedTypes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,6,4">
                                            <views:PixelPanel Fill="{Binding Colour}" HasShadow="False" />
                                            <pixel:PixelText Text="{Binding Name}" Scale="2" Tight="True" Margin="8,5,9,6"
                                                             Colour="{DynamicResource PxText}" Shadow="{DynamicResource PxShadow}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0,0,6,4">
                                <views:PixelPanel Fill="{DynamicResource PxFaceHigh}" HasShadow="False" />
                                <StackPanel Orientation="Horizontal" Margin="8,5,9,6">
                                    <pixel:PixelText Text="{Binding Selected.NatureName}" Scale="2" Tight="True" Colour="{DynamicResource PxText}" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,6,4">
                                <StackPanel Orientation="Horizontal" Margin="2,5,4,6">
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding IsNeutralNature, Converter={StaticResource InverseBoolToVisibility}}">
                                        <pixel:PixelText Text="▲" Scale="2" Tight="True" Colour="{StaticResource UpColor}" />
                                        <pixel:PixelText Text="{Binding Raised}" Scale="2" Tight="True" Margin="3,0,8,0"
                                                         Colour="{StaticResource UpColor}" />
                                        <pixel:PixelText Text="▼" Scale="2" Tight="True" Colour="{StaticResource DownColor}" />
                                        <pixel:PixelText Text="{Binding Lowered}" Scale="2" Tight="True" Margin="3,0,0,0"
                                                         Colour="{StaticResource DownColor}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,6,4" Visibility="{Binding IsFallen, Converter={StaticResource BoolToVisibility}}">
                                <views:PixelPanel Fill="{DynamicResource PxBadDeep}" HasShadow="False" />
                                <pixel:PixelText Text="CAÍDO" Scale="2" Tight="True" Margin="8,5,9,6" Colour="{DynamicResource PxBad}" />
                            </Grid>
                        </WrapPanel>

                        <pixel:PixelText Text="Un huevo no se entrena." Scale="2" Tight="True" Colour="{DynamicResource PxWarn}"
                                         Visibility="{Binding IsEgg, Converter={StaticResource BoolToVisibility}}" />
                        <pixel:PixelText Text="Está dañado en la partida: no se toca." Scale="2" Wrap="True"
                                         Colour="{DynamicResource PxBad}"
                                         Visibility="{Binding IsDamaged, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Grid>
                <!-- La gráfica: cada pico del color de su estadística, con sus EV al lado. -->
                <pixel:PixelWindow Grid.Column="2" Title="REPARTO" Icon="IconPoints"
                                   Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}">
                    <Canvas Width="248" Height="200" HorizontalAlignment="Center" Margin="0,2,0,0">
                        <views:EvHexagon Canvas.Left="58" Canvas.Top="22" Width="135" Height="156"
                                         Values="{Binding EvValues}" Saved="{Binding SavedValues}"
                                         IsOver="{Binding EvOverBudget}"
                                         Plate="#FF0C0916" Guide="#FF3A2F5E" Fill="#FFB07BF0" OverFill="#FFFF6A55" />

                        <ContentPresenter Canvas.Left="75" Canvas.Top="0" Width="100" HorizontalAlignment="Center"
                                          Content="{Binding Rows[0]}" ContentTemplate="{StaticResource ChartLabel}" />
                        <ContentPresenter Canvas.Left="199" Canvas.Top="54" HorizontalAlignment="Left"
                                          Content="{Binding Rows[1]}" ContentTemplate="{StaticResource ChartLabel}" />
                        <ContentPresenter Canvas.Left="199" Canvas.Top="132" HorizontalAlignment="Left"
                                          Content="{Binding Rows[2]}" ContentTemplate="{StaticResource ChartLabel}" />
                        <ContentPresenter Canvas.Left="75" Canvas.Top="183" Width="100" HorizontalAlignment="Center"
                                          Content="{Binding Rows[5]}" ContentTemplate="{StaticResource ChartLabel}" />
                        <ContentPresenter Canvas.Left="0" Canvas.Top="132" Width="54" HorizontalAlignment="Right"
                                          Content="{Binding Rows[4]}" ContentTemplate="{StaticResource ChartLabel}" />
                        <ContentPresenter Canvas.Left="0" Canvas.Top="54" Width="54" HorizontalAlignment="Right"
                                          Content="{Binding Rows[3]}" ContentTemplate="{StaticResource ChartLabel}" />
                    </Canvas>
                </pixel:PixelWindow>
            </Grid>

            <!-- ====================================== LAS SEIS ESTADÍSTICAS, UNA POR LÍNEA -->
            <pixel:PixelWindow Grid.Row="2" Title="EV" Icon="IconChart"
                               Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowTemplate}" Margin="0,0,4,0" />
                </ScrollViewer>
            </pixel:PixelWindow>

            <!-- ====================================== EL PRESUPUESTO Y LAS ÓRDENES, SIEMPRE A LA VISTA -->
            <Grid Grid.Row="3" Margin="0,8,0,0" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}">
                <views:PixelPanel Fill="{DynamicResource PxFace}" />
                <Grid Margin="14,10,16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="80" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <pixel:PixelText Text="{Binding EvTotal}" Scale="3" Tight="True" Shadow="{DynamicResource PxShadow}">
                            <pixel:PixelText.Style>
                                <Style TargetType="pixel:PixelText">
                                    <Setter Property="Colour" Value="{DynamicResource PxAccentInkLight}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EvOverBudget}" Value="True">
                                            <Setter Property="Colour" Value="{DynamicResource PxBad}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </pixel:PixelText.Style>
                        </pixel:PixelText>
                        <pixel:PixelText Text="/ 510" Scale="2" Tight="True" Margin="6,0,0,1" VerticalAlignment="Bottom"
                                         Colour="{DynamicResource PxTextDim}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                        <views:PixelBar Height="14" Track="{DynamicResource PxInk}" Value="{Binding EvFill, Mode=OneWay}">
                            <views:PixelBar.Style>
                                <Style TargetType="views:PixelBar">
                                    <Setter Property="Fill" Value="{DynamicResource PxAccent}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EvOverBudget}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource PxBad}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:PixelBar.Style>
                        </views:PixelBar>
                        <Grid Margin="0,5,0,0">
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding EvOverBudget, Converter={StaticResource InverseBoolToVisibility}}">
                                <pixel:PixelText Text="QUEDAN" Scale="2" Tight="True" Colour="{DynamicResource PxTextDim}" VerticalAlignment="Center" />
                                <pixel:PixelText Text="{Binding EvRemaining}" Scale="2" Tight="True" Margin="5,0,0,0"
                                                 Colour="{DynamicResource PxText}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding EvOverBudget, Converter={StaticResource BoolToVisibility}}">
                                <pixel:PixelText Text="TE PASAS POR" Scale="2" Tight="True" Colour="{DynamicResource PxBad}" VerticalAlignment="Center" />
                                <pixel:PixelText Text="{Binding EvOver}" Scale="2" Tight="True" Margin="5,0,0,0"
                                                 Colour="{DynamicResource PxBad}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Lo que pasó al guardar: verde si entró, rojo si no. -->
                    <Grid Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center" MaxWidth="320"
                          Visibility="{Binding HasTrainStatus, Converter={StaticResource BoolToVisibility}}">
                        <views:PixelPanel HasShadow="False">
                            <views:PixelPanel.Style>
                                <Style TargetType="views:PixelPanel">
                                    <Setter Property="Fill" Value="{DynamicResource PxGoodDeep}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TrainFailed}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource PxBadDeep}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:PixelPanel.Style>
                        </views:PixelPanel>
                        <pixel:PixelText Text="{Binding TrainStatus}" Scale="2" Wrap="True" Margin="10,6,12,8"
                                         Colour="{DynamicResource PxText}" />
                    </Grid>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="A CERO" Style="{StaticResource PxSubtleButton}" Command="{Binding ClearAllCommand}" />
                        <Button Content="DESHACER" Style="{StaticResource PxSubtleButton}" Margin="8,0,0,0"
                                Command="{Binding RevertCommand}" />
                        <Button Content="GUARDAR" Style="{StaticResource PxButton}" Margin="8,0,0,0" Command="{Binding SaveCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- Problemas y avisos, encima de todo. -->
        <Grid Grid.ColumnSpan="3" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,46,0,0" MaxWidth="760"
              Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
            <views:PixelPanel Fill="{DynamicResource PxWarnDeep}" />
            <pixel:PixelText Text="{Binding Message}" Scale="2" Wrap="True" Margin="16,10,22,16" Colour="{DynamicResource PxText}" />
        </Grid>
    </Grid>
</UserControl>
