<UserControl x:Class="PermaLocke.App.Views.MaintenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Una fila de la auditoría, no una tarjeta. Se separan por una línea abajo, que es como
             se lista algo, y el estado se dice con el color de la cifra y no metiendo cada dato en
             su propio recuadro de colores. -->
        <DataTemplate x:Key="AuditRowTemplate">
            <Border Style="{StaticResource Row}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource Body}"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1" Text="{Binding Value}"
                               FontSize="{StaticResource FontSizeLead}"
                               TextAlignment="Right" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Numeric}">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="warn">
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="bad">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Grid.Column="2" Text="{Binding Note}" Style="{StaticResource Faint}"
                               VerticalAlignment="Center" Margin="16,0,0,0" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,10,0">

            <!-- ================================================== POR QUÉ EXISTE -->
            <Border Style="{StaticResource Inset}">
                <StackPanel>
                    <TextBlock Text="ESTADO DE LA RUN" Style="{StaticResource PanelHeading}" />
                    <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                               Text="Comprueba que lo que la aplicación tiene guardado cuadra con lo que hay en la partida. Las cifras en rojo son cosas que hay que arreglar; las de color ámbar, cosas que conviene mirar." />

                    <Border Style="{StaticResource Divider}" Margin="0,14" />

                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="COMPROBAR"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding AuditCommand}" MinWidth="130"
                                VerticalAlignment="Center" Margin="16,0,0,0" />

                        <TextBlock Text="{Binding Headline}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Healthy}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ================================================== LA AUDITORÍA -->
            <Border Style="{StaticResource Well}" Margin="0,12,0,0">
                <ItemsControl ItemsSource="{Binding Rows}"
                              ItemTemplate="{StaticResource AuditRowTemplate}" />
            </Border>

            <!-- ================================================== REPARAR PID
                 La única reparación que se expone, porque es la única que un jugador puede
                 necesitar y no puede hacer de otra forma. El resto de Probe es investigación
                 -barridos de memoria, diffs de banderas- y se queda en la terminal.

                 Dos botones y no uno, a propósito: primero se mira y se dice cuántos, después se
                 escribe. Un solo botón que hiciera las dos cosas escribiría en la partida sin que
                 nadie hubiera visto antes cuánto iba a tocar. -->
            <Border Style="{StaticResource Inset}" Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource ChipWarning}">
                            <TextBlock Text="ESCRIBE EN LA PARTIDA" Style="{StaticResource ChipText}"
                                       Foreground="{StaticResource WarningBrush}" />
                        </Border>
                        <TextBlock Text="REPARAR LOS PID" Style="{StaticResource PanelHeading}"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Style="{StaticResource Body}" Margin="0,9,0,0"
                               Text="El vigilante empareja el equipo del juego con la run por PID, así que un Pokémon registrado sin PID no se puede detectar: puede caer delante de la aplicación y no se registra su muerte. Esto se lo pone." />

                    <TextBlock Style="{StaticResource Faint}" Margin="0,6,0,0"
                               Text="Empareja por los seis IV más el variocolor, que es lo único que no cambia nunca, y solo acepta firmas únicas por los dos lados. Al que no puede colocar sin ninguna duda lo deja en paz en vez de adivinar. Copia la partida antes y la relee después." />

                    <Border Style="{StaticResource Divider}" Margin="0,14" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="MIRAR CUÁNTOS FALTAN" Style="{StaticResource GhostButton}"
                                Command="{Binding InspectPidsCommand}" MinWidth="200" />
                        <Button Content="ESCRIBIRLOS" Style="{StaticResource PrimaryButton}"
                                Command="{Binding RepairPidsCommand}" MinWidth="150"
                                Margin="10,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="{Binding PidStatus}"
                               Margin="0,12,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PidStatus}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>


            <!-- ================================================== CERRAR ENTREGADOS
                 Un wonder trade daba de alta al que llega y no decía nada del que se va, así que su
                 registro se quedaba «en pie» para siempre. En esta run eran 28 Pokémon que no están
                 en la partida, y contarlos entre los vivos es el mismo error que no contar una
                 muerte: un número que describe otra cosa de la que dice.

                 Las entregas ya se arreglaron en su sitio, así que esto solo mira hacia atrás. -->
            <Border Style="{StaticResource Inset}" Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource ChipInfo}">
                            <TextBlock Text="SOLO LA RUN" Style="{StaticResource ChipText}"
                                       Foreground="{StaticResource InfoBrush}" />
                        </Border>
                        <TextBlock Text="CERRAR LOS ENTREGADOS" Style="{StaticResource PanelHeading}"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Style="{StaticResource Body}" Margin="0,9,0,0"
                               Text="Marca como entregados los Pokémon que diste en un wonder trade y la run sigue contando entre los vivos. No toca la partida: solo el registro, y cada uno deja su propio evento." />

                    <TextBlock Style="{StaticResource Faint}" Margin="0,6,0,0"
                               Text="Se identifica por la especie que el propio evento apuntó como entregada, cruzada con los registros sin PID, que ahora son exactamente los que ya no están en la partida. Si las dos cuentas no coinciden para una especie, esa especie se deja en paz: elegir cuál de dos Giratina se fue sería inventar historia en un registro encadenado por hash." />

                    <Border Style="{StaticResource Divider}" Margin="0,14" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="MIRAR CUÁNTOS HAY" Style="{StaticResource GhostButton}"
                                Command="{Binding InspectTradedCommand}" MinWidth="190" />
                        <Button Content="CERRARLOS" Style="{StaticResource PrimaryButton}"
                                Command="{Binding RepairTradedCommand}" MinWidth="140"
                                Margin="10,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="{Binding TradedStatus}" Margin="0,12,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TradedStatus}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ================================================== ETAPAS
                 El tope en vigor es el MAYOR de dos números: lo que detectan los logros y lo que
                 alguien pulsó cuando HOME todavía tenía botón. Leídos como uno solo no se
                 distinguen, y una run cuyo contador a mano se adelantó tiene un tope que nada
                 justifica: esta llegó a 40 con dos pruebas detectadas.

                 Solo se corrige el de a mano. El detectado lo dice el cartucho. -->
            <Border Style="{StaticResource Inset}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="ETAPAS Y TOPE DE NIVEL" Style="{StaticResource PanelHeading}" />

                    <TextBlock Style="{StaticResource Body}" Margin="0,9,0,0"
                               Text="El tope en vigor es el mayor entre lo que detectan los logros y lo que se marcó a mano. Si el contador de a mano se adelantó, el tope sube sin que ninguna prueba lo respalde. Aquí se corrige." />

                    <Border Style="{StaticResource Well}" Margin="0,12,0,0" Padding="14,11">
                        <TextBlock Text="{Binding StageSummary}" Style="{StaticResource Mono}"
                                   Foreground="{StaticResource TextBrush}" />
                    </Border>

                    <Border Style="{StaticResource Divider}" Margin="0,14" />

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ETAPAS A MANO" Style="{StaticResource StatLabel}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox Text="{Binding ManualStages, UpdateSourceTrigger=PropertyChanged}"
                                 Width="70" VerticalAlignment="Center" />
                        <Button Content="CORREGIR" Style="{StaticResource GhostButton}"
                                Command="{Binding SetStagesCommand}" MinWidth="130"
                                Margin="10,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="{Binding StageStatus}" Margin="0,12,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StageStatus}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>


            <!-- ================================================== MARCAR UNA MUERTE A MANO
                 El vigilante NO puede ver todas las muertes, y no por un fallo: caer es un suceso
                 y lo que leemos es un estado, muestreado cada pocos segundos. Tras un Dominante el
                 juego cura al equipo antes de devolver el control, así que a la siguiente lectura
                 el Pokémon ya está entero. Ningún sondeo cierra esa ventana. -->
            <Border Style="{StaticResource Inset}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="MARCAR UNA MUERTE A MANO" Style="{StaticResource PanelHeading}" />

                    <TextBlock Style="{StaticResource Body}" Margin="0,9,0,0" TextWrapping="Wrap"
                               Text="Para cuando un Pokémon cae y la aplicación no llega a verlo: después de una prueba Dominante el juego cura al equipo antes de devolverte el control, y para cuando PermaLocke vuelve a mirar ya está curado." />

                    <TextBlock Style="{StaticResource Faint}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Queda en el historial como marca TUYA, no como algo que la aplicación haya detectado. Cobra la penalización igual que una muerte normal." />

                    <ComboBox ItemsSource="{Binding AlivePokemon}"
                              SelectedItem="{Binding SelectedAlive}"
                              Margin="0,14,0,0" Width="420" HorizontalAlignment="Left">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding SpeciesName, Mode=OneWay}" />
                                    <Run Text=" · Nv." />
                                    <Run Text="{Binding Level, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBox Text="{Binding DeathReason, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,10,0,0" Width="420" HorizontalAlignment="Left"
                             Tag="Qué pasó (queda escrito en el historial)" />

                    <Button Content="MARCAR COMO CAÍDO" Style="{StaticResource PrimaryButton}"
                            Command="{Binding MarkDeadCommand}" MinWidth="220"
                            HorizontalAlignment="Left" Margin="0,12,0,0" />

                    <TextBlock Text="{Binding DeathStatus}"
                               Margin="0,12,0,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DeathStatus}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ================================================== HACER PERMANENTE LA MUERTE
                 Lo del vigilante es una escritura en MEMORIA: sobrevive solo si el jugador guarda
                 después, y no ocurre siquiera cuando la muerte no se llegó a ver. Esto escribe la
                 partida, así que es definitivo, y es idempotente. -->
            <Border Style="{StaticResource Inset}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="DEJAR A LOS CAÍDOS SIN PS" Style="{StaticResource PanelHeading}" />

                    <TextBlock Style="{StaticResource Body}" Margin="0,9,0,0" TextWrapping="Wrap"
                               Text="Todo Pokémon que la run cuenta como caído se queda a 0 PS SIENDO ÉL: misma especie, mismo mote, mismos movimientos, mismo nivel. Al cargar el juego sale debilitado. Se escribe en la PARTIDA, así que hace falta Azahar cerrado." />

                    <TextBlock Style="{StaticResource Faint}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Normalmente no hace falta pulsarlo: la aplicación lo hace sola en cuanto cierras el emulador. Está aquí por si esa vez falló o por si la aplicación estaba cerrada. Se puede repetir sin miedo: uno que ya esté sin PS se salta." />

                    <TextBlock Style="{StaticResource Faint}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Solo funciona con los del EQUIPO. Un Pokémon guardado en una caja no lleva estadísticas de combate, así que ahí un cero no significaría nada y saldría entero: los que estén en caja se cuentan aparte y no se tocan." />

                    <Border Style="{StaticResource Well}" Margin="0,12,0,0" Padding="14,10">
                        <TextBlock Text="{Binding DeathMarkSummary}" Style="{StaticResource Mono}" />
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="MIRAR CUÁNTOS HAY" Style="{StaticResource GhostButton}"
                                Command="{Binding InspectDeathsCommand}" MinWidth="200" />
                        <Button Content="DEJARLOS SIN PS" Style="{StaticResource PrimaryButton}"
                                Command="{Binding EnforceDeathsCommand}" MinWidth="170"
                                Margin="10,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="{Binding DeathMarkStatus}" Margin="0,12,0,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DeathMarkStatus}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ACCESIBILIDAD. La ventana es de tamano fijo porque el mapa tiene que verse entero,
                 pero QUE tamano es de quien la mira, no de quien eligio el numero. -->
            <Border Style="{StaticResource Inset}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="TAMAÑO DE LA VENTANA" Style="{StaticResource StatLabel}" />
                    <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,6,0,12"
                               Text="Se aplica al momento y se recuerda. Si tu pantalla no da para el tamaño elegido, la ventana se ajusta a lo que quepa." />

                    <ItemsControl ItemsSource="{Binding WindowSizes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Left" Content="{Binding Name}"
                                            Style="{StaticResource GhostButton}"
                                            Padding="16,8" FontSize="11.5" MinWidth="130"
                                            Command="{Binding DataContext.SetWindowSizeCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />

                                    <TextBlock Text="{Binding Why}" Style="{StaticResource Faint}"
                                               VerticalAlignment="Center" Margin="12,0,0,0"
                                               TextWrapping="Wrap" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding WindowSizeStatus}" Margin="0,4,0,0" FontSize="11.5">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowSizeStatus}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
