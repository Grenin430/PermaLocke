<Window x:Class="PermaLocke.App.Views.ChangeRoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PermaLocke.App.Views"
        xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel"
        Title="PermaLocke — Cambiar de rol"
        Height="700" Width="640"
        MinHeight="480" MinWidth="540"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource PxBaseBrush}">

    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource PxScrollBar}" />
    </Window.Resources>

    <!-- En píxeles, como el resto de la aplicación (§176). -->
    <Grid>
        <pixel:PixelBackdrop Base="{DynamicResource PxBase}" />

        <Grid Margin="18,16,18,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="2,0,0,14">
                <pixel:PixelText Text="CAMBIAR DE ROL" Scale="4" Tight="True" Colour="{DynamicResource PxText}"
                                 Shadow="{DynamicResource PxShadow}" />
                <pixel:PixelText Text="{Binding CurrentText}" Scale="2" Tight="True" Margin="0,8,0,0"
                                 Colour="{DynamicResource PxTextDim}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">
                    <!-- El aviso va ARRIBA y no en letra pequeña al final: es lo único de esta ventana que el jugador
                         no puede deshacer con otro cambio de rol. -->
                    <Grid Margin="0,0,0,12">
                        <views:PixelPanel Fill="{DynamicResource PxWarnDeep}" />
                        <StackPanel Margin="14,11,20,16">
                            <pixel:PixelText Text="TU MUNDO NO CAMBIA" Scale="2" Tight="True" Colour="{DynamicResource PxWarn}" />
                            <pixel:PixelText Scale="2" Wrap="True" Margin="0,9,0,0" Colour="{DynamicResource PxText}"
                                             Text="Los puntos cambian al momento. Los enemigos siguen como están hasta que vuelvas a generar e instalar tu mundo." />
                        </StackPanel>
                    </Grid>

                    <pixel:PixelWindow Title="ROL NUEVO" Icon="IconPeople">
                        <views:RoleMenuView DataContext="{Binding Menu}" />
                    </pixel:PixelWindow>

                    <pixel:PixelWindow Title="POR QUÉ" Icon="IconDocument" Margin="0,12,0,0">
                        <StackPanel>
                            <pixel:PixelText Text="Obligatorio." Scale="2" Tight="True" Colour="{DynamicResource PxTextFaint}"
                                             Margin="2,0,0,8" />
                            <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource PxTextBox}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" VerticalContentAlignment="Top" />
                            <pixel:PixelText Text="{Binding Problem}" Scale="2" Wrap="True" Colour="{DynamicResource PxBad}"
                                             Margin="2,10,0,0" />
                        </StackPanel>
                    </pixel:PixelWindow>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="CANCELAR" Style="{StaticResource PxSubtleButton}" Command="{Binding CancelCommand}" />
                <Button Content="CAMBIAR EL ROL" Style="{StaticResource PxButton}" Command="{Binding ConfirmCommand}"
                        Margin="10,0,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
