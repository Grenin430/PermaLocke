<UserControl x:Class="PermaLocke.App.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- LA BARRA DICE SI ES BUENO O MALO. Antes «Puntos ganados» y «Penalización» eran la misma
             barra violeta, o sea que el color no podia significar nada ni queriendo y las barras
             solo decian longitudes. El tono lo trae el dato, que es el unico que sabe lo que
             significa; violeta es el neutro, para lo que de verdad no es ni bueno ni malo.
             BasedOn explicito: un estilo con clave NO hereda del implicito, y sin eso se pierde la
             plantilla del tema y vuelve la barra de Windows. -->
        <Style x:Key="ToneBar" TargetType="ProgressBar"
               BasedOn="{StaticResource {x:Type ProgressBar}}">
            <!-- Nueve y no cinco: a cinco se leia como un subrayado y no como una barra. -->
            <Setter Property="Height" Value="9" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="Good">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Bad">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- La cifra de un record, del color de lo que significa. -->
        <Style x:Key="ToneValue" TargetType="TextBlock" BasedOn="{StaticResource CardTitle}">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="Good">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Bad">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Una linea del libro: concepto, barra, total y cuantas veces. La barra es proporcional
             al mayor de su grupo, no al saldo, porque lo que se compara aqui es una fuente contra
             otra y no cada una contra el total. -->
        <DataTemplate x:Key="LedgerTemplate">
            <Border Style="{StaticResource Row}" Padding="0,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource Body}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                    <ProgressBar Grid.Column="1" Style="{StaticResource ToneBar}"
                                 Value="{Binding Share, Mode=OneWay}" />

                    <TextBlock Grid.Column="2" Text="{Binding Total}" Style="{StaticResource Numeric}"
                               TextAlignment="Right" VerticalAlignment="Center" />

                    <TextBlock Grid.Column="3" Text="{Binding Count, StringFormat=×{0}}"
                               Style="{StaticResource Faint}" TextAlignment="Right"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TallyTemplate">
            <Border Style="{StaticResource Row}" Padding="0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource Body}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                    <ProgressBar Grid.Column="1" Style="{StaticResource ToneBar}"
                                 Value="{Binding Share, Mode=OneWay}" />

                    <TextBlock Grid.Column="2" Text="{Binding Count}" Style="{StaticResource Numeric}"
                               TextAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RecordTemplate">
            <Border Style="{StaticResource Row}" Padding="0,8">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value}"
                                   Style="{StaticResource ToneValue}" />
                        <TextBlock Text="{Binding Label}" Style="{StaticResource Body}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding Detail}" Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Faint}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Detail}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- Sin run: se dice, en vez de enseñar ceros que se leerian como una run que va fatal. -->
        <TextBlock Text="Crea una run y aquí aparecerá todo lo que vaya pasando."
                   Style="{StaticResource Muted}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding HasRun, Converter={StaticResource InverseBoolToVisibility}}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding HasRun, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Margin="0,0,10,0">

                <!-- ================================================== EL BALANCE Y LA CURVA
                     Las tres cifras que resumen la economía, y debajo cómo llegó ahí. La curva se
                     escala entre su propio mínimo y su máximo y no desde cero, porque el saldo
                     PUEDE quedarse en negativo -una penalización no es una compra y no pregunta si
                     puedes pagarla-, y anclada a cero una run que se hundió se dibujaría plana. -->
                <Border Style="{StaticResource Inset}">
                    <StackPanel>
                        <TextBlock Text="LA ECONOMÍA DE LA RUN" Style="{StaticResource PanelHeading}" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <StackPanel Margin="0,0,32,0">
                                <TextBlock Text="SALDO" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding BalanceText}" Style="{StaticResource Display}"
                                           Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>

                            <StackPanel Margin="0,0,32,0" VerticalAlignment="Bottom">
                                <TextBlock Text="GANADO" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding EarnedText}" Style="{StaticResource StatValue}"
                                           Foreground="{StaticResource SuccessBrush}" />
                            </StackPanel>

                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="GASTADO Y PERDIDO" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding SpentText}" Style="{StaticResource StatValue}"
                                           Foreground="{StaticResource DangerBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- LA CURVA. Tres capas: la referencia del cero detras, el area que le da
                             cuerpo, y encima la linea. Las tres se dibujan con Stretch="Fill" sobre
                             la MISMA caja de 100x40 -la curva esta normalizada, asi que toca los dos
                             extremos por construccion-, y por eso encajan sin que nadie calcule
                             pixeles. -->
                        <Grid Height="78" Margin="0,16,0,0"
                              Visibility="{Binding HasCurve, Converter={StaticResource BoolToVisibility}}">

                            <!-- Donde estaria el cero. La curva se escala entre su propio minimo y
                                 su maximo porque el saldo PUEDE quedarse en negativo, y el precio de
                                 eso es que mirandola no sabes de que lado estas. Si la run no cruzo
                                 el cero, esta linea no existe en vez de mentir pegada a un borde. -->
                            <Grid Visibility="{Binding HasZero, Converter={StaticResource BoolToVisibility}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="{Binding ZeroAbove,
                                        Converter={StaticResource FractionToStar}}" />
                                    <RowDefinition Height="{Binding ZeroAbove,
                                        Converter={StaticResource FractionToStar}, ConverterParameter=resto}" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="1" VerticalAlignment="Top" BorderThickness="0,1,0,0"
                                        BorderBrush="{StaticResource BorderStrongBrush}" />
                            </Grid>

                            <Polygon Points="{Binding CurveFill}" Stretch="Fill">
                                <Polygon.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="{StaticResource CurveFillColor}" Offset="0" />
                                        <GradientStop Color="Transparent" Offset="1" />
                                    </LinearGradientBrush>
                                </Polygon.Fill>
                            </Polygon>

                            <Polyline Points="{Binding Curve}" Stretch="Fill"
                                      Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8"
                                      StrokeLineJoin="Round" />
                        </Grid>

                        <TextBlock Text="El saldo evento a evento, de la primera anotación a la última."
                                   Style="{StaticResource Faint}" Margin="0,6,0,0"
                                   Visibility="{Binding HasCurve, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Text="La linea gris es el cero." Style="{StaticResource Faint}"
                                   Margin="0,2,0,0"
                                   Visibility="{Binding HasZero, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- ================================================== EL LIBRO
                     La pregunta que la aplicación no sabía contestar: por qué tienes los puntos
                     que tienes. Sale del PointsDelta que cada evento guardó en su momento, no de
                     los precios de hoy: así sigue siendo verdad aunque se cambie la configuración
                     con una run ya empezada. -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Well}">
                        <StackPanel>
                            <TextBlock Text="DE DÓNDE SALEN" Style="{StaticResource PanelHeading}"
                                       Foreground="{StaticResource SuccessBrush}" />
                            <ItemsControl ItemsSource="{Binding Income}" Margin="0,6,0,0"
                                          ItemTemplate="{StaticResource LedgerTemplate}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Well}">
                        <StackPanel>
                            <TextBlock Text="EN QUÉ SE VAN" Style="{StaticResource PanelHeading}"
                                       Foreground="{StaticResource DangerBrush}" />
                            <ItemsControl ItemsSource="{Binding Outgoings}" Margin="0,6,0,0"
                                          ItemTemplate="{StaticResource LedgerTemplate}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ================================================== LA COLECCIÓN -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Inset}">
                        <StackPanel>
                            <TextBlock Text="DE DÓNDE VIENEN TUS POKÉMON" Style="{StaticResource PanelHeading}" />
                            <ItemsControl ItemsSource="{Binding Origins}" Margin="0,6,0,0"
                                          ItemTemplate="{StaticResource TallyTemplate}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Inset}">
                        <StackPanel>
                            <TextBlock Text="CÓMO HAN ACABADO" Style="{StaticResource PanelHeading}" />
                            <ItemsControl ItemsSource="{Binding Fates}" Margin="0,6,0,0"
                                          ItemTemplate="{StaticResource TallyTemplate}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ================================================== RÉCORDS -->
                <Border Style="{StaticResource Inset}" Margin="0,12,0,0">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="ACTUALIZAR"
                                    Style="{StaticResource SubtleButton}"
                                    Command="{Binding RefreshCommand}" MinWidth="120" />
                            <TextBlock Text="RÉCORDS DE LA RUN" Style="{StaticResource PanelHeading}"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding Records}" Margin="0,8,0,0"
                                      ItemTemplate="{StaticResource RecordTemplate}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
