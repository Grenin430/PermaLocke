<UserControl x:Class="PermaLocke.App.Views.PokemonViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PermaLocke.App.Views"
             xmlns:conv="clr-namespace:PermaLocke.App.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <!-- Un hueco del PC. Los vacíos también se dibujan: la caja del juego tiene treinta
             agujeros estén llenos o no, y pintar solo los ocupados la convertiría en una lista. -->
        <Style x:Key="SlotStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Hole" CornerRadius="6" BorderThickness="1"
                                Background="{StaticResource BackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Un hueco vacío se nota que está vacío: ni borde ni fondo, solo el
                                 agujero. Un PC medio lleno tiene que leerse de un vistazo. -->
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter TargetName="Hole" Property="Opacity" Value="0.4" />
                                <Setter TargetName="Hole" Property="Cursor" Value="Arrow" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hole" Property="Background"
                                        Value="{StaticResource SurfaceHighBrush}" />
                                <Setter TargetName="Hole" Property="BorderBrush"
                                        Value="{StaticResource AccentDimBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Hole" Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Hole" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Hole" Property="Background"
                                        Value="{StaticResource AccentDeepBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SlotTemplate">
            <Grid Height="60">
                <Image Source="{Binding Sprite}" Width="52" Height="52" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                <!-- Hay Pokémon pero no icono: se dice, no se disimula. -->
                <TextBlock Text="{Binding Fallback}" FontSize="20"
                           Foreground="{StaticResource TextFaintBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- Caja del EV: pequeña, centrada y de tres dígitos, porque 252 es lo más que cabe.
             Se recorta sola al escribir, así que un 300 se convierte en 252 delante del jugador
             en vez de aceptarse y fallar luego al guardar. -->
        <Style x:Key="EvBox" TargetType="TextBox" BasedOn="{StaticResource Field}">
            <Setter Property="Width" Value="44" />
            <Setter Property="MaxLength" Value="3" />
            <Setter Property="Padding" Value="4,4" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <!-- Lo que todavía no está en la partida se marca, para que "guardar" no sea
                     un botón que uno pulsa por si acaso. -->
                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Una fila de la tabla: la estadística, de qué está hecha, y lo único que se puede
             mover. La barra de arriba mide el IV, de 0 a 31, que es lo que de verdad distingue a
             dos Pokémon de la misma especie y nivel; la de abajo, el EV de 0 a 252. -->
        <DataTemplate x:Key="StatTemplate">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource Muted}"
                           FontSize="12" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Mono}"
                           FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />

                <!-- Las dos barras, una encima de otra: IV arriba, EV abajo. -->
                <StackPanel Grid.Column="2" Margin="9,0" VerticalAlignment="Center">
                    <ProgressBar Height="5" Minimum="0" Maximum="31"
                                 Value="{Binding Iv, Mode=OneWay}">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Style.Triggers>
                                    <!-- Un 31 se ve de un vistazo sin tener que leer el número. -->
                                    <DataTrigger Binding="{Binding Iv}" Value="31">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Iv}" Value="0">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>

                    <ProgressBar Height="5" Minimum="0" Maximum="1" Margin="0,3,0,0"
                                 Value="{Binding Fill, Mode=OneWay}">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>

                <TextBlock Grid.Column="3" Text="{Binding Iv}" Style="{StaticResource Mono}"
                           FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />

                <TextBox Grid.Column="4" Style="{StaticResource EvBox}" Margin="8,0,0,0"
                         IsEnabled="{Binding DataContext.CanEditEvs,
                                     RelativeSource={RelativeSource AncestorType=UserControl}}"
                         Text="{Binding Ev, UpdateSourceTrigger=PropertyChanged,
                                ValidatesOnExceptions=True}" />

                <!-- Máximo y vaciar, uno al lado del otro: mover 252 puntos de una estadística a
                     otra son dos gestos, y con los dos botones a mano son dos clics. -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="4,0,0,0">
                    <Button Content="MÁX" Style="{StaticResource GhostButton}"
                            Padding="6,4" FontSize="9.5"
                            ToolTip="Pone 252 en esta estadística. Si te pasas de 510, el panel te lo dice y no te deja guardar hasta que quites de otra."
                            IsEnabled="{Binding DataContext.CanEditEvs,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Command="{Binding DataContext.MaxEvCommand,
                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />

                    <Button Content="0" Style="{StaticResource GhostButton}"
                            Padding="7,4" FontSize="9.5" Margin="3,0,0,0"
                            ToolTip="Vacía esta estadística y libera sus EV para las demás."
                            IsEnabled="{Binding DataContext.CanEditEvs,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Command="{Binding DataContext.ClearEvCommand,
                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Etiqueta de una fila de la ficha. -->
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>

        <Style x:Key="FieldValue" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="10,0,0,3" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <!-- =============================================== EL EQUIPO
             Siempre a la vista y aparte del PC, porque es con lo que se está jugando: tener que
             pasar cajas para ver si alguien viene tocado es un paso de más. -->
        <Border Grid.Column="0" Style="{StaticResource Inset}" Padding="14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="EQUIPO" Style="{StaticResource StatLabel}"
                           Margin="0,0,0,10" />

                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button Content="RELEER LA PARTIDA" Style="{StaticResource PrimaryButton}"
                            Command="{Binding LoadCommand}" Padding="12,8" FontSize="11.5"
                            HorizontalAlignment="Stretch" />
                    <Button Content="WONDER TRADE" Style="{StaticResource GhostButton}"
                            Command="{Binding Trade.ArmCommand}" Padding="12,8" FontSize="11.5"
                            HorizontalAlignment="Stretch" Margin="0,6,0,0" />
                    <TextBlock Style="{StaticResource Faint}" Margin="0,8,0,0" MaxWidth="150"
                               Text="{Binding Summary}" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Party}" SelectedItem="{Binding SelectedPartySlot}"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource SlotStyle}"
                         ItemTemplate="{StaticResource SlotTemplate}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VerticalAlignment="Top">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- =============================================== EL PC -->
        <Border Grid.Column="2" Style="{StaticResource Inset}" Padding="16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Cabecera de caja: se pasa de una a otra como en el juego, y da la vuelta. -->
                <Border Grid.Row="0" Margin="0,0,0,12" Padding="8,6"
                        Background="{StaticResource BackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMedium}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="‹" Command="{Binding PreviousBoxCommand}"
                                Style="{StaticResource GhostButton}" MinWidth="40" Padding="0,4"
                                FontSize="17" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardTitle}" HorizontalAlignment="Center"
                                       Text="{Binding SelectedBox.Name}" />
                            <TextBlock Style="{StaticResource Mono}" FontSize="11"
                                       Foreground="{StaticResource TextFaintBrush}"
                                       HorizontalAlignment="Center"
                                       Text="{Binding SelectedBox.Occupancy}" />
                        </StackPanel>

                        <Button Grid.Column="2" Content="›" Command="{Binding NextBoxCommand}"
                                Style="{StaticResource GhostButton}" MinWidth="40" Padding="0,4"
                                FontSize="17" />
                    </Grid>
                </Border>

                <!-- Seis columnas por cinco filas: el PC del juego, tal cual. -->
                <ListBox Grid.Row="1" ItemsSource="{Binding Slots}" SelectedItem="{Binding SelectedSlot}"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource SlotStyle}"
                         ItemTemplate="{StaticResource SlotTemplate}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VerticalAlignment="Top">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="6" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

            </Grid>
        </Border>

        <!-- =============================================== LA FICHA -->
        <Border Grid.Column="4" Style="{StaticResource Inset}" Padding="16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- EL INTERCAMBIO. Dice qué se va a entregar y qué banda va a volver antes
                     de tocar nada: esto es lo único de PermaLocke que destruye algo. -->
                <Border Grid.Row="0" Margin="0,0,0,14" Padding="14"
                        CornerRadius="{StaticResource RadiusMedium}" BorderThickness="1"
                        Background="{StaticResource DangerDeepBrush}"
                        BorderBrush="{StaticResource DangerBrush}"
                        Visibility="{Binding Trade.IsArmed, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource DangerBrush}"
                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Style="{StaticResource StatLabel}" Text="WONDER TRADE"
                                       Foreground="{StaticResource DangerBrush}"
                                       VerticalAlignment="Center" />

                            <!-- Cuantos quedan. Los dan las pruebas, y sin ninguno el intercambio
                                 no deja: es lo que hace que la recompensa signifique algo. -->
                            <Border Style="{StaticResource Chip}" Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding Trade.IsLimited, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource ChipText}">
                                    <Run Text="QUEDAN" />
                                    <Run Text="{Binding Trade.Left, Mode=OneWay}" FontWeight="Bold" />
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <TextBlock Style="{StaticResource Body}" FontSize="12" Margin="0,8,0,0"
                                   Text="{Binding Trade.Instruction}" />

                        <TextBlock Style="{StaticResource Body}" FontSize="12" Margin="0,6,0,0"
                                   Foreground="{StaticResource DangerBrush}"
                                   Text="{Binding Trade.Problem}" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="INTERCAMBIAR" Style="{StaticResource DangerButton}"
                                    Command="{Binding Trade.ConfirmCommand}" MinWidth="140" Padding="14,8" />
                            <Button Content="CANCELAR" Style="{StaticResource GhostButton}"
                                    Command="{Binding Trade.CancelCommand}" MinWidth="105" Padding="14,8"
                                    Margin="8,0,0,0" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource Faint}" Margin="0,10,0,0"
                                   Text="El que entregues desaparece de la caja y su sitio lo ocupa el que llegue, que vendrá al mismo nivel. Se copia la partida entera antes de tocarla y se relee después para comprobarlo. Exige el juego cerrado." />
                    </StackPanel>
                </Border>

                <!-- Sin selección: un hueco explicado, no un panel en blanco. -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                            MaxWidth="240">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Border Width="44" Height="44" CornerRadius="8" HorizontalAlignment="Center"
                            Background="{StaticResource BackgroundBrush}"
                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
                        <Ellipse Width="14" Height="14" Stroke="{StaticResource TextFaintBrush}"
                                 StrokeThickness="2"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,14,0,0"
                               Text="Pincha un Pokémon de la caja para ver su ficha." />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="0,0,6,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="80" Height="80"
                                    CornerRadius="{StaticResource RadiusMedium}"
                                    Background="{StaticResource BackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    VerticalAlignment="Top">
                                <Image Source="{Binding SelectedSprite}" Width="68" Height="68"
                                       Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,2,0,0">
                                <TextBlock Style="{StaticResource CardTitle}" FontSize="19">
                                    <Run Text="{Binding Selected.DisplayName, Mode=OneWay}" /><Run
                                        Text="{Binding Selected.GenderMark, Mode=OneWay}"
                                        FontFamily="Segoe UI Symbol" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"
                                           Text="{Binding Selected.Subtitle}" />

                                <WrapPanel Margin="0,7,0,0">
                                    <!-- Estar en el equipo cambia lo que se puede hacer con él:
                                         los EV sí, el wonder trade no, porque ese escribe en las
                                         cajas y el equipo es otro almacén de la partida. -->
                                    <Border Style="{StaticResource Chip}" Margin="0,0,6,0"
                                            Background="{StaticResource SuccessDeepBrush}"
                                            BorderBrush="{StaticResource SuccessBrush}"
                                            Visibility="{Binding Selected.IsInParty,
                                                         Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="EN EL EQUIPO" Style="{StaticResource ChipText}"
                                                   Foreground="{StaticResource SuccessBrush}" />
                                    </Border>

                                    <Border Style="{StaticResource Chip}"
                                            Background="{StaticResource AccentDeepBrush}"
                                            BorderBrush="{StaticResource AccentBrush}"
                                            Visibility="{Binding Selected.IsShiny,
                                                         Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="✨ VARIOCOLOR" Style="{StaticResource ChipText}"
                                                   Foreground="{StaticResource AccentBrightBrush}" />
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="82" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Naturaleza" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldValue}"
                                       Text="{Binding Selected.NatureName}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Habilidad" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValue}"
                                       Text="{Binding Selected.AbilityName}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Objeto" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldValue}"
                                       Text="{Binding Selected.HeldItemName}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Ball" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldValue}"
                                       Text="{Binding Selected.BallName}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Entrenador" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldValue}"
                                       Text="{Binding Selected.TrainerName}" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Encuentro" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource FieldValue}">
                                <Run Text="{Binding Selected.MetLocationName, Mode=OneWay}" />
                                <Run Text=" · Nv." /><Run Text="{Binding Selected.MetLevel, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,14" />

                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" FontSize="11"
                                       Foreground="{StaticResource TextFaintBrush}"
                                       Text="{Binding Selected.IvTotal, StringFormat='IV total {0} de 186'}" />
                            <TextBlock Style="{StaticResource StatLabel}" Text="ESTADÍSTICA · IV · EV" />
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding Stats}" ItemTemplate="{StaticResource StatTemplate}" />

                        <!-- Una caja no guarda las estadísticas de combate, así que hay que
                             calcularlas, y el cálculo usa las bases del cartucho sin randomizar.
                             Se dice en vez de dar el número por bueno: medido sobre una copia de
                             la partida real, un Kommo-o con 168 PS se recalculaba en 151. -->
                        <TextBlock Style="{StaticResource Faint}" Margin="0,8,0,0"
                                   Visibility="{Binding Selected.StatsAreComputed,
                                                Converter={StaticResource BoolToVisibility}}"
                                   Text="La columna de la izquierda está calculada: una caja no guarda las estadísticas de combate. Como tu ROM lleva las bases barajadas, puede no coincidir con lo que verás en el juego. Los del equipo sí son los números que guardó el juego." />

                        <!-- ================================== EL REPARTO DE EV
                             Los dos techos no son una regla de PermaLocke, son el formato: el juego
                             no reparte más de 252 en una estadística ni más de 510 en total, y
                             pasarse deja un Pokémon que el cartucho considera ilegal. -->
                        <Border Style="{StaticResource Inset}" Padding="12,10" Margin="0,12,0,0"
                                Visibility="{Binding CanEditEvs, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" FontSize="11">
                                        <Run Text="{Binding EvTotal, Mode=OneWay}" FontWeight="Bold">
                                            <Run.Style>
                                                <Style TargetType="Run">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EvOverBudget}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Run.Style>
                                        </Run><Run Text=" / 510" Foreground="{StaticResource TextFaintBrush}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource StatLabel}" Text="REPARTO DE EV" />
                                </DockPanel>

                                <ProgressBar Height="6" Minimum="0" Maximum="1" Margin="0,8,0,0"
                                             Value="{Binding EvFill, Mode=OneWay}">
                                    <ProgressBar.Style>
                                        <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EvOverBudget}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>

                                <!-- Repartir es libre: puedes poner 252 en Velocidad teniendo ya
                                     504 repartidos y quitar de PS después, en el orden que te dé
                                     la gana. Lo único que no se puede es guardarlo así. -->
                                <TextBlock Style="{StaticResource Faint}" Margin="0,6,0,0"
                                           Visibility="{Binding EvOverBudget,
                                                        Converter={StaticResource InverseBoolToVisibility}}"
                                           Text="{Binding EvRemaining, StringFormat='Quedan {0} EV por repartir. Máximo 252 en cada una y 510 entre las seis: son los topes del propio juego. Puedes pasarte mientras repartes y quitar de otra después.'}" />

                                <Border Margin="0,8,0,0" Padding="10,7"
                                        CornerRadius="{StaticResource RadiusSmall}"
                                        Background="{StaticResource DangerDeepBrush}"
                                        BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                                        Visibility="{Binding EvOverBudget,
                                                     Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource Body}" FontSize="11.5"
                                               Foreground="{StaticResource DangerBrush}"
                                               Text="{Binding EvOver, StringFormat='Te pasas por {0} EV. Quita de otra estadística y podrás guardar; el juego no admite más de 510 entre las seis.'}" />
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="GUARDAR EN LA PARTIDA"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="12,7" FontSize="11"
                                            Command="{Binding SaveEvsCommand}" />
                                    <Button Content="DESHACER" Style="{StaticResource GhostButton}"
                                            Padding="12,7" FontSize="11" Margin="6,0,0,0"
                                            Command="{Binding RevertEvsCommand}" />
                                    <Button Content="A CERO" Style="{StaticResource GhostButton}"
                                            Padding="12,7" FontSize="11" Margin="6,0,0,0"
                                            Command="{Binding ClearAllEvsCommand}" />
                                </StackPanel>

                                <TextBlock Style="{StaticResource Faint}" Margin="0,8,0,0"
                                           Text="Escribir exige el juego cerrado. Se copia la partida entera antes de tocarla, se relee después para comprobarlo, y el cambio queda en el historial de la run." />

                                <!-- Lo que pasó de verdad al escribir, en verde o en rojo. Nunca
                                     se da por buena una escritura que no se ha vuelto a leer. -->
                                <Border Margin="0,10,0,0" Padding="10,7"
                                        CornerRadius="{StaticResource RadiusSmall}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Background" Value="{StaticResource SuccessDeepBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TrainStatus}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TrainFailed}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource DangerDeepBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding TrainStatus}" Style="{StaticResource Body}"
                                               FontSize="11.5" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Divider}" Margin="0,14" />

                        <TextBlock Style="{StaticResource StatLabel}" Text="MOVIMIENTOS" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Selected.Moves}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BackgroundBrush}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusSmall}"
                                            Padding="9,5" Margin="0,0,0,4">
                                        <TextBlock Style="{StaticResource Body}" FontSize="12"
                                                   Text="{Binding}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource Mono}" FontSize="10" Margin="0,14,0,0"
                                   Foreground="{StaticResource TextFaintBrush}"
                                   Text="{Binding Selected.Pid, StringFormat='PID {0:X8}'}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Problemas y avisos, encima de todo, porque son lo primero que hay que leer. -->
        <Border Grid.Column="0" Grid.ColumnSpan="5" VerticalAlignment="Top" Margin="12"
                Background="{StaticResource SurfaceHighBrush}"
                CornerRadius="{StaticResource RadiusMedium}" Padding="16,13"
                BorderThickness="1" BorderBrush="{StaticResource AccentBrush}"
                Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource Body}" FontSize="12" Text="{Binding Message}" />
        </Border>

        <!-- LA ANIMACIÓN, encima de todo. Solo aparece con el intercambio en marcha. -->
        <views:WonderTradeOverlay Grid.Column="0" Grid.ColumnSpan="5" DataContext="{Binding Trade}"
                                  Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
