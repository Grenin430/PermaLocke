<UserControl x:Class="PermaLocke.App.Views.PokemonViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PermaLocke.App.Views"
             xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel"
             xmlns:conv="clr-namespace:PermaLocke.App.Converters">

    <!--
        EL VISOR EN PÍXELES (§176): el PC del juego. A la izquierda el equipo como el menú del equipo, en el centro la
        caja con su fondo y debajo las 32 cajas en miniatura con lo llenas que están, y a la derecha la ficha como la
        pantalla de datos: retrato, tipos, naturaleza con lo que sube y baja, estadísticas con sus IV y los cuatro
        ataques del color de su tipo. Mismos datos y mismas órdenes que antes; nada se escribe desde aquí salvo el
        wonder trade, que sigue siendo su propio servicio.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <Style TargetType="ScrollBar" BasedOn="{StaticResource PxScrollBar}" />

        <Style x:Key="PxLabel" TargetType="pixel:PixelText">
            <Setter Property="Scale" Value="2" />
            <Setter Property="Tight" Value="True" />
            <Setter Property="Colour" Value="{StaticResource PxTextFaint}" />
        </Style>

        <Style x:Key="PxValue" TargetType="pixel:PixelText">
            <Setter Property="Scale" Value="2" />
            <Setter Property="Tight" Value="True" />
            <Setter Property="Trim" Value="True" />
            <Setter Property="Colour" Value="{StaticResource PxText}" />
        </Style>

        <Style x:Key="BareList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Un hueco del PC: un agujero hundido en el fondo de la caja, los vacíos también. Caído: rojo. Elegido: el
             cursor de esquinas del juego. -->
        <Style x:Key="SlotStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent">
                            <views:PixelPanel x:Name="Hole" IsSunken="True" HasShadow="False" Fill="#C80D0A16" />
                            <ContentPresenter />
                            <views:PixelCursor x:Name="Cursor" Margin="-3" Visibility="Collapsed"
                                               Colour="{StaticResource PxGold}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter TargetName="Hole" Property="Fill" Value="#880D0A16" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDead}" Value="True">
                                <Setter TargetName="Hole" Property="Fill" Value="#D8421A20" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hole" Property="Fill" Value="#E02C2446" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Hole" Property="Fill" Value="#F03A2766" />
                                <Setter TargetName="Cursor" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- El icono al doble y en píxeles enteros, en piedra si ha caído, con sus marcas en las esquinas. -->
        <DataTemplate x:Key="SlotTemplate">
            <Grid Height="70">
                <pixel:PixelSprite Source="{Binding Sprite}" Scale="2" TrimEmpty="True" Outline="{StaticResource PxShadow}"
                                   Stone="{Binding IsDead}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Bob="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />

                <pixel:PixelIcon Icon="IconCross" Scale="1" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                 Margin="6,0,0,4" Visibility="{Binding IsDead, Converter={StaticResource BoolToVisibility}}" />
                <pixel:PixelIcon Icon="IconStar" Scale="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,5,6,0" Visibility="{Binding IsShiny, Converter={StaticResource BoolToVisibility}}" />

                <pixel:PixelText Text="{Binding Fallback}" Scale="3" Tight="True" Colour="{StaticResource PxTextFaint}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- Una fila del equipo, como el menú del equipo del juego: su placa, el icono, el nombre, el nivel y el
             símbolo de sexo. Elegida: la placa se enciende y sale la flecha. -->
        <Style x:Key="PartyRowStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent" Height="60">
                            <views:PixelPanel x:Name="Plate" Fill="{StaticResource PxFaceHigh}" HasShadow="False" />
                            <pixel:PixelText x:Name="Arrow" Text="▶" Scale="2" Tight="True" Visibility="Hidden"
                                             Colour="{StaticResource PxGold}" VerticalAlignment="Center" Margin="-4,0,0,0" />
                            <ContentPresenter Margin="12,0,10,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter TargetName="Plate" Property="Fill" Value="{StaticResource PxWell}" />
                                <Setter TargetName="Plate" Property="IsSunken" Value="True" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDead}" Value="True">
                                <Setter TargetName="Plate" Property="Fill" Value="{StaticResource PxBadDeep}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Fill" Value="{StaticResource PxFaceLift}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Plate" Property="Fill" Value="{StaticResource PxAccentDeep}" />
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="PartyRowTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <pixel:PixelSprite Grid.Column="0" Source="{Binding Sprite}" Scale="2" TrimEmpty="True"
                                   Outline="{StaticResource PxShadow}" Stone="{Binding IsDead}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Bob="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                    <pixel:PixelText Text="{Binding Pokemon.DisplayName}" Style="{StaticResource PxValue}"
                                     Shadow="{StaticResource PxShadow}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <pixel:PixelText Text="Nv." Style="{StaticResource PxLabel}" />
                        <pixel:PixelText Text="{Binding Pokemon.Level}" Scale="2" Tight="True" Margin="4,0,0,0"
                                         Colour="{StaticResource PxTextDim}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <pixel:PixelText Text="{Binding Pokemon.GenderMark}" Scale="2" Tight="True" HorizontalAlignment="Right">
                        <pixel:PixelText.Style>
                            <Style TargetType="pixel:PixelText">
                                <Setter Property="Colour" Value="{StaticResource PxTextDim}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Pokemon.GenderMark}" Value="♂">
                                        <Setter Property="Colour" Value="#FF7AB0FF" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Pokemon.GenderMark}" Value="♀">
                                        <Setter Property="Colour" Value="#FFFF8AB0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </pixel:PixelText.Style>
                    </pixel:PixelText>
                    <pixel:PixelIcon Icon="IconStar" Scale="1" HorizontalAlignment="Right" Margin="0,5,0,0"
                                     Visibility="{Binding IsShiny, Converter={StaticResource BoolToVisibility}}" />
                    <pixel:PixelIcon Icon="IconCross" Scale="1" HorizontalAlignment="Right" Margin="0,5,0,0"
                                     Visibility="{Binding IsDead, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <pixel:PixelText Grid.ColumnSpan="3" Text="HUECO LIBRE" Style="{StaticResource PxLabel}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DataTemplate>

        <!-- Una caja del selector: su número y una barrita de lo llena que está. La de la pantalla, encendida. -->
        <Style x:Key="BoxTileStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTip" Value="{Binding Label}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent" Height="42">
                            <views:PixelPanel x:Name="Plate" Fill="{StaticResource PxWell}" IsSunken="True" HasShadow="False" />
                            <pixel:PixelText x:Name="Number" Text="{Binding Number}" Scale="2" Tight="True"
                                             Colour="{StaticResource PxTextDim}" HorizontalAlignment="Center"
                                             VerticalAlignment="Top" Margin="0,3,0,0" />
                            <views:PixelBar Height="9" Margin="6,0,6,4" VerticalAlignment="Bottom"
                                            Value="{Binding Share, Mode=OneWay}" Fill="{StaticResource PxAccent}"
                                            Track="{StaticResource PxInk}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter TargetName="Number" Property="Colour" Value="{StaticResource PxTextFaint}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Fill" Value="{StaticResource PxFaceLift}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Plate" Property="Fill" Value="{StaticResource PxAccentDeep}" />
                                <Setter TargetName="Plate" Property="IsSunken" Value="False" />
                                <Setter TargetName="Number" Property="Colour" Value="{StaticResource PxText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Una fila de estadísticas: el nombre del color de la naturaleza (rojo sube, azul baja, como en el juego),
             el valor, sus IV en 31 celdas y el número. -->
        <DataTemplate x:Key="StatTemplate">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>

                <pixel:PixelText Grid.Column="0" Text="{Binding Name}" Scale="2" Tight="True" VerticalAlignment="Center">
                    <pixel:PixelText.Style>
                        <Style TargetType="pixel:PixelText">
                            <Setter Property="Colour" Value="{StaticResource PxTextDim}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NatureState}" Value="up">
                                    <Setter Property="Colour" Value="#FFFF8A6A" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NatureState}" Value="down">
                                    <Setter Property="Colour" Value="#FF7AB0FF" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </pixel:PixelText.Style>
                </pixel:PixelText>
                <pixel:PixelText Grid.Column="1" Text="{Binding Value}" Scale="2" Tight="True" TextAlignment="Right"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" Colour="{StaticResource PxText}" />

                <views:PixelBar Grid.Column="2" Height="15" Margin="12,0,10,0" VerticalAlignment="Center"
                                Value="{Binding IvShare, Mode=OneWay}">
                    <views:PixelBar.Style>
                        <Style TargetType="views:PixelBar">
                            <Setter Property="Fill" Value="{StaticResource PxAccent}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Iv}" Value="31">
                                    <Setter Property="Fill" Value="{StaticResource PxGood}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Iv}" Value="0">
                                    <Setter Property="Fill" Value="{StaticResource PxBad}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:PixelBar.Style>
                </views:PixelBar>

                <pixel:PixelText Grid.Column="3" Text="{Binding Iv}" Scale="2" Tight="True" HorizontalAlignment="Right"
                                 VerticalAlignment="Center" Colour="{StaticResource PxTextDim}" />
            </Grid>
        </DataTemplate>

        <!-- Un ataque en su placa del color de su tipo, como en combate: nombre, y debajo tipo, categoría y potencia. -->
        <DataTemplate x:Key="MoveTemplate">
            <Grid Margin="0,0,0,8" Height="60">
                <views:PixelPanel Fill="{Binding TypeColour}" HasShadow="False" />
                <views:PixelPanel Fill="#48000000" HasShadow="False" Margin="3,30,3,3" />
                <Grid Margin="12,8,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <pixel:PixelText Grid.Row="0" Text="{Binding Name}" Scale="2" Tight="True" Trim="True"
                                     Colour="{StaticResource PxText}" Shadow="{StaticResource PxShadow}" />
                    <pixel:PixelText Grid.Row="0" Text="{Binding TypeName}" Scale="2" Tight="True" HorizontalAlignment="Right"
                                     Colour="#E6FFFFFF" Shadow="#80000000" />

                    <DockPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,2,0,0"
                               Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <pixel:PixelText Text="POT" Scale="2" Tight="True" Colour="#B4FFFFFF" />
                            <pixel:PixelText Text="{Binding Power}" Scale="2" Tight="True" Margin="5,0,14,0" Colour="{StaticResource PxText}" />
                            <pixel:PixelText Text="PREC" Scale="2" Tight="True" Colour="#B4FFFFFF" />
                            <pixel:PixelText Text="{Binding Accuracy}" Scale="2" Tight="True" Margin="5,0,14,0" Colour="{StaticResource PxText}" />
                            <pixel:PixelText Text="PP" Scale="2" Tight="True" Colour="#B4FFFFFF" />
                            <pixel:PixelText Text="{Binding PP}" Scale="2" Tight="True" Margin="5,0,0,0" Colour="{StaticResource PxText}" />
                        </StackPanel>
                        <pixel:PixelSprite DockPanel.Dock="Left" Source="{Binding CategoryIcon}" Scale="1"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                        <pixel:PixelText Text="{Binding CategoryText}" Scale="2" Tight="True" Colour="#E6FFFFFF"
                                         VerticalAlignment="Center" />
                    </DockPanel>
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="292" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="430" />
        </Grid.ColumnDefinitions>

        <!-- =============================================== EL EQUIPO -->
        <pixel:PixelWindow Grid.Column="0" Title="EQUIPO" Icon="IconGacha" Padding="14,12,20,18">
            <pixel:PixelWindow.HeaderContent>
                <!-- Una Poké Ball del cartucho por hueco, como la fila de balls del combate: llena, gris o tachada. -->
                <ItemsControl ItemsSource="{Binding Party}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,0,0,0">
                                <pixel:PixelSprite Scale="1" Source="{Binding DataContext.PartyBallSprite,
                                                   RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <pixel:PixelSprite.Style>
                                        <Style TargetType="pixel:PixelSprite">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                    <Setter Property="Silhouette" Value="{StaticResource PxFaceLift}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDead}" Value="True">
                                                    <Setter Property="Stone" Value="True" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </pixel:PixelSprite.Style>
                                </pixel:PixelSprite>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </pixel:PixelWindow.HeaderContent>

            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Button Content="RELEER LA PARTIDA" Style="{StaticResource PxButton}" Command="{Binding LoadCommand}"
                            HorizontalAlignment="Stretch" />
                    <Button Content="WONDER TRADE" Style="{StaticResource PxSubtleButton}"
                            Command="{Binding Trade.ArmCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0" />
                    <pixel:PixelText Text="{Binding Summary}" Scale="2" Wrap="True" Margin="2,10,0,0"
                                     Colour="{StaticResource PxTextFaint}" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Party}" SelectedItem="{Binding SelectedPartySlot}"
                         Style="{StaticResource BareList}" VerticalAlignment="Top"
                         ItemContainerStyle="{StaticResource PartyRowStyle}"
                         ItemTemplate="{StaticResource PartyRowTemplate}" />
            </DockPanel>
        </pixel:PixelWindow>

        <!-- =============================================== EL PC -->
        <pixel:PixelWindow Grid.Column="2" Title="CAJAS DEL PC" Icon="IconGrid" Padding="14,12,20,18">
            <pixel:PixelWindow.HeaderContent>
                <pixel:PixelText Text="{Binding SelectedBox.Occupancy}" Scale="2" Tight="True"
                                 Colour="{StaticResource PxTextDim}" />
            </pixel:PixelWindow.HeaderContent>

            <DockPanel>
                <!-- La placa de la caja, como en el PC del juego: se pasa de una a otra y da la vuelta. -->
                <Grid DockPanel.Dock="Top" Height="54" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="◀" Style="{StaticResource PxSubtleButton}" Padding="14,8,20,13"
                            Command="{Binding PreviousBoxCommand}" VerticalAlignment="Center"
                            AutomationProperties.Name="Caja anterior" />

                    <Grid Grid.Column="1" Margin="8,0">
                        <views:PixelPanel Fill="{StaticResource PxAccentDeep}" />
                        <pixel:PixelText Text="{Binding SelectedBox.Name}" Scale="3" Tight="True" Trim="True"
                                         Colour="{StaticResource PxText}" Shadow="{StaticResource PxShadow}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0,18,6" />
                    </Grid>

                    <Button Grid.Column="2" Content="▶" Style="{StaticResource PxSubtleButton}" Padding="14,8,20,13"
                            Command="{Binding NextBoxCommand}" VerticalAlignment="Center"
                            AutomationProperties.Name="Caja siguiente" />
                </Grid>

                <!-- Las 32 cajas en miniatura: un vistazo a dónde hay Pokémon, y un clic para ir. -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <pixel:PixelText Text="TODAS LAS CAJAS" Style="{StaticResource PxLabel}" Margin="2,0,0,6" />
                    <ListBox ItemsSource="{Binding Boxes}" SelectedItem="{Binding SelectedBox}"
                             Style="{StaticResource BareList}" ItemContainerStyle="{StaticResource BoxTileStyle}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="8" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </StackPanel>

                <!-- Seis por cinco sobre el fondo de la caja. -->
                <Grid VerticalAlignment="Top">
                    <views:PixelPanel Fill="{StaticResource PxInk}" HasShadow="False" />
                    <views:BoxWallpaper Theme="{Binding BoxTheme}" Margin="3" />
                    <ListBox ItemsSource="{Binding Slots}" SelectedItem="{Binding SelectedSlot}"
                             Style="{StaticResource BareList}" Margin="11"
                             ItemContainerStyle="{StaticResource SlotStyle}"
                             ItemTemplate="{StaticResource SlotTemplate}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="6" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </Grid>
            </DockPanel>
        </pixel:PixelWindow>

        <!-- =============================================== LA FICHA -->
        <pixel:PixelWindow Grid.Column="4" Title="FICHA" Icon="IconDocument" Padding="16,12,20,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- EL INTERCAMBIO. Dice qué se va a entregar antes de tocar nada. -->
                <Grid Grid.Row="0" Margin="0,0,0,14"
                      Visibility="{Binding Trade.IsArmed, Converter={StaticResource BoolToVisibility}}">
                    <views:PixelPanel Fill="#FF2E1418" />
                    <StackPanel Margin="16,12,22,20">
                        <DockPanel>
                            <Grid DockPanel.Dock="Right" Visibility="{Binding Trade.IsLimited, Converter={StaticResource BoolToVisibility}}">
                                <views:PixelPanel Fill="{StaticResource PxFaceLift}" HasShadow="False" />
                                <StackPanel Orientation="Horizontal" Margin="9,6,9,7">
                                    <pixel:PixelText Text="QUEDAN" Style="{StaticResource PxLabel}" Colour="{StaticResource PxTextDim}" />
                                    <pixel:PixelText Text="{Binding Trade.Left}" Scale="2" Tight="True" Margin="6,0,0,0"
                                                     Colour="{StaticResource PxText}" />
                                </StackPanel>
                            </Grid>
                            <pixel:PixelText Text="WONDER TRADE" Scale="2" Tight="True" VerticalAlignment="Center"
                                             Colour="{StaticResource PxBad}" Shadow="{StaticResource PxShadow}" />
                        </DockPanel>

                        <pixel:PixelText Text="{Binding Trade.Instruction}" Scale="2" Wrap="True" Margin="0,10,0,0"
                                         Colour="{StaticResource PxText}" />
                        <pixel:PixelText Text="{Binding Trade.Problem}" Scale="2" Wrap="True" Margin="0,6,0,0"
                                         Colour="{StaticResource PxBad}" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="INTERCAMBIAR" Style="{StaticResource PxDangerButton}"
                                    Command="{Binding Trade.ConfirmCommand}" />
                            <Button Content="CANCELAR" Style="{StaticResource PxSubtleButton}"
                                    Command="{Binding Trade.CancelCommand}" Margin="8,0,0,0" />
                        </StackPanel>

                        <pixel:PixelText Text="El que entregues se va y llega otro al mismo nivel. Cierra Azahar antes."
                                         Scale="2" Wrap="True" Margin="0,10,0,0" Colour="{StaticResource PxTextFaint}" />
                    </StackPanel>
                </Grid>

                <!-- Sin selección: el resumen de la partida, como una hoja de datos. -->
                <StackPanel Grid.Row="1" VerticalAlignment="Top">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <pixel:PixelText Text="LA PARTIDA" Style="{StaticResource PxLabel}" Margin="2,2,0,8" />

                    <Grid>
                        <views:PixelPanel Fill="{StaticResource PxWell}" IsSunken="True" HasShadow="False" />
                        <ItemsControl ItemsSource="{Binding Overview}" Margin="14,8,14,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,7">
                                        <pixel:PixelText DockPanel.Dock="Right" Text="{Binding Value}" Scale="2" Tight="True"
                                                         Colour="{StaticResource PxText}" Shadow="{StaticResource PxShadow}" />
                                        <pixel:PixelText Text="{Binding Label}" Style="{StaticResource PxLabel}"
                                                         Colour="{StaticResource PxTextDim}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="2,16,0,0">
                        <pixel:PixelText Text="▶" Scale="2" Tight="True" Colour="{StaticResource PxGold}" />
                        <pixel:PixelText Text="Pincha un Pokémon para ver su ficha." Scale="2" Tight="True" Margin="8,0,0,0"
                                         Colour="{StaticResource PxTextDim}" />
                    </StackPanel>
                </StackPanel>

                <DockPanel Grid.Row="1" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <Grid DockPanel.Dock="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- EL RETRATO: el Pokémon al cuádruple, de pie sobre el fondo de su caja, con su ball. -->
                            <Grid Grid.Column="0" Width="150" Height="140" VerticalAlignment="Top">
                                <views:PixelPanel Fill="{StaticResource PxInk}" HasShadow="False" />
                                <views:BoxWallpaper Theme="{Binding SelectedTheme}" FloorAt="0.8" Margin="3" />
                                <pixel:PixelSprite Source="{Binding SelectedSprite}" Scale="4" TrimEmpty="True" Bob="True"
                                                   Outline="{StaticResource PxShadow}" Stone="{Binding IsSelectedDead}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" />
                                <pixel:PixelSprite Source="{Binding SelectedBallSprite}" Scale="1" Outline="{StaticResource PxShadow}"
                                                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0"
                                                   Visibility="{Binding HasSelectedBall, Converter={StaticResource BoolToVisibility}}" />
                                <pixel:PixelIcon Icon="IconStar" Scale="2" Bob="True" HorizontalAlignment="Right"
                                                 VerticalAlignment="Top" Margin="0,8,8,0"
                                                 Visibility="{Binding Selected.IsShiny, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="16,2,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <pixel:PixelText Text="{Binding Selected.DisplayName}" Scale="3" Tight="True" Trim="True"
                                                     MaxWidth="200" Colour="{StaticResource PxText}" Shadow="{StaticResource PxShadow}" />
                                    <pixel:PixelText Text="{Binding Selected.GenderMark}" Scale="3" Tight="True" Margin="8,0,0,0">
                                        <pixel:PixelText.Style>
                                            <Style TargetType="pixel:PixelText">
                                                <Setter Property="Colour" Value="{StaticResource PxTextDim}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Selected.GenderMark}" Value="♂">
                                                        <Setter Property="Colour" Value="#FF7AB0FF" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Selected.GenderMark}" Value="♀">
                                                        <Setter Property="Colour" Value="#FFFF8AB0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </pixel:PixelText.Style>
                                    </pixel:PixelText>
                                </StackPanel>

                                <pixel:PixelText Text="{Binding Selected.Subtitle}" Scale="2" Tight="True" Margin="0,4,0,0"
                                                 Colour="{StaticResource PxTextDim}" />

                                <!-- El nivel en su placa y los tipos en las suyas, del color de cada tipo. -->
                                <WrapPanel Margin="0,8,0,0">
                                    <Grid Margin="0,0,6,6">
                                        <views:PixelPanel Fill="{StaticResource PxFaceLift}" HasShadow="False" />
                                        <StackPanel Orientation="Horizontal" Margin="9,6,10,7">
                                            <pixel:PixelText Text="Nv." Scale="2" Tight="True" Colour="{StaticResource PxTextDim}" />
                                            <pixel:PixelText Text="{Binding Selected.Level}" Scale="2" Tight="True" Margin="4,0,0,0"
                                                             Colour="{StaticResource PxText}" />
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding SelectedTypes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,6,6">
                                                    <views:PixelPanel Fill="{Binding Colour}" HasShadow="False" />
                                                    <pixel:PixelText Text="{Binding Name}" Scale="2" Tight="True" Margin="9,6,10,7"
                                                                     Colour="{StaticResource PxText}" Shadow="{StaticResource PxShadow}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </WrapPanel>

                                <WrapPanel>
                                    <Grid Margin="0,0,6,6" Visibility="{Binding Selected.IsInParty, Converter={StaticResource BoolToVisibility}}">
                                        <views:PixelPanel Fill="{StaticResource PxGoodDeep}" HasShadow="False" />
                                        <pixel:PixelText Text="EN EL EQUIPO" Scale="2" Tight="True" Margin="9,6,10,7"
                                                         Colour="{StaticResource PxGood}" />
                                    </Grid>
                                    <Grid Margin="0,0,6,6" Visibility="{Binding IsSelectedDead, Converter={StaticResource BoolToVisibility}}">
                                        <views:PixelPanel Fill="{StaticResource PxBadDeep}" HasShadow="False" />
                                        <pixel:PixelText Text="CAÍDO" Scale="2" Tight="True" Margin="9,6,10,7"
                                                         Colour="{StaticResource PxBad}" />
                                    </Grid>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>

                    <!-- LAS PÁGINAS, como la pantalla de datos del juego: cada una cabe entera, sin desplazarse. -->
                    <TabControl Style="{StaticResource PxTabControl}" Margin="0,14,0,0">
                        <TabItem Header="DATOS">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <pixel:PixelText Grid.Row="0" Text="NATURALEZA" Style="{StaticResource PxLabel}" Margin="0,4" />
                                <pixel:PixelText Grid.Row="0" Grid.Column="1" Text="{Binding Selected.NatureName}"
                                                 Style="{StaticResource PxValue}" Margin="0,4" />
                                <pixel:PixelText Grid.Row="1" Grid.Column="1" Text="{Binding NatureEffect}" Scale="2" Tight="True"
                                                 Colour="{StaticResource PxTextDim}" Margin="0,0,0,6" />

                                <pixel:PixelText Grid.Row="2" Text="HABILIDAD" Style="{StaticResource PxLabel}" Margin="0,4" />
                                <pixel:PixelText Grid.Row="2" Grid.Column="1" Text="{Binding Selected.AbilityName}"
                                                 Style="{StaticResource PxValue}" Margin="0,4" />

                                <pixel:PixelText Grid.Row="3" Text="OBJETO" Style="{StaticResource PxLabel}" Margin="0,4" />
                                <pixel:PixelText Grid.Row="3" Grid.Column="1" Text="{Binding Selected.HeldItemName}"
                                                 Style="{StaticResource PxValue}" Margin="0,4" />

                                <pixel:PixelText Grid.Row="4" Text="BALL" Style="{StaticResource PxLabel}" Margin="0,4" />
                                <pixel:PixelText Grid.Row="4" Grid.Column="1" Text="{Binding Selected.BallName}"
                                                 Style="{StaticResource PxValue}" Margin="0,4" />

                                <pixel:PixelText Grid.Row="5" Text="ENTRENADOR" Style="{StaticResource PxLabel}" Margin="0,4" />
                                <pixel:PixelText Grid.Row="5" Grid.Column="1" Text="{Binding Selected.TrainerName}"
                                                 Style="{StaticResource PxValue}" Margin="0,4" />

                                <pixel:PixelText Grid.Row="6" Text="ENCUENTRO" Style="{StaticResource PxLabel}" Margin="0,4" />
                                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                    <pixel:PixelText Text="{Binding Selected.MetLocationName}" Style="{StaticResource PxValue}"
                                                     MaxWidth="180" />
                                    <pixel:PixelText Text="· Nv." Scale="2" Tight="True" Margin="6,0,4,0"
                                                     Colour="{StaticResource PxTextDim}" />
                                    <pixel:PixelText Text="{Binding Selected.MetLevel}" Scale="2" Tight="True"
                                                     Colour="{StaticResource PxText}" />
                                </StackPanel>
                            </Grid>
                        </TabItem>

                        <TabItem Header="ESTADÍSTICAS">
                            <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="ENTRENAR EV" Style="{StaticResource PxSubtleButton}"
                                    Padding="12,6,18,11" Command="{Binding TrainCommand}" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <pixel:PixelText Text="ESTADÍSTICAS" Scale="2" Tight="True" Colour="{StaticResource PxText}"
                                                 Shadow="{StaticResource PxShadow}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <pixel:PixelText Text="IV TOTALES" Style="{StaticResource PxLabel}" />
                                    <pixel:PixelText Text="{Binding Selected.IvTotal}" Scale="2" Tight="True" Margin="6,0,0,0"
                                                     Colour="{StaticResource PxTextDim}" />
                                    <pixel:PixelText Text="/ 186" Style="{StaticResource PxLabel}" Margin="4,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding Stats}" ItemTemplate="{StaticResource StatTemplate}" />

                            </StackPanel>
                        </TabItem>

                        <TabItem Header="ATAQUES">
                            <ItemsControl ItemsSource="{Binding SelectedMoves}" ItemTemplate="{StaticResource MoveTemplate}" />
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Grid>
        </pixel:PixelWindow>

        <!-- Problemas y avisos, encima de todo, porque son lo primero que hay que leer. -->
        <Grid Grid.Column="0" Grid.ColumnSpan="5" VerticalAlignment="Top" Margin="12,46,12,0"
              Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
            <views:PixelPanel Fill="{StaticResource PxWarnDeep}" />
            <StackPanel Orientation="Horizontal" Margin="16,10,22,16">
                <pixel:PixelText Text="!" Scale="3" Tight="True" Colour="{StaticResource PxWarn}" VerticalAlignment="Center" />
                <pixel:PixelText Text="{Binding Message}" Scale="2" Wrap="True" Margin="12,0,0,0" MaxWidth="1100"
                                 Colour="{StaticResource PxText}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- LA ANIMACIÓN, encima de todo. Solo aparece con el intercambio en marcha. -->
        <views:WonderTradeOverlay Grid.Column="0" Grid.ColumnSpan="5" DataContext="{Binding Trade}"
                                  Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
