<UserControl x:Class="PermaLocke.App.Views.PokemonViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PermaLocke.App.Views">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Un hueco del PC. Los vacíos también se dibujan: la caja del juego tiene treinta
             agujeros estén llenos o no, y pintar solo los ocupados la convertiría en una lista. -->
        <Style x:Key="SlotStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Hole" CornerRadius="4" BorderThickness="1"
                                Background="#18000000" BorderBrush="{StaticResource SurfaceAltBrush}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter TargetName="Hole" Property="Opacity" Value="0.35" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hole" Property="Background"
                                        Value="{StaticResource SurfaceAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Hole" Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Hole" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Hole" Property="Background"
                                        Value="{StaticResource SurfaceAltBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SlotTemplate">
            <Grid Height="62">
                <Image Source="{Binding Sprite}" Width="52" Height="52" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                <!-- Hay Pokémon pero no icono: se dice, no se disimula. -->
                <TextBlock Text="{Binding Fallback}" FontSize="22" Opacity="0.5"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource TextBrush}" />
            </Grid>
        </DataTemplate>

        <!-- Una fila de la tabla: la estadística, y de qué está hecha. La barra mide el IV, de 0
             a 31, que es lo que de verdad distingue a dos Pokémon de la misma especie y nivel. -->
        <DataTemplate x:Key="StatTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="74" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="34" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource Muted}" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Mono}"
                           HorizontalAlignment="Right" />

                <ProgressBar Grid.Column="2" Height="6" Margin="10,0" Minimum="0" Maximum="31"
                             Value="{Binding Iv, Mode=OneWay}" VerticalAlignment="Center"
                             Background="#22FFFFFF" Foreground="{StaticResource AccentBrush}">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Style.Triggers>
                                <!-- Un 31 se ve de un vistazo sin tener que leer el número. -->
                                <DataTrigger Binding="{Binding Iv}" Value="31">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border CornerRadius="3" Background="{TemplateBinding Background}" />
                                <Border x:Name="PART_Track" />
                                <Border x:Name="PART_Indicator" CornerRadius="3"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}" />
                            </Grid>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>

                <TextBlock Grid.Column="3" Text="{Binding Iv}" Style="{StaticResource Mono}"
                           HorizontalAlignment="Right" />
                <TextBlock Grid.Column="4" Text="{Binding Ev}" Style="{StaticResource Mono}"
                           HorizontalAlignment="Right" Opacity="0.55" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="366" />
        </Grid.ColumnDefinitions>

        <!-- EL PC -->
        <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,8,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Cabecera de caja: se pasa de una a otra como en el juego, y da la vuelta. -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="‹" Command="{Binding PreviousBoxCommand}"
                            Style="{StaticResource PrimaryButton}" MinWidth="46" FontSize="16" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource PanelHeading}" HorizontalAlignment="Center"
                                   Text="{Binding SelectedBox.Name}" />
                        <TextBlock Style="{StaticResource Mono}" FontSize="11" Opacity="0.6"
                                   HorizontalAlignment="Center"
                                   Text="{Binding SelectedBox.Occupancy}" />
                    </StackPanel>

                    <Button Grid.Column="2" Content="›" Command="{Binding NextBoxCommand}"
                            Style="{StaticResource PrimaryButton}" MinWidth="46" FontSize="16" />
                </Grid>

                <!-- Seis columnas por cinco filas: el PC del juego, tal cual. -->
                <ListBox Grid.Row="1" ItemsSource="{Binding Slots}" SelectedItem="{Binding SelectedSlot}"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource SlotStyle}"
                         ItemTemplate="{StaticResource SlotTemplate}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VerticalAlignment="Top">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="6" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

                <!-- Botones arriba y resumen debajo, no en columnas. En una ventana estrecha una
                     columna Auto con dos botones deja la otra a cero de ancho, y entonces el
                     resumen envuelve letra a letra y estira la fila cientos de píxeles: la caja
                     de arriba se queda sin sitio sin que nada falle. -->
                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <WrapPanel Orientation="Horizontal">
                        <Button Content="RELEER LA PARTIDA" Style="{StaticResource PrimaryButton}"
                                Command="{Binding LoadCommand}" MinWidth="170" Margin="0,0,8,6" />
                        <Button Content="WONDER TRADE" Style="{StaticResource PrimaryButton}"
                                Command="{Binding Trade.ArmCommand}" MinWidth="150" Margin="0,0,0,6" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="{Binding Summary}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- LA FICHA -->
        <Border Grid.Column="1" Style="{StaticResource Panel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- EL INTERCAMBIO. Dice qué se va a entregar y qué banda va a volver antes
                         de tocar nada: esto es lo único de PermaLocke que destruye algo. -->
                    <Border Margin="0,0,0,14" Padding="12" CornerRadius="6" BorderThickness="1"
                            Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            Visibility="{Binding Trade.IsArmed, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Mono}" FontSize="11" Text="WONDER TRADE"
                                       Foreground="{StaticResource AccentBrush}" />

                            <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="{Binding Trade.Instruction}" />

                            <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Foreground="{StaticResource DangerBrush}"
                                       Text="{Binding Trade.Problem}" />

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="INTERCAMBIAR" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding Trade.ConfirmCommand}" MinWidth="140" />
                                <Button Content="CANCELAR" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding Trade.CancelCommand}" MinWidth="110" Margin="8,0,0,0" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"
                                       FontSize="11"
                                       Text="El que entregues desaparece de la caja y su sitio lo ocupa el que llegue, que vendrá al mismo nivel. Se copia la partida entera antes de tocarla y se relee después para comprobarlo. Exige el juego cerrado." />
                        </StackPanel>
                    </Border>

                    <TextBlock TextWrapping="Wrap"
                               Text="Pincha un Pokémon de la caja para ver su ficha.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0" Source="{Binding SelectedSprite}" Width="76" Height="76"
                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   VerticalAlignment="Top" />

                            <StackPanel Grid.Column="1" Margin="10,4,0,0">
                                <TextBlock Style="{StaticResource PanelHeading}" FontSize="19"
                                           TextWrapping="Wrap">
                                    <Run Text="{Binding Selected.DisplayName, Mode=OneWay}" /><Run
                                        Text="{Binding Selected.GenderMark, Mode=OneWay}"
                                        FontFamily="Segoe UI Symbol" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap"
                                           Text="{Binding Selected.Subtitle}" />
                                <TextBlock Style="{StaticResource Mono}" FontSize="11" Margin="0,4,0,0"
                                           Foreground="{StaticResource AccentBrush}" Text="SHINY"
                                           Visibility="{Binding Selected.IsShiny,
                                                        Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,12" Opacity="0.2" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="82" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Naturaleza" Style="{StaticResource Muted}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Body}"
                                       Margin="8,0,0,2" Text="{Binding Selected.NatureName}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Habilidad" Style="{StaticResource Muted}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Body}"
                                       Margin="8,0,0,2" TextWrapping="Wrap" Text="{Binding Selected.AbilityName}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Objeto" Style="{StaticResource Muted}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Body}"
                                       Margin="8,0,0,2" Text="{Binding Selected.HeldItemName}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Ball" Style="{StaticResource Muted}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Body}"
                                       Margin="8,0,0,2" Text="{Binding Selected.BallName}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Entrenador" Style="{StaticResource Muted}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Body}"
                                       Margin="8,0,0,2" Text="{Binding Selected.TrainerName}" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Encuentro" Style="{StaticResource Muted}" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Body}"
                                       Margin="8,0,0,2" TextWrapping="Wrap">
                                <Run Text="{Binding Selected.MetLocationName, Mode=OneWay}" />
                                <Run Text=" · Nv." /><Run Text="{Binding Selected.MetLevel, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>

                        <Separator Margin="0,12" Opacity="0.2" />

                        <Grid Margin="0,0,0,4">
                            <TextBlock Style="{StaticResource Muted}" FontSize="10" Text="ESTADÍSTICA · IV · EV" />
                            <TextBlock Style="{StaticResource Mono}" FontSize="11" HorizontalAlignment="Right"
                                       Text="{Binding Selected.IvTotal, StringFormat='IV total {0} de 186'}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Stats}" ItemTemplate="{StaticResource StatTemplate}" />

                        <Separator Margin="0,12" Opacity="0.2" />

                        <TextBlock Style="{StaticResource Muted}" Text="MOVIMIENTOS" FontSize="10" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding Selected.Moves}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource Body}" Text="{Binding}" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource Mono}" FontSize="10" Margin="0,12,0,0" Opacity="0.45"
                                   Text="{Binding Selected.Pid, StringFormat='PID {0:X8}'}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Problemas y avisos, encima de todo, porque son lo primero que hay que leer. -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Top" Margin="10"
                Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="14"
                BorderThickness="1" BorderBrush="{StaticResource AccentBrush}"
                Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Text="{Binding Message}" />
        </Border>

        <!-- LA ANIMACIÓN, encima de todo. Solo aparece con el intercambio en marcha. -->
        <views:WonderTradeOverlay Grid.Column="0" Grid.ColumnSpan="2" DataContext="{Binding Trade}"
                                  Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
