<UserControl x:Class="PermaLocke.App.Views.PendingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Deliberately says what it is: an unbuilt section, not a broken one. -->
    <Border Style="{StaticResource Inset}" Padding="36,32"
            MaxWidth="560" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel>
            <Border Width="46" Height="46" CornerRadius="23"
                    Background="{StaticResource WarningDeepBrush}"
                    BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                    HorizontalAlignment="Center">
                <TextBlock Text="?" FontFamily="{StaticResource UiFont}" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource WarningBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <TextBlock Text="SECCIÓN NO IMPLEMENTADA TODAVÍA"
                       Style="{StaticResource PanelHeading}" FontSize="14"
                       HorizontalAlignment="Center" Margin="0,18,0,0" />

            <Border Style="{StaticResource Chip}" HorizontalAlignment="Center" Margin="0,4,0,18"
                    Background="{StaticResource WarningDeepBrush}"
                    BorderBrush="{StaticResource WarningBrush}">
                <TextBlock Text="{Binding Phase}" Style="{StaticResource ChipText}"
                           Foreground="{StaticResource WarningBrush}" />
            </Border>

            <TextBlock Text="{Binding Plan}" Style="{StaticResource Body}" TextAlignment="Center" />

            <TextBlock Style="{StaticResource Faint}" TextAlignment="Center" Margin="0,18,0,0"
                       Text="No hay nada que pulsar aquí: prefiero dejarlo vacío antes que poner botones que no hacen nada." />
        </StackPanel>
    </Border>
</UserControl>
