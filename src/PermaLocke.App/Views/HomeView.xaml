<UserControl x:Class="PermaLocke.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Points on an event row: green up, red down, grey when it moved none. -->
        <Style x:Key="EventPoints" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGain}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLoss}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EventDot" TargetType="Ellipse">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{StaticResource BorderStrongBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGain}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLoss}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ================================================== EMPTY STATE
             No run yet. Shown instead of zeroed-out statistics, which would read as a run gone
             badly rather than as one that has not started. -->
        <Border MaxWidth="520" VerticalAlignment="Center" HorizontalAlignment="Center"
                Padding="36,32">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Inset}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasRun}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel>
                <Border Width="46" Height="46" CornerRadius="23"
                        Background="{StaticResource AccentDeepBrush}"
                        BorderBrush="{StaticResource AccentDimBrush}" BorderThickness="1"
                        HorizontalAlignment="Center">
                    <Ellipse Width="16" Height="16" Fill="{StaticResource AccentBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock Text="NO HAY NINGUNA RUN ACTIVA"
                           Style="{StaticResource PanelHeading}" FontSize="15"
                           HorizontalAlignment="Center" Margin="0,18,0,0" />

                <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,6,0,0"
                           Text="Deja tu ROM vanilla de Pokémon Ultra Luna en la carpeta ROM y crea la run. La ROM original no se toca en ningún momento." />

                <Button Content="CREAR RUN" Command="{Binding CreateRunCommand}"
                        Style="{StaticResource PrimaryButton}" Padding="26,10"
                        HorizontalAlignment="Center" Margin="0,24,0,0" />
            </StackPanel>
        </Border>

        <!-- ================================================== DASHBOARD -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasRun}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- ============================================ LÍNEA DE ESTADO
                 UNA banda, no cuatro tarjetas. La rejilla de cuatro recuadros arriba es el gesto
                 más reconocible de una plantilla, y además mentía: daba el mismo peso a cuatro
                 cifras que no valen lo mismo.

                 Ahora es una línea de instrumentos: las cifras van seguidas, separadas por una
                 raya fina, y la última —la que gobierna cómo juegas ahora mismo— se queda con el
                 sitio grande de la derecha. El color solo donde informa: verde y rojo son estados
                 de tus Pokémon; encuentros y cap no son estados, así que van en el color del texto.

                 Lo que hace que se lea como un panel y no como una lista es que las cifras están
                 en Bahnschrift con cifras tabulares: mismo ancho por dígito, así que al subir de
                 9 a 10 no se mueve nada. -->
            <Border Grid.Row="0" Style="{StaticResource Inset}" Padding="4,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="16,12,22,12">
                        <TextBlock Text="EN PIE" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="{Binding AliveCount}" Style="{StaticResource StatValue}"
                                   Foreground="{StaticResource SuccessBrush}" Margin="0,2,0,0" />
                    </StackPanel>

                    <Border Grid.Column="1" Width="1" Margin="0,14"
                            Background="{StaticResource BorderSubtleBrush}" />

                    <StackPanel Grid.Column="2" Margin="22,12">
                        <TextBlock Text="CAÍDOS" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="{Binding DeadCount}" Style="{StaticResource StatValue}"
                                   Foreground="{StaticResource DangerBrush}" Margin="0,2,0,0" />
                    </StackPanel>

                    <Border Grid.Column="3" Width="1" Margin="0,14"
                            Background="{StaticResource BorderSubtleBrush}" />

                    <StackPanel Grid.Column="4" Margin="22,12">
                        <TextBlock Text="ENCUENTROS" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="{Binding EncounterCount}" Style="{StaticResource StatValue}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <Border Grid.Column="5" Width="1" Margin="0,14"
                            Background="{StaticResource BorderSubtleBrush}" />

                    <!-- El cap se lleva el sitio ancho porque es la única cifra que te dice qué
                         puedes hacer AHORA. Su etapa va al lado, no debajo, para que se lea como
                         una frase: «tope 20, segunda prueba». -->
                    <Border Grid.Column="6" Margin="22,10,12,10" Padding="14,7"
                            HorizontalAlignment="Right"
                            Background="{StaticResource AccentDeepBrush}"
                            CornerRadius="{StaticResource RadiusMedium}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center"
                                        HorizontalAlignment="Right" Margin="14,0,0,0">
                                <TextBlock Text="{Binding StageText}" Style="{StaticResource CardTitle}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="ETAPA ACTUAL" Style="{StaticResource StatLabel}"
                                           TextAlignment="Right" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="TOPE DE NIVEL" Style="{StaticResource StatLabel}"
                                           Foreground="{StaticResource AccentDimBrush}" />
                                <TextBlock Text="{Binding LevelCapText}" Style="{StaticResource StatValue}"
                                           Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ================================================ EL EQUIPO
                 Los seis, con el icono del cartucho. Es una aplicación de Pokémon y hasta ahora
                 no enseñaba ninguno: los datos ya estaban en LiveTeam, sin nadie que los pintara.

                 Se esconde entera cuando no hay enlace, en vez de dejar seis huecos vacíos que
                 se leerían como un equipo muerto en lugar de como un juego cerrado. Lo que pasa
                 sin enlace ya lo dice la insignia de arriba.

                 El sprite puede faltar, porque quien no haya abierto nunca el gacha no los tiene
                 extraídos, así que debajo va siempre el nombre y la tira funciona sin ellos. -->
            <Border Grid.Row="2" Padding="16,13">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Inset}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding GameLinkConnected}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding GameLinkStatus}"
                                   Style="{StaticResource Faint}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="EQUIPO EN VIVO" Style="{StaticResource StatLabel}"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding LiveTeam}" Margin="0,11,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,8,0" Padding="8,9"
                                        CornerRadius="{StaticResource RadiusMedium}"
                                        Background="{StaticResource SurfaceHighBrush}"
                                        BorderThickness="1">
                                    <!-- Debilitado: la tarjeta entera se apaga. Un Pokémon caído
                                         tiene que verse caído sin leer el número. -->
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Opacity" Value="1" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HpState}" Value="fainted">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource DangerDeepBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <StackPanel>
                                        <Image Source="{Binding Sprite}" Stretch="Uniform"
                                               Width="48" Height="48"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor" />

                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Body}"
                                                   FontSize="11.5" FontWeight="Bold"
                                                   TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Margin="0,4,0,0" />

                                        <TextBlock Text="{Binding Level}" Style="{StaticResource Faint}"
                                                   TextAlignment="Center" />
                                        <!-- La barra de PS es lo que hace la tira útil y no solo
                                             bonita: de un vistazo se ve quién va tocado.

                                             ProgressBar y no dos Border anidados: un ancho en
                                             píxeles atado a la proporción exigiría saber cuánto
                                             mide la tarjeta, y la tarjeta mide lo que le toque
                                             según el ancho de la ventana. La plantilla de §50 ya
                                             deja el indicador alineado a la izquierda. -->
                                        <ProgressBar Height="4" Margin="0,7,0,0"
                                                     Minimum="0" Maximum="1"
                                                     Value="{Binding HpRatio, Mode=OneWay}">
                                            <ProgressBar.Style>
                                                <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HpState}" Value="low">
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HpState}" Value="critical">
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HpState}" Value="fainted">
                                                            <Setter Property="Foreground" Value="{StaticResource BorderStrongBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ProgressBar.Style>
                                        </ProgressBar>

                                        <TextBlock Text="{Binding Hp}" Style="{StaticResource Mono}"
                                                   FontSize="10.5" TextAlignment="Center" Margin="0,3,0,0"
                                                   Foreground="{StaticResource TextFaintBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ============================================== TWO COLUMNS -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1.25*" />
                </Grid.ColumnDefinitions>

                <!-- ==================================== IDENTIDAD DE LA PARTIDA
                     Qué partida es esta. Ya no repite la etapa ni el tope ni el rol: la etapa y el
                     tope están en la línea de estado de arriba y el rol en la cabecera, donde se
                     ven desde cualquier pantalla. Decir lo mismo dos veces en la misma pantalla es
                     lo que la tenía apretada.

                     SIN CAJA. Un rótulo, el nombre y sus distintivos. Agrupa el aire, no un marco. -->
                <StackPanel Grid.Column="0" VerticalAlignment="Top">
                    <TextBlock Text="PARTIDA" Style="{StaticResource PanelHeading}" />

                    <DockPanel Margin="0,4,0,0">
                        <Border DockPanel.Dock="Left" Style="{StaticResource Rail}"
                                Height="26" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding RunName}" Style="{StaticResource SectionTitle}"
                                   FontSize="{StaticResource FontSizeSection}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <WrapPanel Margin="0,12,0,0">
                        <Border Style="{StaticResource Chip}" Margin="0,0,6,6">
                            <TextBlock Text="{Binding GameName}" Style="{StaticResource ChipText}" />
                        </Border>
                        <Border Style="{StaticResource Chip}" Margin="0,0,6,6">
                            <TextBlock Text="{Binding PlayerName}" Style="{StaticResource ChipText}" />
                        </Border>
                        <Border Style="{StaticResource ChipAccent}" Margin="0,0,6,6">
                            <TextBlock Text="{Binding SeedLabel}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="{StaticResource FontSizeMicro}"
                                       Foreground="{StaticResource AccentBrightBrush}" />
                        </Border>
                    </WrapPanel>

                    <TextBlock Text="{Binding StageSourceText}" Style="{StaticResource Faint}"
                               Margin="0,4,0,0" />

                    <!-- Las dos acciones sobre la partida, en filas de lista y no en cajas. Se
                         separan por una línea abajo, que es como se lista algo. -->
                    <Border Style="{StaticResource Row}" Margin="0,16,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="CAMBIAR"
                                    Style="{StaticResource SubtleButton}"
                                    Command="{Binding ChangeRoleCommand}"
                                    VerticalAlignment="Center" Margin="12,0,0,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="ROL" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding RoleName}" Style="{StaticResource CardTitle}"
                                           FontSize="{StaticResource FontSizeBody}" Margin="0,1,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Borra de verdad: la run entera y la partida de Ultra Luna. Va en rojo y
                         hueco, nunca relleno: un botón rojo macizo pide que lo pulses, y este es
                         justo el que no. Las dos confirmaciones y la copia están en el ViewModel. -->
                    <Border Style="{StaticResource Row}" BorderThickness="0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="EMPEZAR DE CERO"
                                    Command="{Binding StartOverCommand}"
                                    Style="{StaticResource DangerButton}"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Padding="{StaticResource PadTight}" MinHeight="26"
                                    VerticalAlignment="Center" Margin="12,0,0,0" />
                            <TextBlock Text="Borra la run y la partida. Se copia antes."
                                       Style="{StaticResource Faint}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                            <TextBlock Text="{Binding StartOverStatus}"
                                       Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                                       Margin="0,8,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Faint}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StartOverStatus}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                    <!-- ==================================== LOS CAÍDOS
                         Esta columna era media pantalla de nada. Y NO es el equipo en vivo, que ya
                         está arriba y necesita el emulador abierto: esto sale de la base de datos
                         de la run, así que está con el juego cerrado. En un Nuzlocke la lista de
                         quién ya no está es la otra mitad de la historia.

                         Con tope de alto y su propio desplazamiento: una run larga tiene decenas de
                         bajas y sin tope empujaría la página entera. -->
                    <Border Style="{StaticResource Inset}" Margin="0,16,0,0" Padding="14,12"
                            Visibility="{Binding HasFallen, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding DeadCount}"
                                           Style="{StaticResource Numeric}"
                                           Foreground="{StaticResource DangerBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="CAÍDOS" Style="{StaticResource StatLabel}"
                                           VerticalAlignment="Center" />
                            </DockPanel>

                            <ScrollViewer MaxHeight="420" Margin="0,8,0,0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Fallen}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Row}" Padding="0,5">
                                                <DockPanel>
                                                    <!-- El icono, apagado. Es el mismo del cartucho
                                                         que usa el equipo de arriba; medio velado
                                                         basta para que se lea «este ya no está» sin
                                                         inventar un dibujo aparte. -->
                                                    <Image DockPanel.Dock="Left" Source="{Binding Sprite}"
                                                           Width="34" Height="34" Opacity="0.45"
                                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Style="{StaticResource Body}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Detail}"
                                                                   Style="{StaticResource Faint}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Derecha: el historial de la run. -->
                <Border Grid.Column="2" Style="{StaticResource Well}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="ÚLTIMAS ACCIONES"
                                       Style="{StaticResource StatLabel}" Margin="0,0,0,10" />

                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding RecentEvents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" Padding="0,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="14" />
                                                        <ColumnDefinition Width="76" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="52" />
                                                    </Grid.ColumnDefinitions>

                                                    <Ellipse Grid.Column="0" Style="{StaticResource EventDot}"
                                                             HorizontalAlignment="Left" />

                                                    <TextBlock Grid.Column="1" Text="{Binding Timestamp}"
                                                               Style="{StaticResource Mono}" FontSize="11"
                                                               Foreground="{StaticResource TextFaintBrush}"
                                                               VerticalAlignment="Center" />

                                                    <StackPanel Grid.Column="2" Margin="4,0,8,0">
                                                        <TextBlock Text="{Binding Description}"
                                                                   Style="{StaticResource Body}" FontSize="12" />
                                                        <TextBlock Text="{Binding Type}"
                                                                   Style="{StaticResource Mono}" FontSize="10"
                                                                   Foreground="{StaticResource TextFaintBrush}" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="3" Text="{Binding Points}"
                                                               Style="{StaticResource EventPoints}"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                </Border>
            </Grid>

            <!-- ============================================== AVISOS
                 Vivían dentro del panel del equipo en vivo, que se quitó. No se van con él: uno
                 dice que el cap no está haciendo su trabajo y el otro que hay un Pokémon en el
                 juego que la run no conoce. Callarlos sería peor que no tenerlos. -->
            <StackPanel Grid.Row="5">
                <!-- Aquí iba un recuadro verde con lo último que PermaLocke había hecho solo. Ya
                     no: eso lo dicen los avisos flotantes en el momento en que pasa. -->

                <Border Padding="12,9" Margin="0,12,0,0"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Background="{StaticResource DangerDeepBrush}"
                        BorderBrush="{StaticResource DangerBrush}" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCapWarning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding CapWarning}" Style="{StaticResource Body}"
                               FontSize="12" Foreground="{StaticResource DangerBrush}" />
                </Border>

                <Border Padding="12,9" Margin="0,12,0,0"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Background="{StaticResource WarningDeepBrush}"
                        BorderBrush="{StaticResource WarningBrush}" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDetection}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="REGISTRARLO"
                                Command="{Binding RegisterDetectedCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="12,6" FontSize="11.5"
                                Margin="12,0,0,0" />
                        <TextBlock Text="{Binding DetectionMessage}" Style="{StaticResource Body}"
                                   FontSize="12" Foreground="{StaticResource WarningBrush}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

            <!-- The chain check. Quiet when it passes, loud when it does not. -->
            <Border Margin="0,12,0,0" Padding="12,7"
                    CornerRadius="{StaticResource RadiusSmall}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IntegrityOk}" Value="False">
                                <Setter Property="Background" Value="{StaticResource DangerDeepBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IntegrityOk}" Value="False">
                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock Text="{Binding IntegrityStatus}" FontSize="11" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Mono}">
                                <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IntegrityOk}" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Separadas de verdad. Son DOS estados, no una frase: el de la cadena es
                         permanente y el del enlace es un aviso, y pegados uno detras de otro se
                         leian como un renglon corrido. -->
                    <Border Width="1" Margin="14,1" Background="{StaticResource BorderBrush}" />

                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GameLinkConnected}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <!-- Si no hay enlace, el cap no vigila. Decirlo aqui es barato y evita creerse
                         protegido mientras nadie mira. -->
                    <TextBlock Text="{Binding GameLinkStatus}" FontSize="11"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Mono}">
                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GameLinkConnected}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
