<UserControl x:Class="PermaLocke.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Points on an event row: green up, red down, grey when it moved none. -->
        <Style x:Key="EventPoints" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGain}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLoss}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EventDot" TargetType="Ellipse">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{StaticResource BorderStrongBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGain}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLoss}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ================================================== EMPTY STATE
             No run yet. Shown instead of zeroed-out statistics, which would read as a run gone
             badly rather than as one that has not started. -->
        <Border MaxWidth="520" VerticalAlignment="Center" HorizontalAlignment="Center"
                Padding="36,32">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Inset}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasRun}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel>
                <Border Width="46" Height="46" CornerRadius="23"
                        Background="{StaticResource AccentDeepBrush}"
                        BorderBrush="{StaticResource AccentDimBrush}" BorderThickness="1"
                        HorizontalAlignment="Center">
                    <Ellipse Width="16" Height="16" Fill="{StaticResource AccentBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock Text="NO HAY NINGUNA RUN ACTIVA"
                           Style="{StaticResource PanelHeading}" FontSize="15"
                           HorizontalAlignment="Center" Margin="0,18,0,0" />

                <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,6,0,0"
                           Text="Deja tu ROM vanilla de Pokémon Ultra Luna en la carpeta ROM y crea la run. La ROM original no se toca en ningún momento." />

                <Button Content="CREAR RUN" Command="{Binding CreateRunCommand}"
                        Style="{StaticResource PrimaryButton}" Padding="26,10"
                        HorizontalAlignment="Center" Margin="0,24,0,0" />
            </StackPanel>
        </Border>

        <!-- ================================================== DASHBOARD -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasRun}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Four numbers, above everything else. A coloured cap on each tile carries the
                 meaning, so the numbers themselves can stay the same weight. -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Inset}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource SuccessBrush}" CornerRadius="7,7,0,0" />
                        <StackPanel Grid.Row="1" Margin="16,10,16,12">
                            <TextBlock Text="VIVOS" Style="{StaticResource StatLabel}" />
                            <TextBlock Text="{Binding AliveCount}" Style="{StaticResource StatValue}"
                                       Foreground="{StaticResource SuccessBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Inset}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource DangerBrush}" CornerRadius="7,7,0,0" />
                        <StackPanel Grid.Row="1" Margin="16,10,16,12">
                            <TextBlock Text="MUERTOS" Style="{StaticResource StatLabel}" />
                            <TextBlock Text="{Binding DeadCount}" Style="{StaticResource StatValue}"
                                       Foreground="{StaticResource DangerBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Inset}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource AccentBrush}" CornerRadius="7,7,0,0" />
                        <StackPanel Grid.Row="1" Margin="16,10,16,12">
                            <TextBlock Text="ENCUENTROS" Style="{StaticResource StatLabel}" />
                            <TextBlock Text="{Binding EncounterCount}" Style="{StaticResource StatValue}"
                                       Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="6" Style="{StaticResource Inset}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource WarningBrush}" CornerRadius="7,7,0,0" />
                        <StackPanel Grid.Row="1" Margin="16,10,16,12">
                            <TextBlock Text="CAP DE NIVEL" Style="{StaticResource StatLabel}" />
                            <TextBlock Text="{Binding LevelCapText}" Style="{StaticResource StatValue}"
                                       Foreground="{StaticResource WarningBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================================== TWO COLUMNS -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1.25*" />
                </Grid.ColumnDefinitions>

                <!-- Izquierda: qué run es esta y en qué etapa va. -->
                <Border Grid.Column="0" Style="{StaticResource Inset}" Padding="16,14"
                        VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="RUN" Style="{StaticResource StatLabel}" />
                            <TextBlock Text="{Binding RunName}" Style="{StaticResource CardTitle}"
                                       FontSize="18" Margin="0,3,0,0" />

                            <WrapPanel Margin="0,10,0,0">
                                <Border Style="{StaticResource Chip}" Margin="0,0,6,6">
                                    <TextBlock Text="{Binding GameName}" Style="{StaticResource ChipText}" />
                                </Border>
                                <Border Style="{StaticResource Chip}" Margin="0,0,6,6">
                                    <TextBlock Text="{Binding PlayerName}" Style="{StaticResource ChipText}" />
                                </Border>
                                <Border Style="{StaticResource Chip}" Margin="0,0,6,6"
                                        Background="{StaticResource AccentDeepBrush}"
                                        BorderBrush="{StaticResource AccentDimBrush}">
                                    <TextBlock Text="{Binding SeedLabel}"
                                               FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                               Foreground="{StaticResource AccentBrightBrush}" />
                                </Border>
                            </WrapPanel>

                            <Border Style="{StaticResource Divider}" />

                            <TextBlock Text="ETAPA ACTUAL" Style="{StaticResource StatLabel}" />
                            <DockPanel Margin="0,3,0,0">
                                <Border DockPanel.Dock="Right" Style="{StaticResource Chip}"
                                        Background="{StaticResource WarningDeepBrush}"
                                        BorderBrush="{StaticResource WarningBrush}">
                                    <TextBlock Style="{StaticResource ChipText}"
                                               Foreground="{StaticResource WarningBrush}">
                                        <Run Text="CAP" />
                                        <Run Text="{Binding LevelCapText, Mode=OneWay}" FontWeight="Bold" />
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="{Binding StageText}" Style="{StaticResource Body}"
                                           VerticalAlignment="Center" />
                            </DockPanel>

                            <!-- Ya no hay botón de subir etapa: la etapa la deciden los logros, y
                                 un botón que hace lo mismo que la detección solo sirve para
                                 desincronizarla. Tampoco el de registrar captura: lo que hay en la
                                 partida se ve en el visor, y lo que aparece sin registrar lo
                                 anuncia el aviso de abajo con su propio botón. -->
                            <TextBlock Text="{Binding StageSourceText}" Style="{StaticResource Faint}"
                                       Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0" />

                            <Border Style="{StaticResource Divider}" />

                            <TextBlock Text="ROL" Style="{StaticResource StatLabel}" />
                            <DockPanel Margin="0,3,0,0">
                                <!-- El rol se elige al crear la run y no debería moverse. El botón
                                     existe porque un rol al que no se podía llegar -la ruleta del
                                     ludópata- obligaba a empezar una run nueva para probarlo. -->
                                <Button DockPanel.Dock="Right" Content="CAMBIAR"
                                        Style="{StaticResource GhostButton}"
                                        Command="{Binding ChangeRoleCommand}"
                                        Padding="11,5" FontSize="10.5" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding RoleName}" Style="{StaticResource Body}"
                                           VerticalAlignment="Center" />
                            </DockPanel>

                            <Border Style="{StaticResource Divider}" />

                            <!-- Empezar de cero es una run NUEVA, no un borrado: la run vieja se
                                 queda guardada con su historial encadenado, y la partida del juego
                                 no se toca. El aviso lo dice antes de abrir nada. -->
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="EMPEZAR DE CERO"
                                        Style="{StaticResource GhostButton}"
                                        Command="{Binding StartOverCommand}"
                                        Padding="11,5" FontSize="10.5" VerticalAlignment="Center" />
                                <TextBlock Text="Crea una run nueva y deja esta guardada"
                                           Style="{StaticResource Faint}" TextWrapping="Wrap"
                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                            </DockPanel>
                        </StackPanel>
                </Border>

                <!-- Derecha: el historial de la run. -->
                <Border Grid.Column="2" Style="{StaticResource Inset}" Padding="16,14">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="ÚLTIMAS ACCIONES"
                                       Style="{StaticResource StatLabel}" Margin="0,0,0,10" />

                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding RecentEvents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" Padding="0,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="14" />
                                                        <ColumnDefinition Width="76" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="52" />
                                                    </Grid.ColumnDefinitions>

                                                    <Ellipse Grid.Column="0" Style="{StaticResource EventDot}"
                                                             HorizontalAlignment="Left" />

                                                    <TextBlock Grid.Column="1" Text="{Binding Timestamp}"
                                                               Style="{StaticResource Mono}" FontSize="11"
                                                               Foreground="{StaticResource TextFaintBrush}"
                                                               VerticalAlignment="Center" />

                                                    <StackPanel Grid.Column="2" Margin="4,0,8,0">
                                                        <TextBlock Text="{Binding Description}"
                                                                   Style="{StaticResource Body}" FontSize="12" />
                                                        <TextBlock Text="{Binding Type}"
                                                                   Style="{StaticResource Mono}" FontSize="10"
                                                                   Foreground="{StaticResource TextFaintBrush}" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="3" Text="{Binding Points}"
                                                               Style="{StaticResource EventPoints}"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                </Border>
            </Grid>

            <!-- ============================================== AVISOS
                 Vivían dentro del panel del equipo en vivo, que se quitó. No se van con él: uno
                 dice que el cap no está haciendo su trabajo y el otro que hay un Pokémon en el
                 juego que la run no conoce. Callarlos sería peor que no tenerlos. -->
            <StackPanel Grid.Row="3">
                <Border Padding="12,9" Margin="0,12,0,0"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Background="{StaticResource DangerDeepBrush}"
                        BorderBrush="{StaticResource DangerBrush}" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCapWarning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding CapWarning}" Style="{StaticResource Body}"
                               FontSize="12" Foreground="{StaticResource DangerBrush}" />
                </Border>

                <Border Padding="12,9" Margin="0,12,0,0"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Background="{StaticResource WarningDeepBrush}"
                        BorderBrush="{StaticResource WarningBrush}" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDetection}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="REGISTRARLO"
                                Command="{Binding RegisterDetectedCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="12,6" FontSize="11.5"
                                Margin="12,0,0,0" />
                        <TextBlock Text="{Binding DetectionMessage}" Style="{StaticResource Body}"
                                   FontSize="12" Foreground="{StaticResource WarningBrush}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

            <!-- The chain check. Quiet when it passes, loud when it does not. -->
            <Border Margin="0,12,0,0" Padding="12,7"
                    CornerRadius="{StaticResource RadiusSmall}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IntegrityOk}" Value="False">
                                <Setter Property="Background" Value="{StaticResource DangerDeepBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IntegrityOk}" Value="False">
                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock Text="{Binding IntegrityStatus}" FontSize="11" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Mono}">
                                <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IntegrityOk}" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Si no hay enlace, el cap no vigila. Decirlo aquí es barato y evita creerse
                         protegido mientras nadie mira. -->
                    <TextBlock Text="{Binding GameLinkStatus}" FontSize="11" Margin="14,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Mono}">
                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GameLinkConnected}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
