<UserControl x:Class="PermaLocke.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PermaLocke.App.Views"
             xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel">

    <!--
        HOME EN PÍXELES (§176), la muestra del estilo nuevo. Los mismos datos y los mismos avisos que antes, dibujados
        con las piezas de Views/Pixel: placas con contorno y sombra dura, texto en la fuente propia, barras de PS en
        celdas y la barra de desplazamiento hundida. Ni una regla ni un servicio cambian.
    -->
    <UserControl.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource PxScrollBar}" />

        <!-- Los puntos de una línea del historial: verde si suben, rojo si bajan, apagados si no mueven nada. -->
        <Style x:Key="EventPoints" TargetType="pixel:PixelText">
            <Setter Property="Scale" Value="2" />
            <Setter Property="Tight" Value="True" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Colour" Value="{StaticResource PxTextFaint}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGain}" Value="True">
                    <Setter Property="Colour" Value="{StaticResource PxGood}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLoss}" Value="True">
                    <Setter Property="Colour" Value="{StaticResource PxBad}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- La casilla del icono de la línea: teñida de verde si dio puntos y de rojo si los quitó. -->
        <Style x:Key="EventMark" TargetType="views:PixelPanel">
            <Setter Property="HasShadow" Value="False" />
            <Setter Property="Fill" Value="{StaticResource PxFaceHigh}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGain}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource PxGoodDeep}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLoss}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource PxBadDeep}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- El rótulo de un apartado: pequeño, apagado y en mayúsculas. -->
        <Style x:Key="PxLabel" TargetType="pixel:PixelText">
            <Setter Property="Scale" Value="2" />
            <Setter Property="Tight" Value="True" />
            <Setter Property="Colour" Value="{StaticResource PxTextFaint}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ================================================== SIN RUN
             Una placa en el centro con la Poké Ball, en vez de cifras a cero que se leerían como una run mal llevada. -->
        <Grid MaxWidth="560" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasRun}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <views:PixelPanel Fill="{StaticResource PxFace}" />
            <StackPanel Margin="40,34,46,40">
                <pixel:PixelIcon Icon="IconGacha" Scale="4" Bob="True" HorizontalAlignment="Center" />

                <pixel:PixelText Text="NO HAY NINGUNA RUN ACTIVA" Scale="3" Colour="{StaticResource PxText}"
                                 Shadow="{StaticResource PxShadow}" HorizontalAlignment="Center" Margin="0,16,0,0" />

                <pixel:PixelText Text="Pon tu ROM de Pokémon Ultra Luna en la carpeta ROM y crea tu run." Scale="2"
                                 Wrap="True" TextAlignment="Center" Colour="{StaticResource PxTextDim}"
                                 HorizontalAlignment="Center" Margin="0,10,0,0" />

                <Button Content="CREAR RUN" Command="{Binding CreateRunCommand}" Style="{StaticResource PxButton}"
                        HorizontalAlignment="Center" Margin="0,22,0,0" />
            </StackPanel>
        </Grid>

        <!-- ================================================== CON RUN -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasRun}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============================================ LA LÍNEA DE ESTADO
                 Una placa, como el marcador de un juego: cifras grandes con sombra dura separadas por surcos, y el tope
                 de nivel en su propia placa violeta, porque es la única cifra que dice qué puedes hacer ahora. -->
            <Grid Grid.Row="0">
                <views:PixelPanel Fill="{StaticResource PxFace}" />
                <Grid Margin="8,6,14,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="14,10,18,10">
                        <pixel:PixelText Text="EN PIE" Style="{StaticResource PxLabel}" />
                        <pixel:PixelText Text="{Binding AliveCount}" Scale="4" Tight="True" Margin="0,5,0,0"
                                         Colour="{StaticResource PxGood}" Shadow="{StaticResource PxShadow}" />
                    </StackPanel>

                    <pixel:PixelRule Grid.Column="1" Orientation="Vertical" Margin="0,10" />

                    <StackPanel Grid.Column="2" Margin="18,10">
                        <pixel:PixelText Text="CAÍDOS" Style="{StaticResource PxLabel}" />
                        <pixel:PixelText Text="{Binding DeadCount}" Scale="4" Tight="True" Margin="0,5,0,0"
                                         Colour="{StaticResource PxBad}" Shadow="{StaticResource PxShadow}" />
                    </StackPanel>

                    <pixel:PixelRule Grid.Column="3" Orientation="Vertical" Margin="0,10" />

                    <StackPanel Grid.Column="4" Margin="18,10">
                        <pixel:PixelText Text="ENCUENTROS" Style="{StaticResource PxLabel}" />
                        <pixel:PixelText Text="{Binding EncounterCount}" Scale="4" Tight="True" Margin="0,5,0,0"
                                         Colour="{StaticResource PxText}" Shadow="{StaticResource PxShadow}" />
                    </StackPanel>

                    <pixel:PixelRule Grid.Column="5" Orientation="Vertical" Margin="0,10" />

                    <!-- El recorrido: las doce pruebas, la liga y el rematch, cada una con el cristal Z que da -sacado
                         del cartucho-, en color las ganadas, en silueta las que faltan y la que toca encendida y
                         saltando. Debajo, el tope de cada etapa. Es la misma cuenta que decide el tope. -->
                    <StackPanel Grid.Column="6" Margin="18,8,14,4" VerticalAlignment="Center">
                        <DockPanel>
                            <pixel:PixelText DockPanel.Dock="Right" Text="{Binding TrialsText}" Style="{StaticResource PxLabel}"
                                             Colour="{StaticResource PxTextDim}" />
                            <pixel:PixelText Text="RECORRIDO" Style="{StaticResource PxLabel}" />
                        </DockPanel>

                        <Grid Margin="0,7,0,0">
                            <pixel:PixelRule VerticalAlignment="Top" Margin="14,15,14,0" />
                            <ItemsControl ItemsSource="{Binding StageTrack}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center" ToolTip="{Binding Tip}" Background="Transparent">
                                            <Grid Width="30" Height="32" HorizontalAlignment="Center">
                                                <views:PixelPanel IsSunken="True" HasShadow="False">
                                                    <views:PixelPanel.Style>
                                                        <Style TargetType="views:PixelPanel">
                                                            <Setter Property="Fill" Value="{StaticResource PxWell}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Fill" Value="{StaticResource PxAccentDeep}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </views:PixelPanel.Style>
                                                </views:PixelPanel>
                                                <pixel:PixelSprite Source="{Binding Icon}" Scale="1" TrimEmpty="True"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Bob="{Binding IsCurrent}">
                                                    <pixel:PixelSprite.Style>
                                                        <Style TargetType="pixel:PixelSprite">
                                                            <Setter Property="Silhouette" Value="{StaticResource PxFaceLift}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Silhouette" Value="{StaticResource PxAccent}" />
                                                                    <Setter Property="Outline" Value="{StaticResource PxShadow}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsCleared}" Value="True">
                                                                    <Setter Property="Silhouette" Value="Transparent" />
                                                                    <Setter Property="Outline" Value="{StaticResource PxShadow}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </pixel:PixelSprite.Style>
                                                </pixel:PixelSprite>
                                            </Grid>
                                            <pixel:PixelText Text="{Binding Level}" Scale="2" Tight="True" Margin="0,4,0,0"
                                                             HorizontalAlignment="Center">
                                                <pixel:PixelText.Style>
                                                    <Style TargetType="pixel:PixelText">
                                                        <Setter Property="Colour" Value="{StaticResource PxTextFaint}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCleared}" Value="True">
                                                                <Setter Property="Colour" Value="{StaticResource PxTextDim}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Colour" Value="{StaticResource PxAccentLight}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </pixel:PixelText.Style>
                                            </pixel:PixelText>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Column="7" Margin="6,4,0,2">
                        <views:PixelPanel Fill="{StaticResource PxAccentDeep}" HasShadow="False" />
                        <StackPanel Margin="16,10,18,12">
                            <pixel:PixelText Text="TOPE DE NIVEL" Style="{StaticResource PxLabel}"
                                             Colour="{StaticResource PxAccent}" />
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <pixel:PixelText Text="{Binding LevelCapText}" Scale="4" Tight="True"
                                                 Colour="{StaticResource PxAccentLight}" Shadow="{StaticResource PxShadow}" />
                                <StackPanel VerticalAlignment="Bottom" Margin="12,0,0,1">
                                    <pixel:PixelText Text="ETAPA" Style="{StaticResource PxLabel}"
                                                     Colour="{StaticResource PxAccent}" />
                                    <pixel:PixelText Text="{Binding StageText}" Scale="2" Tight="True" Margin="0,3,0,0"
                                                     Colour="{StaticResource PxText}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ================================================ EL EQUIPO EN VIVO
                 Los seis con el icono del cartucho al doble, cada uno en su hueco como en el menú del equipo, con su
                 barra de PS en celdas. Se esconde entero sin enlace: seis huecos vacíos se leerían como un equipo
                 muerto. -->
            <pixel:PixelWindow Grid.Row="2" Title="EQUIPO EN VIVO" Icon="IconGacha">
                <pixel:PixelWindow.Style>
                    <Style TargetType="pixel:PixelWindow" BasedOn="{StaticResource {x:Type pixel:PixelWindow}}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding GameLinkConnected}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </pixel:PixelWindow.Style>

                <pixel:PixelWindow.HeaderContent>
                    <pixel:PixelText Text="{Binding GameLinkStatus}" Scale="2" Tight="True" Trim="True"
                                     Colour="{StaticResource PxTextFaint}" MaxWidth="460" />
                </pixel:PixelWindow.HeaderContent>

                <StackPanel>
                    <Grid Margin="0,0,0,10"
                          Visibility="{Binding HasEncounterWarning, Converter={StaticResource BoolToVisibility}}">
                        <views:PixelPanel Fill="{StaticResource PxWarnDeep}" HasShadow="False" />
                        <pixel:PixelText Text="{Binding EncounterWarning}" Scale="2" Wrap="True" Margin="12,6,12,10"
                                         Colour="{StaticResource PxWarn}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding LiveTeam}" Margin="0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,8,0">
                                    <!-- Debilitado: el hueco entero se apaga y se tiñe. Un Pokémon caído tiene que
                                         verse caído sin leer el número. -->
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Opacity" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HpState}" Value="fainted">
                                                    <Setter Property="Opacity" Value="0.75" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <views:PixelPanel IsSunken="True" HasShadow="False">
                                        <views:PixelPanel.Style>
                                            <Style TargetType="views:PixelPanel">
                                                <Setter Property="Fill" Value="{StaticResource PxWell}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HpState}" Value="fainted">
                                                        <Setter Property="Fill" Value="{StaticResource PxBadDeep}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </views:PixelPanel.Style>
                                    </views:PixelPanel>

                                    <StackPanel Margin="10,8,10,10">
                                        <Grid Height="88">
                                            <pixel:PixelSprite Source="{Binding Sprite}" Scale="3" TrimEmpty="True" HorizontalAlignment="Center"
                                                               VerticalAlignment="Bottom" Outline="{StaticResource PxShadow}">
                                                <pixel:PixelSprite.Style>
                                                    <Style TargetType="pixel:PixelSprite">
                                                        <Setter Property="Stone" Value="False" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HpState}" Value="fainted">
                                                                <Setter Property="Stone" Value="True" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </pixel:PixelSprite.Style>
                                            </pixel:PixelSprite>
                                        </Grid>

                                        <pixel:PixelText Text="{Binding Name}" Scale="2" Tight="True" Trim="True"
                                                         TextAlignment="Center" HorizontalAlignment="Stretch"
                                                         Colour="{StaticResource PxText}" Shadow="{StaticResource PxShadow}"
                                                         Margin="0,4,0,0" />

                                        <pixel:PixelText Text="{Binding Level}" Scale="2" Tight="True" TextAlignment="Center"
                                                         HorizontalAlignment="Stretch" Colour="{StaticResource PxTextDim}"
                                                         Margin="0,3,0,0" />

                                        <!-- La barra de PS en celdas, como la del juego: verde, amarilla, roja o gris. -->
                                        <views:PixelBar Height="15" Margin="0,7,0,0" Value="{Binding HpRatio, Mode=OneWay}">
                                            <views:PixelBar.Style>
                                                <Style TargetType="views:PixelBar">
                                                    <Setter Property="Fill" Value="#FF5CCC74" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HpState}" Value="low">
                                                            <Setter Property="Fill" Value="#FFF0C040" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HpState}" Value="critical">
                                                            <Setter Property="Fill" Value="#FFE84A3C" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HpState}" Value="fainted">
                                                            <Setter Property="Fill" Value="#FF5C567A" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </views:PixelBar.Style>
                                        </views:PixelBar>

                                        <pixel:PixelText Text="{Binding Hp}" Scale="2" Tight="True" TextAlignment="Center"
                                                         HorizontalAlignment="Stretch" Colour="{StaticResource PxTextFaint}"
                                                         Margin="0,4,0,0" />
                                    </StackPanel>

                                    <!-- Variocolor: la estrella del resumen del juego, en la esquina y dando saltitos. -->
                                    <pixel:PixelIcon Icon="IconStar" Scale="2" Bob="True" HorizontalAlignment="Right"
                                                     VerticalAlignment="Top" Margin="0,8,8,0"
                                                     Visibility="{Binding IsShiny, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </pixel:PixelWindow>

            <!-- ============================================== LA PARTIDA -->
            <Grid Grid.Row="4">

                <!-- ==================================== LA PARTIDA
                     El nombre grande, sus distintivos, el rol (solo se ve: el rol se elige al crear la run) y
                     empezar de cero, que borra de verdad y por eso va en rojo. -->
                <pixel:PixelWindow Grid.Column="0" Title="PARTIDA" Icon="IconDocument" VerticalAlignment="Top">
                    <StackPanel>
                        <pixel:PixelText Text="{Binding RunName}" Scale="3" Trim="True" Margin="0,2,0,0"
                                         Colour="{StaticResource PxText}" Shadow="{StaticResource PxShadow}" />

                        <WrapPanel Margin="0,10,0,0">
                            <Grid Margin="0,0,6,6">
                                <views:PixelPanel Fill="{StaticResource PxFaceLift}" HasShadow="False" />
                                <pixel:PixelText Text="{Binding GameName}" Scale="2" Tight="True" Margin="10,7,10,8"
                                                 Colour="{StaticResource PxText}" />
                            </Grid>
                            <Grid Margin="0,0,6,6">
                                <views:PixelPanel Fill="{StaticResource PxFaceLift}" HasShadow="False" />
                                <pixel:PixelText Text="{Binding PlayerName}" Scale="2" Tight="True" Margin="10,7,10,8"
                                                 Colour="{StaticResource PxText}" />
                            </Grid>
                            <Grid Margin="0,0,6,6">
                                <views:PixelPanel Fill="{StaticResource PxAccentDeep}" HasShadow="False" />
                                <pixel:PixelText Text="{Binding RoleName}" Scale="2" Tight="True" Margin="10,7,10,8"
                                                 Colour="{StaticResource PxAccentLight}" />
                            </Grid>
                            <Grid Margin="0,0,6,6">
                                <views:PixelPanel Fill="{StaticResource PxFaceLift}" HasShadow="False" />
                                <pixel:PixelText Text="{Binding SeedLabel}" Scale="2" Tight="True" Margin="10,7,10,8"
                                                 Colour="{StaticResource PxTextDim}" />
                            </Grid>
                        </WrapPanel>

                        <pixel:PixelText Text="{Binding StageSourceText}" Scale="2" Wrap="True" Margin="0,4,0,0"
                                         Colour="{StaticResource PxTextFaint}" />

                        <pixel:PixelRule Margin="0,14,0,10" />

                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="EMPEZAR DE CERO"
                                    Command="{Binding StartOverCommand}" Style="{StaticResource PxDangerButton}"
                                    VerticalAlignment="Center" Margin="12,0,0,0" />
                            <pixel:PixelText Text="Borra la run y la partida." Scale="2" Wrap="True"
                                             Colour="{StaticResource PxTextFaint}" VerticalAlignment="Center" />
                        </DockPanel>

                        <pixel:PixelText Text="{Binding StartOverStatus}" Scale="2" Wrap="True" Margin="0,8,0,0"
                                         Colour="{StaticResource PxBad}" />
                    </StackPanel>
                </pixel:PixelWindow>

            </Grid>

            <!-- ============================================== AVISOS
                 Dos que no se pueden callar —el cap no está haciendo su trabajo, o hay un Pokémon en el juego que la run
                 no conoce— y la comprobación de la cadena con el estado del enlace. -->
            <StackPanel Grid.Row="5">
                <Grid Margin="0,12,0,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCapWarning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <views:PixelPanel Fill="{StaticResource PxBadDeep}" />
                    <pixel:PixelText Text="{Binding CapWarning}" Scale="2" Wrap="True" Margin="14,8,20,14"
                                     Colour="{StaticResource PxBad}" />
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDetection}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <views:PixelPanel Fill="{StaticResource PxWarnDeep}" />
                    <DockPanel Margin="14,8,20,14">
                        <Button DockPanel.Dock="Right" Content="REGISTRARLO" Command="{Binding RegisterDetectedCommand}"
                                Style="{StaticResource PxButton}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        <pixel:PixelText Text="{Binding DetectionMessage}" Scale="2" Wrap="True"
                                         Colour="{StaticResource PxWarn}" VerticalAlignment="Center" />
                    </DockPanel>
                </Grid>

                <!-- La cadena y el enlace: dos estados, cada uno con su luz. Callado si va bien, rojo si no. -->
                <Grid Margin="0,12,0,0">
                    <views:PixelPanel HasShadow="False">
                        <views:PixelPanel.Style>
                            <Style TargetType="views:PixelPanel">
                                <Setter Property="Fill" Value="{StaticResource PxFace}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IntegrityOk}" Value="False">
                                        <Setter Property="Fill" Value="{StaticResource PxBadDeep}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:PixelPanel.Style>
                    </views:PixelPanel>

                    <StackPanel Orientation="Horizontal" Margin="12,8,12,9">
                        <views:PixelPanel Width="18" Height="15" HasShadow="False" VerticalAlignment="Center" Margin="0,0,8,0">
                            <views:PixelPanel.Style>
                                <Style TargetType="views:PixelPanel">
                                    <Setter Property="Fill" Value="{StaticResource PxGood}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IntegrityOk}" Value="False">
                                            <Setter Property="Fill" Value="{StaticResource PxBad}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:PixelPanel.Style>
                        </views:PixelPanel>

                        <pixel:PixelText Text="{Binding IntegrityStatus}" Scale="2" Tight="True" VerticalAlignment="Center">
                            <pixel:PixelText.Style>
                                <Style TargetType="pixel:PixelText">
                                    <Setter Property="Colour" Value="{StaticResource PxTextFaint}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IntegrityOk}" Value="False">
                                            <Setter Property="Colour" Value="{StaticResource PxBad}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </pixel:PixelText.Style>
                        </pixel:PixelText>

                        <pixel:PixelRule Orientation="Vertical" Margin="14,0" />

                        <views:PixelPanel Width="18" Height="15" HasShadow="False" VerticalAlignment="Center" Margin="0,0,8,0">
                            <views:PixelPanel.Style>
                                <Style TargetType="views:PixelPanel">
                                    <Setter Property="Fill" Value="{StaticResource PxWarn}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GameLinkConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource PxGood}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:PixelPanel.Style>
                        </views:PixelPanel>

                        <!-- Si no hay enlace, el cap no vigila. Decirlo aquí es barato. -->
                        <pixel:PixelText Text="{Binding GameLinkStatus}" Scale="2" Tight="True" Trim="True"
                                         VerticalAlignment="Center" MaxWidth="560">
                            <pixel:PixelText.Style>
                                <Style TargetType="pixel:PixelText">
                                    <Setter Property="Colour" Value="{StaticResource PxWarn}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GameLinkConnected}" Value="True">
                                            <Setter Property="Colour" Value="{StaticResource PxTextFaint}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </pixel:PixelText.Style>
                        </pixel:PixelText>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
