<UserControl x:Class="PermaLocke.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- The party HP bar. Green, amber, red: the colour band is decided in the view model so
             the thresholds live in one place instead of being copied into triggers here. -->
        <Style x:Key="HpBar" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
            <Setter Property="Height" Value="5" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HpState}" Value="low">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HpState}" Value="critical">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HpState}" Value="fainted">
                    <Setter Property="Foreground" Value="{StaticResource DangerDeepBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HpNumber" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HpState}" Value="critical">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HpState}" Value="fainted">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Points on an event row: green up, red down, grey when it moved none. -->
        <Style x:Key="EventPoints" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGain}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLoss}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EventDot" TargetType="Ellipse">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{StaticResource BorderStrongBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGain}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLoss}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ================================================== EMPTY STATE
             No run yet. Shown instead of zeroed-out statistics, which would read as a run gone
             badly rather than as one that has not started. -->
        <Border MaxWidth="520" VerticalAlignment="Center" HorizontalAlignment="Center"
                Padding="36,32">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Inset}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasRun}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel>
                <Border Width="46" Height="46" CornerRadius="23"
                        Background="{StaticResource AccentDeepBrush}"
                        BorderBrush="{StaticResource AccentDimBrush}" BorderThickness="1"
                        HorizontalAlignment="Center">
                    <Ellipse Width="16" Height="16" Fill="{StaticResource AccentBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock Text="NO HAY NINGUNA RUN ACTIVA"
                           Style="{StaticResource PanelHeading}" FontSize="15"
                           HorizontalAlignment="Center" Margin="0,18,0,0" />

                <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,6,0,0"
                           Text="Deja tu ROM vanilla de Pokémon Ultra Luna en la carpeta ROM y crea la run. La ROM original no se toca en ningún momento." />

                <Button Content="CREAR RUN" Command="{Binding CreateRunCommand}"
                        Style="{StaticResource PrimaryButton}" Padding="26,10"
                        HorizontalAlignment="Center" Margin="0,24,0,0" />
            </StackPanel>
        </Border>

        <!-- ================================================== DASHBOARD -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasRun}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Four numbers, above everything else. A coloured cap on each tile carries the
                 meaning, so the numbers themselves can stay the same weight. -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Inset}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource SuccessBrush}" CornerRadius="7,7,0,0" />
                        <StackPanel Grid.Row="1" Margin="16,10,16,12">
                            <TextBlock Text="VIVOS" Style="{StaticResource StatLabel}" />
                            <TextBlock Text="{Binding AliveCount}" Style="{StaticResource StatValue}"
                                       Foreground="{StaticResource SuccessBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Inset}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource DangerBrush}" CornerRadius="7,7,0,0" />
                        <StackPanel Grid.Row="1" Margin="16,10,16,12">
                            <TextBlock Text="MUERTOS" Style="{StaticResource StatLabel}" />
                            <TextBlock Text="{Binding DeadCount}" Style="{StaticResource StatValue}"
                                       Foreground="{StaticResource DangerBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Inset}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource AccentBrush}" CornerRadius="7,7,0,0" />
                        <StackPanel Grid.Row="1" Margin="16,10,16,12">
                            <TextBlock Text="ENCUENTROS" Style="{StaticResource StatLabel}" />
                            <TextBlock Text="{Binding EncounterCount}" Style="{StaticResource StatValue}"
                                       Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="6" Style="{StaticResource Inset}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource WarningBrush}" CornerRadius="7,7,0,0" />
                        <StackPanel Grid.Row="1" Margin="16,10,16,12">
                            <TextBlock Text="CAP DE NIVEL" Style="{StaticResource StatLabel}" />
                            <TextBlock Text="{Binding LevelCapText}" Style="{StaticResource StatValue}"
                                       Foreground="{StaticResource WarningBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================================== TWO COLUMNS -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1.25*" />
                </Grid.ColumnDefinitions>

                <!-- Left: which run this is, and who is on the field right now. -->
                <DockPanel Grid.Column="0">
                    <Border DockPanel.Dock="Top" Style="{StaticResource Inset}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="RUN" Style="{StaticResource StatLabel}" />
                            <TextBlock Text="{Binding RunName}" Style="{StaticResource CardTitle}"
                                       FontSize="18" Margin="0,3,0,0" />

                            <WrapPanel Margin="0,10,0,0">
                                <Border Style="{StaticResource Chip}" Margin="0,0,6,6">
                                    <TextBlock Text="{Binding GameName}" Style="{StaticResource ChipText}" />
                                </Border>
                                <Border Style="{StaticResource Chip}" Margin="0,0,6,6">
                                    <TextBlock Text="{Binding PlayerName}" Style="{StaticResource ChipText}" />
                                </Border>
                                <Border Style="{StaticResource Chip}" Margin="0,0,6,6"
                                        Background="{StaticResource AccentDeepBrush}"
                                        BorderBrush="{StaticResource AccentDimBrush}">
                                    <TextBlock Text="{Binding SeedLabel}"
                                               FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                               Foreground="{StaticResource AccentBrightBrush}" />
                                </Border>
                            </WrapPanel>

                            <Border Style="{StaticResource Divider}" />

                            <TextBlock Text="ETAPA ACTUAL" Style="{StaticResource StatLabel}" />
                            <DockPanel Margin="0,3,0,0">
                                <Border DockPanel.Dock="Right" Style="{StaticResource Chip}"
                                        Background="{StaticResource WarningDeepBrush}"
                                        BorderBrush="{StaticResource WarningBrush}">
                                    <TextBlock Style="{StaticResource ChipText}"
                                               Foreground="{StaticResource WarningBrush}">
                                        <Run Text="CAP" />
                                        <Run Text="{Binding LevelCapText, Mode=OneWay}" FontWeight="Bold" />
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="{Binding StageText}" Style="{StaticResource Body}"
                                           VerticalAlignment="Center" />
                            </DockPanel>

                            <!-- Cómo se mueve el cap va en el tooltip del botón que lo mueve a mano:
                                 ahí es donde hace falta, y a cuerpo de texto le robaba tres líneas
                                 al panel del equipo, que entonces cortaba su propio mensaje. -->
                            <TextBlock Text="{Binding StageSourceText}" Style="{StaticResource Faint}"
                                       Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0" />

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="REGISTRAR CAPTURA" Command="{Binding RegisterCaptureCommand}"
                                        Style="{StaticResource PrimaryButton}" Padding="13,7" FontSize="11.5" />
                                <Button Content="ETAPA SUPERADA" Command="{Binding AdvanceStageCommand}"
                                        Style="{StaticResource GhostButton}" Padding="13,7" FontSize="11.5"
                                        Margin="8,0,0,0">
                                    <Button.ToolTip>
                                        <TextBlock TextWrapping="Wrap" MaxWidth="380" LineHeight="17"
                                                   Text="La etapa sube sola en cuanto el cristal Z de la prueba entra en tu mochila. Este botón sólo hace falta si la detección se retrasa: puede subir el cap, nunca bajarlo." />
                                    </Button.ToolTip>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Inset}" Padding="16,14" Margin="0,12,0,0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Margin="0,0,7,0"
                                         VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GameLinkConnected}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="EQUIPO EN EL JUEGO" Style="{StaticResource StatLabel}"
                                           VerticalAlignment="Center" />
                            </DockPanel>

                            <!-- A Pokémon the game has and the run has not. Announced, never
                                 registered behind the player's back: the rules still get to object. -->
                            <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="12"
                                    Background="{StaticResource WarningDeepBrush}"
                                    BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMedium}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDetection}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding DetectionMessage}" Style="{StaticResource Body}"
                                               FontSize="12" Foreground="{StaticResource WarningBrush}" />
                                    <Button Content="REGISTRARLO" Command="{Binding RegisterDetectedCommand}"
                                            Style="{StaticResource PrimaryButton}" Padding="12,6" FontSize="11.5"
                                            HorizontalAlignment="Left" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding GameLinkStatus}"
                                       FontSize="10.5" Margin="0,10,0,0" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Mono}">
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GameLinkConnected}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding LiveTeam}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,9">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Body}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="✨" FontSize="11" Margin="5,0,0,0"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsShiny}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>

                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Level}"
                                                           Style="{StaticResource Mono}" FontSize="12"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           Margin="10,0,0,0" />
                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Hp}"
                                                           Style="{StaticResource HpNumber}" MinWidth="58" />

                                                <ProgressBar Grid.Row="1" Grid.ColumnSpan="3"
                                                             Style="{StaticResource HpBar}"
                                                             Value="{Binding HpRatio, Mode=OneWay}"
                                                             Margin="0,4,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </DockPanel>

                <!-- Right: the log, and how far round the islands the run has got. -->
                <DockPanel Grid.Column="2">
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource Inset}" Padding="16,12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="PROGRESO" Style="{StaticResource StatLabel}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Islands}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Chip}" Margin="0,0,6,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource ChipText}"
                                                           Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="{Binding State}" Style="{StaticResource ChipText}"
                                                           Margin="7,0,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Inset}" Padding="16,14">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="ÚLTIMAS ACCIONES"
                                       Style="{StaticResource StatLabel}" Margin="0,0,0,10" />

                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding RecentEvents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" Padding="0,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="14" />
                                                        <ColumnDefinition Width="76" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="52" />
                                                    </Grid.ColumnDefinitions>

                                                    <Ellipse Grid.Column="0" Style="{StaticResource EventDot}"
                                                             HorizontalAlignment="Left" />

                                                    <TextBlock Grid.Column="1" Text="{Binding Timestamp}"
                                                               Style="{StaticResource Mono}" FontSize="11"
                                                               Foreground="{StaticResource TextFaintBrush}"
                                                               VerticalAlignment="Center" />

                                                    <StackPanel Grid.Column="2" Margin="4,0,8,0">
                                                        <TextBlock Text="{Binding Description}"
                                                                   Style="{StaticResource Body}" FontSize="12" />
                                                        <TextBlock Text="{Binding Type}"
                                                                   Style="{StaticResource Mono}" FontSize="10"
                                                                   Foreground="{StaticResource TextFaintBrush}" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="3" Text="{Binding Points}"
                                                               Style="{StaticResource EventPoints}"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </Grid>

            <!-- The chain check. Quiet when it passes, loud when it does not. -->
            <Border Grid.Row="3" Margin="0,12,0,0" Padding="12,7"
                    CornerRadius="{StaticResource RadiusSmall}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IntegrityOk}" Value="False">
                                <Setter Property="Background" Value="{StaticResource DangerDeepBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IntegrityOk}" Value="False">
                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock Text="{Binding IntegrityStatus}" FontSize="11" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Mono}">
                                <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IntegrityOk}" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
