<UserControl x:Class="PermaLocke.App.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <!-- Un marcador de zona. Los tres estados los decide el ViewModel en State, para no
             repartir la misma decisión entre tres disparadores copiados en cada sitio. -->
        <Style x:Key="ZoneMarker" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
            <Setter Property="Background" Value="#B0202020" />
            <Setter Property="BorderBrush" Value="#E0FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Pin" Fill="{TemplateBinding Background}"
                                     Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2" />
                            <TextBlock Text="{TemplateBinding Content}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pin" Property="StrokeThickness" Value="3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="spent">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="dead">
                    <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- El mismo marcador para el tablero de respaldo, cuadrado y sin mapa debajo. -->
        <Style x:Key="BoardMarker" TargetType="Button" BasedOn="{StaticResource ZoneMarker}">
            <Setter Property="Margin" Value="0,0,5,5" />
            <Setter Property="Background" Value="{StaticResource SunkenBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="spent">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="dead">
                    <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Fila de lista, con la elegida encendida: es la que se lleva el clic del mapa, y
             equivocarse de fila coloca o gasta la zona del que no es. -->
        <Style x:Key="ZoneRow" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="{StaticResource PanelBrush}"
                                CornerRadius="6" BorderThickness="1" Padding="10,8"
                                BorderBrush="{StaticResource BorderSubtleBrush}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{StaticResource SurfaceHighBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{StaticResource AccentDeepBrush}" />
                                <Setter TargetName="Row" Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IslandTab" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,0,5,5" />
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="290" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Inset}" Padding="16,14">
            <DockPanel>

                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="RELEER" Style="{StaticResource GhostButton}"
                            Command="{Binding RefreshCommand}" Padding="14,8" FontSize="11.5"
                            VerticalAlignment="Top" />

                    <StackPanel>
                        <TextBlock Text="ALOLA" Style="{StaticResource StatLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding SpentCount}" Style="{StaticResource StatValue}" />
                            <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Bottom"
                                       Margin="6,0,0,4">
                                <Run Text="de" />
                                <Run Text="{Binding ZoneCount, Mode=OneWay}" />
                                <Run Text="zonas gastadas" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Faint}" TextWrapping="Wrap"
                           Visibility="{Binding HasMap, Converter={StaticResource InverseBoolToVisibility}}"
                           Text="Falta Data/islas.json. Lo genera «RomTool mundos» leyendo del propio cartucho a qué isla pertenece cada zona." />

                <!-- EL MAPA, con el arte del cartucho -->
                <Grid Visibility="{Binding HasArt, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="MapSurface" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Image Source="{Binding IslandImage}" Stretch="None" />

                            <!-- La capa de marcadores. El clic para colocar lo recoge el
                                 code-behind, que es lo unico que sabe donde se ha pinchado. -->
                            <Canvas x:Name="MarkerLayer" Background="Transparent"
                                    MouseLeftButtonDown="OnMapClicked">
                                <ItemsControl ItemsSource="{Binding SelectedIsland.Zones}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                            <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- El margen negativo centra el circulo en el punto
                                                 que se pincho, en vez de colgarlo de su esquina. -->
                                            <Button Content="{Binding Number}" Margin="-13,-13,0,0"
                                                    Style="{StaticResource ZoneMarker}"
                                                    Visibility="{Binding IsPlaced,
                                                        Converter={StaticResource BoolToVisibility}}"
                                                    Command="{Binding DataContext.ClickZoneCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.ToolTip>
                                                    <ToolTip>
                                                        <StackPanel MaxWidth="260">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Tooltip}"
                                                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                                                        </StackPanel>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- RESPALDO: sin las imagenes del cartucho, el tablero numerado de siempre. Que
                     falte un dibujo no puede costarle a nadie su seguimiento de zonas. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasArt, Converter={StaticResource InverseBoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Islands}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelBrush}" CornerRadius="10"
                                        Padding="14,12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}"
                                                       VerticalAlignment="Center" FontSize="11.5">
                                                <Run Text="{Binding SpentCount, Mode=OneWay}" />
                                                <Run Text="/" />
                                                <Run Text="{Binding Count, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource PanelHeading}" />
                                        </DockPanel>

                                        <ItemsControl ItemsSource="{Binding Zones}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Number}"
                                                            Style="{StaticResource BoardMarker}"
                                                            Command="{Binding DataContext.ClickZoneCommand,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.ToolTip>
                                                            <ToolTip>
                                                                <StackPanel MaxWidth="260">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Tooltip}"
                                                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                                                </StackPanel>
                                                            </ToolTip>
                                                        </Button.ToolTip>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- PANEL LATERAL -->
        <Border Grid.Column="1" Style="{StaticResource Inset}" Padding="14,12" Margin="10,0,0,0">
            <DockPanel>

                <!-- Las cuatro islas -->
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Islands}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Name}" Style="{StaticResource IslandTab}"
                                    Command="{Binding DataContext.SelectIslandCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <CheckBox DockPanel.Dock="Top" Content="MODO COLOCAR"
                          IsChecked="{Binding IsPlacingMode}" Margin="0,0,0,4"
                          Visibility="{Binding HasArt, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock DockPanel.Dock="Top" Text="{Binding MarkerCount}"
                           Style="{StaticResource Faint}" Margin="0,0,0,10"
                           Visibility="{Binding HasArt, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" TextWrapping="Wrap"
                           FontSize="11.5" Margin="0,10,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusIsBad}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Grid>
                    <!-- COLOCAR: elige una zona y pincha el mapa -->
                    <DockPanel Visibility="{Binding IsPlacingMode, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock DockPanel.Dock="Top" Text="SIN COLOCAR"
                                   Style="{StaticResource StatLabel}" Margin="0,0,0,4" />
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Faint}" TextWrapping="Wrap"
                                   Margin="0,0,0,10"
                                   Text="Elige una zona y pincha en el mapa dónde va. Se guarda sola, y solo hay que hacerlo una vez." />

                        <ListBox ItemsSource="{Binding Unplaced}" SelectedItem="{Binding Placing}"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource ZoneRow}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- NORMAL: las capturas que aún no han dicho su zona -->
                    <DockPanel Visibility="{Binding IsPlacingMode, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock DockPanel.Dock="Top" Text="SIN ZONA"
                                   Style="{StaticResource StatLabel}" Margin="0,0,0,4" />
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Faint}" TextWrapping="Wrap"
                                   Margin="0,0,0,10"
                                   Text="Elige una captura y pincha el marcador de la zona donde salió. Pinchar una gastada la libera." />

                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Faint}" TextWrapping="Wrap"
                                   Margin="0,10,0,0"
                                   Visibility="{Binding HasPending, Converter={StaticResource InverseBoolToVisibility}}"
                                   Text="Nada pendiente: todas tus capturas tienen su zona dicha." />

                        <ListBox ItemsSource="{Binding Pending}" SelectedItem="{Binding Selected}"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource ZoneRow}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontSize="12" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Where}" Style="{StaticResource Faint}"
                                                   FontSize="10.5" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
