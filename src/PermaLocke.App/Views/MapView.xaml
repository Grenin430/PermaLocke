<UserControl x:Class="PermaLocke.App.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <!-- Un marcador de zona. Los tres estados los decide el ViewModel en State, para no
             repartir la misma decisión entre tres disparadores copiados en cada sitio. -->
        <Style x:Key="ZoneMarker" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
            <Setter Property="Background" Value="#40202020" />
            <Setter Property="BorderBrush" Value="#E0FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Pin" Fill="{TemplateBinding Background}"
                                     Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2" />
                            <TextBlock Text="{TemplateBinding Content}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pin" Property="StrokeThickness" Value="3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Caught">
                    <Setter Property="Background" Value="#E024A148" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Died">
                    <Setter Property="Background" Value="#E0D93A3A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Fled">
                    <Setter Property="Background" Value="#FF080808" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- El mismo marcador para el tablero de respaldo, cuadrado y sin mapa debajo. -->
        <Style x:Key="BoardMarker" TargetType="Button" BasedOn="{StaticResource ZoneMarker}">
            <Setter Property="Margin" Value="0,0,5,5" />
            <Setter Property="Background" Value="{StaticResource SunkenBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Caught">
                    <Setter Property="Background" Value="#24A148" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Died">
                    <Setter Property="Background" Value="#D93A3A" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Fled">
                    <Setter Property="Background" Value="#080808" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IslandTab" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,0,5,5" />
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="290" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Inset}" Padding="16,14">
            <DockPanel>

                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="RELEER" Style="{StaticResource GhostButton}"
                            Command="{Binding RefreshCommand}" Padding="14,8" FontSize="11.5"
                            VerticalAlignment="Top" />

                    <StackPanel>
                        <TextBlock Text="ALOLA" Style="{StaticResource StatLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding SpentCount}" Style="{StaticResource StatValue}" />
                            <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Bottom"
                                       Margin="6,0,0,4">
                                <Run Text="de" />
                                <Run Text="{Binding ZoneCount, Mode=OneWay}" />
                                <Run Text="zonas marcadas" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Faint}" TextWrapping="Wrap"
                           Visibility="{Binding HasMap, Converter={StaticResource InverseBoolToVisibility}}"
                           Text="Falta Data/islas.json. Lo genera «RomTool mundos» leyendo del propio cartucho a qué isla pertenece cada zona." />

                <!-- EL MAPA, con el arte del cartucho -->
                <Grid Visibility="{Binding HasArt, Converter={StaticResource BoolToVisibility}}">
                    <!-- La isla se escala para caber entera en el hueco que haya. Un Viewbox y no
                         un ScrollViewer porque un mapa con barras de desplazamiento no es un mapa:
                         lo que se mira de un vistazo es cuanto queda por gastar, y eso exige verlo
                         todo. Los marcadores van dentro, asi que escalan con el. -->
                    <Viewbox Stretch="Uniform" StretchDirection="Both">
                        <Grid x:Name="MapSurface" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Image Source="{Binding IslandImage}" Stretch="None" />

                            <!-- La capa de marcadores. El clic para colocar lo recoge el
                                 code-behind, que es lo unico que sabe donde se ha pinchado. -->
                            <Canvas x:Name="MarkerLayer" Background="Transparent">
                                <!-- La carta tarda un momento en salir a proposito: apareciendo al
                                     instante, cruzar el mapa dispara veinte. -->
                                <Canvas.Resources>
                                    <Style TargetType="ToolTip">
                                        <Setter Property="Placement" Value="Right" />
                                        <Setter Property="HorizontalOffset" Value="8" />
                                    </Style>
                                </Canvas.Resources>
                                <ItemsControl ItemsSource="{Binding SelectedIsland.Zones}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                            <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- El margen negativo centra el circulo en el punto
                                                 que se pincho, en vez de colgarlo de su esquina. -->
                                            <Button Content="{Binding Number}" Margin="-13,-13,0,0"
                                                    Style="{StaticResource ZoneMarker}"
                                                    Command="{Binding DataContext.ClickZoneCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTipService.InitialShowDelay="350"
                                                    ToolTipService.ShowDuration="30000">
                                                <Button.ToolTip>
                                                    <ToolTip Padding="0" Background="Transparent"
                                                             BorderThickness="0" HasDropShadow="True">
                                                        <Border Background="{StaticResource PanelBrush}"
                                                                BorderBrush="{StaticResource BorderStrongBrush}"
                                                                BorderThickness="1" CornerRadius="8"
                                                                Width="280">
                                                            <StackPanel>
                                                                <!-- La foto arriba, recortada al
                                                                     ancho de la carta. -->
                                                                <Image Source="{Binding Photo}"
                                                                       Stretch="UniformToFill"
                                                                       MaxHeight="180"
                                                                       Visibility="{Binding HasPhoto,
                                                                           Converter={StaticResource BoolToVisibility}}" />

                                                                <StackPanel Margin="12,10,12,11">
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontFamily="{StaticResource DisplayFont}"
                                                                               FontSize="14" TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding Tooltip}"
                                                                               Style="{StaticResource Faint}"
                                                                               TextWrapping="Wrap" Margin="0,4,0,0" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>
                        </Grid>
                    </Viewbox>
                </Grid>

                <!-- RESPALDO: sin las imagenes del cartucho, el tablero numerado de siempre. Que
                     falte un dibujo no puede costarle a nadie su seguimiento de zonas. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasArt, Converter={StaticResource InverseBoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Islands}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelBrush}" CornerRadius="10"
                                        Padding="14,12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}"
                                                       VerticalAlignment="Center" FontSize="11.5">
                                                <Run Text="{Binding SpentCount, Mode=OneWay}" />
                                                <Run Text="/" />
                                                <Run Text="{Binding Count, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource PanelHeading}" />
                                        </DockPanel>

                                        <ItemsControl ItemsSource="{Binding Zones}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Number}"
                                                            Style="{StaticResource BoardMarker}"
                                                            Command="{Binding DataContext.ClickZoneCommand,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.ToolTip>
                                                            <ToolTip>
                                                                <StackPanel MaxWidth="260">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Tooltip}"
                                                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                                                </StackPanel>
                                                            </ToolTip>
                                                        </Button.ToolTip>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- PANEL LATERAL -->
        <Border Grid.Column="1" Style="{StaticResource Inset}" Padding="14,12" Margin="10,0,0,0">
            <DockPanel>

                <!-- Las cuatro islas -->
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Islands}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Name}" Style="{StaticResource IslandTab}"
                                    Command="{Binding DataContext.SelectIslandCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- LEYENDA. El mapa es lo unico que hay que mirar, asi que el panel solo explica
                     que significa cada color y no pide nada. -->
                <StackPanel>
                    <TextBlock Text="LEYENDA" Style="{StaticResource StatLabel}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Pincha una zona para marcar lo que pasó. Cada clic pasa al siguiente, y el cuarto la deja sin marcar." />

                    <ItemsControl>
                        <ItemsControl.Resources>
                            <Style x:Key="LegendDot" TargetType="Border">
                                <Setter Property="Width" Value="22" />
                                <Setter Property="Height" Value="22" />
                                <Setter Property="CornerRadius" Value="11" />
                                <Setter Property="BorderThickness" Value="2" />
                                <Setter Property="BorderBrush" Value="#E0FFFFFF" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                            <Style x:Key="LegendRow" TargetType="StackPanel">
                                <Setter Property="Orientation" Value="Horizontal" />
                                <Setter Property="Margin" Value="0,0,0,10" />
                            </Style>
                            <Style x:Key="LegendText" TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="10,0,0,0" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                        </ItemsControl.Resources>

                        <StackPanel Style="{StaticResource LegendRow}">
                            <Border Style="{StaticResource LegendDot}" Background="#40202020" />
                            <TextBlock Style="{StaticResource LegendText}" Text="Sin marcar" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource LegendRow}">
                            <Border Style="{StaticResource LegendDot}" Background="#E024A148" />
                            <TextBlock Style="{StaticResource LegendText}" Text="Atrapado en esta zona" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource LegendRow}">
                            <Border Style="{StaticResource LegendDot}" Background="#E0D93A3A" />
                            <TextBlock Style="{StaticResource LegendText}" Text="Primer pokémon matado" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource LegendRow}">
                            <Border Style="{StaticResource LegendDot}" Background="#FF080808" />
                            <TextBlock Style="{StaticResource LegendText}" Text="Primer encuentro: huida" />
                        </StackPanel>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="Pasa el ratón por un marcador para ver de qué zona es." />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
