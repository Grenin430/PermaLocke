<UserControl x:Class="PermaLocke.App.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:PermaLocke.App.Services"
             xmlns:conv="clr-namespace:PermaLocke.App.Converters">

    <UserControl.Resources>


        <!-- Un marcador de zona. Los tres estados los decide el ViewModel en State, para no
             repartir la misma decisión entre tres disparadores copiados en cada sitio. -->
        <Style x:Key="ZoneMarker" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
            <Setter Property="Background" Value="{StaticResource ZoneFreeBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ZoneRingBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <!-- Contra-escala: el Viewbox encoge el mapa entero y con el
                                         los marcadores, dejando el numero en nueve pixeles. Un mapa
                                         de verdad conserva el tamano de sus chinchetas al alejar. -->
                                    <ScaleTransform
                                        ScaleX="{Binding DataContext.MarkerScale,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ScaleY="{Binding DataContext.MarkerScale,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    <ScaleTransform x:Name="Press" ScaleX="1" ScaleY="1" />
                                    <ScaleTransform x:Name="Hover" ScaleX="1" ScaleY="1" />
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <!-- La onda: sale del marcador al pulsarlo y se va. Vive debajo de
                                 todo y con Opacity 0, asi que fuera de su medio segundo no existe. -->
<!-- El latido de una zona donde murio alguien. Vive debajo de todo y con
                                 Opacity 0, asi que en las otras tres zonas no existe. -->
                            <Ellipse x:Name="Toll" Stroke="{TemplateBinding Background}"
                                     StrokeThickness="2" Fill="Transparent" Opacity="0"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="TollScale" ScaleX="1" ScaleY="1" />
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <Ellipse x:Name="Wave" Stroke="{TemplateBinding Background}"
                                     StrokeThickness="3" Fill="Transparent" Opacity="0"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="WaveScale" ScaleX="1" ScaleY="1" />
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <!-- Sombra propia: convierte un circulo pintado en una chincheta
                                 apoyada sobre el mapa. -->
                            <Ellipse x:Name="Pin" Fill="{TemplateBinding Background}"
                                     Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1.5"
                                                      Direction="270" Opacity="0.6" Color="Black" />
                                </Ellipse.Effect>
                            </Ellipse>

                            <!-- La cifra NO se ve en el mapa: es un indice dentro de la isla, no un
                                 dato, y sobre el dibujo la zona ya la identifica su sitio. Sigue en
                                 la plantilla porque el tablero de respaldo -el que sale si faltan
                                 las imagenes- comparte este estilo, y alli es lo UNICO que
                                 distingue una casilla de otra. Se pide con Tag, que es la unica
                                 forma de que un estilo derivado encienda una pieza de la plantilla
                                 sin duplicarla entera.
                                 Binding y NO TemplateBinding: Content es un int y Text es string, y
                                 un TemplateBinding no convierte tipos. No falla, no avisa, no
                                 pinta, y por eso esta cifra no se habia visto nunca. -->
                            <TextBlock x:Name="Number" Visibility="Collapsed"
                                       Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextBrush}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}" />

                            <!-- Los tres estados, dibujados. Trazo y no silueta porque a doce
                                 pixeles una figura rellena se convierte en una mancha, y estos
                                 tres tienen que distinguirse entre si de un vistazo. -->
                            <Path x:Name="Tick" Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="2.4" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Visibility="Collapsed" Data="M 7,13.5 L 11,17.5 L 19,8.5" />

                            <!-- El aspa de las muertas. Se lee antes que el color y ahorra ir a la
                                 leyenda: es el unico de estos adornos que ademas informa. -->
                            <Path x:Name="Cross" Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="2.4" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" Visibility="Collapsed"
                                  Data="M 8,8 L 18,18 M 18,8 L 8,18" />

                            <!-- La huida: una flecha que sale, hacia fuera del circulo. -->
                            <Path x:Name="Away" Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="2.2" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Visibility="Collapsed"
                                  Data="M 8,18 L 17,9 M 17,9 L 11.5,9 M 17,9 L 17,14.5" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pin" Property="StrokeThickness" Value="3" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.14" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="Hover"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.14" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="Hover"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!-- El tablero de respaldo pide su cifra. Va antes que el disparador de
                                 marcada, para que ahi tambien la pierda en cuanto tiene dibujo: dos
                                 cosas encima del mismo circulo no se leen ni una. -->
                            <Trigger Property="Tag" Value="numerada">
                                <Setter TargetName="Number" Property="Visibility" Value="Visible" />
                            </Trigger>

                            <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>

                            <!-- Atenuada porque la leyenda esta senalando otro estado. -->
                            <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                                <Setter Property="Opacity" Value="0.18" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding State}" Value="Caught">
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </DataTrigger>

                            <!-- La muerte pesa: aro mas grueso y un latido lento que sale del
                                 marcador. Es el unico estado que no se puede deshacer jugando, y
                                 «donde perdi gente» es la pregunta que un mapa asi tiene que
                                 contestar desde lejos. Solo late mientras la zona esta en ese
                                 estado: el disparador lo enciende y lo apaga. -->
                            <DataTrigger Binding="{Binding State}" Value="Died">
                                <Setter TargetName="Cross" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Pin" Property="StrokeThickness" Value="3" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="Knell">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="TollScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             From="1" To="2.1" Duration="0:0:2.2" />
                                            <DoubleAnimation Storyboard.TargetName="TollScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             From="1" To="2.1" Duration="0:0:2.2" />
                                            <DoubleAnimation Storyboard.TargetName="Toll"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.5" To="0" Duration="0:0:2.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="Knell" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>

                            <!-- La huida con el anillo roto: algo que se escapo. -->
                            <DataTrigger Binding="{Binding State}" Value="Fled">
                                <Setter TargetName="Pin" Property="StrokeDashArray" Value="2.2 1.6" />
                                <Setter TargetName="Away" Property="Visibility" Value="Visible" />
                            </DataTrigger>

                            <!-- Un rebote al pulsar. Es el gesto que mas se repite en toda la
                                 aplicacion -sesenta y una zonas por cuatro estados- y sin acuse de
                                 recibo un doble clic sin querer no se distingue de uno solo. -->
                            <EventTrigger RoutedEvent="Button.Click">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Press"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         From="0.72" To="1" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.9" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Press"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         From="0.72" To="1" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.9" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <!-- Y la onda, que sale del propio marcador y se apaga.
                                             El mismo recurso que el gacha al parar la ruleta. -->
                                        <DoubleAnimation Storyboard.TargetName="WaveScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         From="1" To="2.6" Duration="0:0:0.45" />
                                        <DoubleAnimation Storyboard.TargetName="WaveScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         From="1" To="2.6" Duration="0:0:0.45" />
                                        <DoubleAnimation Storyboard.TargetName="Wave"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="0.85" To="0" Duration="0:0:0.45" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Caught">
                    <Setter Property="Background" Value="{StaticResource ZoneCaughtBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Died">
                    <Setter Property="Background" Value="{StaticResource ZoneDiedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Fled">
                    <Setter Property="Background" Value="{StaticResource ZoneFledBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Una celda por zona para la barra de la run entera. Fija de ancho, asi que los cuatro
             grupos salen proporcionales solos sin que nadie calcule una anchura. -->
        <Style x:Key="RunCell" TargetType="Border">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{StaticResource SunkenBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Caught">
                    <Setter Property="Background" Value="{StaticResource ZoneCaughtBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Died">
                    <Setter Property="Background" Value="{StaticResource ZoneDiedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Fled">
                    <Setter Property="Background" Value="{StaticResource ZoneFledBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- El grupo de una isla dentro de esa barra, subrayado si es la que estas viendo. -->
        <Style x:Key="RunCellGroup" TargetType="Border">
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Padding" Value="0,0,0,4" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- El mismo marcador para el tablero de respaldo, cuadrado y sin mapa debajo. -->
        <Style x:Key="BoardMarker" TargetType="Button" BasedOn="{StaticResource ZoneMarker}">
            <!-- Sin mapa debajo no hay sitio que identifique la zona, asi que aqui la cifra si. -->
            <Setter Property="Tag" Value="numerada" />
            <Setter Property="Margin" Value="0,0,5,5" />
            <Setter Property="Background" Value="{StaticResource SunkenBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Caught">
                    <Setter Property="Background" Value="{StaticResource ZoneCaughtBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Died">
                    <Setter Property="Background" Value="{StaticResource ZoneDiedBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Fled">
                    <Setter Property="Background" Value="{StaticResource ZoneFledBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- El boton de cada isla dice tres cosas: cual es, cuanto llevas, y si esta terminada.
             La ultima en verde, el mismo verde que «atrapado», porque es la suma de lo que hay
             en el mapa y no un color nuevo que aprenderse. -->
        <Style x:Key="IslandTab" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <!-- EL FONDO Y EL BORDE, DICHOS AQUI. Esta plantilla los pinta con TemplateBinding, y
                 ni GhostButton ni PrimaryButton fijan nunca esas PROPIEDADES: las escriben a pelo
                 dentro de sus propias plantillas. Heredar de ellos no trae nada, asi que el boton
                 se quedaba con el fondo por defecto de un Button de Windows -gris claro- y las
                 tres islas sin elegir salian como cajas blancas en una pantalla violeta. Los
                 disparadores de abajo ya los pisan para la elegida y la completada, que es
                 justo por lo que no se noto: la que miras siempre esta bien. -->
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,0,5,5" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="MinWidth" Value="128" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Body" CornerRadius="{StaticResource RadiusSmall}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" ClipToBounds="True">
                                <Grid>
                                    <!-- La barra de progreso, detras de todo: dos columnas de
                                         estrella son la unica forma de dimensionar por proporcion
                                         sin saber antes el ancho. Sustituye a la cifra suelta, que
                                         decia lo mismo peor. -->
                                    <Grid IsHitTestVisible="False">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding Progress,
                                                Converter={StaticResource FractionToStar}}" />
                                            <ColumnDefinition Width="{Binding Progress,
                                                Converter={StaticResource FractionToStar},
                                                ConverterParameter=resto}" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Fill="{StaticResource ZoneDoneFillBrush}" />
                                    </Grid>

                                    <!-- El brillo que recorre la isla elegida. Va dentro del borde
                                         recortado, asi que barre el boton y no se sale. -->
                                    <Rectangle x:Name="Sheen" Opacity="0" IsHitTestVisible="False">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="Transparent" Offset="0" />
                                                <GradientStop Color="{StaticResource SheenColor}" Offset="0.5" />
                                                <GradientStop Color="Transparent" Offset="1" />
                                                <LinearGradientBrush.Transform>
                                                    <TranslateTransform x:Name="SheenSlide" X="-260" />
                                                </LinearGradientBrush.Transform>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>

                                    <!-- El fogonazo al completar una isla. Es el unico momento de
                                         la pantalla que merece celebrarse y ocurria en silencio. -->
                                    <Rectangle x:Name="Flash" Opacity="0" IsHitTestVisible="False"
                                               Fill="{StaticResource ZoneCaughtLightBrush}" />

                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
<!-- Sobre un fondo transparente, bajar la opacidad no se ve: el aviso de que el
                                 boton responde tiene que ser el mismo relleno que usa cualquier otro
                                 boton fantasma de la aplicacion. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="{StaticResource SurfaceHighBrush}" />
                                <Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                            </Trigger>

                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="Shine">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="Sheen"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="SheenSlide"
                                                             Storyboard.TargetProperty="X"
                                                             From="-260" To="260" Duration="0:0:2.6"
                                                             BeginTime="0:0:1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="Shine" />
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Sheen"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Flash"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.55" To="0" Duration="0:0:0.9">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentDeepBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsComplete}" Value="True">
                    <Setter Property="Background" Value="{StaticResource ZoneDoneFillBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource ZoneCaughtBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource ZoneCaughtLightBrush}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsComplete}" Value="True" />
                        <Condition Binding="{Binding IsSelected}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource ZoneDoneFillStrongBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="290" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Inset}" Padding="16,14">
            <DockPanel>

                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Content="RELEER" Style="{StaticResource GhostButton}"
                            Command="{Binding RefreshCommand}" Padding="14,8" FontSize="11.5"
                            VerticalAlignment="Top" />

                    <StackPanel>
                        <TextBlock Text="ALOLA" Style="{StaticResource StatLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Style="{StaticResource StatValue}"
                                       svc:Rolling.To="{Binding SpentCount}" />
                            <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Bottom"
                                       Margin="6,0,0,4">
                                <Run Text="de" />
                                <Run Text="{Binding ZoneCount, Mode=OneWay}" />
                                <Run Text="zonas marcadas" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <!-- LA RUN ENTERA, una celda por zona y un grupo por isla. Sustituye a la cifra
                     suelta: «17 de 61» hay que leerlo, y esto se ve. Y dice mas que un progreso,
                     porque cada celda lleva su estado, asi que de un vistazo estan las cuatro
                     islas, lo gastado, y donde se torcio. El subrayado marca la que estas viendo.
                     Va en un Viewbox que solo encoge: con la ventana estrecha se ajusta, y con
                     sitio de sobra no se estira hasta deformarse. -->
                <Viewbox DockPanel.Dock="Top" Stretch="Uniform" StretchDirection="DownOnly"
                         HorizontalAlignment="Left" Margin="0,0,0,14">
                    <ItemsControl ItemsSource="{Binding Islands}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RunCellGroup}">
                                    <ItemsControl ItemsSource="{Binding Zones}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource RunCell}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Viewbox>

                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Faint}" TextWrapping="Wrap"
                           Visibility="{Binding HasMap, Converter={StaticResource InverseBoolToVisibility}}"
                           Text="Falta Data/islas.json. Lo genera «RomTool mundos» leyendo del propio cartucho a qué isla pertenece cada zona." />

                <!-- EL MAPA, con el arte del cartucho. Hundido: el escalon de gris es lo que
                     separa el mapa del resto de la pantalla, sin una sola sombra de caja. -->
                <Border Style="{StaticResource Well}" Padding="4"
                        Visibility="{Binding HasArt, Converter={StaticResource BoolToVisibility}}">
                    <!-- La isla se escala para caber entera en el hueco que haya. Un Viewbox y no
                         un ScrollViewer porque un mapa con barras de desplazamiento no es un mapa:
                         lo que se mira de un vistazo es cuanto queda por gastar, y eso exige verlo
                         todo. Los marcadores van dentro, asi que escalan con el. -->
                    <Viewbox x:Name="MapFrame" Stretch="Uniform" StretchDirection="Both" Margin="6"
                             SizeChanged="OnMapSized">
                        <Grid x:Name="MapSurface" HorizontalAlignment="Left" VerticalAlignment="Top"
                              SizeChanged="OnMapSized">
                            <!-- La isla necesita suelo. Recortada sobre un panel liso flota, y por
                                 eso se lee pequena aunque ocupe su hueco: no hay nada que diga
                                 donde acaba el mapa y empieza la aplicacion. -->
                            <!-- Dos copias de la misma imagen: la de atras con un halo claro que
                                 despega la isla del fondo, la de delante con su sombra. Un elemento
                                 solo admite UN efecto, y hacian falta los dos. La fuente es la
                                 misma, asi que no se decodifica dos veces. -->
                            <Image Source="{Binding IslandImage}" Stretch="None"
                                   IsHitTestVisible="False">
                                <Image.Effect>
                                    <DropShadowEffect BlurRadius="34" ShadowDepth="0"
                                                      Opacity="0.5"
                                                      Color="{StaticResource IslandHaloColor}" />
                                </Image.Effect>
                            </Image>

                            <Image Source="{Binding IslandImage}" Stretch="None">
                                <Image.Effect>
                                    <DropShadowEffect BlurRadius="26" ShadowDepth="0"
                                                      Opacity="0.55" Color="Black" />
                                </Image.Effect>
                            </Image>

                            <!-- EL MAR RESPIRA. Una banda de luz cruzando el mapa cada diecisiete
                                 segundos. Va sobre el dibujo entero y no solo sobre el agua porque
                                 el agua es parte del PNG y no hay nada que recortar; a este alfa,
                                 sobre tierra no se aprecia y sobre el azul se lee como luz.
                                 Anima la TRANSFORMACION DEL PINCEL y no un efecto: mover un
                                 degradado es barato, y recalcular una sombra en cada fotograma
                                 sobre una imagen de este tamano no lo es. -->
                            <Rectangle IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="Transparent" Offset="0.32" />
                                        <GradientStop Color="{StaticResource TideColor}" Offset="0.5" />
                                        <GradientStop Color="Transparent" Offset="0.68" />
                                        <LinearGradientBrush.Transform>
                                            <TranslateTransform x:Name="Tide" X="-1100" />
                                        </LinearGradientBrush.Transform>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.Triggers>
                                    <EventTrigger RoutedEvent="Rectangle.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="Tide"
                                                                 Storyboard.TargetProperty="X"
                                                                 From="-1100" To="1100"
                                                                 Duration="0:0:17" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Rectangle.Triggers>
                            </Rectangle>

                            <!-- La capa de marcadores. El clic para colocar lo recoge el
                                 code-behind, que es lo unico que sabe donde se ha pinchado. -->
                            <Canvas x:Name="MarkerLayer" Background="Transparent">
                                <!-- La carta tarda un momento en salir a proposito: apareciendo al
                                     instante, cruzar el mapa dispara veinte. -->
                                <Canvas.Resources>
                                    <Style TargetType="ToolTip">
                                        <Setter Property="Placement" Value="Right" />
                                        <Setter Property="HorizontalOffset" Value="8" />
                                    </Style>
                                </Canvas.Resources>
                                <ItemsControl x:Name="Markers" ItemsSource="{Binding SelectedIsland.Zones}"
                                              Loaded="OnMarkersLoaded">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                            <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- El margen negativo centra el circulo en el punto
                                                 que se pincho, en vez de colgarlo de su esquina. -->
                                            <Button Content="{Binding Number}" Margin="-13,-13,0,0"
                                                    Style="{StaticResource ZoneMarker}"
                                                    Command="{Binding DataContext.ClickZoneCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    MouseRightButtonUp="OnZoneRightClicked"
                                                    ToolTipService.InitialShowDelay="350"
                                                    ToolTipService.ShowDuration="30000">
                                                <Button.ToolTip>
                                                    <ToolTip Padding="0" Background="Transparent"
                                                             BorderThickness="0" HasDropShadow="True">
                                                        <Border Background="{StaticResource PanelBrush}"
                                                                BorderBrush="{StaticResource BorderStrongBrush}"
                                                                BorderThickness="1" CornerRadius="8"
                                                                Width="280">
                                                            <StackPanel>
                                                                <!-- La foto arriba, recortada al
                                                                     ancho de la carta. -->
                                                                <Image Source="{Binding Photo}"
                                                                       Stretch="UniformToFill"
                                                                       MaxHeight="180"
                                                                       Visibility="{Binding HasPhoto,
                                                                           Converter={StaticResource BoolToVisibility}}" />

                                                                <StackPanel Margin="12,10,12,11">
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontFamily="{StaticResource DisplayFont}"
                                                                               FontSize="14" TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding Tooltip}"
                                                                               Style="{StaticResource Faint}"
                                                                               TextWrapping="Wrap" Margin="0,4,0,0" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>
                        </Grid>
                    </Viewbox>
                </Border>

                <!-- RESPALDO: sin las imagenes del cartucho, el tablero numerado de siempre. Que
                     falte un dibujo no puede costarle a nadie su seguimiento de zonas. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasArt, Converter={StaticResource InverseBoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Islands}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelBrush}" CornerRadius="10"
                                        Padding="14,12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}"
                                                       VerticalAlignment="Center" FontSize="11.5">
                                                <Run Text="{Binding SpentCount, Mode=OneWay}" />
                                                <Run Text="/" />
                                                <Run Text="{Binding Count, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource PanelHeading}" />
                                        </DockPanel>

                                        <ItemsControl ItemsSource="{Binding Zones}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Number}"
                                                            Style="{StaticResource BoardMarker}"
                                                            Command="{Binding DataContext.ClickZoneCommand,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            MouseRightButtonUp="OnZoneRightClicked">
                                                        <Button.ToolTip>
                                                            <ToolTip>
                                                                <StackPanel MaxWidth="260">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Tooltip}"
                                                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                                                </StackPanel>
                                                            </ToolTip>
                                                        </Button.ToolTip>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- PANEL LATERAL -->
        <Border Grid.Column="1" Style="{StaticResource Inset}" Padding="14,12" Margin="10,0,0,0">
            <DockPanel>

                <!-- Las cuatro islas -->
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Islands}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource IslandTab}"
                                    Command="{Binding DataContext.SelectIslandCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- LEYENDA. El mapa es lo unico que hay que mirar, asi que el panel solo explica
                     que significa cada color y no pide nada. -->
                <StackPanel>
                    <!-- El rotulo dice de QUE isla son las cifras. Antes ponia solo LEYENDA y los
                         cuatro numeros eran del total de Alola, asi que se leian como si fueran de
                         la isla que tenias delante. El total tiene ya su sitio propio, que es la
                         barra de debajo de la cabecera. -->
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Faint}"
                                   VerticalAlignment="Center"
                                   Text="{Binding SelectedIsland.Name}" />
                        <TextBlock Text="EN ESTA ISLA" Style="{StaticResource StatLabel}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Pincha una zona para marcar lo que pasó. Cada clic pasa al siguiente, y el cuarto la deja sin marcar." />

                    <ItemsControl>
                        <ItemsControl.Resources>
                            <Style x:Key="LegendDot" TargetType="Border">
                                <Setter Property="Width" Value="22" />
                                <Setter Property="Height" Value="22" />
                                <Setter Property="CornerRadius" Value="11" />
                                <Setter Property="BorderThickness" Value="2" />
                                <Setter Property="BorderBrush" Value="{StaticResource ZoneRingBrush}" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                            <!-- Las filas responden al raton: iluminan sus zonas en el mapa. Es lo
                                 unico de la pantalla que ademas contesta algo -donde he perdido
                                 gente- que con sesenta y un marcadores no se ve de otra forma. -->
                            <Style x:Key="LegendRow" TargetType="DockPanel">
                                <Setter Property="Margin" Value="0,0,0,10" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Cursor" Value="Hand" />
                            </Style>
                            <Style x:Key="LegendText" TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="10,0,0,0" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                            <!-- La cifra a la derecha, en la fuente que se alinea en columna: son
                                 cuatro numeros que se leen juntos, no cuatro frases. -->
                            <Style x:Key="LegendCount" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="8,0,0,0" />
                                <Setter Property="MinWidth" Value="22" />
                                <Setter Property="TextAlignment" Value="Right" />
                            </Style>
                        </ItemsControl.Resources>

                        <DockPanel Style="{StaticResource LegendRow}" Tag="Free"
                                   MouseEnter="OnLegendEnter" MouseLeave="OnLegendLeave">
                            <Border DockPanel.Dock="Left" Style="{StaticResource LegendDot}"
                                    Background="{StaticResource ZoneFreeBrush}" />
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource LegendCount}"
                                       svc:Rolling.To="{Binding SelectedIsland.FreeCount}" />
                            <TextBlock Style="{StaticResource LegendText}" Text="Sin marcar" />
                        </DockPanel>

                        <DockPanel Style="{StaticResource LegendRow}" Tag="Caught"
                                   MouseEnter="OnLegendEnter" MouseLeave="OnLegendLeave">
                            <Border DockPanel.Dock="Left" Style="{StaticResource LegendDot}"
                                    Background="{StaticResource ZoneCaughtBrush}" />
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource LegendCount}"
                                       svc:Rolling.To="{Binding SelectedIsland.CaughtCount}" />
                            <TextBlock Style="{StaticResource LegendText}" Text="Atrapado en esta zona" />
                        </DockPanel>

                        <DockPanel Style="{StaticResource LegendRow}" Tag="Died"
                                   MouseEnter="OnLegendEnter" MouseLeave="OnLegendLeave">
                            <Border DockPanel.Dock="Left" Style="{StaticResource LegendDot}"
                                    Background="{StaticResource ZoneDiedBrush}" />
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource LegendCount}"
                                       svc:Rolling.To="{Binding SelectedIsland.DiedCount}" />
                            <TextBlock Style="{StaticResource LegendText}" Text="Primer pokémon matado" />
                        </DockPanel>

                        <DockPanel Style="{StaticResource LegendRow}" Tag="Fled"
                                   MouseEnter="OnLegendEnter" MouseLeave="OnLegendLeave">
                            <Border DockPanel.Dock="Left" Style="{StaticResource LegendDot}"
                                    Background="{StaticResource ZoneFledBrush}" />
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource LegendCount}"
                                       svc:Rolling.To="{Binding SelectedIsland.FledCount}" />
                            <TextBlock Style="{StaticResource LegendText}" Text="Primer encuentro: huida" />
                        </DockPanel>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="Pasa el ratón por un marcador para ver de qué zona es." />
                    <!-- Dicho aqui porque un gesto que no se anuncia no existe: el clic derecho
                         estaba y nadie lo iba a encontrar. -->
                    <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Clic izquierdo para pasar al siguiente estado, clic derecho para dejarlo sin marcar." />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
