<UserControl x:Class="PermaLocke.App.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:PermaLocke.App.Services"
             xmlns:views="clr-namespace:PermaLocke.App.Views"
             xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel">

    <!-- EL MAPA EN PÍXELES (§176). El dibujo de cada isla es el del propio cartucho y se queda como está; lo que cambia
         es lo de encima y alrededor: chinchetas de celdas con su icono, la cabecera, las pestañas de isla, la leyenda y
         la carta al pasar el ratón. Se quitan el halo difuminado y el brillo en degradado que cruzaban el mapa, que
         eran justo lo que este estilo no hace. Solo se mira: desde el §118 el mapa lo marca PermaLocke. -->
    <UserControl.Resources>

        <!-- Una chincheta de zona. Los estados los decide el ViewModel en State. SOLO SE MIRA: sigue siendo un Button
             por la plantilla y la carta del ratón, pero sin comando, sin foco y sin cursor de mano. -->
        <Style x:Key="ZoneMarker" TargetType="Button">
            <Setter Property="Width" Value="27" />
            <Setter Property="Height" Value="27" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5" Background="Transparent">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <!-- Contra-escala: el Viewbox encoge el mapa entero y con él las chinchetas. -->
                                    <ScaleTransform
                                        ScaleX="{Binding DataContext.MarkerScale, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ScaleY="{Binding DataContext.MarkerScale, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    <ScaleTransform x:Name="Hover" ScaleX="1" ScaleY="1" />
                                </TransformGroup>
                            </Grid.RenderTransform>

                            <!-- El latido de una zona donde murió alguien: una placa roja que crece y se apaga. -->
                            <views:PixelPanel x:Name="Toll" Fill="{StaticResource ZoneDiedColor}" HasShadow="False"
                                              Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <views:PixelPanel.RenderTransform>
                                    <ScaleTransform x:Name="TollScale" ScaleX="1" ScaleY="1" />
                                </views:PixelPanel.RenderTransform>
                            </views:PixelPanel>

                            <views:PixelPanel x:Name="Pin" Fill="#B0201C2C" HasShadow="False" />

                            <!-- La cifra solo en el tablero de respaldo, donde es lo único que distingue una casilla. -->
                            <pixel:PixelText x:Name="Number" Visibility="Collapsed" Scale="2" Tight="True"
                                             Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Colour="{DynamicResource PxText}" />

                            <pixel:PixelIcon x:Name="Tick" Icon="IconTick" Scale="1" Visibility="Collapsed"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0" />
                            <pixel:PixelIcon x:Name="Cross" Icon="IconCross" Scale="1" Visibility="Collapsed"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0" />
                            <pixel:PixelIcon x:Name="Away" Icon="IconAway" Scale="1" Visibility="Collapsed"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="ScaleX"
                                                             To="1.2" Duration="0:0:0.1" />
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="ScaleY"
                                                             To="1.2" Duration="0:0:0.1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="Tag" Value="numerada">
                                <Setter TargetName="Number" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Pin" Property="Fill" Value="{DynamicResource PxWell}" />
                            </Trigger>

                            <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>

                            <!-- Atenuada porque la leyenda está señalando otro estado. -->
                            <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                                <Setter Property="Opacity" Value="0.18" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding State}" Value="Caught">
                                <Setter TargetName="Pin" Property="Fill" Value="{StaticResource ZoneCaughtColor}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </DataTrigger>

                            <!-- La muerte pesa: un latido lento mientras la zona esté así. -->
                            <DataTrigger Binding="{Binding State}" Value="Died">
                                <Setter TargetName="Pin" Property="Fill" Value="{StaticResource ZoneDiedColor}" />
                                <Setter TargetName="Cross" Property="Visibility" Value="Visible" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="Knell">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="TollScale" Storyboard.TargetProperty="ScaleX"
                                                             From="1" To="2" Duration="0:0:2.2" />
                                            <DoubleAnimation Storyboard.TargetName="TollScale" Storyboard.TargetProperty="ScaleY"
                                                             From="1" To="2" Duration="0:0:2.2" />
                                            <DoubleAnimation Storyboard.TargetName="Toll" Storyboard.TargetProperty="Opacity"
                                                             From="0.45" To="0" Duration="0:0:2.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="Knell" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding State}" Value="Fled">
                                <Setter TargetName="Pin" Property="Fill" Value="{DynamicResource PxInk}" />
                                <Setter TargetName="Away" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Una celda por zona para la barra de la run entera, en píxeles. -->
        <Style x:Key="RunCell" TargetType="views:PixelPanel">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="HasShadow" Value="False" />
            <Setter Property="IsSunken" Value="True" />
            <Setter Property="Fill" Value="{DynamicResource PxWell}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Caught">
                    <Setter Property="Fill" Value="{StaticResource ZoneCaughtColor}" />
                    <Setter Property="IsSunken" Value="False" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Died">
                    <Setter Property="Fill" Value="{StaticResource ZoneDiedColor}" />
                    <Setter Property="IsSunken" Value="False" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Fled">
                    <Setter Property="Fill" Value="#FF3A3350" />
                    <Setter Property="IsSunken" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- El mismo marcador para el tablero de respaldo, sin mapa debajo y con su cifra. -->
        <Style x:Key="BoardMarker" TargetType="Button" BasedOn="{StaticResource ZoneMarker}">
            <Setter Property="Tag" Value="numerada" />
            <Setter Property="Margin" Value="0,0,5,5" />
            <Setter Property="Width" Value="33" />
            <Setter Property="Height" Value="33" />
        </Style>

        <!-- La pestaña de una isla: cuál es, cuánto llevas en una barra, y en verde si está terminada. -->
        <Style x:Key="IslandTab" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <views:PixelPanel x:Name="Plate" Fill="{DynamicResource PxFaceHigh}" HasShadow="False" />
                            <pixel:PixelText x:Name="Arrow" Text="▶" Scale="2" Tight="True" Visibility="Hidden"
                                             Colour="{DynamicResource PxGold}" VerticalAlignment="Center" Margin="-4,0,0,0" />
                            <StackPanel Margin="14,8,12,10">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <pixel:PixelText Scale="2" Tight="True" Colour="{DynamicResource PxText}" Text="{Binding SpentCount}" />
                                        <pixel:PixelText Scale="2" Tight="True" Colour="{DynamicResource PxTextDim}" Text="/" Margin="3,0" />
                                        <pixel:PixelText Scale="2" Tight="True" Colour="{DynamicResource PxTextDim}" Text="{Binding Count}" />
                                    </StackPanel>
                                    <pixel:PixelText x:Name="IslandName" Text="{Binding Name}" Scale="2" Tight="True"
                                                     Colour="{DynamicResource PxText}" Shadow="{DynamicResource PxShadow}" />
                                </DockPanel>
                                <views:PixelBar Height="12" Margin="0,7,0,0" Value="{Binding Progress, Mode=OneWay}"
                                                Fill="{StaticResource ZoneCaughtColor}" Track="{DynamicResource PxInk}" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Fill" Value="{DynamicResource PxFaceLift}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                <Setter TargetName="Plate" Property="Fill" Value="{DynamicResource PxGoodDeep}" />
                                <Setter TargetName="IslandName" Property="Colour" Value="{DynamicResource PxGood}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Plate" Property="Fill" Value="{DynamicResource PxAccentDeep}" />
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- La carta al pasar el ratón por una chincheta: foto del sitio, nombre y qué pasó. -->
        <DataTemplate x:Key="ZoneCard">
            <Grid Width="290">
                <views:PixelPanel Fill="{DynamicResource PxFace}" />
                <StackPanel Margin="6,6,12,14">
                    <Grid MaxHeight="180" ClipToBounds="True"
                          Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVisibility}}">
                        <Image Source="{Binding Photo}" Stretch="UniformToFill" />
                    </Grid>
                    <StackPanel Margin="8,10,6,0">
                        <pixel:PixelText Text="{Binding Name}" Scale="2" Wrap="True" Colour="{DynamicResource PxText}"
                                         Shadow="{DynamicResource PxShadow}" />
                        <pixel:PixelText Text="{Binding Tooltip}" Scale="2" Wrap="True" Margin="0,5,0,0"
                                         Colour="{DynamicResource PxTextDim}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <Style x:Key="LegendRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="LegendDot" TargetType="Grid">
            <Setter Property="Width" Value="27" />
            <Setter Property="Height" Value="27" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LegendText" TargetType="pixel:PixelText">
            <Setter Property="Scale" Value="2" />
            <Setter Property="Wrap" Value="True" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="Colour" Value="{DynamicResource PxText}" />
        </Style>
        <Style x:Key="LegendCount" TargetType="pixel:PixelText">
            <Setter Property="Scale" Value="2" />
            <Setter Property="Tight" Value="True" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Colour" Value="{DynamicResource PxText}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <pixel:PixelWindow Title="ALOLA" Icon="IconGrid" Padding="16,12,22,20">
            <pixel:PixelWindow.HeaderContent>
                <StackPanel Orientation="Horizontal">
                    <pixel:PixelText Scale="2" Tight="True" Colour="{DynamicResource PxGold}" Shadow="{DynamicResource PxShadow}"
                                     svc:Rolling.To="{Binding SpentCount}" />
                    <pixel:PixelText Scale="2" Tight="True" Colour="{DynamicResource PxTextDim}" Text="de" Margin="6,0" />
                    <pixel:PixelText Scale="2" Tight="True" Colour="{DynamicResource PxText}" Text="{Binding ZoneCount}" />
                    <pixel:PixelText Scale="2" Tight="True" Colour="{DynamicResource PxTextDim}" Text="zonas marcadas" Margin="6,0,0,0" />
                </StackPanel>
            </pixel:PixelWindow.HeaderContent>

            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="RELEER" Style="{StaticResource PxSubtleButton}"
                            Command="{Binding RefreshCommand}" VerticalAlignment="Top" Padding="12,6,18,11" />

                    <!-- LA RUN ENTERA, una celda por zona y un grupo por isla, con el de la isla a la vista subrayado.
                         En un Viewbox que solo encoge. -->
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding Islands}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,14,0">
                                        <ItemsControl ItemsSource="{Binding Zones}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <views:PixelPanel Style="{StaticResource RunCell}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <views:PixelPanel Height="9" Margin="0,4,3,0" HasShadow="False" Fill="{DynamicResource PxAccent}"
                                                          Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Viewbox>
                </DockPanel>

                <pixel:PixelText DockPanel.Dock="Top" Text="No se ha podido cargar el mapa." Scale="2" Tight="True"
                                 Colour="{DynamicResource PxTextFaint}"
                                 Visibility="{Binding HasMap, Converter={StaticResource InverseBoolToVisibility}}" />

                <!-- EL MAPA, con el arte del cartucho, en su marco de tinta. -->
                <Grid Visibility="{Binding HasArt, Converter={StaticResource BoolToVisibility}}">
                    <views:PixelPanel Fill="{DynamicResource PxWell}" IsSunken="True" HasShadow="False" />
                    <Viewbox x:Name="MapFrame" Stretch="Uniform" StretchDirection="Both" Margin="10"
                             SizeChanged="OnMapSized">
                        <Grid x:Name="MapSurface" HorizontalAlignment="Left" VerticalAlignment="Top"
                              SizeChanged="OnMapSized">
                            <Image Source="{Binding IslandImage}" Stretch="None" />

                            <!-- La capa de chinchetas. -->
                            <Canvas x:Name="MarkerLayer" Background="Transparent">
                                <!-- La carta tarda un momento en salir a propósito: al instante, cruzar el mapa dispara veinte. -->
                                <Canvas.Resources>
                                    <Style TargetType="ToolTip">
                                        <Setter Property="Placement" Value="Right" />
                                        <Setter Property="HorizontalOffset" Value="8" />
                                    </Style>
                                </Canvas.Resources>
                                <ItemsControl x:Name="Markers" ItemsSource="{Binding SelectedIsland.Zones}"
                                              Loaded="OnMarkersLoaded">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                            <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- El margen negativo centra la chincheta en su punto. -->
                                            <Button Content="{Binding Number}" Margin="-13,-13,0,0"
                                                    Style="{StaticResource ZoneMarker}"
                                                    ToolTipService.InitialShowDelay="350"
                                                    ToolTipService.ShowDuration="30000">
                                                <Button.ToolTip>
                                                    <ToolTip Padding="0" Background="Transparent" BorderThickness="0"
                                                             HasDropShadow="False">
                                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ZoneCard}" />
                                                    </ToolTip>
                                                </Button.ToolTip>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>
                        </Grid>
                    </Viewbox>
                </Grid>

                <!-- RESPALDO: sin las imágenes del cartucho, el tablero numerado de siempre. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasArt, Converter={StaticResource InverseBoolToVisibility}}">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource PxScrollBar}" />
                    </ScrollViewer.Resources>
                    <ItemsControl ItemsSource="{Binding Islands}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <views:PixelPanel Fill="{DynamicResource PxFaceHigh}" HasShadow="False" />
                                    <StackPanel Margin="14,10,14,12">
                                        <DockPanel Margin="0,0,0,10">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <pixel:PixelText Scale="2" Tight="True" Colour="{DynamicResource PxText}" Text="{Binding SpentCount}" />
                                                <pixel:PixelText Scale="2" Tight="True" Colour="{DynamicResource PxTextDim}" Text="/" Margin="3,0" />
                                                <pixel:PixelText Scale="2" Tight="True" Colour="{DynamicResource PxTextDim}" Text="{Binding Count}" />
                                            </StackPanel>
                                            <pixel:PixelText Text="{Binding Name}" Scale="2" Tight="True" Colour="{DynamicResource PxText}" />
                                        </DockPanel>

                                        <ItemsControl ItemsSource="{Binding Zones}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Number}" Style="{StaticResource BoardMarker}">
                                                        <Button.ToolTip>
                                                            <ToolTip Padding="0" Background="Transparent" BorderThickness="0"
                                                                     HasDropShadow="False">
                                                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ZoneCard}" />
                                                            </ToolTip>
                                                        </Button.ToolTip>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </pixel:PixelWindow>

        <!-- PANEL LATERAL -->
        <pixel:PixelWindow Grid.Column="1" Title="ISLAS" Icon="IconGrid" Margin="12,0,0,0">
            <DockPanel>
                <!-- Las cuatro islas -->
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Islands}" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource IslandTab}"
                                    Command="{Binding DataContext.SelectIslandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- LEYENDA. Las filas responden al ratón: iluminan sus zonas en el mapa. -->
                <StackPanel>
                    <pixel:PixelRule Margin="0,4,0,12" />
                    <DockPanel Margin="0,0,0,6">
                        <pixel:PixelText DockPanel.Dock="Right" Text="{Binding SelectedIsland.Name}" Scale="2" Tight="True"
                                         Colour="{DynamicResource PxTextDim}" VerticalAlignment="Center" />
                        <pixel:PixelText Text="EN ESTA ISLA" Scale="2" Tight="True" Colour="{DynamicResource PxTextFaint}" />
                    </DockPanel>
                    <pixel:PixelText Text="Se marcan con tu primer combate salvaje." Scale="2" Wrap="True"
                                     Margin="0,0,0,14" Colour="{DynamicResource PxTextDim}" />

                    <DockPanel Style="{StaticResource LegendRow}" Tag="Free" MouseEnter="OnLegendEnter" MouseLeave="OnLegendLeave">
                        <Grid DockPanel.Dock="Left" Style="{StaticResource LegendDot}">
                            <views:PixelPanel Fill="#B0201C2C" HasShadow="False" />
                        </Grid>
                        <pixel:PixelText DockPanel.Dock="Right" Style="{StaticResource LegendCount}"
                                         svc:Rolling.To="{Binding SelectedIsland.FreeCount}" />
                        <pixel:PixelText Style="{StaticResource LegendText}" Text="Sin marcar" />
                    </DockPanel>

                    <DockPanel Style="{StaticResource LegendRow}" Tag="Caught" MouseEnter="OnLegendEnter" MouseLeave="OnLegendLeave">
                        <Grid DockPanel.Dock="Left" Style="{StaticResource LegendDot}">
                            <views:PixelPanel Fill="{StaticResource ZoneCaughtColor}" HasShadow="False" />
                            <pixel:PixelIcon Icon="IconTick" Scale="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <pixel:PixelText DockPanel.Dock="Right" Style="{StaticResource LegendCount}"
                                         svc:Rolling.To="{Binding SelectedIsland.CaughtCount}" />
                        <pixel:PixelText Style="{StaticResource LegendText}" Text="Atrapado en esta zona" />
                    </DockPanel>

                    <DockPanel Style="{StaticResource LegendRow}" Tag="Died" MouseEnter="OnLegendEnter" MouseLeave="OnLegendLeave">
                        <Grid DockPanel.Dock="Left" Style="{StaticResource LegendDot}">
                            <views:PixelPanel Fill="{StaticResource ZoneDiedColor}" HasShadow="False" />
                            <pixel:PixelIcon Icon="IconCross" Scale="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <pixel:PixelText DockPanel.Dock="Right" Style="{StaticResource LegendCount}"
                                         svc:Rolling.To="{Binding SelectedIsland.DiedCount}" />
                        <pixel:PixelText Style="{StaticResource LegendText}" Text="Primer encuentro: debilitado" />
                    </DockPanel>

                    <DockPanel Style="{StaticResource LegendRow}" Tag="Fled" MouseEnter="OnLegendEnter" MouseLeave="OnLegendLeave">
                        <Grid DockPanel.Dock="Left" Style="{StaticResource LegendDot}">
                            <views:PixelPanel Fill="{DynamicResource PxInk}" HasShadow="False" />
                            <pixel:PixelIcon Icon="IconAway" Scale="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <pixel:PixelText DockPanel.Dock="Right" Style="{StaticResource LegendCount}"
                                         svc:Rolling.To="{Binding SelectedIsland.FledCount}" />
                        <pixel:PixelText Style="{StaticResource LegendText}" Text="Primer encuentro: huida" />
                    </DockPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <pixel:PixelText Text="▶" Scale="2" Tight="True" Colour="{DynamicResource PxGold}" />
                        <pixel:PixelText Text="Pasa el ratón por una chincheta." Scale="2" Wrap="True"
                                         Margin="8,0,0,0" Colour="{DynamicResource PxTextDim}" MaxWidth="230" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </pixel:PixelWindow>
    </Grid>
</UserControl>
