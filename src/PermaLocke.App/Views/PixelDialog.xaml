<Window x:Class="PermaLocke.App.Views.PixelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel"
        Width="560" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource PxBaseBrush}">

    <!-- El aviso de PermaLocke (2026-10-30): el cuadro de Windows, en píxeles como el resto de la aplicación. -->
    <Grid>
        <pixel:PixelBackdrop Base="{DynamicResource PxBase}" />

        <StackPanel Margin="18,16,18,18">
            <pixel:PixelWindow x:Name="Frame" Icon="IconDocument">
                <pixel:PixelText x:Name="Body" Scale="2" Wrap="True" Colour="{DynamicResource PxText}" Margin="2,4,2,6" />
            </pixel:PixelWindow>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="No" Content="NO" Style="{StaticResource PxSubtleButton}" IsCancel="True" Click="OnNo" Visibility="Collapsed" />
                <Button x:Name="Yes" Content="ACEPTAR" Style="{StaticResource PxButton}" IsDefault="True" Click="OnYes" Margin="10,0,0,0" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
