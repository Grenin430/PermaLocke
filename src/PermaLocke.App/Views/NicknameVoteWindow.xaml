<Window x:Class="PermaLocke.App.Views.NicknameVoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PermaLocke.App.Views"
        xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel"
        Title="PermaLocke — Mote"
        Width="330" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        AllowsTransparency="True" Background="Transparent"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- Los motes votados (2026-09-28): pequeña, a la izquierda del emulador a media altura, con su barra. Entra
         deslizándose desde la izquierda; el Pokémon da saltitos. En la votación, los votos de cada mote en directo. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Show" />
        <Style x:Key="Bar" TargetType="views:PixelBar">
            <Setter Property="Fill" Value="{DynamicResource PxGold}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Hurry}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource PxBad}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Cada mote: su nombre y sus votos en directo; el tuyo, en morado. -->
        <Style x:Key="Option" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <views:PixelPanel x:Name="Plate" Fill="{DynamicResource PxFaceLift}" />
                            <ContentPresenter Margin="12,6,17,11" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Fill" Value="{DynamicResource PxAccentDeep}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding DataContext.HasVoted, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                <Setter Property="Opacity" Value="0.5" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsChosen}" Value="True">
                                <Setter TargetName="Plate" Property="Fill" Value="{DynamicResource PxAccent}" />
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
                    <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" From="-60" To="0" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="Hop" Storyboard.TargetProperty="Y" From="0" To="-4" Duration="0:0:0.35"
                                     AutoReverse="True" RepeatBehavior="Forever" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid x:Name="Card" Margin="4">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" />
        </Grid.RenderTransform>
        <views:PixelPanel Fill="{DynamicResource PxFace}" />

        <StackPanel Margin="14,12,18,16">
            <!-- La cabecera: una etiqueta dorada y los segundos -->
            <DockPanel>
                <pixel:PixelText DockPanel.Dock="Right" Text="{Binding Seconds}" Scale="2" Tight="True" Colour="{DynamicResource PxTextFaint}"
                                 VerticalAlignment="Center" />
                <pixel:PixelText Text="{Binding Caption}" Scale="2" Tight="True" Colour="{DynamicResource PxGold}"
                                 Shadow="{DynamicResource PxShadow}" VerticalAlignment="Center" />
            </DockPanel>

            <!-- El Pokémon y la pregunta -->
            <DockPanel Margin="0,10,0,0">
                <Grid DockPanel.Dock="Left" Width="64" Height="54" Margin="0,0,10,0">
                    <views:PixelPanel Fill="{DynamicResource PxWell}" IsSunken="True" HasShadow="False" />
                    <Image Source="{Binding Sprite}" Width="56" Height="42" RenderOptions.BitmapScalingMode="NearestNeighbor">
                        <Image.RenderTransform>
                            <TranslateTransform x:Name="Hop" />
                        </Image.RenderTransform>
                    </Image>
                </Grid>
                <StackPanel VerticalAlignment="Center">
                    <pixel:PixelText Text="{Binding Heading}" Scale="2" Wrap="True" Colour="{DynamicResource PxTextDim}" />
                    <pixel:PixelText Text="{Binding Pokemon}" Scale="3" Tight="True" Margin="0,6,0,0" Colour="{DynamicResource PxText}"
                                     Shadow="{DynamicResource PxShadow}" />
                </StackPanel>
            </DockPanel>

            <!-- 1. PREGUNTAR (a quien captura) -->
            <UniformGrid Columns="2" Margin="0,12,0,0" Visibility="{Binding IsAsk, Converter={StaticResource Show}}">
                <Button Content="NO" Style="{StaticResource PxSubtleButton}" Command="{Binding NoCommand}" Margin="0,0,4,0" />
                <Button Content="SÍ" Style="{StaticResource PxButton}" Command="{Binding YesCommand}" Margin="4,0,0,0" />
            </UniformGrid>

            <!-- 2. PROPONER (a los demás) -->
            <StackPanel Margin="0,12,0,0" Visibility="{Binding IsPropose, Converter={StaticResource Show}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="ENVIAR" Style="{StaticResource PxButton}" Command="{Binding SendCommand}"
                            IsDefault="True" Margin="6,0,0,0" />
                    <TextBox x:Name="Entry" Text="{Binding Proposal, UpdateSourceTrigger=PropertyChanged}" MaxLength="{Binding MaxLength}"
                             Style="{StaticResource PxTextBox}" />
                </DockPanel>
                <pixel:PixelText Text="{Binding Counter}" Scale="2" Tight="True" HorizontalAlignment="Right" Margin="0,6,0,0"
                                 Colour="{DynamicResource PxTextFaint}" />
                <pixel:PixelText Text="{Binding Problem}" Scale="2" Wrap="True" Colour="{DynamicResource PxBad}" Margin="2,6,0,0" />
            </StackPanel>

            <!-- 3. VOTAR -->
            <ItemsControl ItemsSource="{Binding Options}" Margin="0,12,0,0" Visibility="{Binding IsVote, Converter={StaticResource Show}}">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasVoted}" Value="True">
                                <Setter Property="IsHitTestVisible" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding Pick}" Style="{StaticResource Option}">
                            <DockPanel Margin="4,0">
                                <pixel:PixelText DockPanel.Dock="Right" Text="{Binding Count}" Scale="2" Tight="True"
                                                 Colour="{DynamicResource PxGold}" VerticalAlignment="Center" />
                                <pixel:PixelText Text="{Binding Name}" Scale="2" Tight="True" Colour="{DynamicResource PxText}"
                                                 VerticalAlignment="Center" />
                            </DockPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 4. EL GANADOR -->
            <Grid Margin="0,12,0,0" Visibility="{Binding IsResult, Converter={StaticResource Show}}">
                <views:PixelPanel Fill="{DynamicResource PxWell}" IsSunken="True" HasShadow="False" />
                <pixel:PixelText Text="{Binding Result}" Scale="4" Tight="True" HorizontalAlignment="Center" Margin="10,12,10,14"
                                 Colour="{DynamicResource PxGood}" Shadow="{DynamicResource PxShadow}" />
            </Grid>

            <pixel:PixelText Text="{Binding Done}" Scale="2" Wrap="True" Colour="{DynamicResource PxGood}" Margin="2,8,0,0" />

            <!-- La barra de tiempo: dorada, roja los últimos cinco segundos -->
            <views:PixelBar Height="10" Margin="0,12,0,0" Value="{Binding Left}" Track="{DynamicResource PxWell}" Style="{StaticResource Bar}" />
        </StackPanel>
    </Grid>
</Window>
