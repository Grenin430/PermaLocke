<Window x:Class="PermaLocke.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PermaLocke.App.ViewModels"
        xmlns:views="clr-namespace:PermaLocke.App.Views"
        Title="PermaLocke"
        Height="760" Width="1180"
        MinHeight="600" MinWidth="960"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RandomizerViewModel}">
            <views:RandomizerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GachaViewModel}">
            <views:GachaView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShopViewModel}">
            <views:ShopView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AchievementsViewModel}">
            <views:AchievementsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PokemonViewerViewModel}">
            <views:PokemonViewerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PokePasteViewModel}">
            <views:PokePasteView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RouletteViewModel}">
            <views:RouletteView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MiscellaneousViewModel}">
            <views:MiscellaneousView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PendingSectionViewModel}">
            <views:PendingView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- =============================================== SIDEBAR
             Darker than the content and separated by a hairline rather than a gap: it should
             read as the frame of the window, not as another panel floating next to the others. -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Wordmark -->
                <StackPanel Grid.Row="0" Margin="20,24,20,20">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="4" Height="22" RadiusX="2" RadiusY="2"
                                   Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Margin="9,0,0,0" VerticalAlignment="Center"
                                   FontSize="19" FontWeight="Bold" FontStyle="Italic">
                            <Run Text="PERMA" Foreground="{StaticResource TextBrush}" />
                            <Run Text="LOCKE" Foreground="{StaticResource AccentBrush}" />
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="Nuzlocke · Ultra Luna" Style="{StaticResource Faint}"
                               Margin="13,3,0,0" />
                </StackPanel>

                <!-- Sections -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NavItem}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="0,0,10,0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Run summary. The two numbers that matter, always on screen. -->
                <Border Grid.Row="2" Style="{StaticResource Inset}" Margin="16,16,16,18" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="ROL" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="{Binding RoleText}"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />

                        <Border Style="{StaticResource Divider}" Margin="0,11" />

                        <TextBlock Text="PUNTOS" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="{Binding PointsText}"
                                   FontSize="30" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="0,-2,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- =============================================== CONTENT -->
        <Grid Grid.Column="1" Margin="22,20,22,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Heading. The accent bleeds in from the left edge of the strip, which ties the
                 header back to the selected entry in the sidebar right beside it. -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLarge}"
                    Padding="24,18">
                <!-- Solo el título. La línea de descripción se quitó a petición del jugador: en una
                     aplicación que se usa a diario explica lo que ya se sabe y ocupa sitio.
                     A la derecha sí va una cosa, porque no se sabe: si esta pantalla necesita el
                     juego abierto, cerrado o le da igual. Es lo único que decide si pulsar algo
                     aquí va a funcionar, y cambia de sección en sección. -->
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" MaxWidth="290" Margin="20,0,0,0"
                                VerticalAlignment="Center" HorizontalAlignment="Right"
                                Visibility="{Binding ShowsNeed,
                                             Converter={StaticResource BoolToVisibility}}">
                        <Border HorizontalAlignment="Right" CornerRadius="9" Padding="10,4"
                                BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <!-- Apagado por defecto: es la respuesta "no te preocupes", y
                                         gritarla le quitaría fuerza a las que sí ahorran un fallo.
                                         Verde y rojo solo para lo COMPROBADO: que el emulador
                                         conteste, o que no conteste. -->
                                    <Setter Property="Background" Value="{StaticResource SurfaceHighBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NeedState}" Value="ok">
                                            <Setter Property="Background" Value="{StaticResource SuccessDeepBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NeedState}" Value="problem">
                                            <Setter Property="Background" Value="{StaticResource DangerDeepBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NeedState}" Value="closed">
                                            <Setter Property="Background" Value="{StaticResource WarningDeepBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <TextBlock Text="{Binding NeedLabel}"
                                       FontFamily="{StaticResource UiFont}" FontSize="10.5"
                                       FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NeedState}" Value="ok">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding NeedState}" Value="problem">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding NeedState}" Value="closed">
                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="{Binding SelectedSection.Title}" Style="{StaticResource SectionTitle}"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Panel}">
                <ContentControl Content="{Binding SelectedSection}" />
            </Border>
        </Grid>
    </Grid>
</Window>
