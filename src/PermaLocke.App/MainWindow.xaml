<Window x:Class="PermaLocke.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PermaLocke.App.ViewModels"
        xmlns:views="clr-namespace:PermaLocke.App.Views"
        xmlns:svc="clr-namespace:PermaLocke.App.Services"
        xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PermaLocke"
        Icon="Assets/PermaLocke.ico"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterScreen">

    <!-- BARRA DE TITULO PROPIA. Era lo ultimo de la pantalla sin tematizar: una costura gris de
         Windows encima de una aplicacion entera en violeta.

         WindowChrome y no una ventana sin marco a pelo: asi el arrastre, el ajuste a los bordes y
         el menu del sistema los sigue haciendo Windows -son suyos y funcionan mejor que cualquier
         imitacion-, y lo unico que ponemos nosotros es el dibujo. CaptionHeight es la franja que
         Windows trata como barra de titulo; los botones se sacan de ahi con IsHitTestVisibleInChrome
         o no se podrian pulsar. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" GlassFrameThickness="0" CornerRadius="0"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <DataTemplate DataType="{x:Type vm:LauncherViewModel}">
            <views:LauncherView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RandomizerViewModel}">
            <views:RandomizerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GachaViewModel}">
            <views:GachaView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShopViewModel}">
            <views:ShopView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AchievementsViewModel}">
            <views:AchievementsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PokemonViewerViewModel}">
            <views:PokemonViewerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EvTrainingViewModel}">
            <views:EvTrainingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MoveReminderViewModel}">
            <views:MoveReminderView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PokePasteViewModel}">
            <views:PokePasteView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MapViewModel}">
            <views:MapView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RouletteViewModel}">
            <views:RouletteView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BattleModeViewModel}">
            <views:BattleModeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SyncViewModel}">
            <views:SyncView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CemeteryViewModel}">
            <views:CemeteryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MiscellaneousViewModel}">
            <views:MiscellaneousView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PendingSectionViewModel}">
            <views:PendingView />
        </DataTemplate>
    </Window.Resources>

    <!-- El contenido entero, con su propia transformacion: es lo que se despliega al volver desde
         la pestaña. Se anima ESTO y no la ventana porque Window.Opacity solo funciona con
         AllowsTransparency, y esta ventana no la lleva ni le hace falta. -->
    <Grid x:Name="Shell" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="ShellScale" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- =============================================== EL MARCO (§176)
             La ventana entera es una placa de píxeles: contorno de tinta, bisel claro arriba y oscuro abajo, y las
             esquinas mordidas. Todo lo demás va dentro, a dos celdas del borde, para no tapar el bisel. -->
        <views:PixelPanel Grid.RowSpan="2" Fill="{StaticResource PxSidebar}" HasShadow="False" />

        <!-- =============================================== LA BARRA DE TITULO
             WindowChrome sigue haciendo el arrastre y el menú del sistema; lo único nuestro es el dibujo. -->
        <Grid Grid.Row="0" Margin="6,6,6,0">
            <DockPanel>
                <!-- Minimizar y cerrar. Fuera de la franja de arrastre a proposito: dentro,
                     Windows se queda el clic y el boton no llega a enterarse. -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource PxCaptionButton}" Content="-" Click="OnMinimise"
                            ToolTip="Minimizar" AutomationProperties.Name="Minimizar" />
                    <Button Style="{StaticResource PxCaptionClose}" Content="×" Click="OnClose"
                            ToolTip="Cerrar" AutomationProperties.Name="Cerrar" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <pixel:PixelIcon Icon="IconGacha" Scale="2" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <pixel:PixelText Text="PERMALOCKE" Scale="2" Tight="True" Colour="{StaticResource PxText}"
                                     Shadow="{StaticResource PxShadow}" VerticalAlignment="Center" />
                    <pixel:PixelText Text="· NUZLOCKE ULTRA LUNA" Scale="2" Tight="True" Margin="10,0,0,0"
                                     Colour="{StaticResource PxTextFaint}" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>

            <pixel:PixelRule VerticalAlignment="Bottom" />
        </Grid>

        <Grid Grid.Row="1" Margin="6,0,6,6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- =============================================== LA BARRA LATERAL
             El menú de pausa de un juego: cada sección con su icono en color, la de la pantalla con la flecha, la
             placa encendida y el icono saltando como los Pokémon del menú del equipo. -->
        <Grid Grid.Column="0">
            <pixel:PixelRule Orientation="Vertical" HorizontalAlignment="Right" />

            <Grid x:Name="Sidebar" Margin="0,0,6,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- La marca: la Poké Ball y el nombre en dos líneas y dos colores, con sombra dura. En una línea no
                     cabe a este tamaño en los 236 de la barra, y a un tamaño menor deja de ser una marca. -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="18,18,12,18">
                    <pixel:PixelIcon Icon="IconGacha" Scale="4" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <pixel:PixelText Text="PERMA" Scale="3" Tight="True" Colour="{StaticResource PxText}"
                                         Shadow="{StaticResource PxShadow}" />
                        <pixel:PixelText Text="LOCKE" Scale="3" Tight="True" Colour="{StaticResource PxAccent}"
                                         Shadow="{StaticResource PxShadow}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Sections -->
                <ListBox Grid.Row="1" x:Name="NavList"
                         ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource PxNavItem}"
                         Background="Transparent"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource PxScrollBar}" />
                    </ListBox.Resources>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <pixel:PixelIcon Icon="{Binding IconKey}" Scale="2" Margin="0,0,9,0"
                                                 VerticalAlignment="Center"
                                                 Bob="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                    <pixel:PixelIcon.Style>
                                        <Style TargetType="pixel:PixelIcon">
                                            <Setter Property="Dim" Value="True" />
                                            <Style.Triggers>
                                                <DataTrigger Value="True" Binding="{Binding IsSelected,
                                                    RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                                    <Setter Property="Dim" Value="False" />
                                                </DataTrigger>
                                                <DataTrigger Value="True" Binding="{Binding IsMouseOver,
                                                    RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                                    <Setter Property="Dim" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </pixel:PixelIcon.Style>
                                </pixel:PixelIcon>
                                <pixel:PixelText Text="{Binding Title}" Scale="2" VerticalAlignment="Center"
                                                 Margin="0,1,0,0">
                                    <pixel:PixelText.Style>
                                        <Style TargetType="pixel:PixelText">
                                            <Setter Property="Colour" Value="{StaticResource PxTextDim}" />
                                            <Setter Property="Shadow" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Value="True" Binding="{Binding IsMouseOver,
                                                    RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                                    <Setter Property="Colour" Value="{StaticResource PxText}" />
                                                </DataTrigger>
                                                <DataTrigger Value="True" Binding="{Binding IsSelected,
                                                    RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                                    <Setter Property="Colour" Value="{StaticResource PxText}" />
                                                    <Setter Property="Shadow" Value="{StaticResource PxShadow}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </pixel:PixelText.Style>
                                </pixel:PixelText>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- ALOLA, AHORA. Solo si cabe sin hacer que la lista de secciones necesite barra (lo decide
                     MainWindow.xaml.cs). La ventanita ya era pixel art; ahora lo es también lo que dice. -->
                <StackPanel Grid.Row="2" x:Name="AlolaCorner" Margin="16,0,16,16" DataContext="{Binding Sky}">
                    <views:AlolaWindow Hour="{Binding Hour}" HorizontalAlignment="Left"
                                       Visibility="{Binding IsKnown, Converter={StaticResource BoolToVisibility}}" />

                    <DockPanel Margin="1,8,1,0" Visibility="{Binding IsKnown, Converter={StaticResource BoolToVisibility}}">
                        <pixel:PixelText DockPanel.Dock="Right" Text="{Binding TimeText}" Scale="3" Tight="True"
                                         Colour="{StaticResource PxText}" Shadow="{StaticResource PxShadow}"
                                         VerticalAlignment="Bottom" />
                        <StackPanel>
                            <pixel:PixelText Text="ALOLA" Scale="2" Tight="True" Colour="{StaticResource PxTextFaint}" />
                            <pixel:PixelText Text="{Binding PeriodText}" Scale="2" Tight="True" Margin="0,2,0,0"
                                             Colour="{StaticResource PxTextDim}" />
                        </StackPanel>
                    </DockPanel>

                    <pixel:PixelText Text="Hora de Alola desconocida." Scale="2" Wrap="True"
                                     Colour="{StaticResource PxTextFaint}"
                                     Visibility="{Binding IsKnown, Converter={StaticResource InverseBoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- =============================================== EL SUELO
             Debajo de todas las pantallas: violeta con una celosía tenue de celdas, como los fondos de los menús de
             una portátil. Textura, no decoración. -->
        <pixel:PixelBackdrop Grid.Column="1" Base="{StaticResource PxBase}" />

        <!-- =============================================== EL CIELO DE ALOLA
             Una franja en píxeles detrás de la cabecera, hasta su raya: el mar y el cielo a la hora del
             juego. Su alto lo iguala MainWindow.xaml.cs al de la cabecera, que cambia con la letra. -->
        <views:AlolaBanner x:Name="AlolaStrip" Grid.Column="1" VerticalAlignment="Top" Height="72"
                           Hour="{Binding Sky.Hour}"
                           Visibility="{Binding Sky.IsKnown, Converter={StaticResource BoolToVisibility}}" />

        <!-- =============================================== CONTENT -->
        <Grid Grid.Column="1" Margin="22,20,22,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- La cabecera: el icono de la sección saltando, su nombre con sombra dura, y a la derecha lo que se ve
                 desde cualquier pantalla. -->
            <Border Grid.Row="0" x:Name="Header" Background="Transparent" Padding="4,0,4,14">
                <DockPanel>
                    <!-- Si esta pantalla necesita el juego abierto, cerrado o le da igual: lo único que decide si
                         pulsar algo aquí va a funcionar. Apagado por defecto; verde y rojo solo para lo comprobado. -->
                    <Grid DockPanel.Dock="Right" Margin="18,0,0,0" VerticalAlignment="Center"
                          Visibility="{Binding ShowsNeed, Converter={StaticResource BoolToVisibility}}">
                        <views:PixelPanel HasShadow="False">
                            <views:PixelPanel.Style>
                                <Style TargetType="views:PixelPanel">
                                    <Setter Property="Fill" Value="{StaticResource PxFaceLift}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NeedState}" Value="ok">
                                            <Setter Property="Fill" Value="{StaticResource PxGoodDeep}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NeedState}" Value="problem">
                                            <Setter Property="Fill" Value="{StaticResource PxBadDeep}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NeedState}" Value="closed">
                                            <Setter Property="Fill" Value="{StaticResource PxWarnDeep}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:PixelPanel.Style>
                        </views:PixelPanel>
                        <pixel:PixelText Text="{Binding NeedLabel}" Scale="2" Tight="True" Margin="11,8,11,8">
                            <pixel:PixelText.Style>
                                <Style TargetType="pixel:PixelText">
                                    <Setter Property="Colour" Value="{StaticResource PxTextDim}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NeedState}" Value="ok">
                                            <Setter Property="Colour" Value="{StaticResource PxGood}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NeedState}" Value="problem">
                                            <Setter Property="Colour" Value="{StaticResource PxBad}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NeedState}" Value="closed">
                                            <Setter Property="Colour" Value="{StaticResource PxWarn}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </pixel:PixelText.Style>
                        </pixel:PixelText>
                    </Grid>

                    <!-- ==================================== LOS PUNTOS
                         La moneda del sistema, como un contador de recurso en un juego: el rombo, la cifra que rueda
                         hasta su valor nuevo y da un destello verde o rojo, y el rótulo pequeño debajo. -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="18,0,0,0">
                        <Grid VerticalAlignment="Center" Margin="0,0,14,0">
                            <views:PixelPanel Fill="{StaticResource PxFaceLift}" HasShadow="False" />
                            <pixel:PixelText Text="{Binding RoleText}" Scale="2" Tight="True" Margin="11,8,11,8"
                                             Colour="{StaticResource PxText}" />
                        </Grid>

                        <!-- El marcador en su placa translúcida, como el título: de día el cielo es claro. -->
                        <Grid VerticalAlignment="Center">
                        <views:PixelPanel Fill="#C8120E20" HasShadow="False" />
                        <StackPanel Orientation="Horizontal" Margin="9,6,12,8">
                        <pixel:PixelIcon Icon="IconPoints" Scale="2" VerticalAlignment="Center" Margin="0,0,8,0" />

                        <StackPanel VerticalAlignment="Center">
                            <pixel:PixelText x:Name="PointsNumber" Scale="3" Tight="True"
                                             Colour="{StaticResource PxAccent}" Shadow="{StaticResource PxShadow}"
                                             svc:Rolling.To="{Binding PointsValue}"
                                             Visibility="{Binding HasPoints, Converter={StaticResource BoolToVisibility}}" />

                            <!-- Sin run, la raya. Un contador no puede contar hasta un guion. -->
                            <pixel:PixelText Text="{Binding PointsText}" Scale="3" Tight="True"
                                             Colour="{StaticResource PxAccent}" Shadow="{StaticResource PxShadow}"
                                             Visibility="{Binding HasPoints, Converter={StaticResource InverseBoolToVisibility}}" />
                            <pixel:PixelText Text="PUNTOS" Scale="2" Tight="True" Margin="0,3,0,0"
                                             Colour="{StaticResource PxTextDim}" Shadow="{StaticResource PxShadow}" />
                        </StackPanel>
                        </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- ==================================== LA BANDEJA DE REGALOS (§129) -->
                    <Grid DockPanel.Dock="Right" Margin="18,0,0,0" VerticalAlignment="Center"
                          Visibility="{Binding Gifts.HasGifts, Converter={StaticResource BoolToVisibility}}">
                        <Button x:Name="GiftButton" Cursor="Hand" Command="{Binding Gifts.ToggleCommand}"
                                AutomationProperties.Name="Regalos">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid x:Name="Body" Height="40" Width="46" Background="Transparent">
                                        <views:PixelPanel x:Name="Plate" Fill="{StaticResource PxFaceLift}" />
                                        <pixel:PixelIcon x:Name="Face" Icon="IconGift" Scale="2" HorizontalAlignment="Center"
                                                         VerticalAlignment="Center" Margin="0,0,6,6" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Plate" Property="Fill" Value="{StaticResource PxAccentDeep}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Plate" Property="HasShadow" Value="False" />
                                            <Setter TargetName="Plate" Property="Margin" Value="6,6,0,0" />
                                            <Setter TargetName="Face" Property="RenderTransform">
                                                <Setter.Value>
                                                    <TranslateTransform X="6" Y="6" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-8,0" IsHitTestVisible="False">
                            <views:PixelPanel Fill="#FFB8433A" HasShadow="False" />
                            <pixel:PixelText Text="{Binding Gifts.Count}" Scale="2" Tight="True" Margin="7,5,7,5"
                                             Colour="{StaticResource PxText}" />
                        </Grid>
                    </Grid>

                    <!-- JUGAR, EN PEQUEÑO (§125). En todas las pantallas menos en la del lanzador, que tiene el
                         grande: dice si el juego está abierto y cuánto lleva, y lleva a JUGAR. -->
                    <Button DockPanel.Dock="Right" Margin="18,0,0,0" VerticalAlignment="Center" Cursor="Hand"
                            Command="{Binding OpenLauncherCommand}"
                            Visibility="{Binding ShowsPlayButton, Converter={StaticResource BoolToVisibility}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid x:Name="Body" Background="Transparent">
                                    <views:PixelPanel x:Name="Plate" Fill="{StaticResource PxAccent}" />
                                    <StackPanel x:Name="Face" Orientation="Horizontal" Margin="15,9,21,14" VerticalAlignment="Center">
                                        <pixel:PixelText x:Name="Glyph" Text="▶" Scale="2" Tight="True"
                                                         Colour="{StaticResource PxInk}" VerticalAlignment="Center"
                                                         Margin="0,0,8,0" />
                                        <pixel:PixelText x:Name="Label" Text="{Binding Launcher.HeaderText}" Scale="2"
                                                         Tight="True" Colour="{StaticResource PxInk}"
                                                         VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Plate" Property="Fill" Value="{StaticResource PxAccentLight}" />
                                    </Trigger>
                                    <!-- En juego se vuelve verde oscuro con letra clara: no es una llamada a pulsar,
                                         es un aviso de que está abierto. -->
                                    <DataTrigger Binding="{Binding Launcher.IsRunning}" Value="True">
                                        <Setter TargetName="Plate" Property="Fill" Value="#FF2E6B45" />
                                        <Setter TargetName="Label" Property="Colour" Value="#FFE4FFEC" />
                                        <Setter TargetName="Glyph" Property="Colour" Value="#FF8EF0AE" />
                                    </DataTrigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Plate" Property="HasShadow" Value="False" />
                                        <Setter TargetName="Plate" Property="Margin" Value="6,6,0,0" />
                                        <Setter TargetName="Face" Property="RenderTransform">
                                            <Setter.Value>
                                                <TranslateTransform X="6" Y="6" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- El icono de la sección, saltando, y su nombre, en una placa translúcida: de día el cielo de
                         Alola es claro y el sol sale justo por detrás del título. -->
                    <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                        <views:PixelPanel Fill="#C8120E20" HasShadow="False" />
                        <StackPanel Orientation="Horizontal" Margin="10,7,16,9">
                            <pixel:PixelIcon Icon="{Binding SelectedSection.IconKey}" Scale="3" Bob="True"
                                             VerticalAlignment="Center" Margin="0,0,12,0" />

                            <StackPanel VerticalAlignment="Center">
                                <pixel:PixelText Text="{Binding SelectedSection.Title}" Scale="3" Tight="True" Trim="True"
                                                 Colour="{StaticResource PxText}" Shadow="{StaticResource PxShadow}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- La raya de debajo del título: un surco en celdas que arranca en violeta. -->
            <pixel:PixelRule Grid.Row="0" VerticalAlignment="Bottom" AccentCells="20" Margin="4,0,4,0" />

            <!-- El contenido se apoya en el suelo, sin marco propio. -->
            <Border Grid.Row="2" Background="Transparent" Padding="4,0">
                <ContentControl x:Name="SectionHost" Content="{Binding SelectedSection}">
                    <ContentControl.RenderTransform>
                        <TranslateTransform x:Name="SectionSlide" />
                    </ContentControl.RenderTransform>
                </ContentControl>
            </Border>
        </Grid>
        </Grid>

        <!-- LA BANDEJA ABIERTA, una capa de la ventana y no un menú del sistema: así se dibuja con el mismo
             pixel art que el resto y se queda pegada debajo del regalo. -->
        <Grid Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top" Width="400" Margin="0,58,26,0"
              Visibility="{Binding Gifts.IsOpen, Converter={StaticResource BoolToVisibility}}">
            <pixel:PixelWindow Title="REGALOS" Icon="IconGift">
                <pixel:PixelWindow.HeaderContent>
                    <Button Content="CERRAR" Style="{StaticResource PxSubtleButton}" Command="{Binding Gifts.CloseCommand}" />
                </pixel:PixelWindow.HeaderContent>

                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Gifts.Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <views:PixelPanel Fill="{StaticResource PxWell}" IsSunken="True" HasShadow="False" />
                                    <StackPanel Margin="14,10,16,14">
                                        <DockPanel>
                                            <pixel:PixelText DockPanel.Dock="Right" Text="{Binding When}" Scale="2" Tight="True"
                                                             Margin="10,0,0,0" Colour="{StaticResource PxTextFaint}" />
                                            <pixel:PixelText Text="{Binding From}" Scale="2" Tight="True" Trim="True"
                                                             Colour="{StaticResource PxText}" Shadow="{StaticResource PxShadow}" />
                                        </DockPanel>

                                        <pixel:PixelText Text="{Binding What}" Scale="2" Wrap="True" Margin="0,8,0,0"
                                                         Colour="{StaticResource PxGold}" />

                                        <pixel:PixelText Text="{Binding Reason}" Scale="2" Wrap="True" Margin="0,6,0,0"
                                                         Colour="{StaticResource PxTextDim}" />

                                        <pixel:PixelText Text="Necesita Azahar abierto." Scale="2" Tight="True" Margin="0,6,0,0"
                                                         Colour="{StaticResource PxTextFaint}"
                                                         Visibility="{Binding NeedsTheGame, Converter={StaticResource BoolToVisibility}}" />

                                        <Button Content="RECOGER" Style="{StaticResource PxButton}" Margin="0,10,0,0"
                                                HorizontalAlignment="Left"
                                                Command="{Binding DataContext.Gifts.ClaimCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsCollected, Converter={StaticResource InverseBoolToVisibility}}" />

                                        <pixel:PixelText Text="RECOGIDO" Scale="2" Tight="True" Margin="0,10,0,0"
                                                         Colour="{StaticResource PxGood}"
                                                         Visibility="{Binding IsCollected, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <pixel:PixelText Text="{Binding Gifts.Status}" Scale="2" Wrap="True" Margin="0,4,0,0"
                                     Colour="{StaticResource PxText}" />
                </StackPanel>
            </pixel:PixelWindow>
        </Grid>
    </Grid>
</Window>
