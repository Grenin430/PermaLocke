<Window x:Class="PermaLocke.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PermaLocke.App.ViewModels"
        xmlns:views="clr-namespace:PermaLocke.App.Views"
        xmlns:svc="clr-namespace:PermaLocke.App.Services"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PermaLocke"
        Icon="Assets/PermaLocke.ico"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterScreen">

    <!-- BARRA DE TITULO PROPIA. Era lo ultimo de la pantalla sin tematizar: una costura gris de
         Windows encima de una aplicacion entera en violeta.

         WindowChrome y no una ventana sin marco a pelo: asi el arrastre, el ajuste a los bordes y
         el menu del sistema los sigue haciendo Windows -son suyos y funcionan mejor que cualquier
         imitacion-, y lo unico que ponemos nosotros es el dibujo. CaptionHeight es la franja que
         Windows trata como barra de titulo; los botones se sacan de ahi con IsHitTestVisibleInChrome
         o no se podrian pulsar. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" GlassFrameThickness="0" CornerRadius="0"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RandomizerViewModel}">
            <views:RandomizerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GachaViewModel}">
            <views:GachaView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShopViewModel}">
            <views:ShopView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AchievementsViewModel}">
            <views:AchievementsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PokemonViewerViewModel}">
            <views:PokemonViewerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PokePasteViewModel}">
            <views:PokePasteView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MapViewModel}">
            <views:MapView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RouletteViewModel}">
            <views:RouletteView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BattleModeViewModel}">
            <views:BattleModeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SyncViewModel}">
            <views:SyncView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatisticsViewModel}">
            <views:StatisticsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MaintenanceViewModel}">
            <views:MaintenanceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MiscellaneousViewModel}">
            <views:MiscellaneousView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PendingSectionViewModel}">
            <views:PendingView />
        </DataTemplate>
    </Window.Resources>

    <!-- El contenido entero, con su propia transformacion: es lo que se despliega al volver desde
         la pestaña. Se anima ESTO y no la ventana porque Window.Opacity solo funciona con
         AllowsTransparency, y esta ventana no la lleva ni le hace falta. -->
    <Grid x:Name="Shell" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="ShellScale" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- =============================================== LA BARRA DE TITULO -->
        <Border Grid.Row="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <!-- Minimizar y cerrar. Fuera de la franja de arrastre a proposito: dentro,
                     Windows se queda el clic y el boton no llega a enterarse. -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Click="OnMinimise"
                            ToolTip="Minimizar">
                        <Path Data="M 0,0 L 11,0" Stroke="{Binding Foreground,
                                  RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.3" />
                    </Button>
                    <Button Style="{StaticResource CaptionButtonClose}" Click="OnClose"
                            ToolTip="Cerrar">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{Binding Foreground,
                                  RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.3" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Button>
                </StackPanel>

                <!-- Tambien el PNG, por lo mismo. -->
                <Image Source="Assets/PermaLocke.png" Width="18" Height="18"
                       Margin="12,0,9,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <TextBlock Text="PermaLocke" Style="{StaticResource Faint}"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- =============================================== SIDEBAR
             Darker than the content and separated by a hairline rather than a gap: it should
             read as the frame of the window, not as another panel floating next to the others. -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Wordmark -->
                <StackPanel Grid.Row="0" Margin="20,24,20,20">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="4" Height="22" RadiusX="2" RadiusY="2"
                                   Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Margin="9,0,0,0" VerticalAlignment="Center"
                                   FontSize="19" FontWeight="Bold" FontStyle="Italic">
                            <Run Text="PERMA" Foreground="{StaticResource TextBrush}" />
                            <Run Text="LOCKE" Foreground="{StaticResource AccentBrush}" />
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="Nuzlocke · Ultra Luna" Style="{StaticResource Faint}"
                               Margin="13,3,0,0" />
                </StackPanel>

                <!-- Sections -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NavItem}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="0,0,10,0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <!-- El icono se tine cuando la seccion es la activa. La barra de
                                     acento ya estaba, pero mide tres pixeles al borde de la ventana
                                     y sola no se ve; con el icono en violeta, donde estas se lee sin
                                     buscarlo. -->
                                <Path Data="{Binding IconKey, Converter={StaticResource ResourceKey}}"
                                      Margin="0,0,11,0">
                                    <Path.Style>
                                        <Style TargetType="Path" BasedOn="{StaticResource IconNav}">
                                            <Style.Triggers>
                                                <DataTrigger Value="True" Binding="{Binding IsSelected,
                                                    RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                                    <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </Grid>
        </Border>

        <!-- =============================================== CONTENT -->
        <Grid Grid.Column="1" Margin="22,20,22,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- Cabecera. SIN CAJA: era un recuadro redondeado encima de otro recuadro
                 redondeado, y dos marcos apilados no separan nada, solo apelmazan. Ahora es una
                 barra sobre el lienzo, separada del contenido por una linea. Es la diferencia
                 entre el armazon de la ventana y lo que hay dentro. -->
            <Border Grid.Row="0" Background="Transparent" Padding="4,0,4,16"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                <!-- Solo el título. La línea de descripción se quitó a petición del jugador: en una
                     aplicación que se usa a diario explica lo que ya se sabe y ocupa sitio.
                     A la derecha sí va una cosa, porque no se sabe: si esta pantalla necesita el
                     juego abierto, cerrado o le da igual. Es lo único que decide si pulsar algo
                     aquí va a funcionar, y cambia de sección en sección. -->
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" MaxWidth="290" Margin="20,0,0,0"
                                VerticalAlignment="Center" HorizontalAlignment="Right"
                                Visibility="{Binding ShowsNeed,
                                             Converter={StaticResource BoolToVisibility}}">
                        <Border HorizontalAlignment="Right" CornerRadius="9" Padding="10,4"
                                BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <!-- Apagado por defecto: es la respuesta "no te preocupes", y
                                         gritarla le quitaría fuerza a las que sí ahorran un fallo.
                                         Verde y rojo solo para lo COMPROBADO: que el emulador
                                         conteste, o que no conteste. -->
                                    <Setter Property="Background" Value="{StaticResource SurfaceHighBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NeedState}" Value="ok">
                                            <Setter Property="Background" Value="{StaticResource SuccessDeepBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NeedState}" Value="problem">
                                            <Setter Property="Background" Value="{StaticResource DangerDeepBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NeedState}" Value="closed">
                                            <Setter Property="Background" Value="{StaticResource WarningDeepBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <TextBlock Text="{Binding NeedLabel}"
                                       FontFamily="{StaticResource UiFont}" FontSize="10.5"
                                       FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NeedState}" Value="ok">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding NeedState}" Value="problem">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding NeedState}" Value="closed">
                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                    <!-- ==================================== LOS PUNTOS
                         La moneda del sistema, y por eso no van en una tarjeta con una estrella
                         delante: van como va un contador de recurso en un juego, en la esquina
                         de la barra superior, presentes en todas las pantallas y siempre en el
                         mismo sitio.

                         Tres piezas, y cada una hace algo:
                           · el rombo de latón, que es el símbolo del recurso y lo hace reconocible
                             de reojo sin leer la palabra;
                           · la cifra, en Bahnschrift con cifras tabulares, para que al pasar de
                             99 a 100 no se desplace nada de al lado;
                           · el rótulo pequeño debajo, que solo hace falta la primera vez.

                         El latón se usa aquí y en los botones de acción, y en ningún sitio más.
                         Eso es lo que hace que este número se lea como dinero. -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="20,0,0,0">
                        <Border Style="{StaticResource Chip}" VerticalAlignment="Center"
                                Margin="0,0,14,0">
                            <TextBlock Text="{Binding RoleText}" Style="{StaticResource ChipText}" />
                        </Border>

                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconPoints}"
                              Fill="{StaticResource AccentBrush}" Width="13" Height="13"
                              Margin="0,0,8,0" />

                        <StackPanel VerticalAlignment="Center">
                            <!-- La cifra RUEDA hasta su nuevo valor y da un destello del color de
                                 lo que ha pasado. Gastar trescientos puntos y que el numero cambie
                                 sin mas es tirar la mitad de la gracia de gastarlos. El mecanismo
                                 es el mismo que usa el mapa. -->
                            <TextBlock x:Name="PointsNumber" Style="{StaticResource StatValue}"
                                       Foreground="{StaticResource AccentBrush}"
                                       svc:Rolling.To="{Binding PointsValue}"
                                       LineHeight="24" LineStackingStrategy="BlockLineHeight"
                                       Visibility="{Binding HasPoints,
                                           Converter={StaticResource BoolToVisibility}}" />

                            <!-- Sin run, la raya. Un contador no puede contar hasta un guion. -->
                            <TextBlock Text="{Binding PointsText}" Style="{StaticResource StatValue}"
                                       Foreground="{StaticResource AccentBrush}"
                                       LineHeight="24" LineStackingStrategy="BlockLineHeight"
                                       Visibility="{Binding HasPoints,
                                           Converter={StaticResource InverseBoolToVisibility}}" />
                            <TextBlock Text="PUNTOS" Style="{StaticResource StatLabel}"
                                       Foreground="{StaticResource AccentDimBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- EL ICONO DE LA SECCION, delante del titulo. Se probo como marca de agua
                         -en grande y casi borrado detras del texto- y NO funciona: la cabecera mide
                         poco mas de treinta pixeles, asi que un dibujo de ochenta y seis sale
                         recortado por arriba y por abajo y lo que se ve es una losa gris, no una
                         marca. Visto en tres pantallas antes de cambiarlo. Delante y a su tamaño
                         hace lo mismo -darle cara propia a cada pantalla- y no depende de la forma
                         que tenga cada icono. -->
                    <Path Data="{Binding SelectedSection.IconKey, Converter={StaticResource ResourceKey}}"
                          Fill="{StaticResource AccentDimBrush}" Stretch="Uniform"
                          Width="21" Height="21" VerticalAlignment="Center"
                          Margin="1,0,13,0" IsHitTestVisible="False" />

                    <TextBlock Text="{Binding SelectedSection.Title}" Style="{StaticResource SectionTitle}"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- La regla de debajo del titulo arranca en acento y luego se apaga. Un detalle de
                 dos pixeles, pero es lo que convierte una linea divisoria en una cabecera. -->
            <Rectangle Grid.Row="0" Width="58" Height="2" VerticalAlignment="Bottom"
                       HorizontalAlignment="Left" Margin="4,0,0,-1" RadiusX="1" RadiusY="1"
                       Fill="{StaticResource AccentBrush}" IsHitTestVisible="False" />

            <!-- El contenido se apoya en el lienzo, sin marco propio: la pantalla ya esta acotada
                 por la barra lateral y por la cabecera. Un tercer recuadro alrededor no acota
                 nada mas, solo mete otro borde. -->
            <Border Grid.Row="2" Background="Transparent" Padding="4,0">
                <ContentControl x:Name="SectionHost" Content="{Binding SelectedSection}">
                    <ContentControl.RenderTransform>
                        <TranslateTransform x:Name="SectionSlide" />
                    </ContentControl.RenderTransform>
                </ContentControl>
            </Border>
        </Grid>
        </Grid>
    </Grid>
</Window>
