<Window x:Class="PermaLocke.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PermaLocke.App.ViewModels"
        xmlns:views="clr-namespace:PermaLocke.App.Views"
        xmlns:svc="clr-namespace:PermaLocke.App.Services"
        xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PermaLocke"
        Icon="Assets/PermaLocke.ico"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterScreen">

    <!-- BARRA DE TITULO PROPIA. Era lo ultimo de la pantalla sin tematizar: una costura gris de
         Windows encima de una aplicacion entera en violeta.

         WindowChrome y no una ventana sin marco a pelo: asi el arrastre, el ajuste a los bordes y
         el menu del sistema los sigue haciendo Windows -son suyos y funcionan mejor que cualquier
         imitacion-, y lo unico que ponemos nosotros es el dibujo. CaptionHeight es la franja que
         Windows trata como barra de titulo; los botones se sacan de ahi con IsHitTestVisibleInChrome
         o no se podrian pulsar. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" GlassFrameThickness="0" CornerRadius="0"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <DataTemplate DataType="{x:Type vm:LauncherViewModel}">
            <views:LauncherView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RandomizerViewModel}">
            <views:RandomizerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GachaViewModel}">
            <views:GachaView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShopViewModel}">
            <views:ShopView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AchievementsViewModel}">
            <views:AchievementsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PokemonViewerViewModel}">
            <views:PokemonViewerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AlbumViewModel}">
            <views:AlbumView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EvTrainingViewModel}">
            <views:EvTrainingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MoveReminderViewModel}">
            <views:MoveReminderView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PokePasteViewModel}">
            <views:PokePasteView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MapViewModel}">
            <views:MapView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RouletteViewModel}">
            <views:RouletteView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NurseryViewModel}">
            <views:NurseryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BattleModeViewModel}">
            <views:BattleModeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SyncViewModel}">
            <views:SyncView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CemeteryViewModel}">
            <views:CemeteryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <!-- Grupos de la barra (JUGAR, PUNTOS, EQUIPO, TORNEO, INFORMACIÓN): la página elegida, con su propia plantilla. -->
        <DataTemplate DataType="{x:Type vm:GroupSectionViewModel}">
            <ContentControl Content="{Binding SelectedPage}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InformationPageViewModel}">
            <views:InformationView DataContext="{Binding Info}" Tag="{Binding DataContext.Shops, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DifficultyViewModel}">
            <views:DifficultyView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MiscellaneousViewModel}">
            <views:MiscellaneousView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PendingSectionViewModel}">
            <views:PendingView />
        </DataTemplate>
    </Window.Resources>


    <!-- EL MARCO (2026-10-01): lo que se ve dentro de la ventana lo pone el diseño en uso (Shells/*): la barra lateral de
         siempre, las pestañas, el menú de inicio, el muelle o la Pokédex. Los rellena MainWindow.xaml.cs, y todos comparten el
         contexto de datos de esta ventana: cambiar de diseño no cambia la sección ni nada de lo que hay detrás.
         Se anima ESTE contenedor al volver desde la pestaña, y no la ventana, porque Window.Opacity solo funciona con
         AllowsTransparency, y esta ventana no la lleva ni le hace falta. -->
    <ContentControl x:Name="ShellSlot" IsTabStop="False" Focusable="False" RenderTransformOrigin="0.5,0.5"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <ContentControl.RenderTransform>
            <ScaleTransform x:Name="SlotScale" ScaleX="1" ScaleY="1" />
        </ContentControl.RenderTransform>
    </ContentControl>
</Window>
