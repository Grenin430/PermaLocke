<!--
    EL ESTILO EN PÍXELES (§176). La muestra que pidió el jugador: el marco de la ventana, la barra lateral, la cabecera
    y HOME dibujados en celdas, con la misma técnica que las escenas —la máquina de cápsulas, la cabina del intercambio,
    la ruleta—. Todo lo que hay aquí lleva claves propias («Px…») y no pisa ninguna del tema, así que las demás
    pantallas siguen como estaban hasta que se decida si se rehace todo.

    Las reglas son las de siempre en este proyecto: celdas enteras, colores planos, sombra dura, nada de degradados ni
    desenfoques. El texto va en la fuente propia (Views/Pixel/PixelFont.cs), que se dibuja en celdas como todo lo demás.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:PermaLocke.App.Views"
                    xmlns:pixel="clr-namespace:PermaLocke.App.Views.Pixel">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="PixelColours.xaml" />
    </ResourceDictionary.MergedDictionaries>


    <!-- ==================================================================== LA VENTANA
         Un bloque de pantalla como una ventana del menú de un juego: la placa, el título con su icono y su nombre, lo que
         se quiera a la derecha, y el contenido debajo. El título se lleva de cuatro maneras según el diseño en uso
         (PixelWindow.Variant): banda, etiqueta, subrayado o HUD. -->
    <Style TargetType="pixel:PixelWindow">
        <Setter Property="Padding" Value="14,10,18,15" />
        <Setter Property="Fill" Value="{DynamicResource PxFace}" />
        <Setter Property="HeaderFill" Value="{DynamicResource PxFaceHigh}" />
        <Setter Property="HeaderAccent" Value="{DynamicResource PxAccent}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="pixel:PixelWindow">
                    <Grid>
                        <views:PixelPanel x:Name="Frame" Fill="{TemplateBinding Fill}" HeaderFill="{TemplateBinding HeaderFill}"
                                          HeaderAccent="{TemplateBinding HeaderAccent}"
                                          IsSunken="{TemplateBinding IsSunken}"
                                          HeaderHeight="{x:Static pixel:PixelWindow.BandHeight}" />
                        <DockPanel>
<Border DockPanel.Dock="Top" Height="{Binding HeadInset, RelativeSource={RelativeSource TemplatedParent}}" />
                            <DockPanel x:Name="Head" DockPanel.Dock="Top" Height="{x:Static pixel:PixelWindow.BandHeight}"
                                       Margin="12,3,20,0">
                                <ContentPresenter DockPanel.Dock="Right" Content="{TemplateBinding HeaderContent}"
                                                  VerticalAlignment="Center" />

                                <Grid x:Name="TitleCell" VerticalAlignment="Center">
                                    <!-- El hilo que sale del título hacia la derecha (HUD): el título lo tapa por la izquierda. -->
                                    <pixel:PixelRule x:Name="HudRule" VerticalAlignment="Center" Margin="0,0,10,0"
                                                     Visibility="Collapsed" />
                                    <Grid x:Name="TitleBack" HorizontalAlignment="Left">
                                        <views:PixelPanel x:Name="TagPlate" Fill="{TemplateBinding HeaderFill}" HasShadow="False"
                                                          Visibility="Collapsed" />
                                        <DockPanel x:Name="TitleRow">
                                            <Border x:Name="HudBar" DockPanel.Dock="Left" Width="6" Height="21" Margin="0,0,10,0"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource PxAccentBrush}" Visibility="Collapsed" />
                                            <pixel:PixelIcon x:Name="Glyph" DockPanel.Dock="Left" Icon="{TemplateBinding Icon}" Scale="2"
                                                             VerticalAlignment="Center" Margin="0,0,9,0" />
                                            <pixel:PixelText x:Name="Title" Text="{TemplateBinding Title}" Scale="2" Tight="True" Trim="True"
                                                             Colour="{DynamicResource PxText}" Shadow="{DynamicResource PxShadow}"
                                                             VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Grid>
                                </Grid>
                            </DockPanel>

                            <!-- El subrayado del título (Game Boy): un surco a todo lo ancho. -->
                            <pixel:PixelRule x:Name="PlainRule" DockPanel.Dock="Top" Margin="12,0,12,0" Visibility="Collapsed" />

                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Variant" Value="Tag">
                            <Setter TargetName="Frame" Property="HeaderHeight" Value="0" />
                            <Setter TargetName="Head" Property="Height" Value="30" />
                            <Setter TargetName="Head" Property="Margin" Value="10,9,20,0" />
                            <Setter TargetName="TagPlate" Property="Visibility" Value="Visible" />
                            <Setter TargetName="TitleRow" Property="Margin" Value="10,6,14,10" />
                        </Trigger>
                        <Trigger Property="Variant" Value="Plain">
                            <Setter TargetName="Frame" Property="HeaderHeight" Value="0" />
                            <Setter TargetName="Head" Property="Height" Value="28" />
                            <Setter TargetName="Head" Property="Margin" Value="14,6,18,0" />
                            <Setter TargetName="PlainRule" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Variant" Value="Hud">
                            <Setter TargetName="Frame" Property="HeaderHeight" Value="0" />
                            <Setter TargetName="Head" Property="Height" Value="28" />
                            <Setter TargetName="Head" Property="Margin" Value="14,8,18,0" />
                            <Setter TargetName="HudBar" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HudRule" Property="Visibility" Value="Visible" />
                            <Setter TargetName="TitleBack" Property="Background" Value="{Binding FillBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- ==================================================================== BOTONES
         Tres pesos, como en el tema: la acción, las demás y la destructiva. La placa es un PixelPanel con su sombra
         dura, y pulsar es hundirse tres unidades hacia ella, sin escalas suaves. -->
    <Style x:Key="PxButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="14,6,19,11" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Body" Background="Transparent">
                        <views:PixelPanel x:Name="Plate" Fill="{DynamicResource PxAccent}" />
                        <pixel:PixelText x:Name="Label" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                         Colour="{DynamicResource PxOnAccent}" Scale="2" Tight="True"
                                         Margin="{TemplateBinding Padding}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="Fill" Value="{DynamicResource PxAccentLight}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Plate" Property="HasShadow" Value="False" />
                            <Setter TargetName="Plate" Property="Margin" Value="6,6,0,0" />
                            <Setter TargetName="Label" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="6" Y="6" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Plate" Property="Fill" Value="{DynamicResource PxFaceLift}" />
                            <Setter TargetName="Label" Property="Colour" Value="{DynamicResource PxTextFaint}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PxSubtleButton" TargetType="Button" BasedOn="{StaticResource PxButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Body" Background="Transparent">
                        <views:PixelPanel x:Name="Plate" Fill="{DynamicResource PxFaceLift}" />
                        <pixel:PixelText x:Name="Label" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                         Colour="{DynamicResource PxText}" Scale="2" Tight="True"
                                         Margin="{TemplateBinding Padding}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="Fill" Value="{DynamicResource PxAccentDeep}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Plate" Property="HasShadow" Value="False" />
                            <Setter TargetName="Plate" Property="Margin" Value="6,6,0,0" />
                            <Setter TargetName="Label" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="6" Y="6" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Label" Property="Colour" Value="{DynamicResource PxTextFaint}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rojo por dentro y nunca relleno de rojo vivo: un botón rojo macizo pide que lo pulses, y este es el que no. -->
    <Style x:Key="PxDangerButton" TargetType="Button" BasedOn="{StaticResource PxButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Body" Background="Transparent">
                        <views:PixelPanel x:Name="Plate" Fill="{DynamicResource PxBadDeep}" />
                        <pixel:PixelText x:Name="Label" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                         Colour="{DynamicResource PxBad}" Scale="2" Tight="True"
                                         Margin="{TemplateBinding Padding}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="Fill" Value="{DynamicResource PxBadHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Plate" Property="HasShadow" Value="False" />
                            <Setter TargetName="Plate" Property="Margin" Value="6,6,0,0" />
                            <Setter TargetName="Label" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="6" Y="6" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Label" Property="Colour" Value="{DynamicResource PxTextFaint}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Los dos botones de la barra de título: placas pequeñas sin sombra; cerrar se pone roja al pasar por encima. -->
    <Style x:Key="PxCaptionButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="27" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Body" Background="Transparent">
                        <views:PixelPanel x:Name="Plate" Fill="{DynamicResource PxFace}" HasShadow="False" />
                        <pixel:PixelText x:Name="Label" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                         Colour="{DynamicResource PxTextDim}" Scale="2" Tight="True"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="Fill" Value="{DynamicResource PxFaceLift}" />
                            <Setter TargetName="Label" Property="Colour" Value="{DynamicResource PxText}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Body" Property="Margin" Value="0,2,0,-2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PxCaptionClose" TargetType="Button" BasedOn="{StaticResource PxCaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Body" Background="Transparent">
                        <views:PixelPanel x:Name="Plate" Fill="{DynamicResource PxFace}" HasShadow="False" />
                        <pixel:PixelText x:Name="Label" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                         Colour="{DynamicResource PxTextDim}" Scale="2" Tight="True"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="Fill" Value="#FFB8433A" />
                            <Setter TargetName="Label" Property="Colour" Value="{DynamicResource PxText}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Body" Property="Margin" Value="0,2,0,-2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================== EL MENÚ
         Una fila del menú de pausa de un juego: la placa se enciende al pasar por encima, y la sección en pantalla
         lleva además la flecha a la izquierda. El icono y el texto los pone la plantilla de datos de la ventana. -->
    <Style x:Key="PxNavItem" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <StackPanel>
                    <Grid x:Name="Root" Background="Transparent" Height="31" Margin="6,1,8,1">
                        <views:PixelPanel x:Name="Plate" Fill="{DynamicResource PxAccentDeep}" HasShadow="False"
                                          Visibility="Collapsed" />
                        <Grid Margin="5,0,6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="13" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <pixel:PixelText x:Name="Cursor" Grid.Column="0" Text="▶" Scale="2" Tight="True"
                                             Colour="{DynamicResource PxCursor}" VerticalAlignment="Center"
                                             Visibility="Hidden" />
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                    <!-- Lo que cuelga de una entrada abierta: las pestañas de EQUIPO y TORNEO.
                         La plantilla la pone quien usa este estilo (MainWindow); una sección suelta no tiene grupo. -->
                    <ContentControl x:Name="Children" Content="{Binding AsGroup}" ContentTemplate="{DynamicResource NavChildrenTemplate}"
                                    Focusable="False" Visibility="Collapsed" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Plate" Property="Fill" Value="{DynamicResource PxFaceHigh}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Plate" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Plate" Property="Fill" Value="{DynamicResource PxAccentDeep}" />
                            <Setter TargetName="Cursor" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Children" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ==================================================================== PESTAÑAS
         Las páginas de la pantalla de datos de un juego: placas en fila encima de un pozo hundido, la de la página en
         pantalla encendida y pegada al pozo. -->
    <Style x:Key="PxTabItem" TargetType="TabItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid x:Name="Root" Margin="0,4,6,0" Background="Transparent">
                        <views:PixelPanel x:Name="Plate" Fill="{DynamicResource PxFaceHigh}" HasShadow="False" />
                        <pixel:PixelText x:Name="Label" Text="{TemplateBinding Header}" Scale="2" Tight="True"
                                         Colour="{DynamicResource PxTextFaint}" Margin="12,8,12,9"
                                         HorizontalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="Fill" Value="{DynamicResource PxFaceLift}" />
                            <Setter TargetName="Label" Property="Colour" Value="{DynamicResource PxTextDim}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Margin" Value="0,0,6,0" />
                            <Setter TargetName="Plate" Property="Fill" Value="{DynamicResource PxAccentDeep}" />
                            <Setter TargetName="Label" Property="Colour" Value="{DynamicResource PxText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PxTabControl" TargetType="TabControl">
        <Setter Property="ItemContainerStyle" Value="{StaticResource PxTabItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" IsItemsHost="True" />
                        <Grid Margin="0,4,0,0">
                            <views:PixelPanel Fill="{DynamicResource PxWell}" IsSunken="True" HasShadow="False" />
                            <ContentPresenter ContentSource="SelectedContent" Margin="14,12,14,14" />
                        </Grid>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- ==================================================================== BARRA DE DESPLAZAMIENTO
         Una ranura hundida y una tablilla violeta. Sin flechas: se arrastra o se usa la rueda. -->
    <Style x:Key="PxScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="15" />
        <Setter Property="MinWidth" Value="15" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid SnapsToDevicePixels="True">
                        <Border Background="{DynamicResource PxInkBrush}" />
                        <Border Background="{DynamicResource PxWellBrush}" Margin="3" />
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="3">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid SnapsToDevicePixels="True">
                                                <Border Background="{DynamicResource PxAccentBrush}" />
                                                <Border Background="{DynamicResource PxAccentDeepBrush}" Margin="3,3,0,0" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================== CAMPO DE TEXTO
         Lo que se escribe no puede ir en la fuente propia -hay que poder poner el cursor entre dos letras-, así que va
         en monoespaciada clara dentro de un pozo hundido, que es lo que en un juego es una casilla para escribir. -->
    <Style x:Key="PxTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource PxTextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource PxAccentBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource PxAccentBrush}" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid Background="Transparent">
                        <views:PixelPanel x:Name="Well" Fill="{DynamicResource PxWell}" IsSunken="True" HasShadow="False" />
                        <pixel:PixelText x:Name="Hint" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                         Scale="2" Tight="True" Colour="{DynamicResource PxTextFaint}" IsHitTestVisible="False"
                                         Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Visibility="Collapsed" />
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      Focusable="False" Background="Transparent">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource PxScrollBar}" />
                            </ScrollViewer.Resources>
                        </ScrollViewer>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- El texto de ayuda, en la casilla vacía: se va en cuanto escribes. -->
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Well" Property="Fill" Value="{DynamicResource PxWellFocus}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================== CASILLA
         Un hueco hundido y, marcada, una placa violeta dentro: el interruptor de un menú de opciones. -->
    <Style x:Key="PxCheckBox" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="27" Height="27" VerticalAlignment="Center">
                            <views:PixelPanel x:Name="Hole" Fill="{DynamicResource PxWell}" IsSunken="True" HasShadow="False" />
                            <!-- Un recuadro liso y no un PixelPanel: a 15 px el panel no llega a sus 6 celdas mínimas y no pintaba nada. -->
                            <Border x:Name="Mark" Background="{DynamicResource PxAccentBrush}" Margin="8" Visibility="Hidden" />
                        </Grid>
                        <pixel:PixelText x:Name="Label" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                         Scale="2" Tight="True" Colour="{DynamicResource PxTextDim}"
                                         VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Label" Property="Colour" Value="{DynamicResource PxText}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hole" Property="Fill" Value="{DynamicResource PxFaceHigh}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Label" Property="Colour" Value="{DynamicResource PxTextFaint}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================== DESPLEGABLE
         Una casilla hundida con su flecha y, al abrirla, una placa con las opciones: la de encima se enciende. Las
         opciones las dibuja la plantilla de datos de cada pantalla. -->
    <Style x:Key="PxComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid Background="Transparent" MinHeight="32">
                        <views:PixelPanel x:Name="Plate" Fill="{DynamicResource PxAccentDeep}" HasShadow="False" Visibility="Collapsed" />
                        <ContentPresenter Margin="10,6,10,7" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Plate" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Plate" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Plate" Property="Fill" Value="{DynamicResource PxFaceLift}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PxComboBox" TargetType="ComboBox">
        <Setter Property="ItemContainerStyle" Value="{StaticResource PxComboBoxItem}" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" ClickMode="Press" Cursor="Hand"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid Background="Transparent">
                                        <views:PixelPanel x:Name="Well" Fill="{DynamicResource PxWell}" IsSunken="True" HasShadow="False" />
                                        <pixel:PixelText Text="▼" Scale="2" Tight="True" Colour="{DynamicResource PxAccentInk}"
                                                         HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Well" Property="Fill" Value="{DynamicResource PxFaceHigh}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="13,8,40,8" VerticalAlignment="Center" IsHitTestVisible="False" />

                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="None">
                            <Grid MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <views:PixelPanel Fill="{DynamicResource PxFace}" />
                                <ScrollViewer Margin="5,5,11,11" VerticalScrollBarVisibility="Auto">
                                    <ScrollViewer.Resources>
                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource PxScrollBar}" />
                                    </ScrollViewer.Resources>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- El desplegable en el que también se escribe (el selector de especie). Un ComboBox editable necesita su
         PART_EditableTextBox o deja de aceptar texto en silencio (§50), así que es un estilo aparte. -->
    <Style x:Key="PxEditableComboBox" TargetType="ComboBox" BasedOn="{StaticResource PxComboBox}">
        <Setter Property="IsEditable" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource PxTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid Background="Transparent">
                        <views:PixelPanel x:Name="Well" Fill="{DynamicResource PxWell}" IsSunken="True" HasShadow="False" />
                        <TextBox x:Name="PART_EditableTextBox" Margin="12,0,40,0" VerticalAlignment="Center"
                                 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PxTextBrush}"
                                 CaretBrush="{DynamicResource PxAccentBrush}" SelectionBrush="{DynamicResource PxAccentBrush}"
                                 FontFamily="Consolas" FontSize="15"
                                 IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Background="Transparent" />
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                        <ToggleButton Focusable="False" ClickMode="Press" Cursor="Hand" Width="36" HorizontalAlignment="Right"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid Background="Transparent">
                                        <pixel:PixelText Text="▼" Scale="2" Tight="True" Colour="{DynamicResource PxAccentInk}"
                                                         HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0" />
                                    </Grid>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                            <Grid MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <views:PixelPanel Fill="{DynamicResource PxFace}" />
                                <ScrollViewer Margin="5,5,11,11" VerticalScrollBarVisibility="Auto">
                                    <ScrollViewer.Resources>
                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource PxScrollBar}" />
                                    </ScrollViewer.Resources>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Well" Property="Fill" Value="{DynamicResource PxWellFocus}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Una opción de las que se elige una sola (el rol): la tarjeta entera es el botón, con el cursor del juego
         alrededor de la elegida. -->
    <Style x:Key="PxRadioCard" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <views:PixelPanel x:Name="Plate" Fill="{DynamicResource PxFaceHigh}" />
                        <ContentPresenter Margin="14,11,20,16" />
                        <views:PixelCursor x:Name="Cursor" Margin="-4" Visibility="Collapsed" Colour="#FFFFF08A" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="Fill" Value="{DynamicResource PxFaceLift}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Plate" Property="Fill" Value="{DynamicResource PxAccentDeep}" />
                            <Setter TargetName="Cursor" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Un interruptor con cara de botón (CÁMARA LENTA en la killcam): encendido se queda en violeta. -->
    <Style x:Key="PxToggleButton" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="16,8,22,13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Body" Background="Transparent">
                        <views:PixelPanel x:Name="Plate" Fill="{DynamicResource PxFaceLift}" />
                        <pixel:PixelText x:Name="Label" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                         Colour="{DynamicResource PxText}" Scale="2" Tight="True"
                                         Margin="{TemplateBinding Padding}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="Fill" Value="{DynamicResource PxAccentDeep}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Plate" Property="Fill" Value="{DynamicResource PxAccent}" />
                            <Setter TargetName="Label" Property="Colour" Value="{DynamicResource PxOnAccent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Plate" Property="HasShadow" Value="False" />
                            <Setter TargetName="Plate" Property="Margin" Value="6,6,0,0" />
                            <Setter TargetName="Label" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="6" Y="6" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
