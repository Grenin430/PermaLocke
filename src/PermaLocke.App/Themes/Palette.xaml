<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Colour tokens. Every brush in the app comes from here; no literal colours in views.

        The set is layered rather than flat: a dark theme with a single background colour reads
        as a hole, so there are four steps of depth — the app floor, a panel, a raised panel and
        a hairline — and everything on screen sits on one of them. That is what lets a card look
        like a card without drawing a heavy border around it.
    -->

    <!-- Depth, from the floor upwards. -->
    <Color x:Key="BackgroundColor">#FF05070B</Color>
    <Color x:Key="BackgroundLiftColor">#FF090E17</Color>
    <Color x:Key="SurfaceColor">#FF0B1018</Color>
    <Color x:Key="SurfaceAltColor">#FF111827</Color>
    <Color x:Key="SurfaceHighColor">#FF17202F</Color>
    <Color x:Key="BorderColor">#FF1C2637</Color>
    <Color x:Key="BorderStrongColor">#FF283449</Color>

    <!-- Accent. -->
    <Color x:Key="AccentColor">#FF3FD0F0</Color>
    <Color x:Key="AccentBrightColor">#FF7EE4FA</Color>
    <Color x:Key="AccentDimColor">#FF1B6C80</Color>
    <Color x:Key="AccentDeepColor">#FF0E3A47</Color>

    <!-- Text. -->
    <Color x:Key="TextColor">#FFF2F6FA</Color>
    <Color x:Key="TextMutedColor">#FF8FA3B4</Color>
    <Color x:Key="TextFaintColor">#FF5B6B7D</Color>

    <!-- Meaning. -->
    <Color x:Key="DangerColor">#FFE0544F</Color>
    <Color x:Key="DangerDeepColor">#FF3A1614</Color>
    <Color x:Key="SuccessColor">#FF4FE08A</Color>
    <Color x:Key="SuccessDeepColor">#FF10321F</Color>
    <Color x:Key="WarningColor">#FFE0B34F</Color>
    <Color x:Key="WarningDeepColor">#FF3A2C11</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="SurfaceHighBrush" Color="{StaticResource SurfaceHighColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentBrightBrush" Color="{StaticResource AccentBrightColor}" />
    <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDimColor}" />
    <SolidColorBrush x:Key="AccentDeepBrush" Color="{StaticResource AccentDeepColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="{StaticResource TextFaintColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerDeepBrush" Color="{StaticResource DangerDeepColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessDeepBrush" Color="{StaticResource SuccessDeepColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningDeepBrush" Color="{StaticResource WarningDeepColor}" />

    <!-- The floor of the whole window: a slow vertical lift so the screen has a top and a bottom. -->
    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Offset="0" Color="{StaticResource BackgroundLiftColor}" />
        <GradientStop Offset="1" Color="{StaticResource BackgroundColor}" />
    </LinearGradientBrush>

    <!-- A card. Barely a gradient on purpose: enough to catch the light, not enough to notice. -->
    <LinearGradientBrush x:Key="PanelBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{StaticResource SurfaceAltColor}" />
        <GradientStop Offset="1" Color="{StaticResource SurfaceColor}" />
    </LinearGradientBrush>

    <!-- A header strip: the accent bleeding in from the left. -->
    <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="{StaticResource AccentDeepColor}" />
        <GradientStop Offset="0.55" Color="{StaticResource SurfaceAltColor}" />
        <GradientStop Offset="1" Color="{StaticResource SurfaceColor}" />
    </LinearGradientBrush>

    <!-- A filled accent button. -->
    <LinearGradientBrush x:Key="AccentFillBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{StaticResource AccentBrightColor}" />
        <GradientStop Offset="1" Color="{StaticResource AccentColor}" />
    </LinearGradientBrush>

    <!-- The sidebar: darker than the content, so the eye knows which one is furniture. -->
    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{StaticResource SurfaceColor}" />
        <GradientStop Offset="1" Color="{StaticResource BackgroundColor}" />
    </LinearGradientBrush>

    <!-- Un color por rareza del gacha. La animación del ultraespacio pinta un portal de cada
         uno, y el que se ilumina al final es el del tier que ha tocado. -->
    <Color x:Key="Tier1Color">#FF7C8AA0</Color>
    <Color x:Key="Tier2Color">#FF4FE08A</Color>
    <Color x:Key="Tier3Color">#FF3FD0F0</Color>
    <Color x:Key="Tier4Color">#FFB061F0</Color>
    <Color x:Key="Tier5Color">#FFFFB03F</Color>

    <SolidColorBrush x:Key="Tier1Brush" Color="{StaticResource Tier1Color}" />
    <SolidColorBrush x:Key="Tier2Brush" Color="{StaticResource Tier2Color}" />
    <SolidColorBrush x:Key="Tier3Brush" Color="{StaticResource Tier3Color}" />
    <SolidColorBrush x:Key="Tier4Brush" Color="{StaticResource Tier4Color}" />
    <SolidColorBrush x:Key="Tier5Brush" Color="{StaticResource Tier5Color}" />

    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas</FontFamily>

    <!-- Corner radii, named so the whole app rounds by the same amounts. -->
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">12</CornerRadius>

</ResourceDictionary>
