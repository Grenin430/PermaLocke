<Project Sdk="Microsoft.NET.Sdk">

  <!--
    La Ultraumbral del randomizador (2026-10-12) fuera de la app: la escena tal cual la compila PermaLocke.App, con pasos y final
    simulados, en una tira de fotogramas y un vídeo. Los dibujos salen de Data/sprites, como en la app.

      dotnet run -c Release con el proyecto tools/PermaLocke.PortalLab, con la carpeta de salida y, si se quiere, fallo
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PermaLocke.PortalLab</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PermaLocke.App\PermaLocke.App.csproj" />
  </ItemGroup>

</Project>
