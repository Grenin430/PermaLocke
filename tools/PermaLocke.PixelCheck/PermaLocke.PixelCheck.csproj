<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Las pruebas del dibujo del ÁLBUM (§187) en cualquier sistema, también en Linux y en la nube, donde WPF no corre.
    Compila los ficheros puros de la app tal cual (cartas, carpeta, carta en la mano, fuentes, colores de tipo), que
    pintan con PixelColour (§188), y ejecuta las mismas AlbumTests que tests/PermaLocke.App.Tests. El Color de
    sustituto (WpfColour.cs) queda para RoomSprite.At y PixelScene. Desde el §189 compila también PixelScene y la
    máquina de cápsulas del gacha, con sustitutos de WriteableBitmap y compañía (WpfImaging.cs), y ejecuta las
    CapsuleMachineTests; GachaPreviews deja fotogramas de tiradas en PNG.

      dotnet test tools/PermaLocke.PixelCheck
      PERMALOCKE_PIXEL_DIR=/ruta dotnet test tools/PermaLocke.PixelCheck   # además deja PNG para mirarlos

    No está en PermaLocke.slnx a propósito: en Windows esas pruebas ya corren en PermaLocke.App.Tests.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>PermaLocke.PixelCheck</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="..\..\src\PermaLocke.App\Views\PixelColour.cs" Link="App\PixelColour.cs" />
    <Compile Include="..\..\src\PermaLocke.App\Views\TcgCard.cs" Link="App\TcgCard.cs" />
    <Compile Include="..\..\src\PermaLocke.App\Views\TcgCardArt.cs" Link="App\TcgCardArt.cs" />
    <Compile Include="..\..\src\PermaLocke.App\Views\AlbumScene.cs" Link="App\AlbumScene.cs" />
    <Compile Include="..\..\src\PermaLocke.App\Views\HandScene.cs" Link="App\HandScene.cs" />
    <Compile Include="..\..\src\PermaLocke.App\Views\CatchScene.cs" Link="App\CatchScene.cs" />
    <Compile Include="..\..\src\PermaLocke.App\Views\CardTradeScene.cs" Link="App\CardTradeScene.cs" />
    <Compile Include="..\..\src\PermaLocke.App\Views\RoomSprite.cs" Link="App\RoomSprite.cs" />
    <Compile Include="..\..\src\PermaLocke.App\Views\Pixel\PixelFont.cs" Link="App\PixelFont.cs" />
    <Compile Include="..\..\src\PermaLocke.App\Views\Pixel\SmallFont.cs" Link="App\SmallFont.cs" />
    <Compile Include="..\..\src\PermaLocke.App\Services\TypeColours.cs" Link="App\TypeColours.cs" />
    <Compile Include="..\..\src\PermaLocke.App\ViewModels\AlbumPaging.cs" Link="App\AlbumPaging.cs" />
    <Compile Include="..\..\tests\PermaLocke.App.Tests\AlbumTests.cs" Link="Tests\AlbumTests.cs" />
    <Compile Include="..\..\src\PermaLocke.App\Views\PixelScene.cs" Link="App\PixelScene.cs" />
    <Compile Include="..\..\src\PermaLocke.App\Views\AlolaPalette.cs" Link="App\AlolaPalette.cs" />
    <Compile Include="..\..\src\PermaLocke.App\Views\CapsuleMachineScene.cs" Link="App\CapsuleMachineScene.cs" />
    <Compile Include="..\..\src\PermaLocke.App\ViewModels\CapsulePlay.cs" Link="App\CapsulePlay.cs" />
    <Compile Include="..\..\tests\PermaLocke.App.Tests\CapsuleMachineTests.cs" Link="Tests\CapsuleMachineTests.cs" />
  </ItemGroup>

</Project>
