# --- Compilación -------------------------------------------------------------
bin/
obj/
*.user
.vs/

# --- Material que NO se redistribuye -----------------------------------------
# Locke/ es una instalación ajena (BxnnyLocke) con una partida del usuario. Es de
# solo lectura y material de referencia: no es nuestro y no se publica.
/Locke/

# La ROM es propiedad de Nintendo. Cada jugador aporta la suya; PermaLocke nunca
# la modifica ni la distribuye.
/ROM/
# Anclado a la raiz con la barra inicial: sin ella, "ROM/" tambien casaba con
# src/PermaLocke.Randomizer/Rom/, y cinco ficheros de codigo llevaban desde
# entonces fuera del repositorio. Lo mismo vale para el resto de esta lista.

# Los emuladores, incluido el fork propio, se distribuyen desde su repositorio
# con su fuente, no metidos aquí.
/Azahar/
/Nuevo_azahar/


# --- Generado ----------------------------------------------------------------
# Mods de LayeredFS: se regeneran desde la ROM y la seed, y pesan cientos de MB.
/Randomized/

# Partidas, eventos y copias de seguridad de memoria: datos del jugador.
/Saves/

/Logs/
# El fork de Azahar que se reparte con la app: 100 MB de binarios que se reconstruyen desde
# github.com/Grenin430/azahar. Solo se versiona su LEEME, que dice de dónde salen y bajo qué
# licencia se distribuyen.
/Emulator/*
!/Emulator/LEEME.md
# El plugin del Pokémon que te sigue es de otro autor (CC BY-NC-ND): solo se versionan sus créditos.
!/Emulator/follower/
/Emulator/follower/*
!/Emulator/follower/LEEME.txt

# Los sprites de Pokémon son de Nintendo. Se extraen de la ROM que cada jugador ya tiene
# (PermaLocke.RomTool sprites) y nunca se versionan ni se redistribuyen, igual que la ROM.
/Data/sprites/

# El romfs de otro mod sobre el que randomizar. Son gigabytes y son assets de Nintendo:
# igual que ROM/, cada jugador se lo consigue por su cuenta. Ver docs/MOD-EXPANSION.md.
/Expansion/

# La copia del mod anterior que deja el randomizador al reinstalar (§42). Son ficheros
# del juego, igual que ROM/ y Expansion/: se conservan en el disco pero NO se versionan.
/permalocke-mod-anterior/

# Los mapas de area sacados del cartucho para ponerles nombre. Son pixeles de
# Nintendo, igual que Data/sprites/: se extraen de la ROM de cada jugador.
/Data/mapa-areas/

# Los mapas de isla cosidos del cartucho. Pixeles de Nintendo, igual que Data/sprites/.
/Data/mapa-islas/

# Las fotos de cada zona que el jugador reunio para el mapa. Son imagenes del juego,
# igual que Data/sprites/ y Data/mapa-islas/: no se versionan.
/islas/

# Copia del emulador anterior, por si un build nuevo sale malo. Binarios: no se versionan.
/Emulator-anterior/

# Copias del emulador de antes de cada parche del fork. Son binarios y pesan cien megas cada una:
# se guardan para poder volver atras en un minuto, no para versionarlas.
/Emulator-antes-parche3/
/Nuevo_azahar-anterior/
/Nuevo_azahar-antes-parche3/

# La posicion de la pestaña lateral, que es de esta maquina y de nadie mas.
/Config/pestana.json

# Distribuciones locales y pruebas aisladas
/.dist/
